package main

import arrays

// Merge sort: split, sort the halves, merge them.

method merge(array<integer> a, array<integer> b): array<integer> {
    var out = []
    var i = 0
    var j = 0
    while (i < a.length() && j < b.length()) {
        if (a[i] <= b[j]) {
            out.append(a[i])
            i = i + 1
            continue
        }
        out.append(b[j])
        j = j + 1
    }
    return arrays.concat(out, arrays.concat(arrays.slice(a, i, a.length()), arrays.slice(b, j, b.length())))
}

method mergeSort(array<integer> items): array<integer> {
    if (items.length() < 2) {
        return items
    }
    var middle = items.length() / 2
    return merge(mergeSort(arrays.slice(items, 0, middle)), mergeSort(arrays.slice(items, middle, items.length())))
}

method main {
    println mergeSort([38, 27, 43, 3, 9, 82, 10])
}
