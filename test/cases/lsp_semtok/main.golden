== the legend
types: namespace type class enum interface parameter variable property enumMember function method decorator keyword comment string number operator modifier
modifiers: declaration readonly abstract deprecated defaultLibrary modification async documentation
ok   a call hands out a copy
ok   no duplicates
ok   a constant is a readonly variable declaration
ok   every type index is in the legend
== LexicalTokens.classify: what the lexer alone decides
var -> keyword
x -> none
= -> operator
0x1F -> number
+ -> operator
2.5 -> number
"s" -> string
a -> none
< -> none
b -> none
>= -> operator
c -> none
=> -> operator
d -> none
&& -> operator
! -> operator
e -> none
@ -> decorator
; -> none
: -> none
// note -> comment
/// doc -> comment +documentation
/** block */ -> comment +documentation
ok   a plain identifier is left alone
ok   the end of file is left alone
== contextual words: special in their position only
define class Box based Base { }
    define@0=keyword  class@7=keyword  based@17=keyword
define abstract Shape { abstract method area(): float }
    define@0=keyword  abstract@7=keyword  abstract@24=modifier
define abstract class Shape { }
    define@0=keyword  abstract@7=keyword  class@16=keyword
define enum E { A }  define interface I { }  define annotation N { }
    define@0=keyword  enum@7=keyword  define@21=keyword  interface@28=keyword  define@45=keyword  annotation@52=keyword
var define = 1 var class = 2 var based = 3 var construct = 4
    define@4=name  class@19=name  based@33=name  construct@47=name
define class A { construct(integer x) { } method construct(integer y) { } }
    construct@17=keyword  construct@49=name
async method run() { } method abstract() { }
    async@0=modifier  abstract@30=name
method f(): T native "nv_f" variadic  method g(variadic: integer) { }
    native@14=modifier  variadic@28=modifier  variadic@47=name
define class A { string x: get, set  integer get: integer }
    get@27=modifier  set@32=modifier  get@45=name
var get = 1 var set = 2
    get@4=name  set@16=name
method m() { sync { x = 1 } sync (lock) { x = 2 } sync(x) y = sync(3) }
    sync@13=keyword  sync@28=keyword  sync@50=keyword  sync@62=name
method m() { var a = await t  var b = await + 1  var c = await -1 }
    await@21=keyword  await@38=name  await@57=keyword
method m() { var a = thread work(1)  var b = thread  var c = virtual obj.run() }
    thread@21=keyword  thread@45=name  virtual@61=keyword
method m() { a.define a.class a.sync a.await a.this }
    define@15=name  class@24=name  sync@32=name  await@39=name  this@47=name
method m() { this.x = this }
    this@13=keyword  this@22=keyword
import @file import base/maybe @Deprecated @Async{ } method m() { }
    file@8=name  Deprecated@32=decorator  Async@44=decorator
