package csv

// Comma separated values with quoting ("" inside quoted fields).

method parse(string text): array<object> {
    return parseWith(text, ",")
}

method parseWith(string text, string separator): array<object> {
    var rows = []
    var row = []
    var field = ""
    var i = 0
    var n = text.length()
    while (i < n) {
        var c = text.charAt(i)
        if (c == "\"") {
            var close = quoteEnd(text, i + 1)
            field = field + text.substring(i + 1, close).replace("\"\"", "\"")
            i = close + 1
            continue
        }
        if (c == separator) {
            row.append(field)
            field = ""
            i = i + 1
            continue
        }
        if (c != "\n" && c != "\r") {
            field = field + c
            i = i + 1
            continue
        }
        if (c == "\r" && i + 1 < n && text.charAt(i + 1) == "\n") {
            i = i + 1
        }
        row.append(field)
        rows.append(row)
        row = []
        field = ""
        i = i + 1
    }
    if (field != "" || row.length() > 0) {
        row.append(field)
        rows.append(row)
    }
    return rows
}

// The index of the quote that closes a quoted field whose content starts at `from` ("" is an
// escaped quote); the end of the text when it is never closed.
method quoteEnd(string text, integer from): integer {
    var i = from
    while (i < text.length()) {
        if (text.charAt(i) == "\"" && i + 1 < text.length() && text.charAt(i + 1) == "\"") {
            i = i + 2
            continue
        }
        if (text.charAt(i) == "\"") {
            return i
        }
        i = i + 1
    }
    return text.length()
}

method stringify(array<object> rows): string {
    return stringifyWith(rows, ",")
}

method stringifyWith(array<object> rows, string separator): string {
    var lines = []
    for (row in rows) {
        var fields = []
        for (value in row) {
            fields.append(quote("" + value, separator))
        }
        lines.append(fields.join(separator))
    }
    return lines.join("\n")
}

method quote(string value, string separator): string {
    if (value.contains(separator) || value.contains("\"") || value.contains("\n")) {
        return "\"" + value.replace("\"", "\"\"") + "\""
    }
    return value
}
