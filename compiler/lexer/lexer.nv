package lexer

// The Novus lexer: source text -> tokens.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method lex(string source, string file): array<string> {
    var tokens = []
    var i = 0
    var n = source.length()
    var line = 1
    while (i < n) {
        var c = source.charAt(i)
        var pos = file + ":" + line
        if (c == NEWLINE) {
            line = line + 1
            i = i + 1
            continue
        }
        if (c <= " ") {
            i = i + 1
            continue
        }
        if (isAlpha(c)) {
            var block = lexCBlock(source, i, pos, tokens)
            if (block > i) {
                line = line + countNewlines(source, i, block)
                i = block
                continue
            }
            i = lexWord(source, i, pos, tokens)
            continue
        }
        if (isDigit(c)) {
            i = lexNumber(source, i, pos, tokens)
            continue
        }
        var start = i
        i = lexQuotedOrComment(source, i, pos, tokens)
        line = line + countNewlines(source, start, i)
        if (i == start) {
            i = lexSymbol(source, i, pos, tokens)
        }
    }
    tokens.append("EOF " + file + ":" + line + " ")
    return tokens
}

// The index after a string literal or a comment that starts at `i`, `i` itself when none does.
method lexQuotedOrComment(string source, integer i, string pos, array<string> tokens): integer {
    if (source.charAt(i) == QUOTE) {
        return lexString(source, i, pos, tokens)
    }
    var two = twoChars(source, i)
    if (two == "//") {
        return skipLineComment(source, i)
    }
    if (two == "/*") {
        return skipBlockComment(source, i)
    }
    return i
}

method twoChars(string source, integer i): string {
    if (i + 1 < source.length()) {
        return source.charAt(i) + source.charAt(i + 1)
    }
    return ""
}

method countNewlines(string source, integer from, integer to): integer {
    var count = 0
    var i = from
    // an unterminated string or comment ends beyond the text
    var end = to
    if (end > source.length()) {
        end = source.length()
    }
    while (i < end) {
        if (source.charAt(i) == NEWLINE) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

method lexWord(string source, integer from, string pos, array<string> tokens): integer {
    var n = source.length()
    var i = from
    var word = ""
    while (i < n && isAlphaNum(source.charAt(i))) {
        word = word + source.charAt(i)
        i = i + 1
    }
    var kind = "IDENT"
    if (isKeywordWord(word)) {
        kind = "KEYWORD"
    }
    tokens.append(kind + " " + pos + " " + word)
    return i
}

// Numbers: decimal, float (`1.5`, a dot needs a digit after it) and hexadecimal.
method lexNumber(string source, integer from, string pos, array<string> tokens): integer {
    if (isHexPrefix(source, from)) {
        return lexHex(source, from, pos, tokens)
    }
    var n = source.length()
    var i = from
    var num = ""
    var kind = "INT"
    while (i < n && isDigit(source.charAt(i))) {
        num = num + source.charAt(i)
        i = i + 1
    }
    if (i + 1 < n && source.charAt(i) == "." && isDigit(source.charAt(i + 1))) {
        kind = "FLOAT"
        num = num + "."
        i = i + 1
        while (i < n && isDigit(source.charAt(i))) {
            num = num + source.charAt(i)
            i = i + 1
        }
    }
    tokens.append(kind + " " + pos + " " + num)
    return i
}

method isHexPrefix(string source, integer at): bool {
    if (source.charAt(at) != "0" || at + 2 >= source.length()) {
        return false
    }
    var marker = source.charAt(at + 1)
    return (marker == "x" || marker == "X") && isHexDigit(source.charAt(at + 2))
}

// 0x1f: converted right here, so everything downstream only ever sees a
// decimal integer literal.
method lexHex(string source, integer from, string pos, array<string> tokens): integer {
    var n = source.length()
    var i = from + 2
    var value = 0
    while (i < n && isHexDigit(source.charAt(i))) {
        value = value * 16 + hexValue(source.charAt(i))
        i = i + 1
    }
    tokens.append("INT " + pos + " " + value)
    return i
}

method lexString(string source, integer from, string pos, array<string> tokens): integer {
    var n = source.length()
    var i = from + 1
    var text = ""
    while (i < n && source.charAt(i) != QUOTE) {
        var c = source.charAt(i)
        if (c == BACKSLASH && i + 1 < n) {
            text = text + lexEscape(source.charAt(i + 1))
            i = i + 2
            continue
        }
        text = text + c
        i = i + 1
    }
    tokens.append("STRING " + pos + " " + text)
    return i + 1
}

method skipLineComment(string source, integer from): integer {
    var i = from
    while (i < source.length() && source.charAt(i) != NEWLINE) {
        i = i + 1
    }
    return i
}

method skipBlockComment(string source, integer from): integer {
    var n = source.length()
    var i = from + 2
    while (i + 1 < n && (source.charAt(i) != "*" || source.charAt(i + 1) != "/")) {
        i = i + 1
    }
    return i + 2
}

// A two character operator, else a single symbol character; anything else is skipped.
method lexSymbol(string source, integer i, string pos, array<string> tokens): integer {
    var two = twoChars(source, i)
    if (isTwoCharOp(two)) {
        tokens.append("SYM " + pos + " " + canonicalOperator(two))
        return i + 2
    }
    var c = source.charAt(i)
    if (isSymbolChar(c)) {
        tokens.append("SYM " + pos + " " + c)
    }
    return i + 1
}

// The compiler reads `=>` as `>=` and `=<` as `<=`.
method canonicalOperator(string op): string {
    if (op == "=>") {
        return ">="
    }
    if (op == "=<") {
        return "<="
    }
    return op
}
