package data

import json
import os

// The numbers of the landing page, read from snapshot/stats.json (written by tools/sync.sh).

private final STATS_FILE = "snapshot/stats.json"
private final FALLBACK_VERSION = "0.1.0"

private var loadedStats = {}

method stats(): map<string, object> {
    if (loadedStats.has("version")) {
        return loadedStats
    }
    loadedStats = { "version": FALLBACK_VERSION, "compilerLines": 0, "snapshotLines": 0 }
    if (os.isFile(STATS_FILE)) {
        loadedStats = json.parse(os.readFile(STATS_FILE))
    }
    return loadedStats
}

method compilerVersion(): string {
    return stats()["version"]
}

method compilerLines(): integer {
    return stats()["compilerLines"]
}

method snapshotLines(): integer {
    return stats()["snapshotLines"]
}

// 12345 -> "12,345"
method thousands(integer value): string {
    var digits = "" + value
    var out = ""
    var index = 0
    while (index < digits.length()) {
        if (index > 0 && (digits.length() - index) % 3 == 0) {
            out = out + ","
        }
        out = out + digits.charAt(index)
        index = index + 1
    }
    return out
}

method compilerKiloLines(): string {
    var tenths = compilerLines() / 100
    return "" + (tenths / 10) + "." + (tenths % 10) + "k"
}
