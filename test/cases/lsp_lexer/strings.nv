package main

import "novus/lsp/base/text"
import "novus/lsp/syntax/lexing"

method firstString(string template): Token {
    return lexText(dollar(template)).tokens[0]
}

method checkEscapes() {
    expectEqual("strings/plain", "S:\"hello\"=hello", lex("\"hello\""))
    expectEqual("strings/escapes-decode", "S:\"a\\nb\\tc\\\\d\\\"e\\q\"=a\\nb\\tc\\d\"eq", lex("\"a\\nb\\tc\\\\d\\\"e\\q\""))
    var control = firstString("\"x\\0y\\ry\"").value
    expectEqual("strings/nul-and-return-decode-to-control-bytes", "5 0 13", control.length() + " " + ord(control.charAt(1)) + " " + ord(control.charAt(3)))
    expectEqual("strings/unicode-escape-is-literal", "S:\"\\u0041\"=u0041", lex("\"\\u0041\""))
    expectEqual("strings/comment-markers-inside", "S:\"http://x /* y */\"=http://x /* y */ K:var", lex("\"http://x /* y */\" var"))
    expectTrue("strings/terminated", firstString("\"a\"").terminated)
    expectEqual("strings/empty", "S:\"\"=", lex("\"\""))
}

method checkMultiLine() {
    var lexed = lexText("var s = \"one\ntwo\"\nvar t = 1")
    expectEqual("strings/raw-newline-is-legal", "K:var I:s P:= S:\"one\\ntwo\"=one\\ntwo K:var I:t P:= N:1", renderTokens(lexed))
    expectEqual("strings/line-and-column-of-the-opening-quote", "0:8", renderPosition(lexed.tokens[3]))
    expectEqual("strings/next-line-counts-the-newline-inside", "2:0*", renderPosition(lexed.tokens[4]))
    var shared = lexText("\"a\nb\" x")
    expectEqual("strings/token-after-the-closing-quote", "1:3", renderPosition(shared.tokens[1]))
    var continued = lexText("\"a\\\nb\" c")
    expectEqual("strings/backslash-newline-keeps-the-newline", "a\\nb", visible(continued.tokens[0].value))
    expectEqual("strings/backslash-newline-line-counting", "1:3", renderPosition(continued.tokens[1]))
}

method checkInterpolation() {
    expectEqual("interp/one", "[5,6)", spansOf("\"x @{a} y\""))
    expectEqual("interp/two", "[3,4) [12,17)", spansOf("\"@{a} and @{b + 1}\""))
    expectEqual("interp/empty-expression", "[3,3)", spansOf("\"@{}\""))
    expectEqual("interp/escape-before-it", "[5,6)", spansOf("\"\\n@{a}\""))
    expectEqual("interp/escaped-dollar-still-interpolates", "[4,7)", spansOf("\"\\$" + "{1+2}\""))
    expectEqual("interp/escaped-brace-still-opens", "[4,5)", spansOf("\"$\\{a}\""))
    expectEqual("interp/map-literal-balances-braces", "[3,24)", spansOf("\"@{ {\\\"a\\\": 1}.length() }\""))
    expectEqual("interp/unmatched-is-literal", "", spansOf("\"ok @{\""))
    expectEqual("interp/unmatched-first-matched-second", "[6,7)", spansOf("\"@{ @{a} \""))
    expectEqual("interp/plain-dollar-and-braces", "", spansOf("\"cost $5 {x}\""))
    expectEqual("interp/raw-offsets-after-an-escaped-quote", "[8,9)", spansOf("\"\\\"q\\\"@{x}\""))
    var token = firstString("\"a @{x} b\"")
    expectEqual("interp/scanner-recomputes-from-the-token", "[5,6)", renderSpans(StringScanner(dollar("\"a @{x} b\"")).interpolationSpans(token)))
}

method spansOf(string template): string {
    return renderSpans(firstString(template).interpolations)
}
