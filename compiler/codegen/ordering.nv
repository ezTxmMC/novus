package codegen

import ast
import parser

// Evaluation order: the operands of an expression are evaluated left to
// right.
//
// C does not promise that for the arguments of a call or the operands of an
// operator - gcc picks right to left, clang left to right - so an operand
// list in which an operand can have an effect is split up: every operand
// that has to keep its place is evaluated into a temporary by a comma
// expression, in order, and the operation then reads the temporaries.
//
//     a() + b()     ->     (nvt0 = a(), nv_add_fast(nvt0, b()))
//
// Operands that can neither have an effect nor see one stay where they are:
// literals, locals, `this` and arithmetic on them. The loops over unboxed
// integers the compiler generates therefore get no temporaries at all.
//
// operands.nv says what the operands of a node are, temps.nv owns the
// temporaries.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

private final CONDITION_OPERATORS = {"==": true, "!=": true, "<": true, ">": true, "<=": true, ">=": true}

// How an operand relates to the evaluation order. A stable operand cannot
// fail, has no effect and cannot be changed by one; an operand that reads
// takes part in no effect itself but may read what another operand changes
// (a global, a field, an element); an operand with effects calls code.
final OPERAND_STABLE = 0
final OPERAND_READS = 1
final OPERAND_EFFECTS = 2

// Does the text of the node hold a call, a method call, an await or a spawn?
// A literal that only contains the text "(call " says yes as well, which
// merely costs a temporary.
method mentionsCall(string node): bool {
    return node.contains("(call ") || node.contains("(mcall ") || node.contains("(await ") || node.contains("(spawn ")
}

// `module.name` without parentheses is a call of the parameterless function of
// that module unless the module has a global of that name - the cases
// genExpr tells apart for a member of something that is not a value.
method isModuleFunction(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): bool {
    var target = nodeChild(node, 1)
    if (isValueTarget(target, prog, ctx, locals) || prog.has("enum:" + target) || prog.has("pkg:" + target) == false) {
        return false
    }
    return prog.has("global:" + target + "." + nodeChild(node, 2)) == false
}

// Does the node contain a module member that is a call?
method callsModuleFunction(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): bool {
    if (isList(node) == false || nodeHead(node) == "str" || nodeHead(node) == "craw") {
        return false
    }
    if (nodeHead(node) == "mget" && nodeCount(node) == 3 && isModuleFunction(node, prog, ctx, locals)) {
        return true
    }
    for (child in childrenFrom(node, 1)) {
        if (callsModuleFunction(child, prog, ctx, locals)) {
            return true
        }
    }
    return false
}

// Does the node contain code that runs?
method hasEffects(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): bool {
    if (mentionsCall(node)) {
        return true
    }
    return node.contains("(mget ") && callsModuleFunction(node, prog, ctx, locals)
}

// Division, remainder and shifts stop the program on a bad operand.
method canTrap(string node): bool {
    return node.contains("(/ ") || node.contains("(% ") || node.contains("(<< ") || node.contains("(>> ")
}

method atomClass(string node, map<string, string> locals): integer {
    if (node == "true" || node == "false" || node == "this" || isNumberAtom(node) || locals.has(node)) {
        return OPERAND_STABLE
    }
    return OPERAND_READS
}

// Is the node free of code that runs, or made of typed reads (see
// typedReads)? Such an operand reads but has no effect.
method readsOnly(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): bool {
    return hasEffects(node, prog, ctx, locals) == false || typedReads(node, prog, ctx, locals)
}

// Is the node made of reads that the code generator types: a numeric field
// of `this`, a numeric native of the math module, arithmetic on those? They
// call no code of the program. The field of another object is not among
// them: the class the compiler guessed for it is only a guess, and an object
// of another class is asked the ordinary way, which runs the method of that
// class.
method typedReads(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): bool {
    if (isTypedContext(ctx) == false || isList(node) == false) {
        return false
    }
    var head = nodeHead(node)
    if (head == "neg") {
        return readsOnly(nodeChild(node, 1), prog, ctx, locals)
    }
    if (head == "mcall" && nodeCount(node) == 3) {
        return nodeChild(node, 1) == "this" && fieldReadKind(node, prog, ctx, locals) != KIND_NONE
    }
    if (head == "mcall" && isModuleTarget(nodeChild(node, 1), prog, ctx, locals) && isMathNative(nativeOf(node, prog))) {
        return childrenReadOnly(node, 3, prog, ctx, locals)
    }
    if (head == "idx" || (isBinaryOperator(head) && nodeCount(node) == 3)) {
        return childrenReadOnly(node, 1, prog, ctx, locals)
    }
    return false
}

method childrenReadOnly(string node, integer from, map<string, string> prog, map<string, string> ctx, map<string, string> locals): bool {
    var i = from
    var count = nodeCount(node)
    while (i < count) {
        if (readsOnly(nodeChild(node, i), prog, ctx, locals) == false) {
            return false
        }
        i = i + 1
    }
    return true
}

method operandClass(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): integer {
    if (isList(node) == false) {
        return atomClass(node, locals)
    }
    var head = nodeHead(node)
    if (head == "str" || head == "craw" || head == "rawd" || head == "rawi") {
        return OPERAND_STABLE
    }
    if (hasEffects(node, prog, ctx, locals)) {
        if (typedReads(node, prog, ctx, locals)) {
            return OPERAND_READS
        }
        return OPERAND_EFFECTS
    }
    var numeric = isNumericKind(kindOf(node, prog, ctx, locals)) && isLocalArithmetic(node, locals)
    if (numeric && canTrap(node) == false) {
        return OPERAND_STABLE
    }
    return OPERAND_READS
}

// Is the node built from number literals and unboxed locals alone? Nothing
// else an operand computes with is out of the reach of an effect.
method isLocalArithmetic(string node, map<string, string> locals): bool {
    if (isList(node) == false) {
        return isNumberAtom(node) || isIntLocal(locals, node) || isFloatLocal(locals, node)
    }
    var head = nodeHead(node)
    if (head == "neg") {
        return isLocalArithmetic(nodeChild(node, 1), locals)
    }
    if (isBinaryOperator(head) && nodeCount(node) == 3) {
        return isLocalArithmetic(nodeChild(node, 1), locals) && isLocalArithmetic(nodeChild(node, 2), locals)
    }
    return head == "rawd" || head == "rawi"
}

method countKind(array<integer> kinds, integer kind): integer {
    var count = 0
    for (candidate in kinds) {
        if (candidate == kind) {
            count = count + 1
        }
    }
    return count
}

// The index of the last operand that is not stable, -1 when there is none.
method lastUnstable(array<integer> kinds): integer {
    var i = kinds.length() - 1
    while (i >= 0) {
        if (kinds[i] != OPERAND_STABLE) {
            return i
        }
        i = i - 1
    }
    return -1
}

// Which operands are evaluated into temporaries, as indexes in evaluation
// order. An order only has to be enforced when an operand has effects and
// another operand is not stable; then every operand that is not stable,
// except the last of them, is evaluated first. None when the order is free.
method operandsToHoist(array<integer> kinds): array<integer> {
    var unstable = kinds.length() - countKind(kinds, OPERAND_STABLE)
    if (countKind(kinds, OPERAND_EFFECTS) == 0 || unstable < 2) {
        return []
    }
    var last = lastUnstable(kinds)
    var hoisted = []
    var i = 0
    while (i < kinds.length()) {
        if (kinds[i] != OPERAND_STABLE && i != last) {
            hoisted.append(i)
        }
        i = i + 1
    }
    return hoisted
}

// Does the node compute with its operands as unboxed numbers? Then a numeric
// operand may be held in a temporary that is unboxed too; anything else takes
// its operands as values (genCondition and genExpr decide the same way).
method computesWithNumbers(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): bool {
    var head = nodeHead(node)
    if (isBinaryOperator(head) == false || nodeCount(node) != 3) {
        return false
    }
    var left = nodeChild(node, 1)
    var right = nodeChild(node, 2)
    if (head == "==" || head == "!=") {
        return isNumericKind(kindOf(left, prog, ctx, locals)) && isNumericKind(kindOf(right, prog, ctx, locals)) && isBareRead(left, prog, ctx, locals) == false && isBareRead(right, prog, ctx, locals) == false
    }
    if (CONDITION_OPERATORS.has(head)) {
        return isNumericKind(kindOf(left, prog, ctx, locals)) && isNumericKind(kindOf(right, prog, ctx, locals))
    }
    return isNumericKind(kindOf(node, prog, ctx, locals))
}

// The node rewritten to read temporaries, followed by the assignments that
// evaluate them in order - or an empty array when the node's operands need no
// ordering.
method sequenceOperands(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): array<string> {
    if (hasEffects(node, prog, ctx, locals) == false) {
        return []
    }
    var paths = operandPaths(node, prog, ctx, locals)
    if (paths.length() < 2) {
        return []
    }
    var operands = []
    var kinds = []
    for (path in paths) {
        var operand = nodeAt(node, path)
        operands.append(operand)
        kinds.append(operandClass(operand, prog, ctx, locals))
    }
    var hoisted = operandsToHoist(kinds)
    if (hoisted.length() == 0) {
        return []
    }
    var rewritten = node
    var assignments = []
    var numeric = isTypedContext(ctx) && computesWithNumbers(node, prog, ctx, locals)
    for (index in hoisted) {
        var kind = KIND_NONE
        if (isTypedContext(ctx) && (numeric || isBareRead(operands[index], prog, ctx, locals) == false)) {
            kind = kindOf(operands[index], prog, ctx, locals)
        }
        if (isNumericKind(kind)) {
            // an unboxed operand keeps its representation in the temporary
            var typedTemp = newTypedTemp(ctx, kind)
            assignments.append(typedTemp + " = " + genTyped(operands[index], kind, prog, ctx, locals))
            rewritten = replaceAt(rewritten, paths[index], 0, "(" + rawHead(kind) + " " + typedTemp + ")")
            continue
        }
        var temp = newTemp(ctx)
        assignments.append(temp + " = " + genExpr(operands[index], prog, ctx, locals))
        rewritten = replaceAt(rewritten, paths[index], 0, "(craw " + sexpStr(temp) + ")")
    }
    var sequence = [rewritten]
    for (assignment in assignments) {
        sequence.append(assignment)
    }
    return sequence
}

// The C expression that performs the assignments of a sequenceOperands()
// result and then yields `code`, the expression generated from its node.
method sequencedExpr(array<string> sequence, string code): string {
    var steps = []
    var i = 1
    while (i < sequence.length()) {
        steps.append(sequence[i])
        i = i + 1
    }
    steps.append(code)
    return "(" + steps.join(", ") + ")"
}

// The same as statements, for a node that is itself a statement.
method sequencedStatements(array<string> sequence, string indent): string {
    var out = ""
    var i = 1
    while (i < sequence.length()) {
        out = out + indent + sequence[i] + ";" + nl()
        i = i + 1
    }
    return out
}
