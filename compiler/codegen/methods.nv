package codegen

import ast
import parser

// Free methods -> C: parameters, locals and the body.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method deprecationCode(string m, string indent, string flagName): string {
    var annos = nodeChild(m, 4)
    var i = 1
    var annosCount = nodeCount(annos)
    while (i < annosCount) {
        var anno = nodeChild(annos, i)
        if (nodeChild(anno, 1) == "Deprecated") {
            var text = cstr("")
            var since = cstr("")
            var k = 2
            var annoCount = nodeCount(anno)
            while (k < annoCount) {
                var arg = nodeChild(anno, k)
                if (nodeChild(arg, 1) == "text") {
                    text = nodeChild(arg, 2)
                }
                if (nodeChild(arg, 1) == "since") {
                    since = nodeChild(arg, 2)
                }
                k = k + 1
            }
            return indent + "nv_warn_deprecated(&" + flagName + ", " + cstr(methodName(m)) + ", " + since + ", " + text + ");" + nl()
        }
        i = i + 1
    }
    return ""
}

// Parameter bindings from an argument array (class methods and ctors).
method bindArrayParams(string m, string indent, map<string, string> locals): string {
    var params = paramsNode(m)
    var out = ""
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        var p = nodeChild(params, i)
        var ptype = nodeChild(p, 1)
        var pname = nodeChild(p, 2)
        var src = "(n > " + (i - 1) + " ? args[" + (i - 1) + "] : nv_nil)"
        out = out + indent + "nv l_" + pname + " = " + coerceCode(src, ptype) + ";" + nl()
        locals[pname] = "l_" + pname
        i = i + 1
    }
    return out
}

method cParamList(string m): string {
    var params = paramsNode(m)
    var out = ""
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        if (i > 1) {
            out = out + ", "
        }
        out = out + "nv a" + (i - 1)
        i = i + 1
    }
    if (out == "") {
        return "void"
    }
    return out
}

method funcCName(string name, integer arity, integer variant, integer variants): string {
    var base = "f_" + cName(name) + "_" + arity
    if (variants > 1) {
        return base + "_v" + variant
    }
    return base
}

method argNames(integer arity): string {
    var out = ""
    var i = 0
    while (i < arity) {
        if (i > 0) {
            out = out + ", "
        }
        out = out + "a" + i
        i = i + 1
    }
    return out
}

// An async method is the method it was written as, plus two lines: the body
// moves aside under its own name and what callers reach starts it on a
// virtual thread. Nothing at the call sites changes - `f(x)` hands back a
// task there, and `await` is what turns it into the value.
method genFreeMethod(string m, string cname, map<string, string> prog): string {
    if (isAsyncMethod(m) == false) {
        return genFreeMethodBody(m, cname, prog)
    }
    var inner = cname + "_body"
    var arity = arityOf(m)
    var out = genFreeMethodBody(m, inner, prog)
    out = out + "static nv nv_async_" + cname + "(nv *a, int n) {" + nl()
    out = out + "    (void)a;" + nl() + "    (void)n;" + nl()
    out = out + "    return " + inner + "(" + argSlots(arity) + ");" + nl() + "}" + nl()
    out = out + "static nv " + cname + "(" + cParamList(m) + ") {" + nl()
    out = out + "    return nv_spawn(1, nv_async_" + cname + ", " + arity
    if (arity > 0) {
        out = out + ", " + argNames(arity)
    }
    return out + ");" + nl() + "}" + nl()
}

// The context a free method is generated in.
method freeMethodContext(string m): map<string, string> {
    var name = methodName(m)
    return {"class": "", "pkg": packageOf(name), "func": name, "ret": methodRet(m), "pos": "method " + name}
}

// The locals of a free method: its parameters, bound to the C names they are
// given, and the marks of the inference. `returnKinds` collects the kinds of
// what the body returns.
method freeMethodLocals(string m, map<string, string> prog, map<string, string> ctx, array<string> returnKinds): map<string, string> {
    var locals = {}
    var params = paramsNode(m)
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        var pname = nodeChild(nodeChild(params, i), 2)
        locals[pname] = "l_" + pname
        i = i + 1
    }
    markLocalKinds(nodeChild(m, 5), params, true, prog, ctx, locals, returnKinds)
    return locals
}

// The line that turns the boxed argument `index` of a method into its local:
// a number for a parameter the inference unboxed, the coerced value otherwise.
method paramPrologue(string param, integer index, map<string, string> locals): string {
    var pname = nodeChild(param, 2)
    var arg = "a" + index
    if (isIntLocal(locals, pname)) {
        return "    long long l_" + pname + " = nv_as_int(" + arg + ");" + nl()
    }
    if (isFloatLocal(locals, pname)) {
        return "    double l_" + pname + " = nv_as_double(" + arg + ");" + nl()
    }
    return "    nv l_" + pname + " = " + coerceCode(arg, nodeChild(param, 1)) + ";" + nl()
}

method genFreeMethodBody(string m, string cname, map<string, string> prog): string {
    var ctx = freeMethodContext(m)
    var locals = freeMethodLocals(m, prog, ctx, [])
    var descriptor = rawDescriptor(prog, methodName(m), arityOf(m))
    if (descriptor != "") {
        return genWorkerMethod(m, cname, descriptor, prog, ctx, locals)
    }
    var params = paramsNode(m)
    var out = "static nv " + cname + "(" + cParamList(m) + ") {" + nl()
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        out = out + paramPrologue(nodeChild(params, i), i - 1, locals)
        i = i + 1
    }
    var dep = deprecationCode(m, "    ", "dep_" + cname)
    if (dep != "") {
        out = "static int dep_" + cname + " = 0;" + nl() + out + dep
    }
    var body = genBlock(nodeChild(m, 5), "    ", prog, ctx, locals)
    out = out + tempDecls(ctx, "    ") + body
    return out + "    return " + defaultCode(methodRet(m)) + ";" + nl() + "}" + nl()
}
