package scanning

import base/text
import syntax/lexing

private final SCANNING_COMPOUND_OPERATORS = "+-*/%&|^"

// A problem the scanners found in a body; `parsing` turns it into a SyntaxIssue.
define class ScanningProblem {
    Span span
    string code
    string message
    bool warning

    construct(Span span, string code, string message, bool warning) {
        this.span = span
        this.code = code
        this.message = message
        this.warning = warning
    }
}

// `+=`, `-=`, `++`, `--` and friends: the lexer cuts them into two tokens, the compiler then rejects the second one.
method scanningCompoundProblems(array<Token> tokens, integer from, integer to, array<ScanningProblem> problems) {
    var index = from
    while (index + 1 < to) {
        var first = tokens[index]
        var second = tokens[index + 1]
        if (scanningIsCompound(first, second) || scanningIsStep(tokens, index, to)) {
            problems.append(scanningCompoundProblem(first, second))
        }
        index = index + 1
    }
}

method scanningIsCompound(Token first, Token second): bool {
    if (first.kind != TokenKind.Punct || second.isPunct("=") == false || first.end != second.start) {
        return false
    }
    return first.text.length() == 1 && SCANNING_COMPOUND_OPERATORS.indexOf(first.text) >= 0
}

// `++`, and `--` when no operand follows on the same line (`a - -b` is a valid subtraction of a negation).
method scanningIsStep(array<Token> tokens, integer index, integer to): bool {
    var first = tokens[index]
    var second = tokens[index + 1]
    if (first.end != second.start || first.text != second.text) {
        return false
    }
    if (first.isPunct("+")) {
        return true
    }
    return first.isPunct("-") && scanningStartsOperand(tokens, index + 2, to, second.line) == false
}

method scanningStartsOperand(array<Token> tokens, integer index, integer to, integer line): bool {
    if (index >= to || tokens[index].line != line) {
        return false
    }
    var token = tokens[index]
    if (token.kind == TokenKind.Ident || token.kind == TokenKind.Integer || token.kind == TokenKind.Float || token.kind == TokenKind.String) {
        return true
    }
    if (token.kind == TokenKind.Keyword) {
        return token.text == "true" || token.text == "false"
    }
    return token.isPunct("(") || token.isPunct("[") || token.isPunct("{") || token.isPunct("-") || token.isPunct("!")
}

method scanningCompoundProblem(Token first, Token second): ScanningProblem {
    var operatorText = first.text + second.text
    var message = "'" + operatorText + "' does not exist: write 'x = x + 1'"
    return ScanningProblem(Span(first.start, second.end), "compound-assignment", message, false)
}

// Index of the loop variable token of `for ( ... )`, -1 after reporting a header the compiler rejects.
method scanningReadForHeader(ScanningWalker walker, integer first, integer close): integer {
    if (walker.cursor.isKeyword(first, "var") || scanningHasSemicolon(walker, first, close)) {
        walker.report(walker.cursor.spanAt(first), "c-style-for", "C-style 'for (var i = ...; ...)' does not exist: use 'for (item in items)' or a 'while' loop")
        return -1
    }
    if (walker.cursor.isKind(first, TokenKind.Keyword)) {
        walker.report(walker.cursor.spanAt(first), "keyword-as-name", "expected loop variable name but found keyword " + walker.cursor.describeAt(first))
        return -1
    }
    if (walker.cursor.isIdent(first) == false) {
        walker.report(walker.cursor.spanAt(first), "expected-token", "expected loop variable name but found " + walker.cursor.describeAt(first))
        return -1
    }
    if (walker.cursor.isKeyword(first + 1, "in") == false) {
        walker.report(walker.cursor.spanAt(first + 1), "expected-token", "expected 'in' in for loop but found " + walker.cursor.describeAt(first + 1))
    }
    return first
}

method scanningHasSemicolon(ScanningWalker walker, integer first, integer close): bool {
    var index = first
    while (index < close) {
        if (walker.cursor.isPunct(index, ";")) {
            return true
        }
        index = index + 1
    }
    return false
}

// Is the token at `index` the first dot of a cascade `..`? The lexer keeps the two dots apart, so they must touch.
method scanningIsCascadeAt(array<Token> tokens, integer index): bool {
    if (index < 0 || index + 1 >= tokens.length()) {
        return false
    }
    return tokens[index].isPunct(".") && tokens[index + 1].isPunct(".") && tokens[index].end == tokens[index + 1].start
}

// The first `..` outside brackets between `first` and `last`, -1 when there is none: a cascade has the type of its receiver.
method scanningCascadeIndex(array<Token> tokens, integer first, integer last): integer {
    var depth = 0
    var i = first
    while (i < last) {
        if (tokens[i].kind == TokenKind.Punct && scanningIsOpener(tokens[i].value)) {
            depth = depth + 1
        }
        if (tokens[i].kind == TokenKind.Punct && scanningIsCloser(tokens[i].value)) {
            depth = depth - 1
        }
        if (depth == 0 && scanningIsCascadeAt(tokens, i)) {
            return i
        }
        i = i + 1
    }
    return -1
}

private final SCANNING_NAME_OFFSET = 2

// The member tokens of the sections of the cascade `receiver..m()..n = 1` whose receiver name is at `index`: one index per
// section, stopping at a section that continues (`..m().x`, `..m()[0]`) or assigns, because what follows is not the receiver's.
method scanningCascadeMembers(array<Token> tokens, integer index): array<integer> {
    var found = []
    var dot = index + 1
    while (scanningIsCascadeAt(tokens, dot) && dot + SCANNING_NAME_OFFSET < tokens.length() && tokens[dot + SCANNING_NAME_OFFSET].kind == TokenKind.Ident) {
        found.append(dot + SCANNING_NAME_OFFSET)
        dot = scanningSectionEnd(tokens, dot + SCANNING_NAME_OFFSET)
    }
    return found
}

// The index after the section whose member is at `member`; -1 when no further section of the cascade can follow.
method scanningSectionEnd(array<Token> tokens, integer member): integer {
    var next = member + 1
    if (next < tokens.length() && tokens[next].isPunct("(")) {
        next = scanningCloseOf(tokens, next) + 1
    }
    if (next >= tokens.length() || tokens[next].isPunct("=") || tokens[next].isPunct("[")) {
        return -1
    }
    if (tokens[next].isPunct(".") && scanningIsCascadeAt(tokens, next) == false) {
        return -1
    }
    return next
}

// The index of the bracket that closes the one at `open`; the last token when it never closes.
method scanningCloseOf(array<Token> tokens, integer open): integer {
    var depth = 0
    var index = open
    while (index < tokens.length()) {
        if (tokens[index].kind == TokenKind.Punct && scanningIsOpener(tokens[index].value)) {
            depth = depth + 1
        }
        if (tokens[index].kind == TokenKind.Punct && scanningIsCloser(tokens[index].value)) {
            depth = depth - 1
        }
        if (depth == 0) {
            return index
        }
        index = index + 1
    }
    return tokens.length() - 1
}
