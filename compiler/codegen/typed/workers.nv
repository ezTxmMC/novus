package typed

import ast
import parser

// Unboxed workers.
//
// A method with numbers in its signature gets a second C function that takes
// its integer and float parameters as `long long` and `double` and returns a
// number the same way, when everything it returns is a number of known kind
// (kinds.nv). The calls the code generator types go to the worker directly;
// every other call reaches the function under the method's own name, which
// converts boxed arguments exactly as the method's body always did, calls the
// worker and boxes the result.
//
// A worker is described by a string `r:ppp`: `r` is `i`, `d` or `n` for a
// result that is an integer, a float or boxed, and each `p` says the same for
// a parameter. The descriptors are kept in the program index as `raw:name/arity`.
//
// What a method's body can say about its return kinds depends on the workers
// of the methods it calls, so the descriptors are found together: every
// candidate starts out with the kinds it declares, and the bodies are
// analysed again with what the previous round left until nothing changes. A
// round can only take kinds away, so the loop ends.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

final KIND_BOXED = "n"
final MAX_WORKER_ROUNDS = 24

// Can the method have a worker: a plain method of its own, with numbers in its signature?
method isWorkerCandidate(string m, map<string, string> prog): bool {
    if (isNativeMethod(m) || isAbstractMethod(m) || isAsyncMethod(m) || hasCBlock(m)) {
        return false
    }
    if (prog["func:" + methodName(m) + "/" + arityOf(m)] != "1") {
        return false
    }
    return hasNumericSignature(m)
}

method hasNumericSignature(string m): bool {
    if (isNumericKind(kindOfType(methodRet(m)))) {
        return true
    }
    var params = paramsNode(m)
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        if (isNumericKind(kindOfType(nodeChild(nodeChild(params, i), 1)))) {
            return true
        }
        i = i + 1
    }
    return false
}

method boxedOr(string kind): string {
    if (kind == KIND_NONE) {
        return KIND_BOXED
    }
    return kind
}

// The descriptor a method declares: the kinds of its signature.
method declaredDescriptor(string m): string {
    var out = boxedOr(kindOfType(methodRet(m))) + ":"
    var params = paramsNode(m)
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        out = out + boxedOr(kindOfType(nodeChild(nodeChild(params, i), 1)))
        i = i + 1
    }
    return out
}

// The descriptor the analysis of the method's body allows, given the
// workers the program has so far.
method analysedDescriptor(string m, map<string, string> prog): string {
    var ctx = freeMethodContext(m)
    var returnKinds = []
    var locals = freeMethodLocals(m, prog, ctx, returnKinds)
    var result = kindOfType(methodRet(m))
    for (kind in returnKinds) {
        if (kind == KIND_NONE) {
            result = KIND_NONE
        }
    }
    var out = boxedOr(result) + ":"
    var params = paramsNode(m)
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        var pname = nodeChild(nodeChild(params, i), 2)
        var kind = KIND_NONE
        if (isIntLocal(locals, pname)) {
            kind = KIND_INT
        }
        if (isFloatLocal(locals, pname)) {
            kind = KIND_FLOAT
        }
        out = out + boxedOr(kind)
        i = i + 1
    }
    return out
}

// Does the descriptor pass and return everything boxed?
method isAllBoxed(string descriptor): bool {
    var i = 0
    while (i < descriptor.length()) {
        var c = descriptor.charAt(i)
        if (c == KIND_INT || c == KIND_FLOAT) {
            return false
        }
        i = i + 1
    }
    return true
}

method setDescriptor(map<string, string> prog, string key, string descriptor) {
    if (isAllBoxed(descriptor)) {
        prog.remove(key)
        return
    }
    prog[key] = descriptor
}

// One round: every candidate is analysed again. True when a descriptor changed.
method refineWorkers(array<string> candidates, map<string, string> prog): bool {
    var changed = false
    for (m in candidates) {
        var key = "raw:" + methodName(m) + "/" + arityOf(m)
        var descriptor = analysedDescriptor(m, prog)
        var current = ""
        if (prog.has(key)) {
            current = prog[key]
        }
        if (isAllBoxed(descriptor)) {
            descriptor = ""
        }
        if (descriptor != current) {
            setDescriptor(prog, key, descriptor)
            changed = true
        }
    }
    return changed
}

// Works out which methods get a worker and of which kinds.
method analyseWorkers(array<string> decls, map<string, string> prog) {
    var candidates = []
    for (d in decls) {
        if (nodeHead(d) == "method" && isWorkerCandidate(d, prog)) {
            candidates.append(d)
            setDescriptor(prog, "raw:" + methodName(d) + "/" + arityOf(d), declaredDescriptor(d))
        }
    }
    var rounds = 0
    while (refineWorkers(candidates, prog)) {
        rounds = rounds + 1
        if (rounds >= MAX_WORKER_ROUNDS) {
            dropWorkers(candidates, prog)
            return
        }
    }
}

// No fixpoint within the limit: no method gets a worker.
method dropWorkers(array<string> candidates, map<string, string> prog) {
    for (m in candidates) {
        prog.remove("raw:" + methodName(m) + "/" + arityOf(m))
    }
}
