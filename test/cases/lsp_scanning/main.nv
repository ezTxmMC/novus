package main

import @callsites
import @chains
import @check
import @describe
import @locals

method main(): integer {
    checkChains()
    checkCascadeChains()
    checkArgumentCounts()
    checkChainBoundaries()
    checkChainStart()
    checkChainDepthCap()
    checkCallSites()
    checkNesting()
    checkNoCallSite()
    checkSiteCaps()
    checkMainScopes()
    checkVisibility()
    checkStatementBoundaries()
    checkGenerics()
    checkEdgeCases()
    checkHandBuiltDecl()
    checkTokenDescriptions()
    checkDefineKinds()
    return finishChecks()
}
