== scopes
LIMIT = 10 -> LIMIT: variable +declaration +readonly
counter = 0 -> counter: variable +declaration
first(integer LIMIT) -> LIMIT: parameter +declaration
return LIMIT -> LIMIT: parameter
var value = LIMIT -> LIMIT: variable +readonly
var value = -> value: variable +declaration
    value = value -> value: variable +modification
= value + 1 -> value: variable
    counter = counter + 1 -> counter: variable +modification
= counter + 1 -> counter: variable
third(string value) -> value: parameter +declaration
for (value in -> value: variable +declaration
println(value) -> value: variable
integer typed -> typed: variable +declaration
return value\n}\n\nmethod fourth -> value: parameter
return later -> later: none
