#### the plain text of snippets
println "${1:text}"  ->  println "text"
for (${1:item} in ${2:items}) {\n    $0\n}  ->  for (item in items) {\n    \n}
${1:name} = $1  ->  name = name
${1:a${2:b}c}  ->  abc
${3|get,get\, set,set|}  ->  get
price \$5 ${1:{x}}  ->  price $5 {x}
call($1) and ${9}  ->  call() and 
tail $  ->  tail $
open ${1:never closed  ->  open never closed
bare ${x}  ->  bare ${x}
nested ${1:${2:${3:${4:${5:${6:${7:${8:${9:deep}}}}}}}}}  ->  nested ${9:deep}
list: incomplete=true first snippet=false [while (condition) {\n    \n}] second snippet=false [name]
