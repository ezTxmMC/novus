package main

import os
import publish
import site

// novusc run main.nv                 development server on http://localhost:8080
// novusc run main.nv export [dir]    the static site, default dist/

private final EXPORT_COMMAND = "export"
private final DEFAULT_EXPORT_FOLDER = "dist"
private final FIRST_ARGUMENT = 0

method main {
    var arguments = os.args()
    if (arguments.length() == 0 || arguments[FIRST_ARGUMENT] != EXPORT_COMMAND) {
        serveSite()
        return
    }
    var folder = DEFAULT_EXPORT_FOLDER
    if (arguments.length() > 1) {
        folder = arguments[1]
    }
    if (exportSite(folder) == false) {
        os.exit(1)
    }
    println "exported to " + folder
}
