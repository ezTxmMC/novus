package codegen

import ast
import parser

// Whole-program generation: classes, enums, globals, main.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// Records the C text of a body under `key` (the init order reads what a
// function or class reaches from it, see initorder.nv).
method addSource(map<string, string> sources, string key, string text) {
    if (sources.has(key)) {
        sources[key] = sources[key] + text
        return
    }
    sources[key] = text
}

method genClassCode(string node, map<string, string> prog, array<string> protos, array<string> bodies, array<string> registry, map<string, string> sources): integer {
    var cls = nodeChild(node, 1)
    var isEnum = "0"
    if (nodeHead(node) == "enum") {
        isEnum = "1"
    }
    var base = classBase(node)
    if (isClassLike(prog, base) == false) {
        base = ""
    }
    if (base != "") {
        // an inherited method runs whatever the base class reaches
        addSource(sources, "c:" + cls, cstr(base))
    }
    var abstractFlag = "0"
    if (classIsAbstract(node)) {
        abstractFlag = "1"
    }
    protos.append("static NvClass *nv_cls_" + cls + ";" + nl())
    registry.append("    c = nv_class_define(" + cstr(cls) + ", " + cstr(base) + ", " + abstractFlag + ", " + isEnum + ");" + nl())
    registry.append("    nv_cls_" + cls + " = c;" + nl())
    var fields = classFields(node)
    var i = 1
    var fieldsCount = nodeCount(fields)
    while (i < fieldsCount) {
        var f = nodeChild(fields, i)
        registry.append("    nv_class_field(c, " + cstr(nodeChild(f, 2)) + ", " + cstr(normType(nodeChild(f, 1))) + ");" + nl())
        i = i + 1
    }
    var ctor = classCtor(node)
    if (nodeHead(ctor) == "ctor") {
        protos.append("static nv c_" + cls + "(nv self, nv *args, int n);" + nl())
        var ctorBody = genCtor(cls, ctor, prog)
        bodies.append(ctorBody)
        addSource(sources, "c:" + cls, ctorBody)
        registry.append("    nv_class_ctor(c, " + (nodeCount(nodeChild(ctor, 1)) - 1) + ", c_" + cls + ");" + nl())
    }
    var methods = classMethods(node)
    var k = 1
    var methodsCount = nodeCount(methods)
    while (k < methodsCount) {
        var m = nodeChild(methods, k)
        if (isAbstractMethod(m) == false) {
            var cname = methodCName(cls, m, methodVariant(methods, k))
            protos.append("static nv " + cname + "(nv self, nv *args, int n);" + nl())
            var methodBody = genClassMethod(cls, m, cname, prog)
            bodies.append(methodBody)
            addSource(sources, "c:" + cls, methodBody)
            registry.append("    nv_class_method(c, " + cstr(methodName(m)) + ", " + arityOf(m) + ", " + cname + ");" + nl())
        }
        k = k + 1
    }
    return 0
}

method genEnumInit(string node, map<string, string> prog): string {
    var name = nodeChild(node, 1)
    var consts = nodeChild(node, 2)
    var ctx = {"class": "", "pkg": "", "func": "", "ret": "void", "pos": "enum " + name}
    var locals = {}
    var out = ""
    var i = 1
    var constsCount = nodeCount(consts)
    while (i < constsCount) {
        out = out + genEnumConstant(name, nodeChild(consts, i), prog, ctx, locals)
        i = i + 1
    }
    return withTemps(out, tempNames(ctx))
}

// The statement that creates one enum constant. Its constructor arguments are
// evaluated left to right like the arguments of a call.
method genEnumConstant(string enumName, string constant, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    var nargs = nodeCount(constant) - 2
    var sequence = sequenceOperands(constant, prog, ctx, locals)
    var source = constant
    if (sequence.length() > 0) {
        source = sequence[0]
    }
    var constructor = "nv_construct(" + cstr(enumName) + ", " + nargs
    if (nargs > 0) {
        constructor = constructor + ", " + genArgs(source, 2, prog, ctx, locals)
    }
    constructor = constructor + ")"
    if (sequence.length() > 0) {
        constructor = sequencedExpr(sequence, constructor)
    }
    return "    nv_enum_add(" + cstr(enumName) + ", " + cstr(nodeChild(constant, 1)) + ", " + constructor + ");" + nl()
}

// The statements of an initialiser inside a block that declares the
// temporaries (see ordering.nv) they read; unchanged when there are none.
method withTemps(string statements, string temps): string {
    if (temps == "") {
        return statements
    }
    return "    {" + nl() + "        nv " + temps + ";" + nl() + statements + "    }" + nl()
}

method genMainEntry(map<string, string> prog): string {
    var hasMain0 = prog.has("func:main/0")
    var hasMain1 = prog.has("func:main/1")
    if (hasMain0 == false && hasMain1 == false) {
        fail("no 'method main' found", "program")
    }
    var out = "int main(int argc, char **argv) {" + nl()
    out = out + "    nv result = nv_nil;" + nl()
    if (prog.has("litn")) {
        out = out + "    nv_init_literals(nv_lits, nv_lit_text, " + prog["litn"] + ");" + nl()
    }
    out = out + "    nv_init_args(argc, argv);" + nl()
    out = out + "    nv_register_classes();" + nl()
    out = out + "    nv_init_globals();" + nl()
    out = out + mainCallCode(hasMain0, hasMain1)
    out = out + "    nv_terminate(nv_exit_code(result));" + nl()
    out = out + "    return 0;" + nl()
    return out + "}" + nl()
}

// The statement(s) that select and call the user's main method.
method mainCallCode(bool hasMain0, bool hasMain1): string {
    if (hasMain0 && hasMain1) {
        return "    if (argc > 1) {" + nl() + "        result = f_main_1(nv_args());" + nl() + "    } else {" + nl() + "        result = f_main_0();" + nl() + "    }" + nl()
    }
    if (hasMain1) {
        return "    result = f_main_1(nv_args());" + nl()
    }
    return "    result = f_main_0();" + nl()
}

// nv_init_globals: every global becomes a collector root, then the globals
// and the enum constants are initialised, each after what it uses.
method genInitFunction(array<string> rootsInit, array<string> globalUnits, array<string> enumUnits, map<string, string> sources): string {
    var out = "static void nv_init_globals(void) {" + nl() + joinParts(rootsInit)
    var units = globalUnits
    for (enumUnit in enumUnits) {
        units.append(enumUnit)
    }
    for (unit in initOrder(units, sources)) {
        out = out + genUnitInit(unit, sources[unit], unitTemps(unit, sources))
    }
    return out + "}" + nl() + nl()
}

// The temporaries a global's initialiser uses (see ordering.nv), "" when none.
method unitTemps(string unit, map<string, string> sources): string {
    var key = "t:" + unit.substring(2, unit.length())
    if (unit.startsWith("g:") && sources.has(key)) {
        return sources[key]
    }
    return ""
}

// The statement(s) that initialise one unit from its C text; `temps` names
// the temporaries the text reads.
method genUnitInit(string unit, string text, string temps): string {
    if (unit.startsWith("e:")) {
        return text
    }
    var assignment = "g_" + unit.substring(2, unit.length()) + " = " + text + ";"
    if (temps == "") {
        return "    " + assignment + nl()
    }
    return withTemps("        " + assignment + nl(), temps)
}

// Generates the complete C translation unit. `runtime` is the text of
// novus_rt.h to embed; when empty an #include "novus_rt.h" is emitted.
method generateProgram(array<string> decls, string runtime): string {
    var prog = {}
    indexProgram(decls, prog)
    checkClasses(prog, decls)
    analyseWorkers(decls, prog)

    var protos = []
    var bodies = []
    var registry = []
    var rootsInit = []
    var globalUnits = []
    var enumUnits = []
    var sources = {}
    var emitted = {}

    for (d in decls) {
        var head = nodeHead(d)
        if (head == "method" && isNativeMethod(d)) {
            continue
        }
        if (head == "method") {
            var name = methodName(d)
            var arity = arityOf(d)
            var key = name + "/" + arity
            var variants = parseInt(prog["func:" + key])
            var variant = 0
            if (emitted.has(key)) {
                variant = parseInt(emitted[key])
            }
            emitted[key] = intToStr(variant + 1)
            var cname = funcCName(name, arity, variant, variants)
            protos.append("static nv " + cname + "(" + cParamList(d) + ");" + nl())
            var descriptor = rawDescriptor(prog, name, arity)
            if (descriptor != "") {
                protos.append("static " + rawResultType(descriptor) + " " + cname + "_raw(" + rawParamList(d, descriptor) + ");" + nl())
            }
            var body = genFreeMethod(d, cname, prog)
            bodies.append(body)
            sources["f:" + cname] = body
            if (descriptor != "") {
                sources["f:" + cname + "_raw"] = body
            }
            if (variants > 1 && variant == 0) {
                var dispatcherName = funcCName(name, arity, 0, 1)
                var dispatcher = genDispatcher(name, arity, variants, prog)
                protos.append("static nv " + dispatcherName + "(" + cParamList(d) + ");" + nl())
                bodies.append(dispatcher)
                sources["f:" + dispatcherName] = dispatcher
            }
            continue
        }
        if (head == "class" || head == "enum") {
            genClassCode(d, prog, protos, bodies, registry, sources)
            if (head == "enum") {
                enumUnits.append("e:" + nodeChild(d, 1))
                sources["e:" + nodeChild(d, 1)] = genEnumInit(d, prog)
            }
            continue
        }
        if (head == "global") {
            var gname = nodeChild(d, 1)
            var gctx = {"class": "", "pkg": packageOf(gname), "func": "", "ret": "void", "pos": "constant " + gname}
            var glocals = {}
            protos.append("static nv g_" + cName(gname) + ";" + nl())
            // the collector cannot see statics on its own: each global is a root;
            // until its initialiser has run a global reads as null
            rootsInit.append("    nv_gc_root(&g_" + cName(gname) + ");" + nl())
            rootsInit.append("    g_" + cName(gname) + " = nv_nil;" + nl())
            globalUnits.append("g:" + cName(gname))
            sources["g:" + cName(gname)] = genExpr(nodeChild(d, 2), prog, gctx, glocals)
            if (tempNames(gctx) != "") {
                sources["t:" + cName(gname)] = tempNames(gctx)
            }
        }
    }

    var out = []
    out.append("/* do not edit - snapshot of novusc in c */\n" + nl())
    if (runtime == "") {
        out.append("#include " + cstr("novus_rt.h") + nl())
    } else {
        out.append(runtime)
        if (runtime.charAt(runtime.length() - 1) != nl()) {
            out.append(nl())
        }
    }
    out.append(nl() + "/* declarations */" + nl())
    out.append(joinParts(protos))
    out.append(literalTable(prog))
    out.append(icTable(prog))
    out.append(spawnBodies(prog))
    out.append(nl() + "static void nv_register_classes(void) {" + nl() + "    NvClass *c = 0;" + nl() + "    (void)c;" + nl())
    out.append(joinParts(registry))
    out.append("}" + nl() + nl() + genInitFunction(rootsInit, globalUnits, enumUnits, sources))
    var i = 0
    while (i < bodies.length()) {
        out.append(bodies[i] + nl())
        i = i + 1
    }
    out.append(genMainEntry(prog))
    return joinParts(out)
}
