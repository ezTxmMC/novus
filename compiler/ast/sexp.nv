package ast

// Navigating the string-encoded s-expression AST.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method isList(string s): bool {
    if (s.length() > 0) {
        return s.charAt(0) == "("
    }
    return false
}

// s.charAt(i) starts a child node; returns the index just past it.
method atomEnd(string s, integer i): integer {
    var quote = chr(34)
    var backslash = chr(92)
    var n = s.length()
    if (s.charAt(i) == "(") {
        var depth = 0
        var inQuote = false
        while (i < n) {
            var c = s.charAt(i)
            if (inQuote) {
                if (c == backslash) {
                    i = i + 2
                    continue
                }
                if (c == quote) {
                    inQuote = false
                }
                i = i + 1
                continue
            }
            if (c == quote) {
                inQuote = true
            }
            if (c == "(") {
                depth = depth + 1
            }
            if (c == ")") {
                depth = depth - 1
                if (depth == 0) {
                    return i + 1
                }
            }
            i = i + 1
        }
        return n
    }
    if (s.charAt(i) == quote) {
        i = i + 1
        while (i < n && s.charAt(i) != quote) {
            if (s.charAt(i) == backslash) {
                i = i + 1
            }
            i = i + 1
        }
        return i + 1
    }
    while (i < n && s.charAt(i) != " " && s.charAt(i) != ")") {
        i = i + 1
    }
    return i
}

// The index-th child of a list node (index 0 is the head), "" if absent.
method nodeChild(string s, integer index): string {
    var n = s.length()
    var i = 1
    var count = 0
    while (i < n) {
        while (i < n && s.charAt(i) == " ") {
            i = i + 1
        }
        if (i >= n || s.charAt(i) == ")") {
            return ""
        }
        var start = i
        i = atomEnd(s, i)
        if (count == index) {
            return s.substring(start, i)
        }
        count = count + 1
    }
    return ""
}

method nodeCount(string s): integer {
    var n = s.length()
    var i = 1
    var count = 0
    while (i < n) {
        while (i < n && s.charAt(i) == " ") {
            i = i + 1
        }
        if (i >= n || s.charAt(i) == ")") {
            return count
        }
        i = atomEnd(s, i)
        count = count + 1
    }
    return count
}

method nodeHead(string s): string {
    if (isList(s)) {
        return nodeChild(s, 0)
    }
    return ""
}

// Payload of a quoted string atom, still in escaped form.
method strPayload(string s): string {
    if (s.length() >= 2) {
        return s.substring(1, s.length() - 1)
    }
    return ""
}

// The character an escape letter stands for.
method sexpUnescapeChar(string e): string {
    if (e == "n") {
        return chr(10)
    }
    if (e == "r") {
        return chr(13)
    }
    if (e == "t") {
        return chr(9)
    }
    return e
}

// Decodes the escapes of a quoted string atom back into raw text.
method sexpUnescape(string s): string {
    var backslash = chr(92)
    var text = strPayload(s)
    var out = ""
    var i = 0
    var n = text.length()
    while (i < n) {
        var c = text.charAt(i)
        if (c == backslash && i + 1 < n) {
            out = out + sexpUnescapeChar(text.charAt(i + 1))
            i = i + 2
            continue
        }
        out = out + c
        i = i + 1
    }
    return out
}
