package codegen

import ast
import parser

// Method bodies, constructors and overload dispatchers -> C.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method deprecationCode(string m, string indent, string flagName): string {
    var annos = nodeChild(m, 4)
    var i = 1
    var annosCount = nodeCount(annos)
    while (i < annosCount) {
        var anno = nodeChild(annos, i)
        if (nodeChild(anno, 1) == "Deprecated") {
            var text = cstr("")
            var since = cstr("")
            var k = 2
            var annoCount = nodeCount(anno)
            while (k < annoCount) {
                var arg = nodeChild(anno, k)
                if (nodeChild(arg, 1) == "text") {
                    text = nodeChild(arg, 2)
                }
                if (nodeChild(arg, 1) == "since") {
                    since = nodeChild(arg, 2)
                }
                k = k + 1
            }
            return indent + "nv_warn_deprecated(&" + flagName + ", " + cstr(methodName(m)) + ", " + since + ", " + text + ");" + nl()
        }
        i = i + 1
    }
    return ""
}

// Parameter bindings from an argument array (class methods and ctors).
method bindArrayParams(string m, string indent, map<string, string> locals): string {
    var params = paramsNode(m)
    var out = ""
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        var p = nodeChild(params, i)
        var ptype = nodeChild(p, 1)
        var pname = nodeChild(p, 2)
        var src = "(n > " + (i - 1) + " ? args[" + (i - 1) + "] : nv_nil)"
        out = out + indent + "nv l_" + pname + " = " + coerceCode(src, ptype) + ";" + nl()
        locals[pname] = "l_" + pname
        i = i + 1
    }
    return out
}

method cParamList(string m): string {
    var params = paramsNode(m)
    var out = ""
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        if (i > 1) {
            out = out + ", "
        }
        out = out + "nv a" + (i - 1)
        i = i + 1
    }
    if (out == "") {
        return "void"
    }
    return out
}

method funcCName(string name, integer arity, integer variant, integer variants): string {
    var base = "f_" + cName(name) + "_" + arity
    if (variants > 1) {
        return base + "_v" + variant
    }
    return base
}

method argNames(integer arity): string {
    var out = ""
    var i = 0
    while (i < arity) {
        if (i > 0) {
            out = out + ", "
        }
        out = out + "a" + i
        i = i + 1
    }
    return out
}

// An async method is the method it was written as, plus two lines: the body
// moves aside under its own name and what callers reach starts it on a
// virtual thread. Nothing at the call sites changes - `f(x)` hands back a
// task there, and `await` is what turns it into the value.
method genFreeMethod(string m, string cname, map<string, string> prog): string {
    if (isAsyncMethod(m) == false) {
        return genFreeMethodBody(m, cname, prog)
    }
    var inner = cname + "_body"
    var arity = arityOf(m)
    var out = genFreeMethodBody(m, inner, prog)
    out = out + "static nv nv_async_" + cname + "(nv *a, int n) {" + nl()
    out = out + "    (void)a;" + nl() + "    (void)n;" + nl()
    out = out + "    return " + inner + "(" + argSlots(arity) + ");" + nl() + "}" + nl()
    out = out + "static nv " + cname + "(" + cParamList(m) + ") {" + nl()
    out = out + "    return nv_spawn(1, nv_async_" + cname + ", " + arity
    if (arity > 0) {
        out = out + ", " + argNames(arity)
    }
    return out + ");" + nl() + "}" + nl()
}

// The context a free method is generated in.
method freeMethodContext(string m): map<string, string> {
    var name = methodName(m)
    return {"class": "", "pkg": packageOf(name), "func": name, "ret": methodRet(m), "pos": "method " + name}
}

// The locals of a free method: its parameters, bound to the C names they are
// given, and the marks of the inference. `returnKinds` collects the kinds of
// what the body returns.
method freeMethodLocals(string m, map<string, string> prog, map<string, string> ctx, array<string> returnKinds): map<string, string> {
    var locals = {}
    var params = paramsNode(m)
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        var pname = nodeChild(nodeChild(params, i), 2)
        locals[pname] = "l_" + pname
        i = i + 1
    }
    markLocalKinds(nodeChild(m, 5), params, true, prog, ctx, locals, returnKinds)
    return locals
}

// The line that turns the boxed argument `index` of a method into its local:
// a number for a parameter the inference unboxed, the coerced value otherwise.
method paramPrologue(string param, integer index, map<string, string> locals): string {
    var pname = nodeChild(param, 2)
    var arg = "a" + index
    if (isIntLocal(locals, pname)) {
        return "    long long l_" + pname + " = nv_as_int(" + arg + ");" + nl()
    }
    if (isFloatLocal(locals, pname)) {
        return "    double l_" + pname + " = nv_as_double(" + arg + ");" + nl()
    }
    return "    nv l_" + pname + " = " + coerceCode(arg, nodeChild(param, 1)) + ";" + nl()
}

method genFreeMethodBody(string m, string cname, map<string, string> prog): string {
    var ctx = freeMethodContext(m)
    var locals = freeMethodLocals(m, prog, ctx, [])
    var descriptor = rawDescriptor(prog, methodName(m), arityOf(m))
    if (descriptor != "") {
        return genWorkerMethod(m, cname, descriptor, prog, ctx, locals)
    }
    var params = paramsNode(m)
    var out = "static nv " + cname + "(" + cParamList(m) + ") {" + nl()
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        out = out + paramPrologue(nodeChild(params, i), i - 1, locals)
        i = i + 1
    }
    var dep = deprecationCode(m, "    ", "dep_" + cname)
    if (dep != "") {
        out = "static int dep_" + cname + " = 0;" + nl() + out + dep
    }
    var body = genBlock(nodeChild(m, 5), "    ", prog, ctx, locals)
    out = out + tempDecls(ctx, "    ") + body
    return out + "    return " + defaultCode(methodRet(m)) + ";" + nl() + "}" + nl()
}

// The C type of what a worker returns.
method rawResultType(string descriptor): string {
    var kind = rawReturnKind(descriptor)
    if (kind == KIND_INT) {
        return "long long"
    }
    if (kind == KIND_FLOAT) {
        return "double"
    }
    return "nv"
}

// One parameter of a worker: a C number, or the boxed argument.
method rawParamDeclaration(string kind, string pname, integer index): string {
    if (kind == KIND_INT) {
        return "long long l_" + pname
    }
    if (kind == KIND_FLOAT) {
        return "double l_" + pname
    }
    return "nv a" + index
}

// The parameter list of a worker: unboxed where the descriptor says so, the
// boxed value otherwise.
method rawParamList(string m, string descriptor): string {
    var params = paramsNode(m)
    var parts = []
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        parts.append(rawParamDeclaration(rawParamKind(descriptor, i - 1), nodeChild(nodeChild(params, i), 2), i - 1))
        i = i + 1
    }
    if (parts.length() == 0) {
        return "void"
    }
    return parts.join(", ")
}

// What the worker returns when the body falls off its end.
method rawDefaultCode(string descriptor, string t): string {
    var kind = rawReturnKind(descriptor)
    if (kind == KIND_INT) {
        return "0"
    }
    if (kind == KIND_FLOAT) {
        return "0.0"
    }
    return defaultCode(t)
}

// A method with an unboxed worker (workers.nv): the worker `<name>_raw` takes
// and returns what its descriptor says, and the function under the method's
// own name - the one every boxed call reaches - converts the boxed arguments
// the way the body used to, calls the worker and boxes its result.
method genWorkerMethod(string m, string cname, string descriptor, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    var raw = cname + "_raw"
    ctx["rawret"] = rawReturnKind(descriptor)
    var params = paramsNode(m)
    var out = "static " + rawResultType(descriptor) + " " + raw + "(" + rawParamList(m, descriptor) + ") {" + nl()
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        var p = nodeChild(params, i)
        if (rawParamKind(descriptor, i - 1) == "n") {
            out = out + "    nv l_" + nodeChild(p, 2) + " = " + coerceCode("a" + (i - 1), nodeChild(p, 1)) + ";" + nl()
        }
        i = i + 1
    }
    var dep = deprecationCode(m, "    ", "dep_" + cname)
    if (dep != "") {
        out = "static int dep_" + cname + " = 0;" + nl() + out + dep
    }
    var body = genBlock(nodeChild(m, 5), "    ", prog, ctx, locals)
    out = out + tempDecls(ctx, "    ") + body
    out = out + "    return " + rawDefaultCode(descriptor, methodRet(m)) + ";" + nl() + "}" + nl()
    return out + genWorkerEntry(m, cname, raw, descriptor)
}

// A boxed argument as the worker takes it.
method unboxedArgument(string kind, string arg): string {
    if (kind == KIND_INT) {
        return "nv_as_int(" + arg + ")"
    }
    if (kind == KIND_FLOAT) {
        return "nv_as_double(" + arg + ")"
    }
    return arg
}

// The boxed function of a method that has a worker.
method genWorkerEntry(string m, string cname, string raw, string descriptor): string {
    var args = []
    var i = 0
    while (i < arityOf(m)) {
        args.append(unboxedArgument(rawParamKind(descriptor, i), "a" + i))
        i = i + 1
    }
    var call = raw + "(" + args.join(", ") + ")"
    var kind = rawReturnKind(descriptor)
    if (kind == KIND_INT) {
        call = "nv_int(" + call + ")"
    }
    if (kind == KIND_FLOAT) {
        call = "nv_float(" + call + ")"
    }
    return "static nv " + cname + "(" + cParamList(m) + ") {" + nl() + "    return " + call + ";" + nl() + "}" + nl()
}

method genDispatcher(string name, integer arity, integer variants, map<string, string> prog): string {
    var key = name + "/" + arity
    var first = prog["fnode:" + key + "/0"]
    var out = "static nv " + funcCName(name, arity, 0, 1) + "(" + cParamList(first) + ") {" + nl()
    var k = 0
    while (k < variants) {
        var m = prog["fnode:" + key + "/" + k]
        var params = paramsNode(m)
        var cond = ""
        var i = 1
        var paramsCount = nodeCount(params)
        while (i < paramsCount) {
            if (i > 1) {
                cond = cond + " && "
            }
            cond = cond + "nv_type_is(a" + (i - 1) + ", " + cstr(nodeChild(nodeChild(params, i), 1)) + ")"
            i = i + 1
        }
        if (cond == "") {
            cond = "1"
        }
        out = out + "    if (" + cond + ") {" + nl() + "        return " + funcCName(name, arity, k, variants) + "(" + argNames(arity) + ");" + nl() + "    }" + nl()
        k = k + 1
    }
    return out + "    return " + funcCName(name, arity, 0, variants) + "(" + argNames(arity) + ");" + nl() + "}" + nl()
}

method methodCName(string cls, string m, integer variant): string {
    var base = "m_" + cls + "_" + methodName(m) + "_" + arityOf(m)
    if (variant > 0) {
        return base + "_v" + variant
    }
    return base
}

method genClassMethod(string cls, string m, string cname, map<string, string> prog): string {
    var ctx = {"class": cls, "pkg": classPackage(prog, cls), "func": methodName(m), "ret": methodRet(m), "pos": "method " + cls + "." + methodName(m)}
    var locals = {}
    var out = "static nv " + cname + "(nv self, nv *args, int n) {" + nl()
    out = out + bindArrayParams(m, "    ", locals)
    markLocalKinds(nodeChild(m, 5), paramsNode(m), false, prog, ctx, locals, [])
    var dep = deprecationCode(m, "    ", "dep_" + cname)
    if (dep != "") {
        out = "static int dep_" + cname + " = 0;" + nl() + out + dep
    }
    out = out + "    (void)n;" + nl()
    var body = genBlock(nodeChild(m, 5), "    ", prog, ctx, locals)
    out = out + tempDecls(ctx, "    ") + body
    return out + "    return " + defaultCode(methodRet(m)) + ";" + nl() + "}" + nl()
}

method genCtor(string cls, string ctor, map<string, string> prog): string {
    var ctx = {"class": cls, "pkg": classPackage(prog, cls), "func": "construct", "ret": "void", "pos": "constructor of " + cls}
    var locals = {}
    var out = "static nv c_" + cls + "(nv self, nv *args, int n) {" + nl()
    var params = nodeChild(ctor, 1)
    var i = 1
    var paramsCount = nodeCount(params)
    while (i < paramsCount) {
        var p = nodeChild(params, i)
        var pname = nodeChild(p, 2)
        var src = "(n > " + (i - 1) + " ? args[" + (i - 1) + "] : nv_nil)"
        out = out + "    nv l_" + pname + " = " + coerceCode(src, nodeChild(p, 1)) + ";" + nl()
        locals[pname] = "l_" + pname
        i = i + 1
    }
    out = out + "    (void)n;" + nl()
    markLocalKinds(nodeChild(ctor, 2), params, false, prog, ctx, locals, [])
    var body = genBlock(nodeChild(ctor, 2), "    ", prog, ctx, locals)
    out = out + tempDecls(ctx, "    ") + body
    return out + "    return nv_nil;" + nl() + "}" + nl()
}

// Index of `m` among same-named, same-arity methods of the class.
method methodVariant(string methods, integer index): integer {
    var m = nodeChild(methods, index)
    var variant = 0
    var i = 1
    while (i < index) {
        var other = nodeChild(methods, i)
        if (methodName(other) == methodName(m) && arityOf(other) == arityOf(m)) {
            variant = variant + 1
        }
        i = i + 1
    }
    return variant
}
