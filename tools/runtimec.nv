package runtimec

// The C runtime that generated programs #include as novus_rt.h.
// Bootstrap-style memory management: allocations are never freed.
method runtimeC(): string {
    return "#ifndef NOVUS_RT_H
#define NOVUS_RT_H
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct { const char **items; int len; int cap; } NvArr;

static NvArr* nv_arr_new(void) {
    NvArr* a = (NvArr*)malloc(sizeof(NvArr));
    a->len = 0;
    a->cap = 8;
    a->items = (const char**)malloc(sizeof(char*) * a->cap);
    return a;
}

static void nv_arr_push(NvArr* a, const char* s) {
    if (a->len == a->cap) {
        a->cap = a->cap * 2;
        a->items = (const char**)realloc(a->items, sizeof(char*) * a->cap);
    }
    a->items[a->len] = s;
    a->len = a->len + 1;
}

static NvArr* nv_arr_of(int count, ...) {
    NvArr* a = nv_arr_new();
    va_list ap;
    va_start(ap, count);
    for (int i = 0; i < count; i++) {
        nv_arr_push(a, va_arg(ap, const char*));
    }
    va_end(ap);
    return a;
}

static const char* nv_arr_get(NvArr* a, int i) { return a->items[i]; }

static void nv_arr_set(NvArr* a, int i, const char* v) { a->items[i] = v; }

static const char* nv_concat(const char* x, const char* y) {
    size_t lx = strlen(x);
    size_t ly = strlen(y);
    char* r = (char*)malloc(lx + ly + 1);
    memcpy(r, x, lx);
    memcpy(r + lx, y, ly + 1);
    return r;
}

static const char* nv_charat(const char* s, int i) {
    char* r = (char*)malloc(2);
    r[0] = s[i];
    r[1] = 0;
    return r;
}

static const char* nv_substr(const char* s, int start, int end) {
    int n = (int)strlen(s);
    if (start < 0) start = 0;
    if (end > n) end = n;
    if (start > end) start = end;
    char* r = (char*)malloc((size_t)(end - start) + 1);
    memcpy(r, s + start, (size_t)(end - start));
    r[end - start] = 0;
    return r;
}

static int nv_streq(const char* a, const char* b) { return strcmp(a, b) == 0; }

static const char* nv_int2str(int x) {
    char* r = (char*)malloc(16);
    sprintf(r, \"%d\", x);
    return r;
}

static const char* nv_float2str(double x) {
    char* r = (char*)malloc(32);
    sprintf(r, \"%f\", x);
    return r;
}
static const char* nv_chr(int code) {
    char* r = (char*)malloc(2);
    r[0] = (char)code;
    r[1] = 0;
    return r;
}

static int nv_ord(const char* s) { return (int)(unsigned char)s[0]; }

static const char* nv_read_file(const char* path) {
    FILE* f = fopen(path, \"rb\");
    if (!f) return \"\";
    fseek(f, 0, SEEK_END);
    long n = ftell(f);
    fseek(f, 0, SEEK_SET);
    char* buf = (char*)malloc((size_t)n + 1);
    size_t rd = fread(buf, 1, (size_t)n, f);
    buf[rd] = 0;
    fclose(f);
    return buf;
}

static NvArr* nv_args_global = 0;

static void nv_init_args(int argc, char** argv) {
    nv_args_global = nv_arr_new();
    for (int i = 1; i < argc; i++) {
        nv_arr_push(nv_args_global, argv[i]);
    }
}

static NvArr* nv_get_args(void) {
    if (nv_args_global) {
        return nv_args_global;
    }
    return nv_arr_new();
}

typedef struct NvMapE { const char* key; const char* val; struct NvMapE* next; } NvMapE;
typedef struct { NvMapE* head; int len; } NvMap;

static NvMap* nv_map_new(void) {
    NvMap* m = (NvMap*)malloc(sizeof(NvMap));
    m->head = 0;
    m->len = 0;
    return m;
}

static void nv_map_set(NvMap* m, const char* k, const char* v) {
    NvMapE** cur = &m->head;
    while (*cur && strcmp((*cur)->key, k) < 0) {
        cur = &(*cur)->next;
    }
    if (*cur && strcmp((*cur)->key, k) == 0) {
        (*cur)->val = v;
        return;
    }
    NvMapE* e = (NvMapE*)malloc(sizeof(NvMapE));
    e->key = k;
    e->val = v;
    e->next = *cur;
    *cur = e;
    m->len = m->len + 1;
}

static NvMap* nv_map_of(int pairs, ...) {
    NvMap* m = nv_map_new();
    va_list ap;
    va_start(ap, pairs);
    for (int i = 0; i < pairs; i++) {
        const char* k = va_arg(ap, const char*);
        const char* v = va_arg(ap, const char*);
        nv_map_set(m, k, v);
    }
    va_end(ap);
    return m;
}

static const char* nv_map_get(NvMap* m, const char* k) {
    NvMapE* e = m->head;
    while (e) {
        if (strcmp(e->key, k) == 0) return e->val;
        e = e->next;
    }
    return \"\";
}

static int nv_map_has(NvMap* m, const char* k) {
    NvMapE* e = m->head;
    while (e) {
        if (strcmp(e->key, k) == 0) return 1;
        e = e->next;
    }
    return 0;
}

static void nv_map_remove(NvMap* m, const char* k) {
    NvMapE** cur = &m->head;
    while (*cur) {
        if (strcmp((*cur)->key, k) == 0) {
            *cur = (*cur)->next;
            m->len = m->len - 1;
            return;
        }
        cur = &(*cur)->next;
    }
}

static NvArr* nv_map_keys(NvMap* m) {
    NvArr* a = nv_arr_new();
    NvMapE* e = m->head;
    while (e) {
        nv_arr_push(a, e->key);
        e = e->next;
    }
    return a;
}
#endif"
}
