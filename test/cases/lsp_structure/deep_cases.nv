package main

import "novus/lsp/features/structure"
import @support
import @fixtures

private final STRUCT_DEEP_LEVELS = 250

// A file whose blocks nest deeper than the limit of the parsers: the braces must still pair up exactly.
method structDeepText(): string {
    var lines = ["method main() {"]
    var level = 1
    while (level < STRUCT_DEEP_LEVELS) {
        lines.append("if (true) {")
        level = level + 1
    }
    lines.append("println(1)")
    while (level > 0) {
        lines.append("}")
        level = level - 1
    }
    return lines.join("\n") + "\n"
}

method runDeepFoldingCases() {
    println("== deeply nested folding")
    var content = structDeepText()
    var world = StructWorld({"/d/project.nv": "project \"d\"\nmain \"main.nv\"\n", "/d/main.nv": content})
    var entries = FoldingBuilder().ranges(world.context("/d/main.nv"))
    println("ranges: " + entries.length())
    for (position in [0, 1, 49, 50, 199, 200, 248]) {
        println("range " + position + ": " + (entries[position].startLine + 1) + "-" + (entries[position].endLine + 1))
    }
}
