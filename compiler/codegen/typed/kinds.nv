package typed

import ast
import parser

// The kind of an expression: does it always produce an integer, always a
// float, or anything else?
//
// An expression of kind integer or float is computed as a C `long long` or
// `double` and boxed once, where a boxed value is needed. What has a kind:
//
//   - number literals and the locals the inference proved to be numbers
//     (`int:x` / `float:x` marks in the locals map, see typed/marks.nv);
//   - arithmetic on those, and a float with any value on the other side of
//     `-`, `*`, `/` and `%` (the runtime checks the other side, see
//     nv_fmul_du);
//   - calls of methods that have an unboxed worker (workers.nv), and the
//     numeric natives of the math module;
//   - fields declared `integer` or `float`, read from `this` or from a
//     receiver whose class is known (classOf below).
//
// Declared field types are trusted: every store into a numeric field
// converts (see coerceFieldCode and nv_coerce_numeric_field), so a field
// holds a number of its kind, and a value that is not one is reported as a
// type error when the code reads it unboxed. That happens only where the
// value is computed with. A field that is merely read - passed on, compared
// for equality, kept in a local, returned - stays boxed and is never checked
// (isBareRead and valueKind below).
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

final KIND_NONE = ""
final KIND_INT = "i"
final KIND_FLOAT = "d"

// The operators a value of each kind survives; the classification below runs
// for every node of every expression, so the sets are built once.
private final FLOAT_OPERATORS = {"+": true, "-": true, "*": true, "/": true, "%": true}
private final INTEGER_OPERATORS = {"+": true, "-": true, "*": true, "/": true, "%": true,
    "&": true, "|": true, "^": true, "<<": true, ">>": true}
// `+` is not among them: with a string on one side it concatenates.
private final MIXED_OPERATORS = {"-": true, "*": true, "/": true, "%": true}

// Does the code generator work on typed expressions inside this function?
// Initialisers of globals and enum constants are generated outside any
// function, where nothing could declare the temporaries a typed expression
// may need.
method isTypedContext(map<string, string> ctx): bool {
    return ctx.has("func") && ctx["func"] != ""
}

method isNumericKind(string kind): bool {
    return kind != KIND_NONE
}

// The kind a declared type stands for.
method kindOfType(string t): string {
    var n = normType(t)
    if (n == "integer") {
        return KIND_INT
    }
    if (n == "float") {
        return KIND_FLOAT
    }
    return KIND_NONE
}

method atomKind(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (isNumberAtom(node)) {
        if (hasDot(node)) {
            return KIND_FLOAT
        }
        return KIND_INT
    }
    if (isIntLocal(locals, node)) {
        return KIND_INT
    }
    if (isFloatLocal(locals, node)) {
        return KIND_FLOAT
    }
    if (isTypedContext(ctx) && resolveVar(node, prog, ctx, locals) == "" && isImplicitField(node, prog, ctx, locals)) {
        return kindOfType(fieldType(prog, ctx["class"], node))
    }
    return KIND_NONE
}

// A `+ - * / %` or bitwise node: both sides numbers of one kind, or a float
// and anything else.
method arithmeticKind(string node, string head, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    // each operand is classified once: asking twice doubles the work per level of a chain
    var left = kindOf(nodeChild(node, 1), prog, ctx, locals)
    var right = kindOf(nodeChild(node, 2), prog, ctx, locals)
    if (left == KIND_INT && right == KIND_INT && INTEGER_OPERATORS.has(head)) {
        return KIND_INT
    }
    if (FLOAT_OPERATORS.has(head) == false) {
        return KIND_NONE
    }
    if (isNumericKind(left) && isNumericKind(right) && (left == KIND_FLOAT || right == KIND_FLOAT)) {
        return KIND_FLOAT
    }
    if (isTypedContext(ctx) && MIXED_OPERATORS.has(head) && (left == KIND_FLOAT || right == KIND_FLOAT)) {
        return KIND_FLOAT
    }
    return KIND_NONE
}

// Is the node a read of a numeric field and nothing else: `this.f()`,
// `p.f()` or the name of a field of the class? Such a value is only checked
// when it is computed with.
method isBareRead(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): bool {
    if (isList(node) == false) {
        return isNumberAtom(node) == false && isIntLocal(locals, node) == false && isFloatLocal(locals, node) == false && isNumericKind(atomKind(node, prog, ctx, locals))
    }
    return nodeHead(node) == "mcall" && nodeCount(node) == 3 && isModuleTarget(nodeChild(node, 1), prog, ctx, locals) == false && isNumericKind(kindOf(node, prog, ctx, locals))
}

// The kind of a value that is stored or returned as it is: a bare field read
// has none, so that a local or a result made of it stays boxed and a value
// that is no number passes through as it did before the code was typed.
method valueKind(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (isBareRead(node, prog, ctx, locals)) {
        return KIND_NONE
    }
    return kindOf(node, prog, ctx, locals)
}

// Does the expression always produce an integer (`i`), always a float
// (`d`), or neither ("")?
method kindOf(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (isList(node) == false) {
        return atomKind(node, prog, ctx, locals)
    }
    var head = nodeHead(node)
    if (head == "neg") {
        return kindOf(nodeChild(node, 1), prog, ctx, locals)
    }
    if (head == "rawi") {
        return KIND_INT
    }
    if (head == "rawd") {
        return KIND_FLOAT
    }
    if ((FLOAT_OPERATORS.has(head) || INTEGER_OPERATORS.has(head)) && nodeCount(node) == 3) {
        return arithmeticKind(node, head, prog, ctx, locals)
    }
    if (head == "call") {
        return callKind(node, prog, ctx)
    }
    if (head == "mcall") {
        return methodCallKind(node, prog, ctx, locals)
    }
    return KIND_NONE
}
