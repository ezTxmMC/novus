package main

import web
import os
import pages
import strings

// Navigation structure (static for now, matching old website)
define class NavItem {
    private string path: get
    private string title: get
    private string summary: get
}

var NAV = [
    NavItem{path="/docs/introduction", title="Introduction", summary="What is Novus?"},
    NavItem{path="/docs/installation", title="Installation", summary="Get Novus running."},
    NavItem{path="/docs/first-program", title="First Program", summary="Hello, world."},
    NavItem{path="/docs/cli", title="Command Line", summary="novusc commands."},
    NavItem{path="/docs/language/basics", title="Basics", summary="Values and types."},
    NavItem{path="/docs/language/control-flow", title="Control Flow", summary="if, while, for."},
    NavItem{path="/docs/language/methods", title="Methods", summary="Functions and methods."},
    NavItem{path="/docs/language/collections", title="Collections", summary="arrays, maps."},
    NavItem{path="/docs/language/classes", title="Classes", summary="Objects and state."},
    NavItem{path="/docs/language/modules", title="Modules", summary="Packages and imports."},
    NavItem{path="/docs/language/concurrency", title="Concurrency", summary="Threads and sync."},
    NavItem{path="/docs/web/components", title="Web Components", summary="nvh templates."},
    NavItem{path="/docs/projects/manifest", title="Manifest", summary="project.nv"},
    NavItem{path="/docs/projects/dependencies", title="Dependencies", summary="Versions and imports."},
    NavItem{path="/docs/projects/editor", title="Editor Setup", summary="LSP and IDEs."},
    NavItem{path="/docs/projects/language-server", title="Language Server", summary="novus-lsp."},
    NavItem{path="/docs/architecture", title="Architecture", summary="Compiler and runtime."},
    NavItem{path="/docs/bootstrapping", title="Bootstrapping", summary="Self-hosting."},
]

method main {
    if (os.env("BUILD") == "export") {
        exportSite()
    } else {
        web.page("/", Home())
        web.page("/examples", Examples())
        web.page("/stdlib", Stdlib())
        web.page("/benchmarks", Benchmarks())
        for (item in NAV) {
            web.page(item.path, Docs())
        }
        web.serve(web.port(8080))
    }
}

method exportSite() {
    var dist = "dist"
    os.mkdir(dist)

    // Home
    exportPageSimple(Home(), dist + "/index.html")

    // Top-level pages
    exportPageSimple(Examples(), dist + "/examples/index.html")
    exportPageSimple(Stdlib(), dist + "/stdlib/index.html")
    exportPageSimple(Benchmarks(), dist + "/benchmarks/index.html")

    // Docs
    for (item in NAV) {
        var docs = Docs()
        docs.nvProp("path", item.path)
        var view = web.view(docs)
        var html = web.document(view, false)
        var dir = dist + item.path
        var idx = strings.lastIndexOf(dir, "/")
        if (idx > 0) {
            os.mkdir(dir.substring(0, idx))
        }
        os.mkdir(dir)
        os.writeFile(dir + "/index.html", html)
    }
}

method exportPageSimple(NvhComponent comp, string file) {
    var view = web.view(comp)
    var html = web.document(view, false)
    var idx = strings.lastIndexOf(file, "/")
    if (idx > 0) {
        var dir = file.substring(0, idx)
        os.mkdir(dir)
    }
    os.writeFile(file, html)
}

method navPrev(string path): NavItem {
    var idx = navIndex(path)
    if (idx <= 0) {
        return NavItem{path="", title="", summary=""}
    }
    return NAV[idx - 1]
}

method navNext(string path): NavItem {
    var idx = navIndex(path)
    if (idx < 0 || idx >= NAV.length() - 1) {
        return NavItem{path="", title="", summary=""}
    }
    return NAV[idx + 1]
}

method navIndex(string path): integer {
    var i = 0
    while (i < NAV.length()) {
        if (NAV[i].path == path) {
            return i
        }
        i = i + 1
    }
    return -1
}

method loadContent(string path): string {
    var slug = path
    if (slug.startsWith("/docs/")) {
        slug = slug.substring(6, slug.length())
    }
    var file = "content/" + slug + ".md"
    if (os.isFile(file)) {
        return os.readFile(file)
    }
    return ""
}

// Simplified markdown renderer (stub for quick test)
method mdToHtml(string md): string {
    // For now, just escape and wrap paragraphs: raw markdown content
    // Full renderer in lib/markdown.nv (to be integrated)
    var lines = md.split(chr(10))
    var out = []
    var i = 0
    while (i < lines.length()) {
        var line = lines[i]
        if (line.startsWith("# ")) {
            out.append("<h1>" + line.substring(2, line.length()) + "</h1>")
        } else if (line.startsWith("## ")) {
            out.append("<h2>" + line.substring(3, line.length()) + "</h2>")
        } else if (line.startsWith("```")) {
            out.append("<pre><code>")
        } else if (line == "") {
            // skip blank lines
        } else {
            out.append("<p>" + line + "</p>")
        }
        i = i + 1
    }
    return out.join("")
}
