package parser

import ast
import lexer

// Expressions: precedence climbing, literals, calls, interpolation.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// C's order: the bitwise operators bind looser than the comparisons,
// the shifts tighter. Built once, it is asked for every token of an expression.
private final PRECEDENCES = { "||": 1, "&&": 2, "|": 3, "^": 4, "&": 5, "==": 6, "!=": 6,
    "<": 7, ">": 7, "<=": 7, ">=": 7, "<<": 8, ">>": 8,
    "+": 9, "-": 9, "*": 10, "/": 10, "%": 10 }

method precedenceOf(array<string> tokens, integer p): integer {
    if (p >= tokens.length()) {
        return 0 - 1
    }
    var t = tokens[p]
    if (tokKind(t) != "SYM") {
        return 0 - 1
    }
    var op = tokVal(t)
    if (PRECEDENCES.has(op)) {
        return parseInt(PRECEDENCES[op])
    }
    return 0 - 1
}

// After an element of a comma separated list: skips a ',' and returns the
// next position; at the closer returns pos unchanged; fails otherwise.
method afterListItem(array<string> tokens, integer pos, string closer, string what): integer {
    if (isSym(tokens, pos, ",")) {
        return pos + 1
    }
    if (isSym(tokens, pos, closer)) {
        return pos
    }
    fail("expected ',' or '" + closer + "' in " + what + " but found " + describe(tokens, pos), posOf(tokens, pos))
    return pos
}

// Argument list after '(' up to and including ')'. Returns the nodes
// joined with spaces (prefixed by one space each) and the position.
method parseArgs(array<string> tokens, integer pos): map<string, string> {
    var p = pos
    var node = ""
    while (isSym(tokens, p, ")") == false) {
        if (atEnd(tokens, p)) {
            fail("unterminated argument list", posOf(tokens, p))
        }
        var arg = parseExpr(tokens, p, 0)
        node = node + " " + arg["node"]
        p = afterListItem(tokens, parseInt(arg["pos"]), ")", "argument list")
    }
    return { "node": node, "pos": p + 1 }
}

// Can a token begin an expression? `await` is only the operator when one
// follows it, so `await` stays usable as a name everywhere else.
method startsExpression(array<string> tokens, integer pos): bool {
    if (atEnd(tokens, pos)) {
        return false
    }
    var kind = tokKind(tokens[pos])
    if (kind == "IDENT" || kind == "INT" || kind == "FLOAT" || kind == "STRING") {
        return true
    }
    var val = tokVal(tokens[pos])
    if (kind == "KEYWORD") {
        return val == "true" || val == "false"
    }
    if (kind == "SYM") {
        return val == "(" || val == "[" || val == "{" || val == "-" || val == "!"
    }
    return false
}

// await expr, thread call(...), virtual call(...)
method parseUnary(array<string> tokens, integer pos): map<string, string> {
    if (isIdent(tokens, pos)) {
        var word = tokVal(tokens[pos])
        if (word == "await" && startsExpression(tokens, pos + 1)) {
            var awaited = parseUnary(tokens, pos + 1)
            return { "node": "(await " + awaited["node"] + ")", "pos": parseInt(awaited["pos"]) }
        }
        if ((word == "thread" || word == "virtual") && isIdent(tokens, pos + 1)) {
            var spawned = parseUnary(tokens, pos + 1)
            var spawnedHead = nodeHead(spawned["node"])
            if (spawnedHead != "call" && spawnedHead != "mcall") {
                fail("'" + word + "' runs a method call: " + word + " work(...)", posOf(tokens, pos))
            }
            var kind = "virtual"
            if (word == "thread") {
                kind = "os"
            }
            return { "node": "(spawn " + kind + " " + spawned["node"] + ")", "pos": parseInt(spawned["pos"]) }
        }
    }
    return parsePrimary(tokens, pos)
}

method parsePostfix(array<string> tokens, string node, integer pos): map<string, string> {
    while (true) {
        if (isSym(tokens, pos, "[")) {
            var idxE = parseExpr(tokens, pos + 1, 0)
            node = "(idx " + node + " " + idxE["node"] + ")"
            pos = expectSym(tokens, parseInt(idxE["pos"]), "]")
            continue
        }
        if (isSym(tokens, pos, ".") == false) {
            break
        }
        pos = expectIdent(tokens, pos + 1, "member name after '.'")
        var name = tokVal(tokens[pos - 1])
        if (isSym(tokens, pos, "(")) {
            var args = parseArgs(tokens, pos + 1)
            node = "(mcall " + node + " " + name + args["node"] + ")"
            pos = parseInt(args["pos"])
            continue
        }
        node = "(mget " + node + " " + name + ")"
    }
    return { "node": node, "pos": pos }
}

method parseExpr(array<string> tokens, integer pos, integer minPrec): map<string, string> {
    return parseExprWith(tokens, pos, minPrec, true)
}

method parseExprWith(array<string> tokens, integer pos, integer minPrec, bool cascading): map<string, string> {
    var left = parseOperand(tokens, pos, cascading)
    var node = left["node"]
    var p = parseInt(left["pos"])
    while (p < tokens.length()) {
        var prec = precedenceOf(tokens, p)
        if (prec < 0 || prec < minPrec) {
            break
        }
        var op = tokVal(tokens[p])
        var right = parseExprWith(tokens, p + 1, prec + 1, cascading)
        node = "(" + op + " " + node + " " + right["node"] + ")"
        p = parseInt(right["pos"])
    }
    return { "node": node, "pos": p }
}
