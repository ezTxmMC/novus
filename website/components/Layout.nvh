<?nv
prop string title = "Novus"
prop string description = "Novus is a small, self-hosting programming language that compiles to portable C."
prop string section = ""
prop string canonical = ""
?>
<head>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#0d0a14">
    <meta property="og:title" content="{title} - Novus">
    <meta property="og:description" content={description}>
    <title>{title} - Novus</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/site.css">
    <script src="/site.js" defer></script>
</head>
<div class="flex min-h-screen flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header section={section} />
    <main id="main" class="rise flex-1 [--rise-delay:0ms]">
        <slot />
    </main>
    <Footer />
    <dialog class="search-dialog" id="search-dialog" aria-label="Search the site">
        <div class="search-bar flex items-center gap-3 px-4">
            <input id="search-input" class="w-full bg-transparent py-4 text-ink-50 placeholder:text-ink-500 focus:outline-none" type="search" placeholder="Search docs, examples, the standard library..." autocomplete="off" aria-controls="search-results">
            <kbd class="rounded border border-ink-600 px-1.5 py-0.5 font-mono text-[10px] text-ink-400">esc</kbd>
        </div>
        <ul id="search-results" class="max-h-[50vh] overflow-y-auto p-2" role="listbox" aria-label="Results"></ul>
        <p id="search-empty" hidden class="px-4 py-6 text-center text-sm text-ink-400">Nothing found.</p>
    </dialog>
</div>
