package lexcore

method lex(string source): array<string> {
    var keywords = { "method": true, "return": true, "var": true, "if": true,
        "else": true, "while": true, "for": true, "in": true, "println": true,
        "true": true, "false": true, "package": true, "integer": true,
        "float": true, "string": true, "bool": true, "void": true,
        "array": true, "map": true }
    var symbols = { "{": "LBRACE", "}": "RBRACE", "(": "LPAREN", ")": "RPAREN",
        "[": "LBRACKET", "]": "RBRACKET", ":": "COLON", ",": "COMMA",
        ".": "DOT", "+": "PLUS", "-": "MINUS", "*": "STAR", "/": "SLASH",
        "%": "PERCENT", "=": "EQUAL", "<": "LANGLE", ">": "RANGLE", "!": "NOT" }
    var quote = chr(34)
    var newline = chr(10)
    var tokens = []
    var i = 0
    var n = source.length()
    while (i < n) {
        var c = source.charAt(i)
        if (c <= " ") {
            i = i + 1
        } else if (isAlpha(c)) {
            var word = ""
            while (i < n && isAlphaNum(source.charAt(i))) {
                word = word + source.charAt(i)
                i = i + 1
            }
            if (keywords.has(word)) {
                tokens.append("KEYWORD " + word)
            } else {
                tokens.append("IDENT " + word)
            }
        } else if (isDigit(c)) {
            var num = ""
            while (i < n && isDigit(source.charAt(i))) {
                num = num + source.charAt(i)
                i = i + 1
            }
            if (i + 1 < n && source.charAt(i) == "." && isDigit(source.charAt(i + 1))) {
                num = num + "."
                i = i + 1
                while (i < n && isDigit(source.charAt(i))) {
                    num = num + source.charAt(i)
                    i = i + 1
                }
                tokens.append("FLOAT " + num)
            } else {
                tokens.append("INT " + num)
            }
        } else if (c == quote) {
            var text = ""
            i = i + 1
            while (i < n && source.charAt(i) != quote) {
                text = text + source.charAt(i)
                i = i + 1
            }
            i = i + 1
            tokens.append("STRING " + text)
        } else {
            var two = ""
            if (i + 1 < n) {
                two = c + source.charAt(i + 1)
            }
            if (two == "//") {
                while (i < n && source.charAt(i) != newline) {
                    i = i + 1
                }
            } else if (isTwoCharOp(two)) {
                tokens.append("OP " + two)
                i = i + 2
            } else if (symbols.has(c)) {
                tokens.append(symbols[c] + " " + c)
                i = i + 1
            } else {
                i = i + 1
            }
        }
    }
    return tokens
}

method isTwoCharOp(string op): bool {
    return op == "==" || op == "!=" || op == "<=" || op == ">=" || op == "&&" || op == "||"
}

method isDigit(string c): bool {
    return c >= "0" && c <= "9"
}

method isAlpha(string c): bool {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
}

method isAlphaNum(string c): bool {
    return isAlpha(c) || isDigit(c)
}
