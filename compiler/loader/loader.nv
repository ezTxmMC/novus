package loader

import arrays
import os

import ast
import nvh
import parser
import std

// Loads a program: its files, the packages they import and the standard
// library modules.
//
// A package is a folder below the project root (the directory of project.nv,
// else the one of the main file): `import geo` loads every .nv and .nvh file
// in geo/, `import geo/shapes` those in geo/shapes/, `import @geo/circle` only
// geo/circle.nv. The root folder itself holds the main package; its other
// files are imported one by one (`import @helpers`). A dependency module is
// imported by its path in quotes, "example.com/geo" (its entry file),
// "example.com/geo/shapes" (a package of it) or "example.com/geo/shapes/circle"
// (one file of that package); inside a module, the module is the root.
//
// Functions and globals of a package are namespaced like those of a
// standard module - `(method geo.area ...)` - so that two packages may use
// the same names. Code calls them unqualified as long as only one package
// has the name (see codegen/index.nv), and as geo.area(...) when several do.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// Longest module key that `rel` names ("" when it is none).
method moduleOf(string rel, map<string, string> modules): string {
    var best = ""
    for (key in modules) {
        if (key.endsWith("/")) {
            continue
        }
        if (rel == key || rel.startsWith(key + "/")) {
            if (key.length() > best.length()) {
                best = key
            }
        }
    }
    return best
}

// The source files of a folder (.nv, .nvh), sorted ([] when it is none).
method sourceFilesIn(string dir): array<string> {
    var out = []
    if (os.isDir(dir) == false) {
        return out
    }
    for (entry in os.listDir(dir)) {
        if (isSourceName(entry)) {
            if (os.isFile(joinPath(dir, entry))) {
                out.append(entry)
            }
        }
    }
    return arrays.sort(out)
}

method loadFile(string path, string root, string importedFrom, map<string, string> loaded, array<string> out, map<string, string> modules): integer {
    var key = normalizePath(path)
    if (loaded.has(key)) {
        return 0
    }
    loaded[key] = "1"
    if (fileExists(path) == false) {
        fail("cannot open '" + path + "'", importedFrom)
    }
    var dir = dirName(path)
    var decls = parseFile(sourceText(path, dir, root), fileLabel(path))
    var qualifier = declaredQualifier(decls, packageQualifier(packagePath(root, dir)))
    if (qualifier != "" && loaded.has("userpkg:" + qualifier) == false) {
        loaded["userpkg:" + qualifier] = "1"
        out.append("(userpkg " + qualifier + ")")
    }
    addDecls(decls, dir, root, qualifier, fileLabel(path), loaded, out, modules)
    return 0
}

// The package prefix of a file's declarations: the one of its folder, "" when it declares
// `package main`. A declared name that is not the folder's is an error.
method declaredQualifier(array<string> decls, string folderQualifier): string {
    var qualifier = folderQualifier
    for (d in decls) {
        if (nodeHead(d) != "package") {
            continue
        }
        var declared = nodeChild(d, 1)
        if (declared == "main") {
            // the program's main package, wherever its files live
            qualifier = ""
            continue
        }
        if (qualifier != "" && declared != qualifier) {
            fail("the file declares package " + declared + " but lives in the folder of package " + qualifier + " - a folder is a package, so write 'package " + qualifier + "'", sexpUnescape(nodeChild(d, 2)))
        }
    }
    return qualifier
}

// Every file of the package folder `dir`.
method loadPackageDir(string dir, string root, string from, map<string, string> loaded, array<string> out, map<string, string> modules): integer {
    var key = "pkgdir:" + normalizePath(dir)
    if (loaded.has(key)) {
        return 0
    }
    loaded[key] = "1"
    for (file in sourceFilesIn(dir)) {
        loadFile(joinPath(dir, file), root, from, loaded, out, modules)
    }
    return 0
}

// All top-level declarations of the program rooted at mainFile.
method loadProgram(string mainFile): array<string> {
    return loadProgramWith(mainFile, {})
}

// Same, with dependency modules (key -> entry file, key + "/" -> directory).
method loadProgramWith(string mainFile, map<string, string> modules): array<string> {
    var loaded = {}
    var decls = []
    var root = projectRoot(mainFile)
    loaded["main"] = normalizePath(mainFile)
    loadFile(mainFile, root, "command line", loaded, decls, modules)
    if (isComponentName(mainFile)) {
        // a component run on its own: serve it as the page at /
        var serve = "import web\nmethod main {\n    web.page(\"/\", " + nvhClassName(mainFile) + "())\n    web.serve(web.port(8080))\n}\n"
        addDecls(parseFile(serve, fileLabel(mainFile) + "#serve"), ".", "", "", "command line", loaded, decls, modules)
    }
    return decls
}
