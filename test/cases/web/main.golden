    <p data-nv-click="[&quot;c7&quot;,&quot;nvInline1&quot;,[],&quot;&quot;]" data-nv="c7">only <button data-nv-click="[&quot;c7&quot;,&quot;explode&quot;,[],&quot;&quot;]">boom</button></p>
    <button data-nv-click="[&quot;c1&quot;,&quot;dropFirst&quot;,[],&quot;&quot;]">drop</button>
