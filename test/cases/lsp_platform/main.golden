--- walker
isSkippedDirectoryName(.git): true
isSkippedDirectoryName(.): true
isSkippedDirectoryName(.hidden): true
isSkippedDirectoryName(build): true
isSkippedDirectoryName(dist): true
isSkippedDirectoryName(out): true
isSkippedDirectoryName(node_modules): true
isSkippedDirectoryName(src): false
isSkippedDirectoryName(Build): false
isSkippedDirectoryName(outside): false
isSkippedDirectoryName(_x): false
isSkippedDirectoryName(distribution): false
MAX_SOURCE_FILE_BYTES: 2097152
walk memory .nv, big files are not filtered: [/w/a.nv, /w/big.nv, /w/sub/b.nv]
walk memory .nv and .nvh: [/w/a.nv, /w/big.nv, /w/sub/b.nv, /w/sub/deep/e.nvh]
walk memory depth 1: [/w/a.nv, /w/big.nv, /w/sub/b.nv]
walk memory missing root: []
walk disk .nv, depth 12 (skips dot/build/dist/out/node_modules, the link and big.nv): [a.nv, exact.nv, project.nv, sub/deep/d.nv, sub/deep/deeper/dd.nv, sub/s.nv]
walk disk .nv and .nvh: [a.nv, b.nvh, exact.nv, project.nv, sub/deep/d.nv, sub/deep/deeper/dd.nv, sub/s.nv]
walk disk depth 0: [a.nv, exact.nv, project.nv]
walk disk depth 1: [a.nv, exact.nv, project.nv, sub/s.nv]
walk disk depth 2: [a.nv, exact.nv, project.nv, sub/deep/d.nv, sub/s.nv]
walk disk no extensions: []
walk disk root is a file: []
walk disk missing root: []
