<?nv
import data

method searchText(StdModule module, StdFunction function): string {
    return (module.name + " " + function.name + " " + function.doc).toLower()
}
?>
<Layout title="Standard library" description="Every module and function of the Novus standard library, generated from std/." section="stdlib">
    <div class="mx-auto max-w-[90rem] px-4 py-12 sm:px-6 lg:px-8" data-filter>
        <h1 class="text-4xl font-semibold tracking-tight text-ink-50">Standard library</h1>
        <p class="mt-3 max-w-3xl text-ink-400">{data.stdModules().length()} modules with {data.functionCount()} functions, generated from <a href="https://github.com/ezTxmMC/novus/tree/master/std" rel="noreferrer">std/</a>. Import a module by name (<code class="font-mono text-ink-200">import strings</code>) and call its functions namespaced (<code class="font-mono text-ink-200">strings.repeat(...)</code>). Functions marked <span class="rounded border border-primary-500/40 px-1.5 py-0.5 font-mono text-[10px] text-primary-300">native</span> are implemented by the C runtime, the rest is Novus you can read.</p>
        <nav class="mt-6 flex flex-wrap gap-1.5" aria-label="Modules">
            {#for module in data.stdModules()}
                <a href="#{module.name}" class="chip font-mono no-underline">{module.name}</a>
            {/for}
        </nav>
        <label class="sr-only" for="std-filter">Filter functions</label>
        <input id="std-filter" class="input mt-6 max-w-md" type="search" placeholder="Filter functions..." data-filter-input>
        <p class="mt-3 text-xs text-ink-500" data-filter-count aria-live="polite">{data.functionCount()} shown</p>
        <div class="mt-8 space-y-12">
            {#for module in data.stdModules()}
                <section id={module.name} data-filter-section aria-labelledby="h-{module.name}">
                    <h2 id="h-{module.name}" class="flex items-baseline gap-3 font-mono text-xl font-semibold text-ink-50">{module.name} <span class="font-sans text-xs font-normal text-ink-500">{module.functions.length()} functions</span></h2>
                    <p class="mt-1 max-w-3xl text-sm text-ink-400">{module.summary}</p>
                    <ul class="mt-4 divide-y divide-ink-800 overflow-hidden rounded-xl border border-ink-700">
                        {#for function in module.functions}
                            <li data-filter-item data-text={searchText(module, function)} class="grid gap-1 px-4 py-3 md:grid-cols-2 md:gap-6">
                                <code class="font-mono text-[13px] break-words text-ink-100"><span class="text-primary-300">{module.name}.</span>{function.signature}</code>
                                <p class="text-sm text-ink-400">{function.doc}
                                    {#if function.native}
                                        <span class="ml-2 rounded border border-primary-500/40 px-1.5 py-0.5 font-mono text-[10px] text-primary-300">native</span>
                                    {/if}
                                </p>
                            </li>
                        {/for}
                    </ul>
                </section>
            {/for}
        </div>
    </div>
</Layout>
