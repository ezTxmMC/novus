package main

import "novus/lsp/features/semtok"
import @support

// A string token is one span; the code inside a `${...}` is classified on top of it, and the encoder cuts the string
// around it (6.28: an interpolation span cuts the surrounding string token).
method runStringCases() {
    println("== strings and interpolations")
    var dollar = "$"
    var source = stLines([
        "method main() {",
        "    var n = 1",
        "    println(\"a " + dollar + "{n + 2} b " + dollar + "{n} c\")",
        "    println(\"tab\\t " + dollar + "{n}\")",
        "    println(\"open " + dollar + "{n and no close\")",
        "    println(\"esc " + dollar + "{id(\\\"x\\\")} end\")",
        "    println(\"two\nlines " + dollar + "{n}\nend\")",
        "}",
        "method id(string s): string {",
        "    return s",
        "}"
    ])
    var world = StWorld(stProject(source))
    stShow("interpolations", source, world.spans("/p/main.nv", source))
}

// The C of a block is no Novus code and gets no tokens; its `$name` is classified like a name in the code.
method runCBlockCases() {
    println("== C blocks")
    var dollar = "$"
    var source = stLines([
        "define class Counter {",
        "    integer total",
        "",
        "    method bump(integer by) {",
        "        var local = 1",
        "        c { int x = 1; " + dollar + "total = nv_int(nv_ival(" + dollar + "local) + " + dollar + dollar + " + " + dollar + "by); }",
        "        println local",
        "    }",
        "}"
    ])
    var world = StWorld(stProject(source))
    stShow("variables of a C block", source, world.spans("/p/main.nv", source))
}
