package main

// Parsing simple key=value configuration lines.

method parseConfig(string text): map<string, string> {
    var config = {}
    for (line in text.split("\n")) {
        var trimmed = line.trim()
        if (trimmed == "" || trimmed.startsWith("#")) {
            continue
        }
        var at = trimmed.indexOf("=")
        if (at < 0) {
            continue
        }
        config[trimmed.substring(0, at).trim()] = trimmed.substring(at + 1, trimmed.length()).trim()
    }
    return config
}

method main {
    var config = parseConfig("# settings\nhost = localhost\nport = 8080\n\ndebug=true")
    for (key in config) {
        println "${key} -> ${config[key]}"
    }
}
