method stdSource(string name): string {
    if (name == "arrays") {
        return "package arrays\n\n// Array helpers beyond the builtin methods (length, append, pop, insert,\n// remove, contains, indexOf, join, clear).\n\nmethod sort(array<object> items): array<object> native \"nv_arr_sorted\"   // ascending, numbers or strings\nmethod sortDesc(array<object> items): array<object> {\n    return reverse(sort(items))\n}\n\nmethod reverse(array<object> items): array<object> {\n    var out = []\n    var i = items.length()\n    while (i > 0) {\n        out.append(items[i - 1])\n        i = i - 1\n    }\n    return out\n}\n\nmethod unique(array<object> items): array<object> {\n    var out = []\n    for (x in items) {\n        if (out.contains(x) == false) {\n            out.append(x)\n        }\n    }\n    return out\n}\n\n// [from, to) as integers\nmethod range(integer from, integer to): array<integer> {\n    var out = []\n    var i = from\n    while (i < to) {\n        out.append(i)\n        i = i + 1\n    }\n    return out\n}\n\nmethod slice(array<object> items, integer from, integer to): array<object> {\n    var out = []\n    var i = from\n    if (i < 0) {\n        i = 0\n    }\n    while (i < to && i < items.length()) {\n        out.append(items[i])\n        i = i + 1\n    }\n    return out\n}\n\nmethod concat(array<object> a, array<object> b): array<object> {\n    var out = []\n    for (x in a) {\n        out.append(x)\n    }\n    for (x in b) {\n        out.append(x)\n    }\n    return out\n}\n\nmethod sum(array<object> numbers): object {\n    var total = 0\n    for (x in numbers) {\n        total = total + x\n    }\n    return total\n}\n\nmethod min(array<object> items): object {\n    var best = items[0]\n    for (x in items) {\n        if (x < best) {\n            best = x\n        }\n    }\n    return best\n}\n\nmethod max(array<object> items): object {\n    var best = items[0]\n    for (x in items) {\n        if (x > best) {\n            best = x\n        }\n    }\n    return best\n}\n\nmethod first(array<object> items): object {\n    return items[0]\n}\n\nmethod last(array<object> items): object {\n    return items[items.length() - 1]\n}\n\nmethod isEmpty(array<object> items): bool {\n    return items.length() == 0\n}\n\n// Number of elements equal to `value`.\nmethod countOf(array<object> items, object value): integer {\n    var n = 0\n    for (x in items) {\n        if (x == value) {\n            n = n + 1\n        }\n    }\n    return n\n}\n\n// Copies the array (shallow).\nmethod copy(array<object> items): array<object> {\n    return slice(items, 0, items.length())\n}\n\n// Splits into chunks of `size` elements.\nmethod chunk(array<object> items, integer size): array<object> {\n    var out = []\n    var i = 0\n    while (i < items.length()) {\n        out.append(slice(items, i, i + size))\n        i = i + size\n    }\n    return out\n}\n"
    }
    if (name == "base64") {
        return "package base64\n\nimport math\n\n// Base64 encoding (RFC 4648, with padding).\n\nmethod alphabet(): string {\n    return \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"\n}\n\nmethod encode(string text): string {\n    var table = alphabet()\n    var out = \"\"\n    var i = 0\n    var n = text.length()\n    while (i < n) {\n        var b0 = ord(text.charAt(i))\n        var b1 = 0\n        var b2 = 0\n        if (i + 1 < n) {\n            b1 = ord(text.charAt(i + 1))\n        }\n        if (i + 2 < n) {\n            b2 = ord(text.charAt(i + 2))\n        }\n        var triple = b0 * 65536 + b1 * 256 + b2\n        out = out + table.charAt(triple / 262144)\n        out = out + table.charAt((triple / 4096) % 64)\n        if (i + 1 < n) {\n            out = out + table.charAt((triple / 64) % 64)\n        }\n        if (i + 1 >= n) {\n            out = out + \"=\"\n        }\n        if (i + 2 < n) {\n            out = out + table.charAt(triple % 64)\n        }\n        if (i + 2 >= n) {\n            out = out + \"=\"\n        }\n        i = i + 3\n    }\n    return out\n}\n\nmethod decode(string encoded): string {\n    var table = alphabet()\n    var out = \"\"\n    var bits = 0\n    var value = 0\n    for (c in encoded) {\n        if (c == \"=\" || c == \"\\n\" || c == \"\\r\" || c == \" \") {\n            continue\n        }\n        var index = table.indexOf(c)\n        if (index < 0) {\n            continue\n        }\n        value = value * 64 + index\n        bits = bits + 6\n        if (bits >= 8) {\n            bits = bits - 8\n            var byte = value / math.powInt(2, bits)\n            out = out + chr(byte % 256)\n            value = value % math.powInt(2, bits)\n        }\n    }\n    return out\n}\n"
    }
    if (name == "bits") {
        return "package bits\n\n// Bit operations that have no operator.\n//\n// The operators &, |, ^, << and >> are part of the language and work on 64\n// bit integers; >> keeps the sign. What is left over lives here.\n\n// Logical right shift - zeros are shifted in, unlike >>.\nmethod ushr(integer value, integer count): integer native \"nv_bits_ushr\"\n\n// The complement of every bit.\nmethod not(integer value): integer native \"nv_bits_not\"\n\nmethod rotateLeft(integer value, integer count): integer native \"nv_bits_rotl\"\nmethod rotateRight(integer value, integer count): integer native \"nv_bits_rotr\"\n\n// The low `count` bits of `value`.\nmethod mask(integer value, integer count): integer native \"nv_bits_mask\"\n\n// Arithmetic that wraps at 64 bits rather than overflowing. Signed overflow\n// is undefined in C, which the generated code is, so an algorithm that relies\n// on wrapping - a random number generator reproducing another language's, for\n// instance - has to say so explicitly.\nmethod wrappingAdd(integer a, integer b): integer native \"nv_bits_wrapping_add\"\nmethod wrappingSub(integer a, integer b): integer native \"nv_bits_wrapping_sub\"\nmethod wrappingMul(integer a, integer b): integer native \"nv_bits_wrapping_mul\"\n\n// The low 32 bits, read as a signed 32 bit number.\nmethod toI32(integer value): integer native \"nv_bits_to_i32\"\n\n// An unsigned 64 bit value as a float. A plain conversion reads the top bit\n// as a sign; this one does not.\nmethod toUnsignedFloat(integer value): float native \"nv_bits_to_unsigned_float\"\n\n// How many bits are set.\nmethod countOnes(integer value): integer native \"nv_bits_count_ones\"\n\n// The position of the highest set bit, -1 when `value` is zero. The number\n// of bits it takes to store a value is one more than this.\nmethod highestBit(integer value): integer native \"nv_bits_highest\"\n\n// Whether bit `index` is set.\nmethod isSet(integer value, integer index): bool {\n    return ushr(value, index) & 1 == 1\n}\n\n// `value` with bit `index` set.\nmethod set(integer value, integer index): integer {\n    return value | (1 << index)\n}\n\n// `value` with bit `index` cleared.\nmethod clear(integer value, integer index): integer {\n    return value & not(1 << index)\n}\n\n// The number of bits needed to represent values 0..count-1, at least 1.\nmethod bitsFor(integer count): integer {\n    if (count <= 1) {\n        return 1\n    }\n    return highestBit(count - 1) + 1\n}\n"
    }
    if (name == "bytes") {
        return "package bytes\n\n// Binary buffers.\n//\n// A Novus string carries an explicit byte length and charAt/substring work on\n// bytes, so a string is also the byte buffer: it holds NUL and every value in\n// 0..255 unchanged. This module reads and writes the fixed width and variable\n// length integers a binary protocol is made of, always big endian - the byte\n// order of the Minecraft, DNS and TLS wire formats alike.\n//\n// Reads past the end of a buffer do not abort the program: they yield 0 and\n// raise a flag, so a server survives a truncated or hostile packet.\n//   if (bytes.failed()) { ... bytes.clearError() }\n\nmethod size(string buffer): integer native \"nv_bytes_size\"\nmethod slice(string buffer, integer from, integer to): string native \"nv_bytes_slice\"\nmethod join(array<string> parts): string native \"nv_bytes_join\"\nmethod zeros(integer count): string native \"nv_bytes_zeros\"\n\n// Byte exact search and comparison (the string builtins stop at a NUL byte).\nmethod indexOf(string haystack, string needle, integer from): integer native \"nv_bytes_index_of\"\nmethod equal(string a, string b): bool native \"nv_bytes_equal\"\n\nmethod failed(): bool native \"nv_bytes_failed\"\nmethod clearError() native \"nv_bytes_clear_error\"\n\n// Reading at a byte offset.\nmethod u8(string buffer, integer offset): integer native \"nv_bytes_u8\"\nmethod u16(string buffer, integer offset): integer native \"nv_bytes_u16\"\nmethod u32(string buffer, integer offset): integer native \"nv_bytes_u32\"\nmethod i8(string buffer, integer offset): integer native \"nv_bytes_i8\"\nmethod i16(string buffer, integer offset): integer native \"nv_bytes_i16\"\nmethod i32(string buffer, integer offset): integer native \"nv_bytes_i32\"\nmethod i64(string buffer, integer offset): integer native \"nv_bytes_i64\"\nmethod f32(string buffer, integer offset): float native \"nv_bytes_f32\"\nmethod f64(string buffer, integer offset): float native \"nv_bytes_f64\"\n\n// Variable length integers: seven bits per byte, the high bit continues.\n// varIntSize() reports how many bytes the value occupies, 0 when the buffer\n// ends inside it and -1 when it is longer than the encoding allows.\nmethod varInt(string buffer, integer offset): integer native \"nv_bytes_varint\"\nmethod varIntSize(string buffer, integer offset): integer native \"nv_bytes_varint_size\"\nmethod varLong(string buffer, integer offset): integer native \"nv_bytes_varlong\"\nmethod varLongSize(string buffer, integer offset): integer native \"nv_bytes_varlong_size\"\n\n// Writing: each returns the encoded bytes.\nmethod putU8(integer value): string native \"nv_bytes_put_u8\"\nmethod putI16(integer value): string native \"nv_bytes_put_i16\"\nmethod putI32(integer value): string native \"nv_bytes_put_i32\"\nmethod putI64(integer value): string native \"nv_bytes_put_i64\"\nmethod putF32(float value): string native \"nv_bytes_put_f32\"\nmethod putF64(float value): string native \"nv_bytes_put_f64\"\nmethod putVarInt(integer value): string native \"nv_bytes_put_varint\"\nmethod putVarLong(integer value): string native \"nv_bytes_put_varlong\"\n\n// How many bytes putVarInt() will produce - needed to size a length prefix\n// before the body it describes exists.\nmethod varIntSizeOf(integer value): integer native \"nv_bytes_varint_written\"\n\nmethod hex(string buffer): string native \"nv_bytes_hex\"\nmethod fromHex(string text): string native \"nv_bytes_from_hex\"\nmethod toArray(string buffer): array<integer> native \"nv_bytes_to_array\"\nmethod ofArray(array<integer> values): string native \"nv_bytes_of_array\"\n\n// A bool is one byte, 0 or 1.\nmethod putBool(bool value): string {\n    if (value) {\n        return putU8(1)\n    }\n    return putU8(0)\n}\n\nmethod boolAt(string buffer, integer offset): bool {\n    return u8(buffer, offset) != 0\n}\n\n// A length prefixed UTF-8 string: a VarInt byte count, then the bytes.\nmethod putString(string text): string {\n    return putVarInt(size(text)) + text\n}\n"
    }
    if (name == "cli") {
        return "package cli\n\n// Command line parsing: `cli.parse(args)` splits positional arguments from\n// options: --name value, --name=value, --flag, -x.\n//   { \"args\": [...], \"opts\": { \"name\": \"value\", \"flag\": \"true\" } }\n\nmethod parse(array<string> arguments): map<string, object> {\n    var positional = []\n    var options = {}\n    var i = 0\n    while (i < arguments.length()) {\n        var a = arguments[i]\n        if (a == \"--\") {\n            i = i + 1\n            while (i < arguments.length()) {\n                positional.append(arguments[i])\n                i = i + 1\n            }\n            break\n        }\n        if (a.startsWith(\"--\")) {\n            var body = a.substring(2, a.length())\n            var eq = body.indexOf(\"=\")\n            if (eq >= 0) {\n                options[body.substring(0, eq)] = body.substring(eq + 1, body.length())\n                i = i + 1\n                continue\n            }\n            if (i + 1 < arguments.length() && arguments[i + 1].startsWith(\"-\") == false) {\n                options[body] = arguments[i + 1]\n                i = i + 2\n                continue\n            }\n            options[body] = \"true\"\n            i = i + 1\n            continue\n        }\n        if (a.startsWith(\"-\") && a.length() > 1) {\n            options[a.substring(1, a.length())] = \"true\"\n            i = i + 1\n            continue\n        }\n        positional.append(a)\n        i = i + 1\n    }\n    return { \"args\": positional, \"opts\": options }\n}\n\n// Option value or a fallback.\nmethod option(map<string, object> parsed, string name, string fallback): string {\n    var opts = parsed[\"opts\"]\n    if (opts.has(name)) {\n        return opts[name]\n    }\n    return fallback\n}\n\nmethod flag(map<string, object> parsed, string name): bool {\n    var opts = parsed[\"opts\"]\n    return opts.has(name)\n}\n\n// Positional argument at `index` or a fallback.\nmethod argument(map<string, object> parsed, integer index, string fallback): string {\n    var args = parsed[\"args\"]\n    if (index < args.length()) {\n        return args[index]\n    }\n    return fallback\n}\n"
    }
    if (name == "config") {
        return "package config\n\nimport json\nimport properties\nimport toml\nimport yaml\n\n// Configuration files by their extension: .json, .toml, .yaml/.yml,\n// .properties/.cfg/.ini (see the modules of those names).\n//\n//     var settings = config.load(\"app.yaml\")\n//     config.save(settings, \"app.toml\")\n\n// The parsed file.\nmethod load(string file): object {\n    return parse(readText(file), format(file))\n}\n\n// Writes `value` in the format the file's extension names.\nmethod save(object value, string file) {\n    writeFile(file, stringify(value, format(file)))\n}\n\n// \"json\", \"toml\", \"yaml\" or \"properties\" for a file name (\"\" when unknown).\nmethod format(string file): string {\n    var lower = file.toLower()\n    if (lower.endsWith(\".json\")) {\n        return \"json\"\n    }\n    if (lower.endsWith(\".toml\")) {\n        return \"toml\"\n    }\n    if (lower.endsWith(\".yaml\") || lower.endsWith(\".yml\")) {\n        return \"yaml\"\n    }\n    if (lower.endsWith(\".properties\") || lower.endsWith(\".cfg\") || lower.endsWith(\".ini\") || lower.endsWith(\".conf\")) {\n        return \"properties\"\n    }\n    return \"\"\n}\n\nmethod parse(string text, string kind): object {\n    if (kind == \"json\") {\n        return json.parse(text)\n    }\n    if (kind == \"toml\") {\n        return toml.parse(text)\n    }\n    if (kind == \"yaml\" || kind == \"yml\") {\n        return yaml.parse(text)\n    }\n    if (kind == \"properties\" || kind == \"cfg\" || kind == \"ini\") {\n        return properties.parse(text)\n    }\n    raise(\"config: unknown format '\" + kind + \"' (json, toml, yaml, properties)\")\n    return \"\"\n}\n\nmethod stringify(object value, string kind): string {\n    if (kind == \"json\") {\n        return json.pretty(value) + \"\\n\"\n    }\n    if (kind == \"toml\") {\n        return toml.stringify(value)\n    }\n    if (kind == \"yaml\" || kind == \"yml\") {\n        return yaml.stringify(value)\n    }\n    if (kind == \"properties\" || kind == \"cfg\" || kind == \"ini\") {\n        return properties.stringify(value)\n    }\n    raise(\"config: unknown format '\" + kind + \"' (json, toml, yaml, properties)\")\n    return \"\"\n}\n\n// A value by dotted path: get(settings, \"server.port\"); `fallback` when a\n// part of the path is missing.\nmethod get(object value, string path, object fallback): object {\n    var current = value\n    for (part in path.split(\".\")) {\n        if (typeOf(current) == \"map\" && current.has(part)) {\n            current = current[part]\n        } else if (typeOf(current) == \"array\" && part != \"\" && parseInt(part) >= 0 && parseInt(part) < current.length() && \"\" + parseInt(part) == part) {\n            current = current[parseInt(part)]\n        } else {\n            return fallback\n        }\n    }\n    return current\n}\n\nmethod raise(string message) native \"nv_try_raise\"\n\nmethod readText(string file): string {\n    if (fileExists(file) == false) {\n        raise(\"config: cannot open '\" + file + \"'\")\n    }\n    return readFile(file)\n}\n"
    }
    if (name == "crypto") {
        return "package crypto\n\nimport bytes\n\n// Hashes, a block cipher and randomness - raw bytes in, raw bytes out.\n//\n// SHA-1 and MD5 are here because network protocols still ask for them\n// (session digests, version 3 UUIDs). Neither is a safe choice for new\n// designs; do not use them to store passwords.\n\n// 20 raw bytes.\nmethod sha1(string data): string native \"nv_crypto_sha1\"\n\n// SHA-256, as 32 raw bytes.\nmethod sha256(string data): string native \"nv_crypto_sha256\"\n\n// 16 raw bytes.\nmethod md5(string data): string native \"nv_crypto_md5\"\n\n// Cryptographically strong random bytes (/dev/urandom where available).\nmethod random(integer count): string native \"nv_crypto_random\"\n\n// AES-128 in CFB-8: a byte-wise stream cipher. Both key and iv are 16 bytes.\n// The mode keeps a shift register between calls, so one handle per direction\n// of a stream; feed it the bytes in order. Returns a handle, -1 on a bad key.\nmethod cipher(string key, string iv, bool encrypt): integer native \"nv_crypto_cipher_new\"\nmethod update(integer handle, string data): string native \"nv_crypto_cipher_update\"\nmethod release(integer handle) native \"nv_crypto_cipher_free\"\n\n// The digest some session services expect: SHA-1 read as a signed big endian\n// number, printed in hex, negatives as \"-\" and the two's complement.\nmethod signedHexDigest(string data): string native \"nv_crypto_mc_digest\"\n\n// RSA.\n//\n// generate() makes a key pair and returns a handle; it looks for two random\n// primes, so it takes a moment and belongs at startup, not in a request.\n// publicDer() hands out the public key as a DER SubjectPublicKeyInfo, which\n// is the form a peer expects to be given. decrypt() undoes PKCS#1 v1.5\n// padding and returns \"\" when the block is not well formed.\nmethod rsaGenerate(integer bits): integer native \"nv_crypto_rsa_generate\"\nmethod rsaPublicDer(integer handle): string native \"nv_crypto_rsa_public_der\"\nmethod rsaDecrypt(integer handle, string data): string native \"nv_crypto_rsa_decrypt\"\nmethod rsaEncrypt(integer handle, string data): string native \"nv_crypto_rsa_encrypt\"\nmethod rsaRelease(integer handle) native \"nv_crypto_rsa_free\"\n\n// \"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\" of 16 raw bytes.\nmethod uuidText(string raw): string native \"nv_crypto_uuid_text\"\n\n// Lower case hex of a digest.\nmethod hex(string data): string {\n    return bytes.hex(data)\n}\n\n// A version 3 (MD5) UUID of `name` in `namespace`, as 16 raw bytes.\nmethod uuid3(string namespace, string name): string {\n    var digest = md5(namespace + name)\n    var version = 0x30 + (bytes.u8(digest, 6) % 16)\n    var variant = 0x80 + (bytes.u8(digest, 8) % 64)\n    return bytes.slice(digest, 0, 6) + bytes.putU8(version) + bytes.slice(digest, 7, 8) + bytes.putU8(variant) + bytes.slice(digest, 9, 16)\n}\n\n// A random version 4 UUID as 16 raw bytes.\nmethod uuid4(): string {\n    var raw = random(16)\n    var version = 0x40 + (bytes.u8(raw, 6) % 16)\n    var variant = 0x80 + (bytes.u8(raw, 8) % 64)\n    return bytes.slice(raw, 0, 6) + bytes.putU8(version) + bytes.slice(raw, 7, 8) + bytes.putU8(variant) + bytes.slice(raw, 9, 16)\n}\n"
    }
    if (name == "csv") {
        return "package csv\n\n// Comma separated values with quoting (\"\" inside quoted fields).\n\nmethod parse(string text): array<object> {\n    return parseWith(text, \",\")\n}\n\nmethod parseWith(string text, string separator): array<object> {\n    var rows = []\n    var row = []\n    var field = \"\"\n    var quoted = false\n    var i = 0\n    var n = text.length()\n    while (i < n) {\n        var c = text.charAt(i)\n        if (quoted) {\n            if (c == \"\\\"\" && i + 1 < n && text.charAt(i + 1) == \"\\\"\") {\n                field = field + \"\\\"\"\n                i = i + 2\n                continue\n            }\n            if (c == \"\\\"\") {\n                quoted = false\n                i = i + 1\n                continue\n            }\n            field = field + c\n            i = i + 1\n            continue\n        }\n        if (c == \"\\\"\") {\n            quoted = true\n            i = i + 1\n            continue\n        }\n        if (c == separator) {\n            row.append(field)\n            field = \"\"\n            i = i + 1\n            continue\n        }\n        if (c == \"\\n\" || c == \"\\r\") {\n            if (c == \"\\r\" && i + 1 < n && text.charAt(i + 1) == \"\\n\") {\n                i = i + 1\n            }\n            row.append(field)\n            rows.append(row)\n            row = []\n            field = \"\"\n            i = i + 1\n            continue\n        }\n        field = field + c\n        i = i + 1\n    }\n    if (field != \"\" || row.length() > 0) {\n        row.append(field)\n        rows.append(row)\n    }\n    return rows\n}\n\nmethod stringify(array<object> rows): string {\n    return stringifyWith(rows, \",\")\n}\n\nmethod stringifyWith(array<object> rows, string separator): string {\n    var lines = []\n    for (row in rows) {\n        var fields = []\n        for (value in row) {\n            fields.append(quote(\"\" + value, separator))\n        }\n        lines.append(fields.join(separator))\n    }\n    return lines.join(\"\\n\")\n}\n\nmethod quote(string value, string separator): string {\n    if (value.contains(separator) || value.contains(\"\\\"\") || value.contains(\"\\n\")) {\n        return \"\\\"\" + value.replace(\"\\\"\", \"\\\"\\\"\") + \"\\\"\"\n    }\n    return value\n}\n"
    }
    if (name == "fmt") {
        return "package fmt\n\nimport math\nimport strings\n\n// Human friendly formatting of numbers and sizes.\n\nmethod fixed(float x, integer decimals): string native \"nv_fmt_fixed\"   // \"3.14\"\n\n// 1234567 -> \"1,234,567\"\nmethod thousands(integer n): string {\n    var digits = \"\" + math.abs(n)\n    var out = \"\"\n    var i = digits.length()\n    while (i > 0) {\n        var start = i - 3\n        if (start < 0) {\n            start = 0\n        }\n        var group = digits.substring(start, i)\n        if (out == \"\") {\n            out = group\n        }\n        if (out != group) {\n            out = group + \",\" + out\n        }\n        i = start\n    }\n    if (n < 0) {\n        return \"-\" + out\n    }\n    return out\n}\n\n// 1536 -> \"1.5 KB\"\nmethod bytes(integer n): string {\n    if (n < 1024) {\n        return \"" + chr(36) + "{n} B\"\n    }\n    var units = [\"KB\", \"MB\", \"GB\", \"TB\"]\n    var value = math.toFloat(n)\n    var unit = \"\"\n    for (u in units) {\n        value = value / 1024.0\n        unit = u\n        if (value < 1024.0) {\n            break\n        }\n    }\n    return fixed(value, 1) + \" \" + unit\n}\n\n// 0.256 -> \"25.6%\"\nmethod percent(float ratio, integer decimals): string {\n    return fixed(ratio * 100.0, decimals) + \"%\"\n}\n\n// Two-column table: rows of [label, value].\nmethod table(array<object> rows): string {\n    var width = 0\n    for (row in rows) {\n        var label = \"\" + row[0]\n        if (label.length() > width) {\n            width = label.length()\n        }\n    }\n    var lines = []\n    for (row in rows) {\n        lines.append(strings.padRight(\"\" + row[0], width) + \"  \" + row[1])\n    }\n    return lines.join(\"\\n\")\n}\n"
    }
    if (name == "hash") {
        return "package hash\n\n// Non-cryptographic hashes.\n\nmethod fnv1a(string text): integer native \"nv_hash_fnv1a\"   // 64-bit FNV-1a, always >= 0\nmethod crc32(string text): integer native \"nv_hash_crc32\"\n\n// Stable small hash for bucketing: 0 .. buckets-1\nmethod bucket(string text, integer buckets): integer {\n    return fnv1a(text) % buckets\n}\n\n// Hex string of a hash value.\nmethod hex(integer value): string {\n    var digits = \"0123456789abcdef\"\n    var out = \"\"\n    var v = value\n    if (v == 0) {\n        return \"0\"\n    }\n    while (v > 0) {\n        out = digits.charAt(v % 16) + out\n        v = v / 16\n    }\n    return out\n}\n"
    }
    if (name == "http") {
        return "package http\n\nimport json\n\n// HTTP client driven by the curl command line tool (https included).\n// get/post/put/delete return the body and abort on transport errors;\n// request never aborts and returns {status, ok, body, headers, error}.\n\nmethod get(string url): string native \"nv_http_get\"\nmethod post(string url, object body): string native \"nv_http_post\"     // maps/arrays are sent as JSON\nmethod put(string url, object body): string native \"nv_http_put\"\nmethod delete(string url): string native \"nv_http_delete\"\nmethod request(string verb, string url, object body, map<string, string> headers): map<string, object> native \"nv_http_request\"\nmethod download(string url, string file): bool native \"nv_http_download\"\n\n// GET that parses the response as JSON.\nmethod getJson(string url): object {\n    return json.parse(get(url))\n}\n\n// POST with a JSON body, parsing the JSON response.\nmethod postJson(string url, object body): object {\n    return json.parse(post(url, body))\n}\n"
    }
    if (name == "io") {
        return "package io\n\n// Standard input and output.\n\nmethod readLine(): string native \"nv_read_line\"\nmethod readAll(): string native \"nv_read_all\"          // everything from stdin\nmethod write(string text) native \"nv_io_write\"          // stdout without newline\nmethod writeErr(string text) native \"nv_io_write_err\"   // stderr without newline\nmethod flush() native \"nv_io_flush\"\n\nmethod readLines(): array<string> {\n    var out = []\n    for (line in readAll().replace(\"\\r\\n\", \"\\n\").split(\"\\n\")) {\n        out.append(line)\n    }\n    if (out.length() > 0 && out[out.length() - 1] == \"\") {\n        out.pop()\n    }\n    return out\n}\n\n// Asks a question on stdout and reads the answer.\nmethod prompt(string question): string {\n    write(question)\n    flush()\n    return readLine()\n}\n"
    }
    if (name == "json") {
        return "package json\n\n// JSON: text <-> maps, arrays, primitives (objects serialize their fields).\n\nmethod stringify(object value): string native \"nv_json_stringify\"\nmethod pretty(object value): string native \"nv_json_pretty\"          // 2-space indented\nmethod parse(string text): object native \"nv_json_parse\"             // aborts on invalid input\nmethod isValid(string text): bool native \"nv_json_is_valid\"\nmethod load(string file): object native \"nv_json_load\"\nmethod save(object value, string dir, string file) native \"nv_json_save\"  // creates dir, pretty printed\n\n// Parses text, or returns `fallback` when it is not valid JSON.\nmethod parseOr(string text, object fallback): object {\n    if (isValid(text)) {\n        return parse(text)\n    }\n    return fallback\n}\n"
    }
    if (name == "log") {
        return "package log\n\nimport strings\nimport time\n\n// Leveled logging to stderr: debug < info < warn < error.\n\nvar minimumLevel = 1\nvar showTime = true\n\nmethod setLevel(string level) {\n    minimumLevel = levelValue(level)\n}\n\nmethod setTimestamps(bool enabled) {\n    showTime = enabled\n}\n\nmethod debug(string message) {\n    write(0, \"DEBUG\", message)\n}\n\nmethod info(string message) {\n    write(1, \"INFO\", message)\n}\n\nmethod warn(string message) {\n    write(2, \"WARN\", message)\n}\n\nmethod error(string message) {\n    write(3, \"ERROR\", message)\n}\n\nmethod levelValue(string level): integer {\n    var levels = { \"debug\": 0, \"info\": 1, \"warn\": 2, \"error\": 3 }\n    if (levels.has(level.toLower())) {\n        return levels[level.toLower()]\n    }\n    return 1\n}\n\nmethod write(integer level, string name, string message) {\n    if (level < minimumLevel) {\n        return\n    }\n    var prefix = \"\"\n    if (showTime) {\n        prefix = time.nowIso() + \" \"\n    }\n    eprintln prefix + strings.padRight(name, 5) + \" \" + message\n}\n"
    }
    if (name == "maps") {
        return "package maps\n\n// Map helpers beyond the builtin methods (length, has, keys, values, remove, get).\n\n// Copies `b` over `a` into a new map.\nmethod merge(map<string, object> a, map<string, object> b): map<string, object> {\n    var out = {}\n    for (k in a) {\n        out[k] = a[k]\n    }\n    for (k in b) {\n        out[k] = b[k]\n    }\n    return out\n}\n\nmethod fromPairs(array<string> keys, array<object> values): map<string, object> {\n    var out = {}\n    var i = 0\n    while (i < keys.length() && i < values.length()) {\n        out[keys[i]] = values[i]\n        i = i + 1\n    }\n    return out\n}\n\n// Swaps keys and values (values become string keys).\nmethod invert(map<string, object> m): map<string, string> {\n    var out = {}\n    for (k in m) {\n        out[\"\" + m[k]] = k\n    }\n    return out\n}\n\nmethod copy(map<string, object> m): map<string, object> {\n    return merge({}, m)\n}\n\nmethod isEmpty(map<string, object> m): bool {\n    return m.length() == 0\n}\n\n// Entries as [key, value] pairs in key order.\nmethod entries(map<string, object> m): array<object> {\n    var out = []\n    for (k in m) {\n        out.append([k, m[k]])\n    }\n    return out\n}\n\n// Counts how often each element occurs.\nmethod countValues(array<object> items): map<string, integer> {\n    var out = {}\n    for (x in items) {\n        var key = \"\" + x\n        if (out.has(key)) {\n            out[key] = out[key] + 1\n            continue\n        }\n        out[key] = 1\n    }\n    return out\n}\n"
    }
    if (name == "math") {
        return "package math\n\n// Numbers: integer and float helpers plus the usual functions.\n\nmethod sqrt(float x): float native \"nv_math_sqrt\"\nmethod pow(float base, float exponent): float native \"nv_math_pow\"\nmethod floor(float x): integer native \"nv_math_floor\"\n\n// The nearest value a 32 bit float holds. Novus numbers are 64 bit; this is\n// for arithmetic that has to come out the way a 32 bit one would - a wire\n// format, or another implementation whose floats are single precision.\nmethod toFloat32(float x): float native \"nv_math_to_float32\"\nmethod ceil(float x): integer native \"nv_math_ceil\"\nmethod round(float x): integer native \"nv_math_round\"\nmethod sin(float x): float native \"nv_math_sin\"\nmethod cos(float x): float native \"nv_math_cos\"\nmethod tan(float x): float native \"nv_math_tan\"\nmethod atan2(float y, float x): float native \"nv_math_atan2\"\nmethod log(float x): float native \"nv_math_log\"\nmethod exp(float x): float native \"nv_math_exp\"\nmethod toFloat(object x): float native \"nv_parse_float\"\nmethod toInt(object x): integer native \"nv_parse_int\"\n\nmethod pi(): float {\n    return 3.141592653589793\n}\n\nmethod abs(object x): object {\n    if (x < 0) {\n        return 0 - x\n    }\n    return x\n}\n\nmethod min(object a, object b): object {\n    if (a < b) {\n        return a\n    }\n    return b\n}\n\nmethod max(object a, object b): object {\n    if (a > b) {\n        return a\n    }\n    return b\n}\n\nmethod clamp(object x, object low, object high): object {\n    return max(low, min(x, high))\n}\n\nmethod sign(object x): integer {\n    if (x < 0) {\n        return -1\n    }\n    if (x > 0) {\n        return 1\n    }\n    return 0\n}\n\nmethod isEven(integer n): bool {\n    return n % 2 == 0\n}\n\nmethod isOdd(integer n): bool {\n    return n % 2 != 0\n}\n\nmethod gcd(integer a, integer b): integer {\n    var x = abs(a)\n    var y = abs(b)\n    while (y != 0) {\n        var t = y\n        y = x % y\n        x = t\n    }\n    return x\n}\n\nmethod lcm(integer a, integer b): integer {\n    if (a == 0 || b == 0) {\n        return 0\n    }\n    return abs(a * b) / gcd(a, b)\n}\n\n// Integer power (exponent >= 0).\nmethod powInt(integer base, integer exponent): integer {\n    var result = 1\n    var i = 0\n    while (i < exponent) {\n        result = result * base\n        i = i + 1\n    }\n    return result\n}\n\nmethod isPrime(integer n): bool {\n    if (n < 2) {\n        return false\n    }\n    var i = 2\n    while (i * i <= n) {\n        if (n % i == 0) {\n            return false\n        }\n        i = i + 1\n    }\n    return true\n}\n\n// Rounds a float to `decimals` places.\nmethod roundTo(float x, integer decimals): float {\n    var factor = pow(10.0, toFloat(decimals))\n    return toFloat(round(x * factor)) / factor\n}\n"
    }
    if (name == "net") {
        return "package net\n\nimport strings\n\n// TCP sockets.\n//\n// Sockets are non-blocking and are driven by poll(): one loop serves every\n// connection, which is what a program with a tick or frame loop wants. A\n// socket is an integer handle; -1 means the call produced none.\n//\n// A method cannot return a value and an error at once, so every call records\n// what happened and status() reports it:\n//   0  ok      - the call did what it says       (net.ok())\n//   1  again   - nothing was ready, not an error  (net.again())\n//   2  closed  - the peer hung up                 (net.closed())\n//   3  error   - see net.error() for the message  (net.failed())\n\n// Binds host:port and starts listening. \"\" or \"0.0.0.0\" as host takes every\n// interface. Returns the socket, or -1 (status ERROR).\nmethod listen(string host, integer port): integer native \"nv_net_listen\"\n\n// The next waiting connection, or -1 with status AGAIN when there is none.\nmethod accept(integer server): integer native \"nv_net_accept\"\n\n// Connects to host:port. Returns the socket, or -1 (status ERROR).\nmethod connect(string host, integer port): integer native \"nv_net_connect\"\n\n// Up to `max` bytes. An empty result with status AGAIN means nothing was\n// ready; with status CLOSED it means the peer is gone.\nmethod recv(integer socket, integer max): string native \"nv_net_recv\"\n\n// The number of bytes the kernel took, which may be fewer than offered: keep\n// the remainder and send it when the socket is writable again.\nmethod send(integer socket, string data): integer native \"nv_net_send\"\n\nmethod close(integer socket) native \"nv_net_close\"\n\n// The subset of `sockets` that can be read without blocking. A timeout of 0\n// polls, -1 waits indefinitely.\nmethod poll(array<integer> sockets, integer timeoutMs): array<integer> native \"nv_net_poll\"\n\n// The subset that can be written to - use it to drain a backed up send\n// buffer instead of spinning on it.\nmethod pollWrite(array<integer> sockets, integer timeoutMs): array<integer> native \"nv_net_poll_write\"\n\nmethod status(): integer native \"nv_net_status\"\nmethod error(): string native \"nv_net_error\"\n\n// \"1.2.3.4:56789\" of the connected peer, \"\" when it cannot be determined.\nmethod peer(integer socket): string native \"nv_net_peer\"\n\nmethod ok(): bool {\n    return status() == 0\n}\n\n// Whether the last call found nothing ready (not an error).\nmethod again(): bool {\n    return status() == 1\n}\n\nmethod closed(): bool {\n    return status() == 2\n}\n\nmethod failed(): bool {\n    return status() == 3\n}\n\n// The address part of peer(), without the port.\nmethod peerHost(integer socket): string {\n    var address = peer(socket)\n    var colon = strings.lastIndexOf(address, \":\")\n    if (colon < 0) {\n        return address\n    }\n    return address.substring(0, colon)\n}\n\n// Sends everything that fits right now and returns what is left over.\nmethod sendSome(integer socket, string data): string {\n    var written = send(socket, data)\n    if (written >= data.length()) {\n        return \"\"\n    }\n    return data.substring(written, data.length())\n}\n"
    }
    if (name == "os") {
        return "package os\n\n// Operating system: files, directories, processes, environment, time.\n// Functions marked `native` are implemented by the C runtime.\n\nmethod mkdir(string path): bool native \"nv_os_mkdir\"           // creates missing parents\nmethod rmdir(string path): bool native \"nv_os_rmdir\"           // removes an empty directory\nmethod remove(string path): bool native \"nv_remove_file\"       // deletes a file\nmethod removeAll(string path): bool native \"nv_os_remove_all\"  // deletes a file or directory tree\nmethod listDir(string path): array<string> native \"nv_os_list_dir\"\nmethod exists(string path): bool native \"nv_path_exists\"\nmethod isDir(string path): bool native \"nv_os_is_dir\"\nmethod isFile(string path): bool native \"nv_os_is_file\"\nmethod rename(string from, string to): bool native \"nv_os_rename\"\nmethod copy(string from, string to): bool native \"nv_os_copy\"\nmethod fileSize(string path): integer native \"nv_os_file_size\"   // -1 when missing\nmethod modified(string path): integer native \"nv_os_modified\"    // unix seconds, -1 when missing\nmethod readFile(string path): string native \"nv_read_file\"\nmethod writeFile(string path, string content) native \"nv_write_file\"\nmethod appendFile(string path, string content) native \"nv_append_file\"\nmethod cwd(): string native \"nv_path_absolute\"\nmethod chdir(string path): bool native \"nv_os_chdir\"\nmethod temp(): string native \"nv_path_temp\"\nmethod home(): string native \"nv_os_home\"\nmethod exec(string command): integer native \"nv_exec\"           // exit code\nmethod output(string command): string native \"nv_os_output\"     // captured stdout\nmethod env(string name): string native \"nv_env\"\nmethod setEnv(string name, string value): bool native \"nv_os_set_env\"\nmethod exit(integer code) native \"nv_exit\"\nmethod platform(): string native \"nv_platform\"                  // linux | macos | windows | unix\nmethod args(): array<string> native \"nv_args\"\nmethod pid(): integer native \"nv_os_pid\"\nmethod time(): integer native \"nv_os_time\"                      // unix seconds\nmethod clock(): float native \"nv_os_clock\"                      // seconds, sub-second precision\nmethod sleep(integer milliseconds) native \"nv_os_sleep\"\nmethod readLine(): string native \"nv_read_line\"\n\n// Interrupts. catchInterrupt() asks the operating system to raise a flag when\n// the program is asked to stop - ctrl-C, or a terminate signal - instead of\n// killing it outright; interrupted() reads that flag and clears it. A program\n// with something worth writing out checks it in its main loop and shuts down\n// on its own terms.\nmethod catchInterrupt() native \"nv_os_catch_interrupt\"\nmethod interrupted(): bool native \"nv_os_interrupted\"\n\n// Whether a command is available on this system.\nmethod hasCommand(string name): bool {\n    if (platform() == \"windows\") {\n        return exec(\"where \" + name + \" > nul 2>&1\") == 0\n    }\n    return exec(\"command -v \" + name + \" > /dev/null 2>&1\") == 0\n}\n\n// Environment variable or a fallback when unset.\nmethod envOr(string name, string fallback): string {\n    var value = env(name)\n    if (value == \"\") {\n        return fallback\n    }\n    return value\n}\n"
    }
    if (name == "path") {
        return "package path\n\n// File system paths (pure string handling, forward slashes everywhere).\n\nmethod join(string parts): string native \"nv_path_join\" variadic\nmethod absolute(): string native \"nv_path_absolute\"             // the working directory\nmethod absolute(string path): string native \"nv_path_absolute_of\"\nmethod normalize(string path): string native \"nv_path_normalize\"\nmethod relative(string base, string target): string native \"nv_path_relative\"\nmethod dirname(string path): string native \"nv_path_dirname\"\nmethod basename(string path): string native \"nv_path_basename\"\nmethod stem(string path): string native \"nv_path_stem\"            // basename without extension\nmethod extension(string path): string native \"nv_path_extension\"  // \".txt\", \"\" when none\nmethod isAbsolute(string path): bool native \"nv_path_is_absolute\"\nmethod exists(string path): bool native \"nv_path_exists\"\nmethod isDir(string path): bool native \"nv_os_is_dir\"\nmethod isFile(string path): bool native \"nv_os_is_file\"\nmethod temp(): string native \"nv_path_temp\"\nmethod separator(): string native \"nv_path_separator\"\n\n// \"a/b/c.txt\" with a new extension: withExtension(\"a/b/c.txt\", \".md\")\nmethod withExtension(string p, string ext): string {\n    var current = extension(p)\n    return p.substring(0, p.length() - current.length()) + ext\n}\n\n// The path segments: \"a/b/c\" -> [a, b, c]\nmethod segments(string p): array<string> {\n    var out = []\n    for (s in normalize(p).split(\"/\")) {\n        if (s != \"\") {\n            out.append(s)\n        }\n    }\n    return out\n}\n"
    }
    if (name == "properties") {
        return "package properties\n\n// .properties and .cfg files: key = value lines.\n//\n//     var settings = properties.load(\"app.properties\")\n//     println settings[\"db.url\"]\n//\n// The Java format: `key=value`, `key: value` or `key value`; comments start\n// with # or ! (and ; as in .cfg/.ini files); a line ending in a backslash\n// continues on the next one; \\t \\n \\r \\f \\\\ and \\uXXXX are escapes. A\n// `[section]` header, as .cfg and .ini files have, prefixes the keys after\n// it: `port` below `[server]` is \"server.port\" - sections() groups them\n// instead. Values are always strings.\n\nmethod parse(string text): map<string, string> {\n    var out = {}\n    var section = \"\"\n    for (entry in entries(text)) {\n        if (entry[0] == \"section\") {\n            section = entry[1]\n            continue\n        }\n        var key = entry[1]\n        if (section != \"\") {\n            key = section + \".\" + key\n        }\n        out[key] = entry[2]\n    }\n    return out\n}\n\n// section -> key -> value; keys before the first [section] are under \"\".\nmethod sections(string text): map<string, map<string, string>> {\n    var out = {}\n    var section = \"\"\n    for (entry in entries(text)) {\n        if (entry[0] == \"section\") {\n            section = entry[1]\n            if (out.has(section) == false) {\n                out[section] = {}\n            }\n            continue\n        }\n        if (out.has(section) == false) {\n            out[section] = {}\n        }\n        out[section][entry[1]] = entry[2]\n    }\n    return out\n}\n\nmethod load(string file): map<string, string> {\n    return parse(readText(file))\n}\n\nmethod loadSections(string file): map<string, map<string, string>> {\n    return sections(readText(file))\n}\n\nmethod save(map<string, object> values, string file) {\n    writeFile(file, stringify(values))\n}\n\n// key=value lines (keys in order). Nested maps are written with dotted keys.\nmethod stringify(map<string, object> values): string {\n    var out = []\n    writeFlat(values, \"\", out)\n    return out.join(\"\")\n}\n\n// [section] blocks: section -> key -> value (\"\" for keys without a section).\nmethod stringifySections(map<string, object> sections): string {\n    var out = []\n    if (sections.has(\"\")) {\n        writeFlat(sections[\"\"], \"\", out)\n    }\n    for (name in sections) {\n        if (name == \"\") {\n            continue\n        }\n        if (out.length() > 0) {\n            out.append(\"\\n\")\n        }\n        out.append(\"[\" + name + \"]\\n\")\n        writeFlat(sections[name], \"\", out)\n    }\n    return out.join(\"\")\n}\n\nmethod raise(string message) native \"nv_try_raise\"\n\nmethod readText(string file): string {\n    if (fileExists(file) == false) {\n        raise(\"properties: cannot open '\" + file + \"'\")\n    }\n    return readFile(file)\n}\n\nmethod writeFlat(map<string, object> values, string prefix, array<string> out): integer {\n    for (key in values) {\n        var full = key\n        if (prefix != \"\") {\n            full = prefix + \".\" + key\n        }\n        var v = values[key]\n        if (typeOf(v) == \"map\") {\n            writeFlat(v, full, out)\n        } else {\n            var text = \"\"\n            if (typeOf(v) != \"unknown\") {\n                text = \"\" + v\n            }\n            out.append(escapeText(full, true) + \"=\" + escapeText(text, false) + \"\\n\")\n        }\n    }\n    return 0\n}\n\nmethod escapeText(string s, bool isKey): string {\n    var out = []\n    var i = 0\n    while (i < s.length()) {\n        var c = s.charAt(i)\n        if (c == \"\\\\\") {\n            out.append(\"\\\\\\\\\")\n        } else if (c == \"\\n\") {\n            out.append(\"\\\\n\")\n        } else if (c == \"\\r\") {\n            out.append(\"\\\\r\")\n        } else if (c == \"\\t\") {\n            out.append(\"\\\\t\")\n        } else if (isKey && (c == \"=\" || c == \":\" || c == \" \" || c == \"#\" || c == \"!\")) {\n            out.append(\"\\\\\" + c)\n        } else if (isKey == false && i == 0 && c == \" \") {\n            out.append(\"\\\\ \")\n        } else {\n            out.append(c)\n        }\n        i = i + 1\n    }\n    return out.join(\"\")\n}\n\n// The logical lines as [\"section\", name] and [\"pair\", key, value].\nmethod entries(string text): array<object> {\n    var out = []\n    var lines = text.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\").split(\"\\n\")\n    var i = 0\n    while (i < lines.length()) {\n        var line = trimStart(lines[i])\n        i = i + 1\n        if (line == \"\" || line.startsWith(\"#\") || line.startsWith(\"!\") || line.startsWith(\";\")) {\n            continue\n        }\n        // a backslash at the end continues the line (an even number of them\n        // are escaped backslashes)\n        while (endsInContinuation(line) && i < lines.length()) {\n            line = line.substring(0, line.length() - 1) + trimStart(lines[i])\n            i = i + 1\n        }\n        if (endsInContinuation(line)) {\n            line = line.substring(0, line.length() - 1)\n        }\n        var trimmed = line.trim()\n        if (trimmed.startsWith(\"[\") && trimmed.endsWith(\"]\")) {\n            out.append([\"section\", trimmed.substring(1, trimmed.length() - 1).trim()])\n            continue\n        }\n        var split = separator(line)\n        var key = line\n        var value = \"\"\n        if (split >= 0) {\n            key = line.substring(0, split)\n            var rest = split + 1\n            // \"key = value\": the separator may be surrounded by spaces\n            if (line.charAt(split) == \" \" || line.charAt(split) == \"\\t\") {\n                while (rest < line.length() && (line.charAt(rest) == \" \" || line.charAt(rest) == \"\\t\")) {\n                    rest = rest + 1\n                }\n                if (rest < line.length() && (line.charAt(rest) == \"=\" || line.charAt(rest) == \":\")) {\n                    rest = rest + 1\n                }\n            }\n            value = trimStart(line.substring(rest, line.length()))\n        }\n        out.append([\"pair\", unescape(key.trim()), unescape(value)])\n    }\n    return out\n}\n\nmethod trimStart(string s): string {\n    var i = 0\n    while (i < s.length() && (s.charAt(i) == \" \" || s.charAt(i) == \"\\t\" || s.charAt(i) == chr(12))) {\n        i = i + 1\n    }\n    return s.substring(i, s.length())\n}\n\nmethod endsInContinuation(string line): bool {\n    var count = 0\n    var i = line.length() - 1\n    while (i >= 0 && line.charAt(i) == \"\\\\\") {\n        count = count + 1\n        i = i - 1\n    }\n    return count % 2 == 1\n}\n\n// Index of the first unescaped '=', ':' or whitespace, -1 if none.\nmethod separator(string line): integer {\n    var i = 0\n    while (i < line.length()) {\n        var c = line.charAt(i)\n        if (c == \"\\\\\") {\n            i = i + 2\n            continue\n        }\n        if (c == \"=\" || c == \":\" || c == \" \" || c == \"\\t\") {\n            return i\n        }\n        i = i + 1\n    }\n    return 0 - 1\n}\n\nmethod unescape(string s): string {\n    if (s.contains(\"\\\\\") == false) {\n        return s\n    }\n    var out = []\n    var i = 0\n    while (i < s.length()) {\n        var c = s.charAt(i)\n        if (c != \"\\\\\" || i + 1 >= s.length()) {\n            out.append(c)\n            i = i + 1\n            continue\n        }\n        var e = s.charAt(i + 1)\n        i = i + 2\n        if (e == \"t\") {\n            out.append(\"\\t\")\n        } else if (e == \"n\") {\n            out.append(\"\\n\")\n        } else if (e == \"r\") {\n            out.append(\"\\r\")\n        } else if (e == \"f\") {\n            out.append(chr(12))\n        } else if (e == \"u\" && i + 4 <= s.length()) {\n            out.append(utf8(hexValue(s.substring(i, i + 4))))\n            i = i + 4\n        } else {\n            out.append(e)\n        }\n    }\n    return out.join(\"\")\n}\n\nmethod hexValue(string s): integer {\n    var n = 0\n    var i = 0\n    while (i < s.length()) {\n        var c = s.charAt(i)\n        var d = 0\n        if (c >= \"0\" && c <= \"9\") {\n            d = ord(c) - ord(\"0\")\n        } else if (c >= \"a\" && c <= \"f\") {\n            d = ord(c) - ord(\"a\") + 10\n        } else if (c >= \"A\" && c <= \"F\") {\n            d = ord(c) - ord(\"A\") + 10\n        }\n        n = n * 16 + d\n        i = i + 1\n    }\n    return n\n}\n\n// The UTF-8 bytes of a code point.\nmethod utf8(integer code): string {\n    if (code < 128) {\n        return chr(code)\n    }\n    if (code < 2048) {\n        return chr(192 + code / 64) + chr(128 + code % 64)\n    }\n    return chr(224 + code / 4096) + chr(128 + (code / 64) % 64) + chr(128 + code % 64)\n}\n"
    }
    if (name == "random") {
        return "package random\n\nimport arrays\nimport math\n\n// Pseudo random numbers (xorshift, seeded from the clock unless seed() is called).\n\nmethod seed(integer value) native \"nv_random_seed\"\nmethod next(): integer native \"nv_random_next\"     // 0 .. 2^62-1\n\n// Integer in [low, high].\nmethod int(integer low, integer high): integer {\n    if (high <= low) {\n        return low\n    }\n    return low + next() % (high - low + 1)\n}\n\n// Float in [0, 1).\nmethod float(): float {\n    return math.toFloat(next() % 1000000000) / 1000000000.0\n}\n\nmethod bool(): bool {\n    return next() % 2 == 0\n}\n\nmethod pick(array<object> items): object {\n    return items[int(0, items.length() - 1)]\n}\n\n// A shuffled copy (Fisher-Yates).\nmethod shuffle(array<object> items): array<object> {\n    var out = arrays.copy(items)\n    var i = out.length() - 1\n    while (i > 0) {\n        var j = int(0, i)\n        var t = out[i]\n        out[i] = out[j]\n        out[j] = t\n        i = i - 1\n    }\n    return out\n}\n\n// Random string of `length` characters from `alphabet`.\nmethod string(integer length, string alphabet): string {\n    var out = \"\"\n    var i = 0\n    while (i < length) {\n        out = out + alphabet.charAt(int(0, alphabet.length() - 1))\n        i = i + 1\n    }\n    return out\n}\n"
    }
    if (name == "strings") {
        return "package strings\n\n// String helpers beyond the builtin methods (length, charAt, substring,\n// indexOf, contains, startsWith, endsWith, split, replace, trim, toUpper,\n// toLower).\n\nmethod repeat(string s, integer times): string {\n    var out = \"\"\n    var i = 0\n    while (i < times) {\n        out = out + s\n        i = i + 1\n    }\n    return out\n}\n\nmethod padLeft(string s, integer width): string {\n    return padLeftWith(s, width, \" \")\n}\n\nmethod padRight(string s, integer width): string {\n    return padRightWith(s, width, \" \")\n}\n\nmethod padLeftWith(string s, integer width, string fill): string {\n    var out = s\n    while (out.length() < width) {\n        out = fill + out\n    }\n    return out\n}\n\nmethod padRightWith(string s, integer width, string fill): string {\n    var out = s\n    while (out.length() < width) {\n        out = out + fill\n    }\n    return out\n}\n\nmethod reverse(string s): string {\n    var out = \"\"\n    var i = s.length()\n    while (i > 0) {\n        out = out + s.charAt(i - 1)\n        i = i - 1\n    }\n    return out\n}\n\nmethod lines(string s): array<string> {\n    return s.replace(\"\\r\\n\", \"\\n\").split(\"\\n\")\n}\n\n// Words separated by any run of whitespace.\nmethod words(string s): array<string> native \"nv_str_words\"\n\nmethod count(string s, string sub): integer {\n    if (sub == \"\") {\n        return 0\n    }\n    var n = 0\n    var at = s.indexOf(sub)\n    while (at >= 0) {\n        n = n + 1\n        at = s.indexOf(sub, at + sub.length())\n    }\n    return n\n}\n\nmethod lastIndexOf(string s, string sub): integer {\n    var last = -1\n    var at = s.indexOf(sub)\n    while (at >= 0) {\n        last = at\n        at = s.indexOf(sub, at + 1)\n    }\n    return last\n}\n\nmethod capitalize(string s): string {\n    if (s == \"\") {\n        return s\n    }\n    return s.charAt(0).toUpper() + s.substring(1, s.length())\n}\n\nmethod isDigit(string c): bool {\n    return c >= \"0\" && c <= \"9\"\n}\n\nmethod isAlpha(string c): bool {\n    return (c >= \"a\" && c <= \"z\") || (c >= \"A\" && c <= \"Z\")\n}\n\nmethod isSpace(string c): bool {\n    return c == \" \" || c == \"\\t\" || c == \"\\n\" || c == \"\\r\"\n}\n\nmethod isNumeric(string s): bool {\n    if (s == \"\") {\n        return false\n    }\n    var i = 0\n    if (s.charAt(0) == \"-\") {\n        i = 1\n    }\n    if (i >= s.length()) {\n        return false\n    }\n    while (i < s.length()) {\n        if (isDigit(s.charAt(i)) == false) {\n            return false\n        }\n        i = i + 1\n    }\n    return true\n}\n\nmethod chars(string s): array<string> {\n    return s.split(\"\")\n}\n\n// Removes `prefix` when present.\nmethod stripPrefix(string s, string prefix): string {\n    if (s.startsWith(prefix)) {\n        return s.substring(prefix.length(), s.length())\n    }\n    return s\n}\n\nmethod stripSuffix(string s, string suffix): string {\n    if (suffix != \"\" && s.endsWith(suffix)) {\n        return s.substring(0, s.length() - suffix.length())\n    }\n    return s\n}\n\n// Shortens to `width` characters, ending with \"...\" when cut.\nmethod truncate(string s, integer width): string {\n    if (s.length() <= width) {\n        return s\n    }\n    if (width <= 3) {\n        return s.substring(0, width)\n    }\n    return s.substring(0, width - 3) + \"...\"\n}\n\nmethod compare(string a, string b): integer {\n    if (a < b) {\n        return -1\n    }\n    if (a > b) {\n        return 1\n    }\n    return 0\n}\n"
    }
    if (name == "test") {
        return "package test\n\n// Minimal test helpers: assertions count failures, report() prints a\n// summary and returns the exit code.\n\nvar passed = 0\nvar failed = 0\n\nmethod assert(bool condition, string name) {\n    if (condition) {\n        passed = passed + 1\n        return\n    }\n    failed = failed + 1\n    eprintln \"FAIL \" + name\n}\n\nmethod assertEqual(object actual, object expected, string name) {\n    if (actual == expected) {\n        passed = passed + 1\n        return\n    }\n    failed = failed + 1\n    eprintln \"FAIL \" + name + \": expected \" + expected + \" but got \" + actual\n}\n\nmethod report(): integer {\n    println \"" + chr(36) + "{passed} passed, " + chr(36) + "{failed} failed\"\n    if (failed > 0) {\n        return 1\n    }\n    return 0\n}\n"
    }
    if (name == "thread") {
        return "package thread\n\n// Threads, virtual threads, and the things they share.\n//\n// `thread f(...)` runs f on an operating system thread, `virtual f(...)` on a\n// virtual one: a stack of its own that a small pool of carrier threads runs,\n// so a program can have hundreds of thousands of them where it could not\n// have thousands of the other kind. Both hand back a task, and `await` is\n// the value it ends up with. An `async method` is one whose calls do that by\n// themselves:\n//\n//     var t = virtual render(scene)\n//     var image = await t\n//\n//     async method fetch(string url): string { ... }\n//     var body = await fetch(\"...\")\n//\n// Blocking a virtual thread - await, sleep, a lock, a channel - parks it and\n// lets its carrier pick up the next one. Calls the runtime knows nothing\n// about (os.sleep, reading a file, exec) block the carrier itself, so inside\n// a virtual thread reach for thread.sleep() rather than os.sleep().\n//\n// A lock, channel, counter or group is an integer handle, the way a socket\n// is in `net`. Values are shared between threads as they are; anything two\n// threads write needs a lock, which `sync { ... }` is the short way to take:\n//\n//     sync { total = total + 1 }          // the program-wide lock\n//     sync (accounts) { ... }             // one from thread.mutex()\n//\n// The program ends when main returns, whatever is still running, so await\n// what has to finish.\n\n// --- tasks -----------------------------------------------------------\n\n// Waits for a task and answers with its result - the same thing `await`\n// does, for when a handle is passed around rather than awaited on the spot.\nmethod join(integer task): object native \"nv_await\"\n\n// Has the task finished? Answers straight away.\nmethod done(integer task): bool native \"nv_task_is_done\"\n\n// Waits for every task in the array and collects the results in order.\nmethod joinAll(array tasks): array native \"nv_await_all\"\n\n// --- the thread that is running --------------------------------------\n\n// Sleeps. In a virtual thread this parks it and the carrier goes on with\n// other work; on an operating system thread it is an ordinary sleep.\nmethod sleep(integer milliseconds) native \"nv_thread_sleep\"\n\n// Hands the processor to whatever is runnable next.\nmethod yield() native \"nv_thread_yield\"\n\nmethod isVirtual(): bool native \"nv_thread_is_virtual\"\n\n// A number that stays the same for one thread and differs between threads.\nmethod id(): integer native \"nv_thread_self_id\"\n\n// --- the carrier pool -------------------------------------------------\n\nmethod cpus(): integer native \"nv_thread_cpus\"              // processors of the machine\nmethod parallelism(): integer native \"nv_thread_parallelism\"  // carriers virtual threads may use\nmethod setParallelism(integer carriers) native \"nv_thread_set_parallelism\"\nmethod running(): integer native \"nv_thread_running\"        // virtual threads not finished yet\n\n// Whether virtual threads are real ones here. Where the platform has no\n// stack switching they fall back to operating system threads, which changes\n// nothing about what a program means - only how many of them fit.\nmethod supportsVirtual(): bool native \"nv_thread_virtual_supported\"\n\n// --- locks -------------------------------------------------------------\n\n// A re-entrant lock. `sync (m) { ... }` is the same thing without the\n// matching unlock to forget.\nmethod mutex(): integer native \"nv_lock_new\"\nmethod lock(integer mutex) native \"nv_lock_acquire\"\nmethod unlock(integer mutex) native \"nv_lock_release\"\nmethod tryLock(integer mutex): bool native \"nv_lock_try_acquire\"\n\n// --- channels -----------------------------------------------------------\n\n// A queue between threads. Capacity 0 is unbuffered: a send waits until the\n// value has been taken.\nmethod channel(integer capacity): integer native \"nv_chan_new\"\n\n// Waits for room and hands the value over. False means the channel was\n// closed and the value went nowhere.\nmethod send(integer channel, object value): bool native \"nv_chan_send\"\n\n// Waits for a value. A closed and empty channel has none left to give, and\n// since a channel may carry any value - the empty one included - received()\n// is what says whether there was one:\n//\n//     while (true) {\n//         var item = thread.recv(work)\n//         if (thread.received() == false) {\n//             break\n//         }\n//         handle(item)\n//     }\nmethod recv(integer channel): object native \"nv_chan_recv\"\n\n// A value if one is waiting, nothing otherwise - never blocks.\nmethod tryRecv(integer channel): object native \"nv_chan_try_recv\"\n\n// Did the last recv() or tryRecv() of this thread produce a value?\nmethod received(): bool native \"nv_chan_received\"\n\n// Wakes everyone waiting on the channel. Values already in it can still be\n// received; sending into it no longer works.\nmethod close(integer channel) native \"nv_chan_close\"\n\nmethod closed(integer channel): bool native \"nv_chan_is_closed\"\nmethod length(integer channel): integer native \"nv_chan_length\"\n\n// --- counters -------------------------------------------------------------\n\n// A number several threads may change without a lock of their own.\nmethod counter(integer initial): integer native \"nv_counter_new\"\nmethod add(integer counter, integer delta): integer native \"nv_counter_add\"  // the new value\nmethod get(integer counter): integer native \"nv_counter_get\"\nmethod set(integer counter, integer value) native \"nv_counter_set\"\n\n// Sets the counter to `value` if it still holds `expect`.\nmethod compareAndSet(integer counter, integer expect, integer value): bool native \"nv_counter_swap\"\n\nmethod increment(integer counter): integer {\n    return add(counter, 1)\n}\n\nmethod decrement(integer counter): integer {\n    return add(counter, 0 - 1)\n}\n\n// --- groups ---------------------------------------------------------------\n\n// Counts work that is still outstanding, for fan-outs whose tasks nobody\n// kept: groupAdd() what is about to start, groupDone() what finished,\n// groupWait() until nothing is left. With the task handles in hand,\n// joinAll() says the same thing more directly.\nmethod group(): integer native \"nv_group_new\"\nmethod groupAdd(integer group, integer count) native \"nv_group_add\"\nmethod groupDone(integer group) native \"nv_group_done\"\nmethod groupWait(integer group) native \"nv_group_wait\"\n"
    }
    if (name == "time") {
        return "package time\n\nimport math\n\n// Time: unix seconds, wall clock, formatting.\n\nmethod now(): integer native \"nv_os_time\"          // unix seconds\nmethod clock(): float native \"nv_os_clock\"         // seconds with sub-second precision\nmethod sleep(integer milliseconds) native \"nv_os_sleep\"\nmethod iso(integer unixSeconds): string native \"nv_time_iso\"        // 2026-09-01T12:34:56Z (UTC)\nmethod format(integer unixSeconds, string layout): string native \"nv_time_format\"  // strftime layout, UTC\nmethod parts(integer unixSeconds): map<string, integer> native \"nv_time_parts\"     // year, month, day, hour, minute, second, weekday, yearday (UTC)\n\nmethod nowIso(): string {\n    return iso(now())\n}\n\n// Milliseconds since `startClock` (from clock()).\nmethod elapsedMs(float startClock): integer {\n    return math.round((clock() - startClock) * 1000.0)\n}\n\n// \"1h 2m 3s\" style duration for a number of seconds.\nmethod duration(integer seconds): string {\n    if (seconds < 60) {\n        return \"" + chr(36) + "{seconds}s\"\n    }\n    if (seconds < 3600) {\n        return \"" + chr(36) + "{seconds / 60}m " + chr(36) + "{seconds % 60}s\"\n    }\n    if (seconds < 86400) {\n        return \"" + chr(36) + "{seconds / 3600}h " + chr(36) + "{(seconds % 3600) / 60}m\"\n    }\n    return \"" + chr(36) + "{seconds / 86400}d " + chr(36) + "{(seconds % 86400) / 3600}h\"\n}\n"
    }
    if (name == "toml") {
        return "package toml\n\nimport json\n\n// TOML configuration files (TOML 1.0): parse, stringify, load and save.\n//\n//     var config = toml.load(\"app.toml\")\n//     println config[\"server\"][\"port\"]\n//\n// Tables become maps, arrays arrays, and values integers, floats, bools and\n// strings. Dates and times are kept as their text (2026-09-18T12:00:00Z).\n// Invalid input is a runtime error naming the line; parseOr() and isValid()\n// check without one.\n\nmethod parse(string text): map<string, object> {\n    var p = TomlParser{text=text, at=0, line=1}\n    return p.document()\n}\n\n// The parsed text, or `fallback` when it is not valid TOML.\nmethod parseOr(string text, object fallback): object {\n    var result = tryRun(TomlTask{text=text})\n    if (tryFailed()) {\n        return fallback\n    }\n    return result\n}\n\nmethod isValid(string text): bool {\n    tryRun(TomlTask{text=text})\n    return tryFailed() == false\n}\n\n// The message of why `text` is not valid TOML (\"\" when it is).\nmethod errorOf(string text): string {\n    tryRun(TomlTask{text=text})\n    return tryError()\n}\n\nmethod load(string file): map<string, object> {\n    if (fileExists(file) == false) {\n        raise(\"toml: cannot open '\" + file + \"'\")\n    }\n    return parse(readFile(file))\n}\n\nmethod save(map<string, object> value, string file) {\n    writeFile(file, stringify(value))\n}\n\n// A map as a TOML document: plain keys first, then [tables] and\n// [[arrays of tables]].\nmethod stringify(map<string, object> value): string {\n    var out = []\n    writeTable(value, \"\", out)\n    var text = out.join(\"\")\n    if (text.startsWith(\"\\n\")) {\n        return text.substring(1, text.length())\n    }\n    return text\n}\n\nmethod tryRun(object task): object native \"nv_try_run\"\nmethod tryFailed(): bool native \"nv_try_failed\"\nmethod tryError(): string native \"nv_try_error\"\nmethod raise(string message) native \"nv_try_raise\"\n\n// --- writing ---------------------------------------------------------------\n\nmethod writeTable(map<string, object> table, string prefix, array<string> out): integer {\n    var tables = []\n    for (key in table) {\n        var v = table[key]\n        if (isTable(v) || isTableArray(v)) {\n            tables.append(key)\n        } else {\n            out.append(quoteKey(key) + \" = \" + inline(v) + \"\\n\")\n        }\n    }\n    for (key in tables) {\n        var path = quoteKey(key)\n        if (prefix != \"\") {\n            path = prefix + \".\" + path\n        }\n        var v = table[key]\n        if (isTable(v)) {\n            out.append(\"\\n[\" + path + \"]\\n\")\n            writeTable(v, path, out)\n        } else {\n            for (item in v) {\n                out.append(\"\\n[[\" + path + \"]]\\n\")\n                writeTable(item, path, out)\n            }\n        }\n    }\n    return 0\n}\n\nmethod isTable(object v): bool {\n    return typeOf(v) == \"map\"\n}\n\n// A non-empty array of maps is written as [[name]] sections.\nmethod isTableArray(object v): bool {\n    if (typeOf(v) != \"array\" || v.length() == 0) {\n        return false\n    }\n    for (item in v) {\n        if (typeOf(item) != \"map\") {\n            return false\n        }\n    }\n    return true\n}\n\nmethod inline(object v): string {\n    var kind = typeOf(v)\n    if (kind == \"string\") {\n        return quote(v)\n    }\n    if (kind == \"integer\" || kind == \"bool\") {\n        return \"\" + v\n    }\n    if (kind == \"float\") {\n        return json.stringify(v)\n    }\n    if (kind == \"array\") {\n        var parts = []\n        for (item in v) {\n            parts.append(inline(item))\n        }\n        return \"[\" + parts.join(\", \") + \"]\"\n    }\n    if (kind == \"map\") {\n        var fields = []\n        for (key in v) {\n            fields.append(quoteKey(key) + \" = \" + inline(v[key]))\n        }\n        if (fields.length() == 0) {\n            return \"{}\"\n        }\n        return \"{ \" + fields.join(\", \") + \" }\"\n    }\n    // TOML has no null: nothing is written as an empty string\n    return \"\\\"\\\"\"\n}\n\nmethod quote(string s): string {\n    return json.stringify(s)\n}\n\nmethod quoteKey(string key): string {\n    if (key == \"\") {\n        return \"\\\"\\\"\"\n    }\n    var i = 0\n    while (i < key.length()) {\n        if (bareChar(key.charAt(i)) == false) {\n            return quote(key)\n        }\n        i = i + 1\n    }\n    return key\n}\n\nmethod bareChar(string c): bool {\n    return (c >= \"a\" && c <= \"z\") || (c >= \"A\" && c <= \"Z\") || (c >= \"0\" && c <= \"9\") || c == \"_\" || c == \"-\"\n}\n\n// --- reading ---------------------------------------------------------------\n\ndefine class TomlTask {\n    private string text: get, set\n\n    method run(): object {\n        return toml.parse(text)\n    }\n}\n\n// A cursor over the text; the grammar is small enough for one class.\ndefine class TomlParser {\n    private string text: get, set\n    private integer at: get, set\n    private integer line: get, set\n\n    method fail(string message) {\n        raise(\"toml: line \" + line + \": \" + message)\n    }\n\n    method peek(): string {\n        if (at >= text.length()) {\n            return \"\"\n        }\n        return text.charAt(at)\n    }\n\n    method peekAt(integer offset): string {\n        if (at + offset >= text.length()) {\n            return \"\"\n        }\n        return text.charAt(at + offset)\n    }\n\n    method startsHere(string s): bool {\n        return text.substring(at, at + s.length()) == s\n    }\n\n    method advance(): string {\n        var c = text.charAt(at)\n        at = at + 1\n        if (c == \"\\n\") {\n            line = line + 1\n        }\n        return c\n    }\n\n    // Spaces and tabs.\n    method spaces() {\n        while (peek() == \" \" || peek() == \"\\t\") {\n            at = at + 1\n        }\n    }\n\n    // Spaces, line breaks and comments (inside arrays).\n    method blank() {\n        while (true) {\n            var c = peek()\n            if (c == \" \" || c == \"\\t\" || c == \"\\r\" || c == \"\\n\") {\n                advance()\n            } else if (c == \"#\") {\n                comment()\n            } else {\n                return\n            }\n        }\n    }\n\n    method comment() {\n        while (peek() != \"\" && peek() != \"\\n\") {\n            at = at + 1\n        }\n    }\n\n    // After a key/value or a header only a comment may follow on the line.\n    method endOfLine() {\n        spaces()\n        if (peek() == \"#\") {\n            comment()\n        }\n        if (peek() == \"\\r\") {\n            at = at + 1\n        }\n        if (peek() == \"\") {\n            return\n        }\n        if (peek() != \"\\n\") {\n            fail(\"unexpected '\" + peek() + \"' after the value\")\n        }\n        advance()\n    }\n\n    method document(): map<string, object> {\n        var root = {}\n        var current = root\n        while (true) {\n            blank()\n            if (peek() == \"\") {\n                return root\n            }\n            if (startsHere(\"[[\")) {\n                at = at + 2\n                var path = keyPath()\n                spaces()\n                if (startsHere(\"]]\") == false) {\n                    fail(\"expected ']]'\")\n                }\n                at = at + 2\n                var parent = descend(root, path, path.length() - 1)\n                var last = path[path.length() - 1]\n                if (parent.has(last) == false) {\n                    parent[last] = []\n                }\n                if (typeOf(parent[last]) != \"array\") {\n                    fail(\"'\" + last + \"' is not an array of tables\")\n                }\n                var entry = {}\n                parent[last].append(entry)\n                current = entry\n                endOfLine()\n                continue\n            }\n            if (peek() == \"[\") {\n                at = at + 1\n                var tpath = keyPath()\n                spaces()\n                if (peek() != \"]\") {\n                    fail(\"expected ']'\")\n                }\n                at = at + 1\n                current = descend(root, tpath, tpath.length())\n                endOfLine()\n                continue\n            }\n            keyValue(current)\n            endOfLine()\n        }\n        return root\n    }\n\n    // The table `count` steps down `path` (the last entry of an array of\n    // tables when one is on the way), created as needed.\n    method descend(map<string, object> root, array<string> path, integer count): map<string, object> {\n        var table = root\n        var i = 0\n        while (i < count) {\n            var key = path[i]\n            if (table.has(key) == false) {\n                table[key] = {}\n            }\n            var next = table[key]\n            if (typeOf(next) == \"array\" && next.length() > 0 && typeOf(next[next.length() - 1]) == \"map\") {\n                next = next[next.length() - 1]\n            }\n            if (typeOf(next) != \"map\") {\n                fail(\"'\" + key + \"' is already a value, not a table\")\n            }\n            table = next\n            i = i + 1\n        }\n        return table\n    }\n\n    method keyValue(map<string, object> table) {\n        var path = keyPath()\n        spaces()\n        if (peek() != \"=\") {\n            fail(\"expected '=' after the key\")\n        }\n        at = at + 1\n        spaces()\n        var target = descend(table, path, path.length() - 1)\n        var last = path[path.length() - 1]\n        if (target.has(last)) {\n            fail(\"'\" + last + \"' is defined twice\")\n        }\n        target[last] = value()\n    }\n\n    // a.b.\"c d\" -> [\"a\", \"b\", \"c d\"]\n    method keyPath(): array<string> {\n        var path = []\n        while (true) {\n            spaces()\n            var c = peek()\n            if (c == \"\\\"\") {\n                path.append(basicString())\n            } else if (c == \"'\") {\n                path.append(literalString())\n            } else {\n                var start = at\n                while (bareChar(peek())) {\n                    at = at + 1\n                }\n                if (at == start) {\n                    fail(\"expected a key\")\n                }\n                path.append(text.substring(start, at))\n            }\n            spaces()\n            if (peek() != \".\") {\n                return path\n            }\n            at = at + 1\n        }\n        return path\n    }\n\n    method value(): object {\n        var c = peek()\n        if (startsHere(\"\\\"\\\"\\\"\")) {\n            return multiBasic()\n        }\n        if (startsHere(\"'''\")) {\n            return multiLiteral()\n        }\n        if (c == \"\\\"\") {\n            return basicString()\n        }\n        if (c == \"'\") {\n            return literalString()\n        }\n        if (c == \"[\") {\n            return arrayValue()\n        }\n        if (c == \"{\") {\n            return inlineTable()\n        }\n        if (startsHere(\"true\")) {\n            at = at + 4\n            return true\n        }\n        if (startsHere(\"false\")) {\n            at = at + 5\n            return false\n        }\n        return scalar()\n    }\n\n    method arrayValue(): array {\n        at = at + 1\n        var items = []\n        while (true) {\n            blank()\n            if (peek() == \"]\") {\n                at = at + 1\n                return items\n            }\n            if (peek() == \"\") {\n                fail(\"unclosed array\")\n            }\n            items.append(value())\n            blank()\n            if (peek() == \",\") {\n                at = at + 1\n            } else if (peek() != \"]\") {\n                fail(\"expected ',' or ']' in an array\")\n            }\n        }\n        return items\n    }\n\n    method inlineTable(): map<string, object> {\n        at = at + 1\n        var table = {}\n        spaces()\n        if (peek() == \"}\") {\n            at = at + 1\n            return table\n        }\n        while (true) {\n            keyValue(table)\n            spaces()\n            if (peek() == \"}\") {\n                at = at + 1\n                return table\n            }\n            if (peek() != \",\") {\n                fail(\"expected ',' or '}' in an inline table\")\n            }\n            at = at + 1\n        }\n        return table\n    }\n\n    // A number, a date or a time: everything up to the next delimiter.\n    method scalar(): object {\n        var start = at\n        while (peek() != \"\" && peek() != \",\" && peek() != \"]\" && peek() != \"}\" && peek() != \"\\n\" && peek() != \"\\r\" && peek() != \"#\") {\n            at = at + 1\n        }\n        var raw = text.substring(start, at).trim()\n        if (raw == \"\") {\n            fail(\"expected a value\")\n        }\n        return number(raw)\n    }\n\n    method number(string raw): object {\n        var s = raw.replace(\"_\", \"\")\n        var body = s\n        var negative = false\n        if (body.startsWith(\"+\")) {\n            body = body.substring(1, body.length())\n        } else if (body.startsWith(\"-\")) {\n            negative = true\n            body = body.substring(1, body.length())\n        }\n        if (body == \"inf\" || body == \"nan\") {\n            if (negative) {\n                return parseFloat(\"-\" + body)\n            }\n            return parseFloat(body)\n        }\n        if (body.startsWith(\"0x\") || body.startsWith(\"0o\") || body.startsWith(\"0b\")) {\n            var base = 16\n            if (body.startsWith(\"0o\")) {\n                base = 8\n            }\n            if (body.startsWith(\"0b\")) {\n                base = 2\n            }\n            var n = 0\n            var i = 2\n            while (i < body.length()) {\n                var d = digit(body.charAt(i))\n                if (d < 0 || d >= base) {\n                    fail(\"invalid number '\" + raw + \"'\")\n                }\n                n = n * base + d\n                i = i + 1\n            }\n            if (negative) {\n                return 0 - n\n            }\n            return n\n        }\n        if (isDateLike(body)) {\n            return raw\n        }\n        if (body == \"\" || body.charAt(0) < \"0\" || body.charAt(0) > \"9\" || json.isValid(body) == false) {\n            fail(\"invalid value '\" + raw + \"'\")\n        }\n        if (body.contains(\".\") || body.contains(\"e\") || body.contains(\"E\")) {\n            if (negative) {\n                return 0.0 - parseFloat(body)\n            }\n            return parseFloat(body)\n        }\n        if (negative) {\n            return 0 - parseInt(body)\n        }\n        return parseInt(body)\n    }\n\n    method isDateLike(string s): bool {\n        if (s.length() >= 10 && s.charAt(4) == \"-\" && s.charAt(7) == \"-\") {\n            return true\n        }\n        return s.length() >= 8 && s.charAt(2) == \":\" && s.charAt(5) == \":\"\n    }\n\n    method digit(string c): integer {\n        if (c >= \"0\" && c <= \"9\") {\n            return ord(c) - ord(\"0\")\n        }\n        if (c >= \"a\" && c <= \"f\") {\n            return ord(c) - ord(\"a\") + 10\n        }\n        if (c >= \"A\" && c <= \"F\") {\n            return ord(c) - ord(\"A\") + 10\n        }\n        return 0 - 1\n    }\n\n    method basicString(): string {\n        at = at + 1\n        var out = []\n        while (true) {\n            var c = peek()\n            if (c == \"\" || c == \"\\n\") {\n                fail(\"unclosed string\")\n            }\n            at = at + 1\n            if (c == \"\\\"\") {\n                return out.join(\"\")\n            }\n            if (c == \"\\\\\") {\n                out.append(escape())\n            } else {\n                out.append(c)\n            }\n        }\n        return \"\"\n    }\n\n    method literalString(): string {\n        at = at + 1\n        var start = at\n        while (peek() != \"'\") {\n            if (peek() == \"\" || peek() == \"\\n\") {\n                fail(\"unclosed string\")\n            }\n            at = at + 1\n        }\n        at = at + 1\n        return text.substring(start, at - 1)\n    }\n\n    method multiBasic(): string {\n        at = at + 3\n        skipFirstNewline()\n        var out = []\n        while (true) {\n            if (peek() == \"\") {\n                fail(\"unclosed \\\"\\\"\\\" string\")\n            }\n            if (startsHere(\"\\\"\\\"\\\"\")) {\n                // up to two quotes may end the content: \"\"\"a\"\"\"\"\" is a\"\"\n                while (startsHere(\"\\\"\\\"\\\"\\\"\")) {\n                    out.append(\"\\\"\")\n                    at = at + 1\n                }\n                at = at + 3\n                return out.join(\"\")\n            }\n            var c = advance()\n            if (c == \"\\\\\") {\n                var n = peek()\n                if (n == \"\\n\" || n == \" \" || n == \"\\t\" || n == \"\\r\") {\n                    // a line ending backslash eats the break and the indentation\n                    while (peek() == \" \" || peek() == \"\\t\" || peek() == \"\\r\" || peek() == \"\\n\") {\n                        advance()\n                    }\n                } else {\n                    out.append(escape())\n                }\n            } else if (c != \"\\r\") {\n                out.append(c)\n            }\n        }\n        return \"\"\n    }\n\n    method multiLiteral(): string {\n        at = at + 3\n        skipFirstNewline()\n        var out = []\n        while (true) {\n            if (peek() == \"\") {\n                fail(\"unclosed ''' string\")\n            }\n            if (startsHere(\"'''\")) {\n                while (startsHere(\"''''\")) {\n                    out.append(\"'\")\n                    at = at + 1\n                }\n                at = at + 3\n                return out.join(\"\")\n            }\n            var c = advance()\n            if (c != \"\\r\") {\n                out.append(c)\n            }\n        }\n        return \"\"\n    }\n\n    method skipFirstNewline() {\n        if (peek() == \"\\r\") {\n            at = at + 1\n        }\n        if (peek() == \"\\n\") {\n            advance()\n        }\n    }\n\n    // The character after a backslash (already consumed).\n    method escape(): string {\n        var c = peek()\n        at = at + 1\n        if (c == \"n\") {\n            return \"\\n\"\n        }\n        if (c == \"t\") {\n            return \"\\t\"\n        }\n        if (c == \"r\") {\n            return \"\\r\"\n        }\n        if (c == \"b\") {\n            return chr(8)\n        }\n        if (c == \"f\") {\n            return chr(12)\n        }\n        if (c == \"e\") {\n            return chr(27)\n        }\n        if (c == \"\\\"\" || c == \"\\\\\") {\n            return c\n        }\n        if (c == \"u\" || c == \"U\") {\n            var count = 4\n            if (c == \"U\") {\n                count = 8\n            }\n            var code = 0\n            var i = 0\n            while (i < count) {\n                var d = digit(peek())\n                if (d < 0) {\n                    fail(\"invalid \\\\\" + c + \" escape\")\n                }\n                code = code * 16 + d\n                at = at + 1\n                i = i + 1\n            }\n            return utf8(code)\n        }\n        fail(\"invalid escape '\\\\\" + c + \"'\")\n        return \"\"\n    }\n}\n\n// The UTF-8 bytes of a code point.\nmethod utf8(integer code): string {\n    if (code < 128) {\n        return chr(code)\n    }\n    if (code < 2048) {\n        return chr(192 + code / 64) + chr(128 + code % 64)\n    }\n    if (code < 65536) {\n        return chr(224 + code / 4096) + chr(128 + (code / 64) % 64) + chr(128 + code % 64)\n    }\n    return chr(240 + code / 262144) + chr(128 + (code / 4096) % 64) + chr(128 + (code / 64) % 64) + chr(128 + code % 64)\n}\n"
    }
    if (name == "web") {
        return "package web\n\nimport bytes\nimport crypto\nimport io\nimport json\nimport math\nimport net\nimport os\nimport path\n\n// Server rendered, live web components: the runtime behind .nvh files\n// (pages, the HTTP server, views, patches and the browser script).\n\n// A .nvh file is HTML with Novus in it - like PHP - and at the same time a\n// component, the way a .vue or .svelte file is one. The compiler turns\n// `Counter.nvh` into a class Counter based NvhComponent; this module renders\n// such components on the server, answers the browser and keeps them live:\n//\n//     import web\n//     import \"pages/Home.nvh\"\n//\n//     method main {\n//         web.page(\"/\", Home())            // a prototype: every visit gets its own\n//         web.page(\"/user/:id\", User())    // :id and ?query= become props\n//         web.files(\"/assets\", \"public\")\n//         web.serve(8080)\n//     }\n//\n// Every page a browser opens is a view: its components live on the server,\n// each with its own refs. An event (@click, @input, bind=...) is sent to the\n// server, the handler runs there, the components are rendered again and only\n// those whose own output changed are sent back and patched into the page.\n// A view also holds a server-sent event stream, so changes that happen\n// elsewhere - another visitor, web.tick() - reach it without a request.\n//\n// The server is one thread and one poll() loop, so handlers never race each\n// other and state shared between views needs no lock.\n\n// --- configuration -------------------------------------------------------\n\nvar routes = []\nvar mounts = []\nvar views = {}\nvar tickEvery = 0\nvar viewTimeout = 300\nvar quiet = false\nvar lastError = \"\"\n\n// The placeholder for the event's value in handler arguments: " + chr(36) + "value in a\n// template, filled in by the browser (input text, checkbox state, form data).\nvar VALUE = {\"" + chr(36) + "nv\": \"value\"}\n\n// A page: a URL pattern and the component that renders it. Segments written\n// :name are captured and, like query parameters, handed to the component's\n// props of that name.\nmethod page(string pattern, NvhComponent component) {\n    routes.append([segments(pattern), component])\n}\n\n// Serves the files below `dir` under the URL prefix.\nmethod files(string prefix, string dir) {\n    var p = prefix\n    if (p.endsWith(\"/\") == false) {\n        p = p + \"/\"\n    }\n    mounts.append([p, dir])\n}\n\n// Calls tick() on every component of every open view each `milliseconds`\n// and pushes what changed (0 turns it off).\nmethod tick(integer milliseconds) {\n    tickEvery = milliseconds\n}\n\n// Seconds a view is kept after its page lost the connection (default 300).\nmethod keepViews(integer seconds) {\n    viewTimeout = seconds\n}\n\n// No request log on stdout.\nmethod silent() {\n    quiet = true\n}\n\n// The port from " + chr(36) + "PORT, or the fallback.\nmethod port(integer fallback): integer {\n    var p = os.env(\"PORT\")\n    if (p == \"\") {\n        return fallback\n    }\n    return parseInt(p)\n}\n\n// --- values in templates --------------------------------------------------\n\n// Text for HTML: & < > \" ' become entities.\nmethod escape(object value): string {\n    var s = text(value)\n    if (s.contains(\"&\")) {\n        s = s.replace(\"&\", \"&amp;\")\n    }\n    if (s.contains(\"<\")) {\n        s = s.replace(\"<\", \"&lt;\")\n    }\n    if (s.contains(\">\")) {\n        s = s.replace(\">\", \"&gt;\")\n    }\n    if (s.contains(\"\\\"\")) {\n        s = s.replace(\"\\\"\", \"&quot;\")\n    }\n    if (s.contains(\"'\")) {\n        s = s.replace(\"'\", \"&#39;\")\n    }\n    return s\n}\n\n// The text form of a value; nothing (an unset field) is \"\".\nmethod text(object value): string {\n    var kind = typeOf(value)\n    if (kind == \"string\") {\n        return value\n    }\n    if (kind == \"unknown\") {\n        return \"\"\n    }\n    return \"\" + value\n}\n\n// name={value}: true writes the bare attribute, false and nothing drop it.\nmethod attr(string name, object value): string {\n    var kind = typeOf(value)\n    if (kind == \"bool\") {\n        if (value) {\n            return \" \" + name\n        }\n        return \"\"\n    }\n    if (kind == \"unknown\") {\n        return \"\"\n    }\n    return \" \" + name + \"=\\\"\" + escape(value) + \"\\\"\"\n}\n\n// Conversions for props and bound refs (the browser sends text).\nmethod toInt(object value): integer {\n    var kind = typeOf(value)\n    if (kind == \"integer\") {\n        return value\n    }\n    if (kind == \"bool\") {\n        if (value) {\n            return 1\n        }\n        return 0\n    }\n    if (kind == \"unknown\") {\n        return 0\n    }\n    return math.toInt(value)\n}\n\nmethod toFloat(object value): float {\n    var kind = typeOf(value)\n    if (kind == \"float\") {\n        return value\n    }\n    if (kind == \"unknown\") {\n        return 0.0\n    }\n    return math.toFloat(value)\n}\n\nmethod toBool(object value): bool {\n    var kind = typeOf(value)\n    if (kind == \"bool\") {\n        return value\n    }\n    if (kind == \"integer\") {\n        return value != 0\n    }\n    var s = text(value)\n    return s == \"true\" || s == \"on\" || s == \"1\" || s == \"yes\"\n}\n\nmethod toStr(object value): string {\n    return text(value)\n}\n\n// A prop handed to a child component (<Child name={value}>).\nmethod prop(NvhComponent child, string name, object value) {\n    if (child.nvProp(name, value) == false) {\n        raise(\"<" + chr(36) + "{child.nvName()}> has no prop '" + chr(36) + "{name}'\")\n    }\n}\n\n// --- errors ------------------------------------------------------------------\n\n// A step of a component run with runtime errors caught (see guarded()).\ndefine class NvhGuard {\n    private object target: get, set\n    private string action: get, set\n    private string key: get, set\n    private object value: get, set\n\n    method run(): object {\n        if (action == \"call\") {\n            return target.nvCall(key, value)\n        }\n        if (action == \"set\") {\n            return target.nvSet(key, value)\n        }\n        if (action == \"prop\") {\n            return target.nvProp(key, value)\n        }\n        if (action == \"render\") {\n            target.nvRenderNow()\n            return true\n        }\n        if (action == \"tick\") {\n            target.tick()\n            return true\n        }\n        return false\n    }\n}\n\nmethod tryRun(object task): object native \"nv_try_run\"\nmethod tryFailed(): bool native \"nv_try_failed\"\nmethod tryError(): string native \"nv_try_error\"\nmethod raise(string message) native \"nv_try_raise\"\n\n// Runs one step of a component. A runtime error in it - an index out of\n// range in a handler, say - does not end the server: the step answers\n// nothing, failed() is true and failure() has the message.\nmethod guarded(object target, string action, string key, object value): object {\n    lastError = \"\"\n    var result = tryRun(NvhGuard{target=target, action=action, key=key, value=value})\n    if (tryFailed()) {\n        lastError = tryError()\n        var what = action\n        if (key != \"\") {\n            what = what + \" \" + key\n        }\n        eprintln \"web: error in " + chr(36) + "{target.nvName()} (" + chr(36) + "{what}): " + chr(36) + "{lastError}\"\n    }\n    return result\n}\n\nmethod failed(): bool {\n    return lastError != \"\"\n}\n\nmethod failure(): string {\n    return lastError\n}\n\n// Handler arguments with the " + chr(36) + "value placeholders replaced.\nmethod fill(array args, object value): array {\n    var out = []\n    for (a in args) {\n        if (typeOf(a) == \"map\" && a.has(\"" + chr(36) + "nv\")) {\n            out.append(value)\n        } else {\n            out.append(a)\n        }\n    }\n    return out\n}\n\n// --- components ------------------------------------------------------------\n\n// The base of every .nvh component. The nv* methods are generated by the\n// compiler or used by the generated code; mount(), tick(), emit(),\n// navigate() and id() are meant for components themselves.\ndefine class NvhComponent {\n    private string nvid\n    private object nvview\n    private object nvowner\n    private map<string, object> nvkids\n    private map<string, bool> nvseen\n    private map<string, integer> nvcount\n    private map<string, object> nvlisteners\n    private array nvslot\n    private array nvparts\n    private bool nvready\n\n    // generated for each .nvh file\n    method nvName(): string {\n        return \"NvhComponent\"\n    }\n\n    method nvNew(): NvhComponent {\n        return NvhComponent()\n    }\n\n    method nvDefaults() {\n    }\n\n    method nvSetup() {\n    }\n\n    method nvProp(string name, object value): bool {\n        return false\n    }\n\n    method nvSet(string name, object value): bool {\n        return false\n    }\n\n    method nvCall(string name, array args): bool {\n        return false\n    }\n\n    method nvRender(array out) {\n    }\n\n    method nvStyle(): string {\n        return \"\"\n    }\n\n    // Runs once, after the props arrived and the refs were initialized,\n    // before the first render.\n    method mount() {\n    }\n\n    // Runs every web.tick() interval while the page is open.\n    method tick() {\n    }\n\n    // The id of the component in its page (the data-nv attribute).\n    method id(): string {\n        return nvid\n    }\n\n    // Raises an event the parent listens to with @name=\"handler(...)\".\n    method emit(string event) {\n        emit(event, \"\")\n    }\n\n    method emit(string event, object value) {\n        if (nvlisteners.has(event) == false) {\n            return\n        }\n        var spec = nvlisteners[event]\n        var owner = spec[0]\n        if (owner.nvCall(spec[1], fill(spec[2], value)) == false) {\n            eprintln \"web: " + chr(36) + "{owner.nvName()} has no handler " + chr(36) + "{spec[1]}/" + chr(36) + "{spec[2].length()} for @" + chr(36) + "{event}\"\n        }\n    }\n\n    // Sends the browser to another URL once the current event is handled.\n    method navigate(string url) {\n        nvview.nvGo(url)\n    }\n\n    // --- used by the generated code ---\n    method nvInit(object view, string id, object owner) {\n        nvview = view\n        nvid = id\n        nvowner = owner\n        nvkids = {}\n        nvseen = {}\n        nvcount = {}\n        nvlisteners = {}\n        nvslot = []\n        nvparts = []\n        nvready = false\n    }\n\n    method nvView(): object {\n        return nvview\n    }\n\n    method nvParts(): array {\n        return nvparts\n    }\n\n    // The key of the next <Tag> without key={...}: its position among the\n    // tags of that name in this render.\n    method nvKey(string tag): string {\n        var n = 0\n        if (nvcount.has(tag)) {\n            n = nvcount[tag]\n        }\n        nvcount[tag] = n + 1\n        return tag + \"#\" + n\n    }\n\n    method nvKeyed(string tag, object key): string {\n        return tag + \"@\" + text(key)\n    }\n\n    // The child rendered under `key`: the one from the last render, which\n    // keeps its refs, or `fresh` when there was none.\n    method nvChild(string key, NvhComponent fresh): NvhComponent {\n        nvseen[key] = true\n        if (nvkids.has(key)) {\n            var old = nvkids[key]\n            if (old.nvName() == fresh.nvName()) {\n                old.nvClaim()\n                return old\n            }\n        }\n        fresh.nvInit(nvview, nvview.nvNextId(), this)\n        fresh.nvDefaults()\n        nvkids[key] = fresh\n        return fresh\n    }\n\n    method nvClaim() {\n        nvlisteners = {}\n        nvslot = []\n    }\n\n    method nvListen(string event, NvhComponent owner, string handler, array args) {\n        nvlisteners[event] = [owner, handler, args]\n    }\n\n    method nvSetSlot(array parts) {\n        nvslot = parts\n    }\n\n    method nvEmitSlot(array out) {\n        for (p in nvslot) {\n            out.append(p)\n        }\n    }\n\n    method nvRenderChild(NvhComponent child): NvhComponent {\n        child.nvRenderNow()\n        return child\n    }\n\n    method nvRenderNow() {\n        if (nvready == false) {\n            nvready = true\n            nvSetup()\n            mount()\n        }\n        nvseen = {}\n        nvcount = {}\n        var out = []\n        nvRender(out)\n        var gone = []\n        for (k in nvkids) {\n            if (nvseen.has(k) == false) {\n                gone.append(k)\n            }\n        }\n        for (k in gone) {\n            nvkids.remove(k)\n        }\n        nvparts = out\n    }\n\n    method nvHeadOut(): array {\n        return nvview.nvHead()\n    }\n\n    method nvMark(): string {\n        return \" data-nv=\\\"\" + nvid + \"\\\"\"\n    }\n\n    method nvOn(string event, string handler, array args, string mods): string {\n        return \" data-nv-\" + event + \"=\\\"\" + escape(json.stringify([nvid, handler, args, mods])) + \"\\\"\"\n    }\n\n    method nvBind(string name): string {\n        return \" data-nv-bind=\\\"\" + escape(json.stringify([nvid, name])) + \"\\\"\"\n    }\n}\n\n// --- views -------------------------------------------------------------------\n\n// One open page: its component tree and what the browser was sent last.\ndefine class NvhView {\n    private string vid\n    private NvhComponent root\n    private integer next\n    private map<string, object> comps\n    private map<string, string> own\n    private map<string, bool> styled\n    private array head\n    private string go\n    private integer socket\n    private integer touched\n\n    method nvStart(string id, NvhComponent page) {\n        vid = id\n        root = page\n        next = 0\n        comps = {}\n        own = {}\n        styled = {}\n        head = []\n        go = \"\"\n        socket = -1\n        touched = os.time()\n        page.nvInit(this, nvNextId(), page)\n        page.nvDefaults()\n    }\n\n    method nvId(): string {\n        return vid\n    }\n\n    method nvRoot(): NvhComponent {\n        return root\n    }\n\n    method nvNextId(): string {\n        next = next + 1\n        return \"c\" + next\n    }\n\n    method nvHead(): array {\n        return head\n    }\n\n    method nvGo(string url) {\n        go = url\n    }\n\n    method nvSocket(): integer {\n        return socket\n    }\n\n    method nvSetSocket(integer s) {\n        socket = s\n        touched = os.time()\n    }\n\n    method nvTouch() {\n        touched = os.time()\n    }\n\n    method nvExpired(integer now): bool {\n        return socket < 0 && now - touched > viewTimeout\n    }\n\n    method nvComponent(string cid): object {\n        return comps[cid]\n    }\n\n    method nvHas(string cid): bool {\n        return comps.has(cid)\n    }\n\n    // Renders everything again and answers what changed since the last\n    // time: {\"p\": [[id, html]...], \"s\": [css...], \"go\": url}.\n    method nvRefresh(): map<string, object> {\n        head = []\n        guarded(root, \"render\", \"\", \"\")\n        if (failed()) {\n            return {\"p\": [], \"s\": [], \"error\": failure()}\n        }\n        var fresh = {}\n        var found = {}\n        collect(root, fresh, found)\n        var patches = []\n        changed(root, own, fresh, patches)\n        own = fresh\n        comps = found\n        var css = []\n        for (cid in found) {\n            var c = found[cid]\n            var name = c.nvName()\n            if (styled.has(name) == false) {\n                styled[name] = true\n                var style = c.nvStyle()\n                if (style != \"\") {\n                    css.append(style)\n                }\n            }\n        }\n        var update = {\"p\": patches, \"s\": css}\n        if (go != \"\") {\n            update[\"go\"] = go\n            go = \"\"\n        }\n        return update\n    }\n\n    // The style sheets of every kind of component on the page.\n    method nvStyles(): array {\n        var seen = {}\n        var out = []\n        for (cid in comps) {\n            var c = comps[cid]\n            if (seen.has(c.nvName()) == false) {\n                seen[c.nvName()] = true\n                var style = c.nvStyle()\n                if (style != \"\") {\n                    out.append(style)\n                }\n            }\n        }\n        return out\n    }\n\n    method nvTickAll() {\n        for (cid in comps) {\n            guarded(comps[cid], \"tick\", \"\", \"\")\n        }\n    }\n\n    // A browser event: {\"c\": id, \"h\": handler, \"a\": [args]} or a binding\n    // {\"c\": id, \"b\": ref, \"val\": value}.\n    method nvEvent(map<string, object> message): map<string, object> {\n        touched = os.time()\n        var cid = text(message[\"c\"])\n        var problem = \"\"\n        if (comps.has(cid)) {\n            var c = comps[cid]\n            if (message.has(\"b\")) {\n                var name = text(message[\"b\"])\n                if (guarded(c, \"set\", name, message[\"val\"]) == false && failed() == false) {\n                    eprintln \"web: " + chr(36) + "{c.nvName()} has no ref '" + chr(36) + "{name}' to bind\"\n                }\n            } else {\n                var handler = text(message[\"h\"])\n                var args = []\n                if (message.has(\"a\") && typeOf(message[\"a\"]) == \"array\") {\n                    args = message[\"a\"]\n                }\n                if (guarded(c, \"call\", handler, args) == false && failed() == false) {\n                    eprintln \"web: " + chr(36) + "{c.nvName()} has no handler " + chr(36) + "{handler}/" + chr(36) + "{args.length()}\"\n                }\n            }\n            problem = failure()\n        }\n        var update = nvRefresh()\n        if (problem != \"\" && update.has(\"error\") == false) {\n            update[\"error\"] = problem\n        }\n        return update\n    }\n}\n\n// Every component under `c`: its own output (children as <#id> markers)\n// into `fresh`, the component itself into `found`.\nmethod collect(NvhComponent c, map<string, string> fresh, map<string, object> found): integer {\n    found[c.id()] = c\n    var parts = []\n    for (p in c.nvParts()) {\n        if (typeOf(p) == \"string\") {\n            parts.append(p)\n        } else {\n            parts.append(\"<#\" + p.id() + \">\")\n            collect(p, fresh, found)\n        }\n    }\n    fresh[c.id()] = parts.join(\"\")\n    return 0\n}\n\n// The topmost components whose own output differs from the last render.\nmethod changed(NvhComponent c, map<string, string> old, map<string, string> fresh, array patches): integer {\n    var cid = c.id()\n    if (old.has(cid) == false || old[cid] != fresh[cid]) {\n        patches.append([cid, html(c)])\n        return 0\n    }\n    for (p in c.nvParts()) {\n        if (typeOf(p) != \"string\") {\n            changed(p, old, fresh, patches)\n        }\n    }\n    return 0\n}\n\n// The HTML of a component, its children included.\nmethod html(NvhComponent c): string {\n    var out = []\n    htmlInto(c.nvParts(), out)\n    return out.join(\"\")\n}\n\nmethod htmlInto(array parts, array out): integer {\n    for (p in parts) {\n        if (typeOf(p) == \"string\") {\n            out.append(p)\n        } else {\n            htmlInto(p.nvParts(), out)\n        }\n    }\n    return 0\n}\n\n// --- rendering without a server (static pages, tests) -----------------------\n\n// A view for `component`, rendered once and not registered with the server.\nmethod view(NvhComponent component): NvhView {\n    var view = NvhView()\n    view.nvStart(\"test\", component)\n    view.nvRefresh()\n    return view\n}\n\n// The HTML of the view's page component.\nmethod render(NvhView view): string {\n    return html(view.nvRoot())\n}\n\n// The HTML of a component rendered on its own.\nmethod renderHtml(NvhComponent component): string {\n    return render(view(component))\n}\n\n// Runs a handler as a click would and answers the update as JSON.\nmethod trigger(NvhView view, string cid, string handler, array args): string {\n    return json.stringify(view.nvEvent({\"c\": cid, \"h\": handler, \"a\": args}))\n}\n\n// Sets a bound ref as typing into its input would.\nmethod input(NvhView view, string cid, string name, object value): string {\n    return json.stringify(view.nvEvent({\"c\": cid, \"b\": name, \"val\": value}))\n}\n\n// A whole HTML document for the view (head, styles, body); `live` adds the\n// script that connects it to the server.\nmethod document(NvhView view, bool live): string {\n    var out = [\"<!doctype html>\\n<html>\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n\"]\n    htmlInto(view.nvHead(), out)\n    for (css in view.nvStyles()) {\n        out.append(\"<style>\" + css + \"</style>\\n\")\n    }\n    out.append(\"</head>\\n<body>\\n\")\n    out.append(html(view.nvRoot()))\n    if (live) {\n        out.append(\"\\n<script>window.nvView=\\\"\" + view.nvId() + \"\\\";\" + client() + \"</script>\")\n    }\n    out.append(\"\\n</body>\\n</html>\\n\")\n    return out.join(\"\")\n}\n\n// --- the server ----------------------------------------------------------------\n\n// One connection: what came in, what still has to go out, and whether it\n// is a view's event stream.\ndefine class NvhConn {\n    private integer fd: get, set\n    private string input: get, set\n    private string output: get, set\n    private bool live: get, set\n    private bool closing: get, set\n    private string vid: get, set\n}\n\n// Serves the pages, files and views until the program is stopped.\nmethod serve(integer port) {\n    var server = net.listen(\"\", port)\n    if (server < 0) {\n        eprintln \"web: cannot listen on port " + chr(36) + "{port}: " + chr(36) + "{net.error()}\"\n        os.exit(1)\n    }\n    println \"web: serving on http://localhost:" + chr(36) + "{port}\"\n    io.flush()\n    var conns = {}\n    var lastTick = nowMs()\n    var lastSweep = os.time()\n    while (true) {\n        var sockets = [server]\n        var pending = false\n        for (key in conns) {\n            var c = conns[key]\n            sockets.append(c.fd())\n            if (bytes.size(c.output()) > 0) {\n                pending = true\n            }\n        }\n        var wait = 1000\n        if (tickEvery > 0) {\n            wait = tickEvery - (nowMs() - lastTick)\n            if (wait < 0) {\n                wait = 0\n            }\n        }\n        if (pending && wait > 10) {\n            wait = 10\n        }\n        for (s in net.poll(sockets, wait)) {\n            if (s == server) {\n                acceptAll(server, conns)\n            } else {\n                var key = \"\" + s\n                if (conns.has(key)) {\n                    readFrom(conns[key], conns)\n                }\n            }\n        }\n        flush(conns)\n        if (tickEvery > 0 && nowMs() - lastTick >= tickEvery) {\n            lastTick = nowMs()\n            for (vid in views) {\n                if (views[vid].nvSocket() >= 0) {\n                    views[vid].nvTickAll()\n                }\n            }\n            pushAll(\"\", conns)\n            flush(conns)\n        }\n        var now = os.time()\n        if (now - lastSweep >= 15) {\n            lastSweep = now\n            sweep(now, conns)\n        }\n    }\n}\n\nmethod nowMs(): integer {\n    return math.floor(os.clock() * 1000.0)\n}\n\nmethod acceptAll(integer server, map<string, object> conns): integer {\n    while (true) {\n        var s = net.accept(server)\n        if (s < 0) {\n            return 0\n        }\n        conns[\"\" + s] = NvhConn{fd=s, input=\"\", output=\"\", live=false, closing=false, vid=\"\"}\n    }\n    return 0\n}\n\nmethod readFrom(NvhConn conn, map<string, object> conns): integer {\n    var data = net.recv(conn.fd(), 65536)\n    if (bytes.size(data) == 0) {\n        if (net.again() == false) {\n            drop(conn, conns)\n        }\n        return 0\n    }\n    if (conn.live()) {\n        return 0\n    }\n    conn.input(bytes.join([conn.input(), data]))\n    var buffer = conn.input()\n    var end = buffer.indexOf(\"\\r\\n\\r\\n\")\n    if (end < 0) {\n        if (bytes.size(buffer) > 65536) {\n            respond(conn, \"GET\", 431, \"text/plain\", \"request header too large\")\n        }\n        return 0\n    }\n    var lines = buffer.substring(0, end).split(\"\\r\\n\")\n    var first = lines[0].split(\" \")\n    if (first.length() < 2) {\n        respond(conn, \"GET\", 400, \"text/plain\", \"bad request\")\n        return 0\n    }\n    var headers = {}\n    var i = 1\n    while (i < lines.length()) {\n        var colon = lines[i].indexOf(\":\")\n        if (colon > 0) {\n            headers[lines[i].substring(0, colon).trim().toLower()] = lines[i].substring(colon + 1, lines[i].length()).trim()\n        }\n        i = i + 1\n    }\n    var length = 0\n    if (headers.has(\"content-length\")) {\n        length = parseInt(headers[\"content-length\"])\n    }\n    if (bytes.size(buffer) < end + 4 + length) {\n        return 0\n    }\n    var body = bytes.slice(buffer, end + 4, end + 4 + length)\n    conn.input(\"\")\n    dispatch(conn, first[0], first[1], body, conns)\n    return 0\n}\n\nmethod dispatch(NvhConn conn, string verb, string target, string body, map<string, object> conns): integer {\n    var where = target\n    var query = \"\"\n    var q = target.indexOf(\"?\")\n    if (q >= 0) {\n        where = target.substring(0, q)\n        query = target.substring(q + 1, target.length())\n    }\n    where = urlDecode(where)\n    var params = parseQuery(query)\n    if (where == \"/_nvh/event\") {\n        if (verb != \"POST\") {\n            respond(conn, verb, 405, \"text/plain\", \"method not allowed\")\n            return 0\n        }\n        respond(conn, verb, 200, \"application/json\", eventReply(body, conns))\n        return 0\n    }\n    if (where == \"/_nvh/live\") {\n        startLive(conn, params, conns)\n        return 0\n    }\n    if (verb != \"GET\" && verb != \"HEAD\") {\n        logRequest(verb, target, 405)\n        respond(conn, verb, 405, \"text/plain\", \"method not allowed\")\n        return 0\n    }\n    for (m in mounts) {\n        if (where.startsWith(m[0])) {\n            if (serveFile(conn, verb, where.substring(m[0].length(), where.length()), m[1])) {\n                logRequest(verb, target, 200)\n                return 0\n            }\n        }\n    }\n    var parts = segments(where)\n    for (route in routes) {\n        var captured = {}\n        if (matches(route[0], parts, captured)) {\n            for (key in captured) {\n                params[key] = captured[key]\n            }\n            var view = NvhView()\n            view.nvStart(newViewId(), route[1].nvNew())\n            var root = view.nvRoot()\n            for (key in params) {\n                guarded(root, \"prop\", key, params[key])\n            }\n            var first = view.nvRefresh()\n            if (first.has(\"error\")) {\n                logRequest(verb, target, 500)\n                respond(conn, verb, 500, \"text/html; charset=utf-8\", \"<!doctype html>\\n<title>500</title>\\n<h1>500 - the page failed</h1>\\n<pre>\" + escape(first[\"error\"]) + \"</pre>\\n\")\n                return 0\n            }\n            views[view.nvId()] = view\n            logRequest(verb, target, 200)\n            respond(conn, verb, 200, \"text/html; charset=utf-8\", document(view, true))\n            return 0\n        }\n    }\n    logRequest(verb, target, 404)\n    respond(conn, verb, 404, \"text/html; charset=utf-8\", \"<!doctype html>\\n<title>404</title>\\n<h1>404 - not found</h1>\\n<p>\" + escape(where) + \"</p>\\n\")\n    return 0\n}\n\nmethod logRequest(string verb, string target, integer status) {\n    if (quiet == false) {\n        println \"web: " + chr(36) + "{verb} " + chr(36) + "{target} " + chr(36) + "{status}\"\n        io.flush()\n    }\n}\n\nmethod respond(NvhConn conn, string verb, integer status, string kind, string body) {\n    var head = \"HTTP/1.1 \" + status + \" \" + reason(status) + \"\\r\\nContent-Type: \" + kind + \"\\r\\nContent-Length: \" + bytes.size(body) + \"\\r\\nCache-Control: no-store\\r\\nConnection: close\\r\\n\\r\\n\"\n    if (verb == \"HEAD\") {\n        conn.output(bytes.join([conn.output(), head]))\n    } else {\n        conn.output(bytes.join([conn.output(), head, body]))\n    }\n    conn.closing(true)\n}\n\nmethod reason(integer status): string {\n    var reasons = {200: \"OK\", 204: \"No Content\", 400: \"Bad Request\", 500: \"Internal Server Error\", 403: \"Forbidden\", 404: \"Not Found\", 405: \"Method Not Allowed\", 431: \"Request Header Fields Too Large\"}\n    if (reasons.has(status)) {\n        return reasons[status]\n    }\n    return \"Status\"\n}\n\n// An event from a page: runs it, lets the other open views catch up and\n// answers the update for the page that sent it.\nmethod eventReply(string body, map<string, object> conns): string {\n    var message = json.parseOr(body, {})\n    if (typeOf(message) != \"map\" || message.has(\"v\") == false || views.has(text(message[\"v\"])) == false) {\n        return \"{\\\"reload\\\":true}\"\n    }\n    var vid = text(message[\"v\"])\n    var update = views[vid].nvEvent(message)\n    pushAll(vid, conns)\n    return json.stringify(update)\n}\n\n// GET /_nvh/live?v=<view>: the view's server-sent event stream.\nmethod startLive(NvhConn conn, map<string, string> params, map<string, object> conns): integer {\n    if (params.has(\"v\") == false || views.has(params[\"v\"]) == false) {\n        respond(conn, \"GET\", 204, \"text/plain\", \"\")\n        return 0\n    }\n    var view = views[params[\"v\"]]\n    var old = \"\" + view.nvSocket()\n    if (view.nvSocket() >= 0 && old != \"\" + conn.fd() && conns.has(old)) {\n        net.close(view.nvSocket())\n        conns.remove(old)\n    }\n    view.nvSetSocket(conn.fd())\n    conn.live(true)\n    conn.vid(view.nvId())\n    conn.output(conn.output() + \"HTTP/1.1 200 OK\\r\\nContent-Type: text/event-stream\\r\\nCache-Control: no-store\\r\\nConnection: keep-alive\\r\\n\\r\\n: live\\n\\n\")\n    push(conn, view.nvRefresh())\n    return 0\n}\n\nmethod push(NvhConn conn, map<string, object> update): integer {\n    if (update[\"p\"].length() > 0 || update[\"s\"].length() > 0 || update.has(\"go\") || update.has(\"error\")) {\n        conn.output(conn.output() + \"data: \" + json.stringify(update) + \"\\n\\n\")\n    }\n    return 0\n}\n\n// Renders every connected view except `except` again and streams the\n// changes to it.\nmethod pushAll(string except, map<string, object> conns): integer {\n    for (vid in views) {\n        if (vid == except) {\n            continue\n        }\n        var view = views[vid]\n        var key = \"\" + view.nvSocket()\n        if (view.nvSocket() < 0) {\n            continue\n        }\n        if (conns.has(key) == false) {\n            view.nvSetSocket(-1)\n            continue\n        }\n        push(conns[key], view.nvRefresh())\n    }\n    return 0\n}\n\nmethod flush(map<string, object> conns): integer {\n    var finished = []\n    for (key in conns) {\n        var c = conns[key]\n        var size = bytes.size(c.output())\n        if (size > 0) {\n            var written = net.send(c.fd(), c.output())\n            if (net.failed()) {\n                finished.append(key)\n                continue\n            }\n            if (written >= size) {\n                c.output(\"\")\n            } else {\n                c.output(bytes.slice(c.output(), written, size))\n            }\n        }\n        if (bytes.size(c.output()) == 0 && c.closing()) {\n            finished.append(key)\n        }\n    }\n    for (key in finished) {\n        drop(conns[key], conns)\n    }\n    return 0\n}\n\nmethod drop(NvhConn conn, map<string, object> conns): integer {\n    net.close(conn.fd())\n    conns.remove(\"\" + conn.fd())\n    if (conn.live() && views.has(conn.vid())) {\n        var view = views[conn.vid()]\n        if (view.nvSocket() == conn.fd()) {\n            view.nvSetSocket(-1)\n        }\n    }\n    return 0\n}\n\n// Forgets views whose page is gone and keeps the event streams alive.\nmethod sweep(integer now, map<string, object> conns): integer {\n    var expired = []\n    for (vid in views) {\n        if (views[vid].nvExpired(now)) {\n            expired.append(vid)\n        }\n    }\n    for (vid in expired) {\n        views.remove(vid)\n    }\n    for (key in conns) {\n        var c = conns[key]\n        if (c.live()) {\n            c.output(c.output() + \": ping\\n\\n\")\n            if (views.has(c.vid())) {\n                views[c.vid()].nvTouch()\n            }\n        }\n    }\n    return 0\n}\n\nmethod newViewId(): string {\n    return crypto.hex(crypto.random(12))\n}\n\n// --- files ---------------------------------------------------------------------\n\nmethod serveFile(NvhConn conn, string verb, string rel, string dir): bool {\n    if (rel.contains(\"..\") || rel.contains(chr(92))) {\n        return false\n    }\n    var file = path.join(dir, rel)\n    if (os.isDir(file)) {\n        file = path.join(file, \"index.html\")\n    }\n    if (os.isFile(file) == false) {\n        return false\n    }\n    respond(conn, verb, 200, mimeType(file), os.readFile(file))\n    return true\n}\n\nmethod mimeType(string file): string {\n    var types = {\".html\": \"text/html; charset=utf-8\", \".htm\": \"text/html; charset=utf-8\",\n        \".css\": \"text/css; charset=utf-8\", \".js\": \"text/javascript; charset=utf-8\",\n        \".mjs\": \"text/javascript; charset=utf-8\", \".json\": \"application/json\",\n        \".txt\": \"text/plain; charset=utf-8\", \".svg\": \"image/svg+xml\", \".png\": \"image/png\",\n        \".jpg\": \"image/jpeg\", \".jpeg\": \"image/jpeg\", \".gif\": \"image/gif\", \".webp\": \"image/webp\",\n        \".ico\": \"image/x-icon\", \".woff\": \"font/woff\", \".woff2\": \"font/woff2\",\n        \".wasm\": \"application/wasm\", \".pdf\": \"application/pdf\", \".xml\": \"application/xml\"}\n    var ext = path.extension(file).toLower()\n    if (types.has(ext)) {\n        return types[ext]\n    }\n    return \"application/octet-stream\"\n}\n\n// --- URLs ----------------------------------------------------------------------\n\nmethod segments(string url): array<string> {\n    var out = []\n    for (s in url.split(\"/\")) {\n        if (s != \"\") {\n            out.append(s)\n        }\n    }\n    return out\n}\n\nmethod matches(array<string> pattern, array<string> parts, map<string, string> captured): bool {\n    if (pattern.length() != parts.length()) {\n        return false\n    }\n    var i = 0\n    while (i < pattern.length()) {\n        if (pattern[i].startsWith(\":\")) {\n            captured[pattern[i].substring(1, pattern[i].length())] = parts[i]\n        } else {\n            if (pattern[i] != parts[i]) {\n                return false\n            }\n        }\n        i = i + 1\n    }\n    return true\n}\n\nmethod parseQuery(string query): map<string, string> {\n    var out = {}\n    for (pair in query.split(\"&\")) {\n        if (pair == \"\") {\n            continue\n        }\n        var eq = pair.indexOf(\"=\")\n        if (eq < 0) {\n            out[urlDecode(pair)] = \"\"\n        } else {\n            out[urlDecode(pair.substring(0, eq))] = urlDecode(pair.substring(eq + 1, pair.length()))\n        }\n    }\n    return out\n}\n\n// %XX escapes and + as a space.\nmethod urlDecode(string s): string {\n    if (s.contains(\"%\") == false && s.contains(\"+\") == false) {\n        return s\n    }\n    var out = []\n    var i = 0\n    var n = s.length()\n    while (i < n) {\n        var c = s.charAt(i)\n        if (c == \"+\") {\n            out.append(\" \")\n            i = i + 1\n            continue\n        }\n        if (c == \"%\" && i + 2 < n) {\n            var decoded = bytes.fromHex(s.substring(i + 1, i + 3))\n            if (bytes.size(decoded) == 1) {\n                out.append(decoded)\n                i = i + 3\n                continue\n            }\n        }\n        out.append(c)\n        i = i + 1\n    }\n    return bytes.join(out)\n}\n\n// --- the browser side ------------------------------------------------------------\n\n// The script every live page runs: sends events, applies patches (a small\n// DOM morph that keeps focus and what is being typed) and listens to the\n// view's event stream. When the server lost the view - it restarted - the\n// page reloads itself.\nmethod client(): string {\n    return \"(function(){\nvar V=window.nvView,queue=[],busy=false,pend={};\nvar keys={enter:'Enter',escape:'Escape',esc:'Escape',tab:'Tab',space:' ',up:'ArrowUp',down:'ArrowDown',left:'ArrowLeft',right:'ArrowRight',delete:'Delete',backspace:'Backspace'};\nfunction bkey(el){var b=JSON.parse(el.getAttribute('data-nv-bind'));return b[0]+' '+b[1];}\nfunction send(m){m.v=V;if(m.b){var k=m.c+' '+m.b;pend[k]=(pend[k]||0)+1;}queue.push(m);pump();}\nfunction pump(){\nif(busy||!queue.length)return;\nbusy=true;\nvar m=queue.shift();\nfetch('/_nvh/event',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(m)})\n.then(function(r){return r.json();}).then(apply,function(){})\n.then(function(){if(m.b)pend[m.c+' '+m.b]--;busy=false;pump();});\n}\nfunction apply(d){\nif(d.reload){location.reload();return;}\nvar bar=document.getElementById('nv-error');\nif(d.error){console.error('novus: '+d.error);if(!bar){bar=document.createElement('div');bar.id='nv-error';bar.setAttribute('style','position:fixed;left:1rem;right:1rem;bottom:1rem;padding:.75rem 1rem;background:#b3261e;color:#fff;font:14px/1.4 ui-monospace,monospace;border-radius:.5rem;z-index:2147483647;white-space:pre-wrap');document.body.appendChild(bar);}bar.textContent='Server error: '+d.error;}\nelse if(bar&&(d.p||[]).length){bar.remove();}\n(d.s||[]).forEach(function(css){var st=document.createElement('style');st.textContent=css;document.head.appendChild(st);});\n(d.p||[]).forEach(function(p){\nvar el=document.querySelector('[data-nv='+JSON.stringify(p[0])+']');\nif(!el)return;\nvar t=document.createElement('template');t.innerHTML=p[1];\nvar n=t.content.firstElementChild;if(n)morph(el,n);\n});\nsync(document);\nif(d.go)location.href=d.go;\n}\nfunction morph(a,b){\nif(a.nodeType!==b.nodeType||a.nodeName!==b.nodeName){a.parentNode.replaceChild(document.importNode(b,true),a);return;}\nif(a.nodeType!==1){if(a.nodeValue!==b.nodeValue)a.nodeValue=b.nodeValue;return;}\nvar i,n;\nfor(i=a.attributes.length-1;i>=0;i--){n=a.attributes[i].name;if(!b.hasAttribute(n))a.removeAttribute(n);}\nfor(i=0;i<b.attributes.length;i++){n=b.attributes[i];if(a.getAttribute(n.name)!==n.value)a.setAttribute(n.name,n.value);}\nif(a.tagName==='INPUT'&&settle(a)){if(a.type==='checkbox'||a.type==='radio')a.checked=b.hasAttribute('checked');else if(a.value!==(b.getAttribute('value')||''))a.value=b.getAttribute('value')||'';}\nvar x=a.firstChild,y=b.firstChild,nx,ny;\nwhile(y){ny=y.nextSibling;if(!x){a.appendChild(document.importNode(y,true));}else{nx=x.nextSibling;morph(x,y);x=nx;}y=ny;}\nwhile(x){nx=x.nextSibling;a.removeChild(x);x=nx;}\n}\nfunction settle(el){\nif(el!==document.activeElement)return true;\nreturn el.hasAttribute('data-nv-bind')&&!pend[bkey(el)];\n}\nfunction sync(root){\nroot.querySelectorAll('[data-nv-value]').forEach(function(el){var v=el.getAttribute('data-nv-value');if(settle(el)&&el.value!==v)el.value=v;});\n}\nfunction valueOf(el,type){\nif(type==='submit'){var o={};new FormData(el).forEach(function(v,k){o[k]=v;});return o;}\nif(el.type==='checkbox'||el.type==='radio')return el.checked;\nreturn el.value===undefined?null:el.value;\n}\n['click','dblclick','input','change','submit','keydown','keyup','focusin','focusout'].forEach(function(type){\ndocument.addEventListener(type,function(e){\nvar el=e.target;\nif(!el||!el.closest)return;\nif((type==='input'||type==='change')&&el.hasAttribute('data-nv-bind')){\nvar box=el.type==='checkbox',whole=box||el.type==='radio'||el.tagName==='SELECT';\nif(type===(whole?'change':'input')){var b=JSON.parse(el.getAttribute('data-nv-bind'));send({c:b[0],b:b[1],val:box?el.checked:el.value});}\n}\nvar name=type==='focusin'?'focus':type==='focusout'?'blur':type;\nvar t=el.closest('[data-nv-'+name+']');\nif(!t)return;\nvar spec=JSON.parse(t.getAttribute('data-nv-'+name)),mods=(spec[3]||'').split(' ');\nvar want=mods.filter(function(m){return keys[m];}).map(function(m){return keys[m];});\nif(want.length&&want.indexOf(e.key)<0)return;\nif(name==='submit'||mods.indexOf('prevent')>=0)e.preventDefault();\nif(mods.indexOf('stop')>=0)e.stopPropagation();\nvar val=valueOf(t,name);\nsend({c:spec[0],h:spec[1],a:(spec[2]||[]).map(function(a){return a&&a['" + chr(36) + "nv']==='value'?val:a;})});\n});\n});\nsync(document);\nif(window.EventSource){\nvar es=new EventSource('/_nvh/live?v='+encodeURIComponent(V));\nes.onmessage=function(m){apply(JSON.parse(m.data));};\nes.onerror=function(){if(es.readyState===2)setTimeout(function(){location.reload();},500);};\n}\n})();\"\n}\n"
    }
    if (name == "yaml") {
        return "package yaml\n\nimport json\n\n// YAML configuration files (.yaml, .yml): parse, stringify, load and save.\n//\n//     var config = yaml.load(\"app.yml\")\n//     for (host in config[\"servers\"]) { ... }\n//\n// The configuration subset of YAML 1.2: block mappings and sequences by\n// indentation, flow collections ([a, b], {k: v}), plain, 'single' and\n// \"double\" quoted scalars, block scalars (| and >, with - and + chomping),\n// comments and a leading --- document marker. Scalars resolve to integers\n// (also 0x.., 0o..), floats (also .inf, .nan), true/false and null (nothing);\n// everything else is a string. Anchors, aliases, tags and several documents\n// in one file are not supported. Invalid input is a runtime error naming the\n// line; parseOr() and isValid() check without one.\n\nmethod parse(string text): object {\n    var p = YamlParser{lines=[], numbers=[], at=0}\n    p.prepare(text)\n    return p.document()\n}\n\n// The parsed text, or `fallback` when it is not valid YAML.\nmethod parseOr(string text, object fallback): object {\n    var result = tryRun(YamlTask{text=text})\n    if (tryFailed()) {\n        return fallback\n    }\n    return result\n}\n\nmethod isValid(string text): bool {\n    tryRun(YamlTask{text=text})\n    return tryFailed() == false\n}\n\n// The message of why `text` is not valid YAML (\"\" when it is).\nmethod errorOf(string text): string {\n    tryRun(YamlTask{text=text})\n    return tryError()\n}\n\nmethod load(string file): object {\n    if (fileExists(file) == false) {\n        raise(\"yaml: cannot open '\" + file + \"'\")\n    }\n    return parse(readFile(file))\n}\n\nmethod save(object value, string file) {\n    writeFile(file, stringify(value))\n}\n\n// A value as a YAML document in block style.\nmethod stringify(object value): string {\n    var out = []\n    writeValue(value, 0, out)\n    var text = out.join(\"\")\n    if (text.endsWith(\"\\n\") == false) {\n        text = text + \"\\n\"\n    }\n    return text\n}\n\nmethod tryRun(object task): object native \"nv_try_run\"\nmethod tryFailed(): bool native \"nv_try_failed\"\nmethod tryError(): string native \"nv_try_error\"\nmethod raise(string message) native \"nv_try_raise\"\n\n// nothing: what YAML's null becomes\nmethod none(): object {\n}\n\n// --- writing ---------------------------------------------------------------\n\nmethod spaces(integer n): string {\n    var s = \"\"\n    var i = 0\n    while (i < n) {\n        s = s + \" \"\n        i = i + 1\n    }\n    return s\n}\n\nmethod isCollection(object v): bool {\n    var kind = typeOf(v)\n    return (kind == \"map\" || kind == \"array\") && v.length() > 0\n}\n\n// Appends `value` as the content of a line already started (after \"key:\" or\n// \"- \"), continuing on indented lines when it is a collection.\nmethod writeValue(object value, integer indent, array<string> out): integer {\n    var kind = typeOf(value)\n    if (kind == \"map\" && value.length() > 0) {\n        for (key in value) {\n            var v = value[key]\n            out.append(spaces(indent) + scalarText(key) + \":\")\n            if (isCollection(v)) {\n                out.append(\"\\n\")\n                if (typeOf(v) == \"array\") {\n                    writeValue(v, indent, out)\n                } else {\n                    writeValue(v, indent + 2, out)\n                }\n            } else {\n                out.append(\" \" + scalarText(v) + \"\\n\")\n            }\n        }\n        return 0\n    }\n    if (kind == \"array\" && value.length() > 0) {\n        for (item in value) {\n            if (typeOf(item) == \"map\" && item.length() > 0) {\n                // - first: 1\n                //   second: 2\n                var inner = []\n                writeValue(item, indent + 2, inner)\n                var text = inner.join(\"\")\n                out.append(spaces(indent) + \"- \" + text.substring(indent + 2, text.length()))\n            } else if (typeOf(item) == \"array\" && item.length() > 0) {\n                out.append(spaces(indent) + \"-\\n\")\n                writeValue(item, indent + 2, out)\n            } else {\n                out.append(spaces(indent) + \"- \" + scalarText(item) + \"\\n\")\n            }\n        }\n        return 0\n    }\n    out.append(spaces(indent) + scalarText(value) + \"\\n\")\n    return 0\n}\n\nmethod scalarText(object v): string {\n    var kind = typeOf(v)\n    if (kind == \"unknown\") {\n        return \"null\"\n    }\n    if (kind == \"integer\" || kind == \"bool\") {\n        return \"\" + v\n    }\n    if (kind == \"float\") {\n        return json.stringify(v)\n    }\n    if (kind == \"map\") {\n        return \"{}\"\n    }\n    if (kind == \"array\") {\n        return \"[]\"\n    }\n    var s = \"\" + v\n    if (needsQuotes(s)) {\n        return json.stringify(s)\n    }\n    return s\n}\n\n// Would the plain scalar be read back as something else?\nmethod needsQuotes(string s): bool {\n    if (s == \"\" || s.trim() != s) {\n        return true\n    }\n    if (typeOf(resolve(s)) != \"string\") {\n        return true\n    }\n    var first = s.charAt(0)\n    var specials = \"-?:,[]{}#&*!|>'\\\"%@`\"\n    if (specials.contains(first)) {\n        return true\n    }\n    if (s.contains(\": \") || s.contains(\" #\") || s.endsWith(\":\") || s.contains(\"\\n\") || s.contains(\"\\t\")) {\n        return true\n    }\n    return false\n}\n\n// --- reading ---------------------------------------------------------------\n\n// A plain scalar's value: null, bool, integer, float or the text itself.\nmethod resolve(string s): object {\n    if (s == \"\" || s == \"~\" || s == \"null\" || s == \"Null\" || s == \"NULL\") {\n        return none()\n    }\n    if (s == \"true\" || s == \"True\" || s == \"TRUE\") {\n        return true\n    }\n    if (s == \"false\" || s == \"False\" || s == \"FALSE\") {\n        return false\n    }\n    var body = s\n    var negative = false\n    if (body.startsWith(\"-\") || body.startsWith(\"+\")) {\n        negative = body.startsWith(\"-\")\n        body = body.substring(1, body.length())\n    }\n    if (body == \".inf\" || body == \".Inf\" || body == \".INF\") {\n        if (negative) {\n            return parseFloat(\"-inf\")\n        }\n        return parseFloat(\"inf\")\n    }\n    if (s == \".nan\" || s == \".NaN\" || s == \".NAN\") {\n        return parseFloat(\"nan\")\n    }\n    if (body.startsWith(\"0x\") || body.startsWith(\"0o\")) {\n        var base = 16\n        if (body.startsWith(\"0o\")) {\n            base = 8\n        }\n        var n = 0\n        var i = 2\n        if (body.length() == 2) {\n            return s\n        }\n        while (i < body.length()) {\n            var d = hexDigit(body.charAt(i))\n            if (d < 0 || d >= base) {\n                return s\n            }\n            n = n * base + d\n            i = i + 1\n        }\n        if (negative) {\n            return 0 - n\n        }\n        return n\n    }\n    if (allDigits(body)) {\n        if (negative) {\n            return 0 - parseInt(body)\n        }\n        return parseInt(body)\n    }\n    if (isFloatText(body)) {\n        var text = body\n        if (text.startsWith(\".\")) {\n            text = \"0\" + text\n        }\n        if (negative) {\n            return 0.0 - parseFloat(text)\n        }\n        return parseFloat(text)\n    }\n    return s\n}\n\nmethod allDigits(string s): bool {\n    if (s == \"\") {\n        return false\n    }\n    var i = 0\n    while (i < s.length()) {\n        if (s.charAt(i) < \"0\" || s.charAt(i) > \"9\") {\n            return false\n        }\n        i = i + 1\n    }\n    return true\n}\n\n// YAML 1.2 core schema floats: (.5 | 1 | 1. | 1.5)([eE][-+]?9)?, unsigned.\nmethod isFloatText(string s): bool {\n    var mantissa = s\n    var exponent = \"\"\n    var e = s.indexOf(\"e\")\n    if (e < 0) {\n        e = s.indexOf(\"E\")\n    }\n    if (e >= 0) {\n        mantissa = s.substring(0, e)\n        exponent = s.substring(e + 1, s.length())\n        if (exponent.startsWith(\"+\") || exponent.startsWith(\"-\")) {\n            exponent = exponent.substring(1, exponent.length())\n        }\n        if (allDigits(exponent) == false) {\n            return false\n        }\n    }\n    var dot = mantissa.indexOf(\".\")\n    if (dot < 0) {\n        return e >= 0 && allDigits(mantissa)\n    }\n    var whole = mantissa.substring(0, dot)\n    var fraction = mantissa.substring(dot + 1, mantissa.length())\n    if (whole == \"\") {\n        return allDigits(fraction)\n    }\n    return allDigits(whole) && (fraction == \"\" || allDigits(fraction))\n}\n\nmethod hexDigit(string c): integer {\n    if (c >= \"0\" && c <= \"9\") {\n        return ord(c) - ord(\"0\")\n    }\n    if (c >= \"a\" && c <= \"f\") {\n        return ord(c) - ord(\"a\") + 10\n    }\n    if (c >= \"A\" && c <= \"F\") {\n        return ord(c) - ord(\"A\") + 10\n    }\n    return 0 - 1\n}\n\nmethod indentOf(string line): integer {\n    var i = 0\n    while (i < line.length() && line.charAt(i) == \" \") {\n        i = i + 1\n    }\n    return i\n}\n\n// The line without a trailing comment (a # at the start or after a space,\n// outside quotes).\nmethod stripComment(string line): string {\n    var quote = \"\"\n    var i = 0\n    while (i < line.length()) {\n        var c = line.charAt(i)\n        if (quote != \"\") {\n            if (c == \"\\\\\" && quote == \"\\\"\") {\n                i = i + 2\n                continue\n            }\n            if (c == quote) {\n                quote = \"\"\n            }\n        } else if (c == \"\\\"\" || c == \"'\") {\n            if (i == 0 || line.charAt(i - 1) == \" \" || line.charAt(i - 1) == \"[\" || line.charAt(i - 1) == \"{\" || line.charAt(i - 1) == \",\") {\n                quote = c\n            }\n        } else if (c == \"#\" && (i == 0 || line.charAt(i - 1) == \" \" || line.charAt(i - 1) == \"\\t\")) {\n            return line.substring(0, i)\n        }\n        i = i + 1\n    }\n    return line\n}\n\n// Index of the ':' that separates a mapping key from its value (followed by\n// a space or the end of the line, outside quotes and brackets), -1 if none.\nmethod keyColon(string s): integer {\n    var quote = \"\"\n    var depth = 0\n    var i = 0\n    while (i < s.length()) {\n        var c = s.charAt(i)\n        if (quote != \"\") {\n            if (c == \"\\\\\" && quote == \"\\\"\") {\n                i = i + 2\n                continue\n            }\n            if (c == quote) {\n                quote = \"\"\n            }\n        } else if ((c == \"\\\"\" || c == \"'\") && i == 0) {\n            quote = c\n        } else if (c == \"[\" || c == \"{\") {\n            depth = depth + 1\n        } else if (c == \"]\" || c == \"}\") {\n            depth = depth - 1\n        } else if (c == \":\" && depth == 0 && (i + 1 == s.length() || s.charAt(i + 1) == \" \")) {\n            return i\n        }\n        i = i + 1\n    }\n    return 0 - 1\n}\n\nmethod isSequenceItem(string content): bool {\n    return content == \"-\" || content.startsWith(\"- \")\n}\n\ndefine class YamlTask {\n    private string text: get, set\n\n    method run(): object {\n        return yaml.parse(text)\n    }\n}\n\n// The document as lines (tabs kept out of indentation, comments dropped for\n// all but block scalars) and a cursor over them.\ndefine class YamlParser {\n    private array<string> lines: get, set\n    private array<integer> numbers: get, set\n    private integer at: get, set\n    private array<string> raw\n\n    method fail(integer lineNumber, string message) {\n        raise(\"yaml: line \" + lineNumber + \": \" + message)\n    }\n\n    method prepare(string text) {\n        raw = text.replace(\"\\r\\n\", \"\\n\").split(\"\\n\")\n        var started = false\n        var n = 0\n        while (n < raw.length()) {\n            var line = raw[n]\n            var trimmed = line.trim()\n            if (trimmed == \"---\" || trimmed.startsWith(\"--- \")) {\n                if (started) {\n                    // only the first document\n                    return\n                }\n                started = true\n                n = n + 1\n                continue\n            }\n            if (trimmed == \"...\") {\n                return\n            }\n            lines.append(line)\n            numbers.append(n + 1)\n            n = n + 1\n        }\n    }\n\n    // The next line that has content (skipping blank and comment-only ones).\n    method skipBlank() {\n        while (at < lines.length() && stripComment(lines[at]).trim() == \"\") {\n            at = at + 1\n        }\n    }\n\n    method document(): object {\n        skipBlank()\n        if (at >= lines.length()) {\n            return none()\n        }\n        var indent = indentOf(lines[at])\n        var value = block(indent)\n        skipBlank()\n        if (at < lines.length()) {\n            fail(numbers[at], \"unexpected indentation\")\n        }\n        return value\n    }\n\n    // The collection or scalar starting at the current line, whose lines are\n    // indented by `indent`.\n    method block(integer indent): object {\n        skipBlank()\n        var line = lines[at]\n        if (line.contains(\"\\t\") && indentOf(line) < line.length() && line.substring(0, indentOf(line) + 1).contains(\"\\t\")) {\n            fail(numbers[at], \"tabs cannot indent YAML\")\n        }\n        var content = stripComment(line).trim()\n        if (isSequenceItem(content)) {\n            return sequence(indent)\n        }\n        if (keyColon(content) >= 0 && content.startsWith(\"[\") == false && content.startsWith(\"{\") == false) {\n            return mapping(indent)\n        }\n        // a lone scalar or flow collection, possibly over several lines\n        var number = numbers[at]\n        var text = content\n        at = at + 1\n        while (open(text) && at < lines.length()) {\n            text = text + \" \" + stripComment(lines[at]).trim()\n            at = at + 1\n        }\n        return inlineValue(text, number)\n    }\n\n    method sequence(integer indent): array {\n        var items = []\n        while (true) {\n            skipBlank()\n            if (at >= lines.length()) {\n                return items\n            }\n            var line = lines[at]\n            var content = stripComment(line).trim()\n            if (indentOf(line) != indent || isSequenceItem(content) == false) {\n                if (indentOf(line) > indent) {\n                    fail(numbers[at], \"unexpected indentation in a sequence\")\n                }\n                return items\n            }\n            var k = 1\n            while (k < content.length() && content.charAt(k) == \" \") {\n                k = k + 1\n            }\n            var rest = content.substring(k, content.length())\n            if (rest == \"\") {\n                at = at + 1\n                skipBlank()\n                if (at < lines.length() && indentOf(lines[at]) > indent) {\n                    items.append(block(indentOf(lines[at])))\n                } else {\n                    items.append(none())\n                }\n                continue\n            }\n            // \"- key: value\" or \"- - x\": the item is a block starting inside\n            // this line; parse it with the dash turned into indentation\n            lines[at] = spaces(indent + k) + rest\n            items.append(block(indent + k))\n        }\n        return items\n    }\n\n    method mapping(integer indent): map<string, object> {\n        var result = {}\n        while (true) {\n            skipBlank()\n            if (at >= lines.length()) {\n                return result\n            }\n            var line = lines[at]\n            var number = numbers[at]\n            if (indentOf(line) != indent) {\n                if (indentOf(line) > indent) {\n                    fail(number, \"unexpected indentation\")\n                }\n                return result\n            }\n            var content = stripComment(line).trim()\n            if (isSequenceItem(content)) {\n                return result\n            }\n            var colon = keyColon(content)\n            if (colon < 0) {\n                fail(number, \"expected 'key: value'\")\n            }\n            var key = keyText(content.substring(0, colon).trim(), number)\n            if (result.has(key)) {\n                fail(number, \"duplicate key '\" + key + \"'\")\n            }\n            var rest = content.substring(colon + 1, content.length()).trim()\n            at = at + 1\n            if (rest == \"\") {\n                skipBlank()\n                if (at < lines.length() && (indentOf(lines[at]) > indent || (indentOf(lines[at]) == indent && isSequenceItem(stripComment(lines[at]).trim())))) {\n                    result[key] = block(indentOf(lines[at]))\n                } else {\n                    result[key] = none()\n                }\n                continue\n            }\n            if (rest.startsWith(\"|\") || rest.startsWith(\">\")) {\n                result[key] = blockScalar(rest, indent, number)\n                continue\n            }\n            var text = rest\n            while (open(text) && at < lines.length()) {\n                text = text + \" \" + stripComment(lines[at]).trim()\n                at = at + 1\n            }\n            // plain scalars may continue on more indented lines\n            if (text.startsWith(\"\\\"\") == false && text.startsWith(\"'\") == false && text.startsWith(\"[\") == false && text.startsWith(\"{\") == false) {\n                while (at < lines.length() && stripComment(lines[at]).trim() != \"\" && indentOf(lines[at]) > indent && keyColon(stripComment(lines[at]).trim()) < 0) {\n                    text = text + \" \" + stripComment(lines[at]).trim()\n                    at = at + 1\n                }\n            }\n            result[key] = inlineValue(text, number)\n        }\n        return result\n    }\n\n    method keyText(string key, integer number): string {\n        if (key.startsWith(\"\\\"\") || key.startsWith(\"'\")) {\n            var v = inlineValue(key, number)\n            return \"\" + v\n        }\n        return key\n    }\n\n    // Has the flow collection or quoted scalar not ended on this line yet?\n    method open(string text): bool {\n        var depth = 0\n        var quote = \"\"\n        var previous = \"\"\n        var i = 0\n        while (i < text.length()) {\n            var c = text.charAt(i)\n            if (quote != \"\") {\n                if (c == \"\\\\\" && quote == \"\\\"\") {\n                    i = i + 2\n                    continue\n                }\n                if (c == quote) {\n                    quote = \"\"\n                }\n            } else if ((c == \"\\\"\" || c == \"'\") && (previous == \"\" || previous == \"[\" || previous == \"{\" || previous == \",\" || previous == \":\")) {\n                // a quote starts a scalar only where one begins: it's stays plain\n                quote = c\n            } else if (c == \"[\" || c == \"{\") {\n                depth = depth + 1\n            } else if (c == \"]\" || c == \"}\") {\n                depth = depth - 1\n            }\n            if (c != \" \" && c != \"\\t\") {\n                previous = c\n            }\n            i = i + 1\n        }\n        return depth > 0 || quote != \"\"\n    }\n\n    // | and > scalars: the more indented lines that follow, literally or\n    // folded, with the final line break kept (clip), dropped (-) or all\n    // trailing breaks kept (+).\n    method blockScalar(string header, integer indent, integer number): string {\n        var folded = header.startsWith(\">\")\n        var chomp = \"\"\n        if (header.contains(\"-\")) {\n            chomp = \"-\"\n        }\n        if (header.contains(\"+\")) {\n            chomp = \"+\"\n        }\n        var body = []\n        var width = 0 - 1\n        while (at < lines.length()) {\n            var line = lines[at]\n            if (line.trim() == \"\") {\n                body.append(\"\")\n                at = at + 1\n                continue\n            }\n            if (indentOf(line) <= indent) {\n                break\n            }\n            if (width < 0) {\n                width = indentOf(line)\n            }\n            if (indentOf(line) < width) {\n                fail(numbers[at], \"a block scalar's lines need the indentation of its first line\")\n            }\n            body.append(line.substring(width, line.length()))\n            at = at + 1\n        }\n        var trailing = 0\n        while (body.length() > 0 && body[body.length() - 1] == \"\") {\n            body.pop()\n            trailing = trailing + 1\n        }\n        var text = \"\"\n        if (folded) {\n            var i = 0\n            while (i < body.length()) {\n                var part = body[i]\n                if (i > 0) {\n                    if (part == \"\" || body[i - 1] == \"\" || part.startsWith(\" \") || body[i - 1].startsWith(\" \")) {\n                        text = text + \"\\n\"\n                    } else {\n                        text = text + \" \"\n                    }\n                }\n                text = text + part\n                i = i + 1\n            }\n        } else {\n            text = body.join(\"\\n\")\n        }\n        if (body.length() == 0) {\n            return \"\"\n        }\n        if (chomp == \"-\") {\n            return text\n        }\n        if (chomp == \"+\") {\n            var k = 0\n            text = text + \"\\n\"\n            while (k < trailing) {\n                text = text + \"\\n\"\n                k = k + 1\n            }\n            return text\n        }\n        return text + \"\\n\"\n    }\n\n    // A scalar or a flow collection written on one (joined) line.\n    method inlineValue(string text, integer number): object {\n        var f = YamlFlow{text=text, at=0, line=number, depth=0}\n        var value = f.value()\n        f.skipSpaces()\n        if (f.done() == false) {\n            fail(number, \"unexpected text after the value: \" + text.substring(f.at(), text.length()))\n        }\n        return value\n    }\n}\n\n// Flow style: [a, b], {k: v}, quoted and plain scalars.\ndefine class YamlFlow {\n    private string text: get, set\n    private integer at: get, set\n    private integer line: get, set\n    private integer depth: get, set\n\n    method fail(string message) {\n        raise(\"yaml: line \" + line + \": \" + message)\n    }\n\n    method done(): bool {\n        return at >= text.length()\n    }\n\n    method peek(): string {\n        if (at >= text.length()) {\n            return \"\"\n        }\n        return text.charAt(at)\n    }\n\n    method skipSpaces() {\n        while (peek() == \" \" || peek() == \"\\t\") {\n            at = at + 1\n        }\n    }\n\n    method value(): object {\n        skipSpaces()\n        var c = peek()\n        if (c == \"[\") {\n            return list()\n        }\n        if (c == \"{\") {\n            return mapValue()\n        }\n        if (c == \"\\\"\") {\n            return doubleQuoted()\n        }\n        if (c == \"'\") {\n            return singleQuoted()\n        }\n        return plain(true)\n    }\n\n    method list(): array {\n        at = at + 1\n        depth = depth + 1\n        var items = []\n        while (true) {\n            skipSpaces()\n            if (peek() == \"]\") {\n                at = at + 1\n                depth = depth - 1\n                return items\n            }\n            if (done()) {\n                fail(\"unclosed [\")\n            }\n            items.append(value())\n            skipSpaces()\n            if (peek() == \",\") {\n                at = at + 1\n            } else if (peek() != \"]\") {\n                fail(\"expected ',' or ']'\")\n            }\n        }\n        return items\n    }\n\n    method mapValue(): map<string, object> {\n        at = at + 1\n        depth = depth + 1\n        var result = {}\n        while (true) {\n            skipSpaces()\n            if (peek() == \"}\") {\n                at = at + 1\n                depth = depth - 1\n                return result\n            }\n            if (done()) {\n                fail(\"unclosed {\")\n            }\n            var key = \"\"\n            if (peek() == \"\\\"\") {\n                key = doubleQuoted()\n            } else if (peek() == \"'\") {\n                key = singleQuoted()\n            } else {\n                key = \"\" + plain(false)\n            }\n            skipSpaces()\n            if (peek() != \":\") {\n                fail(\"expected ':' after '\" + key + \"'\")\n            }\n            at = at + 1\n            result[key] = value()\n            skipSpaces()\n            if (peek() == \",\") {\n                at = at + 1\n            } else if (peek() != \"}\") {\n                fail(\"expected ',' or '}'\")\n            }\n        }\n        return result\n    }\n\n    // Up to the next delimiter: inside a flow collection , ] } end it, and\n    // a key's plain scalar also ends at ':'.\n    method plain(bool isValue): object {\n        var start = at\n        while (done() == false) {\n            var c = peek()\n            if (depth > 0 && (c == \",\" || c == \"]\" || c == \"}\")) {\n                break\n            }\n            if (c == \":\" && (isValue == false || at + 1 >= text.length() || text.charAt(at + 1) == \" \")) {\n                if (isValue == false) {\n                    break\n                }\n            }\n            at = at + 1\n        }\n        var s = text.substring(start, at).trim()\n        if (isValue) {\n            return resolve(s)\n        }\n        return s\n    }\n\n    method doubleQuoted(): string {\n        at = at + 1\n        var out = []\n        while (true) {\n            if (done()) {\n                fail(\"unclosed \\\" string\")\n            }\n            var c = peek()\n            at = at + 1\n            if (c == \"\\\"\") {\n                return out.join(\"\")\n            }\n            if (c != \"\\\\\") {\n                out.append(c)\n                continue\n            }\n            var e = peek()\n            at = at + 1\n            if (e == \"n\") {\n                out.append(\"\\n\")\n            } else if (e == \"t\") {\n                out.append(\"\\t\")\n            } else if (e == \"r\") {\n                out.append(\"\\r\")\n            } else if (e == \"0\") {\n                out.append(chr(0))\n            } else if (e == \"e\") {\n                out.append(chr(27))\n            } else if (e == \"u\" || e == \"x\" || e == \"U\") {\n                var count = 4\n                if (e == \"x\") {\n                    count = 2\n                }\n                if (e == \"U\") {\n                    count = 8\n                }\n                var code = 0\n                var i = 0\n                while (i < count) {\n                    var d = hexDigit(peek())\n                    if (d < 0) {\n                        fail(\"invalid \\\\\" + e + \" escape\")\n                    }\n                    code = code * 16 + d\n                    at = at + 1\n                    i = i + 1\n                }\n                out.append(utf8(code))\n            } else {\n                out.append(e)\n            }\n        }\n        return \"\"\n    }\n\n    method singleQuoted(): string {\n        at = at + 1\n        var out = []\n        while (true) {\n            if (done()) {\n                fail(\"unclosed ' string\")\n            }\n            var c = peek()\n            at = at + 1\n            if (c == \"'\") {\n                if (peek() == \"'\") {\n                    out.append(\"'\")\n                    at = at + 1\n                    continue\n                }\n                return out.join(\"\")\n            }\n            out.append(c)\n        }\n        return \"\"\n    }\n}\n\n// The UTF-8 bytes of a code point.\nmethod utf8(integer code): string {\n    if (code < 128) {\n        return chr(code)\n    }\n    if (code < 2048) {\n        return chr(192 + code / 64) + chr(128 + code % 64)\n    }\n    if (code < 65536) {\n        return chr(224 + code / 4096) + chr(128 + (code / 64) % 64) + chr(128 + code % 64)\n    }\n    return chr(240 + code / 262144) + chr(128 + (code / 4096) % 64) + chr(128 + (code / 64) % 64) + chr(128 + code % 64)\n}\n"
    }
    if (name == "zlib") {
        return "package zlib\n\n// Deflate compression in the zlib container (RFC 1950/1951).\n//\n// Implemented in the runtime itself rather than against the system zlib, so a\n// program that compresses still needs nothing but a C compiler. Inflate reads\n// all three block types; compress writes fixed Huffman blocks.\n\n// Compresses to a zlib stream (78 9C header, Adler-32 trailer).\nmethod compress(string data): string native \"nv_zlib_compress\"\n\n// Decompresses a zlib stream. `limit` caps the output so that a small\n// hostile input cannot expand without bound; 0 means no limit. Returns \"\"\n// and sets failed() when the stream is damaged or exceeds the limit.\nmethod decompress(string data, integer limit): string native \"nv_zlib_decompress\"\n\nmethod failed(): bool native \"nv_zlib_failed\"\n\n// Decompression without an output limit.\nmethod inflate(string data): string {\n    return decompress(data, 0)\n}\n"
    }
    return ""
}
