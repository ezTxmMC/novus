== all directives
  dir=/work/app name=[github.com/user/app] version=[0.1.0] main=[cmd/main.nv] lib=[lib.nv] output=[tool]
  entry=lib.nv mainPath=/work/app/cmd/main.nv executable=tool
  directive line 1 project [github.com/user/app] key 11-18 values [19-40]
  directive line 2 version [0.1.0] key 41-48 values [49-56]
  directive line 3 main [cmd/main.nv] key 57-61 values [62-75]
  directive line 4 lib [lib.nv] key 76-79 values [80-88]
  directive line 5 output [tool] key 89-95 values [96-102]
  directive line 6 novus [0.1.0-pre.alpha.2] key 103-108 values [109-128]
  directive line 7 require [github.com/user/lib, v1.2.0] key 129-136 values [137-158 159-167]
  directive line 8 replace [github.com/user/lib, ../lib] key 168-175 values [176-197 198-206]
