  "Run a task so that a runtime error becomes a value": {
    "body": [
      "method tryRun(object task): object native \"nv_try_run\"",
      "method tryFailed(): bool native \"nv_try_failed\"",
      "method tryError(): string native \"nv_try_error\"",
      "",
      "define class ${1:GuardedTask} {",
      "\tmethod run(): object {",
      "\t\t$0",
      "\t\treturn 0",
      "\t}",
      "}"
    ],
    "description": "Run a task so that a runtime error becomes a value (natives as in std/toml.nv). Insert once per package: a second copy duplicates the three native declarations",
