{
  "package": {
    "prefix": "package",
    "body": [
      "package ${1:main}",
      "",
      "$0"
    ],
    "description": "Package declaration"
  },
  "import": {
    "prefix": "import",
    "body": [
      "import ${1:module}"
    ],
    "description": "Import a module"
  },
  "main": {
    "prefix": "main",
    "body": [
      "method main {",
      "\t$0",
      "}"
    ],
    "description": "Program entry point"
  },
  "main with args": {
    "prefix": "mainargs",
    "body": [
      "method main(array<string> args) {",
      "\t$0",
      "}"
    ],
    "description": "Program entry point receiving arguments"
  },
  "method": {
    "prefix": "method",
    "body": [
      "method ${1:name}(${2:integer value})${3:: ${4:integer}} {",
      "\t$0",
      "}"
    ],
    "description": "Method declaration"
  },
  "method without parameters": {
    "prefix": "methodv",
    "body": [
      "method ${1:name} {",
      "\t$0",
      "}"
    ],
    "description": "Method declaration without parameter list"
  },
  "abstract method": {
    "prefix": "abstract",
    "body": [
      "abstract method ${1:name}(${2})${3:: ${4:bool}}"
    ],
    "description": "Abstract method signature"
  },
  "class": {
    "prefix": "class",
    "body": [
      "define class ${1:Name}${2: based ${3:Base}} {",
      "\tprivate final ${4:string} ${5:field}: get, set",
      "",
      "\tconstruct(${4:string} ${5:field}) {",
      "\t\tthis.${5:field} = ${5:field}",
      "\t}",
      "",
      "\t$0",
      "}"
    ],
    "description": "Class definition with constructor"
  },
  "class with primary constructor": {
    "prefix": "classp",
    "body": [
      "define class ${1:Name}(${2:string} ${3:field}) {",
      "\tprivate final ${2:string} ${3:field}: get, set",
      "\t$0",
      "}"
    ],
    "description": "Class definition with primary constructor parameters"
  },
  "abstract class": {
    "prefix": "abstractclass",
    "body": [
      "define abstract ${1:Name} {",
      "\tabstract method ${2:name}(): ${3:bool}",
      "\t$0",
      "}"
    ],
    "description": "Abstract class definition"
  },
  "interface": {
    "prefix": "interface",
    "body": [
      "define interface ${1:IName} {",
      "\t${2:method}()",
      "\t$0",
      "}"
    ],
    "description": "Interface definition"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "define enum ${1:Name} {",
      "\t${2:FIRST}(\"${3:first}\"),",
      "\t${4:SECOND}(\"${5:second}\");",
      "",
      "\tprivate final string text: get",
      "",
      "\tprivate construct(string text) {",
      "\t\tthis.text = text",
      "\t}",
      "}"
    ],
    "description": "Enum definition with constructor"
  },
  "annotation": {
    "prefix": "annotation",
    "body": [
      "define annotation ${1:Name} {",
      "\t${2:text}(): ${3:string}",
      "\t$0",
      "}"
    ],
    "description": "Annotation definition"
  },
  "construct": {
    "prefix": "construct",
    "body": [
      "construct(${1:string} ${2:name}) {",
      "\tthis.${2:name} = ${2:name}",
      "\t$0",
      "}"
    ],
    "description": "Constructor"
  },
  "field": {
    "prefix": "field",
    "body": [
      "private final ${1:string} ${2:name}: ${3|get,get\\, set,set|}"
    ],
    "description": "Field with accessors"
  },
  "var": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value}"
    ],
    "description": "Variable declaration"
  },
  "typed var": {
    "prefix": "vart",
    "body": [
      "var ${1:name}: ${2:integer} = ${3:value}"
    ],
    "description": "Variable declaration with explicit type"
  },
  "println": {
    "prefix": "println",
    "body": [
      "println \"${1:text}\""
    ],
    "description": "Print a line"
  },
  "println interpolated": {
    "prefix": "printf",
    "body": [
      "println \"${1:text} \\${${2:value}}\""
    ],
    "description": "Print a line with string interpolation"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "If statement"
  },
  "if else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If / else statement"
  },
  "for in": {
    "prefix": "for",
    "body": [
      "for (${1:item} in ${2:items}) {",
      "\t$0",
      "}"
    ],
    "description": "For-in loop"
  },
  "for index": {
    "prefix": "fori",
    "body": [
      "for (var ${1:i} = 0; ${1:i} < ${2:count}; ${1:i} = ${1:i} + 1) {",
      "\t$0",
      "}"
    ],
    "description": "Counted for loop"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "struct init": {
    "prefix": "new",
    "body": [
      "${1:Type}{",
      "\t${2:field}=${3:value}",
      "}"
    ],
    "description": "Initialize an object with named fields"
  },
  "deprecated": {
    "prefix": "@Deprecated",
    "body": [
      "@Deprecated{",
      "\ttext=\"${1:Reason}\",",
      "\tsince=\"${2:0.1.0}\"",
      "}"
    ],
    "description": "Mark a member as deprecated"
  },
  "doc comment": {
    "prefix": "doc",
    "body": [
      "/**",
      " * ${1:Description}",
      " */"
    ],
    "description": "Documentation comment"
  },
  "Print to stderr": {
    "prefix": "eprintln",
    "body": [
      "eprintln \"${1:message}\""
    ],
    "description": "Print a line to standard error"
  },
  "Print without newline": {
    "prefix": "print",
    "body": [
      "print ${1:value}"
    ],
    "description": "Print without a line break"
  },
  "Run a command": {
    "prefix": "exec",
    "body": [
      "var ${1:code} = os.exec(\"${2:command}\")"
    ],
    "description": "Run a shell command (import os)"
  },
  "HTTP request": {
    "prefix": "http",
    "body": [
      "var ${1:response} = http.request(\"${2:GET}\", \"${3:https://example.com}\", ${4:\"\"}, {})",
      "if (${1:response}[\"ok\"]) {",
      "\t$0",
      "}"
    ],
    "description": "HTTP request with status/body/headers (import http)"
  }
}
