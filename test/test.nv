package main

method main {
    println intAdd(10, 5)
    println floatAdd(3.5, 2.5)
    println mixedAdd(10, 5.5)
    println floatToInt(7.9)
    println intToFloat(42)
    println floatPercent(10, 3)
}

method intAdd(integer a, integer b): integer {
    return a + b
}

method floatAdd(float a, float b): float {
    return a + b
}

method floatPercent(float a, float b): float {
    return a % b
}

method mixedAdd(integer a, float b): float {
    return a + b
}

method floatToInt(float x): integer {
    return x
}

method intToFloat(integer x): float {
    return x
}
