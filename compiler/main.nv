package main

import "driver/build.nv"
import "driver/cli.nv"

// novusc - the Novus compiler driver.
//
//   novusc run [file.nv] [args...]        compile to a temporary binary and run it
//   novusc build [file.nv] [options]      compile to a native executable
//   novusc emit [file.nv] [-o out.c]      write the generated C
//   novusc check [file.nv]                parse and analyze only
//   novusc init [module] | deps [...]     project.nv and dependencies
//   novusc version | help
//
// Without a source file the commands use the project.nv of the current
// directory (main file, output name, dependencies).
//
// See driver/cli.nv for the options and driver/build.nv for the build steps.

method main(array<string> arguments) {
    if (arguments.length() < 1) {
        printUsage()
        return 1
    }
    var command = arguments[0]
    if (command == "version" || command == "--version" || command == "-v") {
        println "novusc ${VERSION}"
        return 0
    }
    if (command == "help" || command == "--help" || command == "-h") {
        printUsage()
        return 0
    }
    if (command == "init") {
        return initProject(arguments)
    }
    if (command == "deps") {
        return depsCommand(arguments)
    }
    if (command == "emit") {
        return emitCommand(sourceFor(arguments), optionsFrom(arguments, optionStart(arguments)))
    }
    if (command == "check") {
        var source = sourceFor(arguments)
        generate(source, "")
        println "ok: ${source}"
        return 0
    }
    if (command == "build") {
        var output = buildBinary(sourceFor(arguments), optionsFrom(arguments, optionStart(arguments)))
        println "built ${output}"
        return 0
    }
    if (command == "run") {
        return runCommand(sourceFor(arguments), arguments)
    }
    eprintln "novusc: unknown command '${command}'"
    printUsage()
    return 1
}
