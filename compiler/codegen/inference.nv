package codegen

import ast
import parser

// Type inference for local variables.
//
// A local that only ever holds integers is generated as a C `long long`
// instead of an `nv`, a local that only ever holds floats as a `double`, so
// loops and counters stay in registers. The analysis is deliberately
// conservative: a name qualifies only when every declaration and every
// assignment in the method is an expression of that kind (kinds.nv), and it
// starts from the assumption that all candidates qualify, dropping them
// until the set is stable.
//
// The results are marks in the method's locals map: `int:x` and `float:x`
// for unboxed locals, `cls:x` for a local that is guessed to hold an object of
// a class and `elem:x` for one that holds an array of them.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// Names of locals that are unboxed integers are stored in the same map the
// C names live in, under an "int:" prefix.
method markInt(map<string, string> locals, string name) {
    locals["int:" + name] = "1"
}

method isIntLocal(map<string, string> locals, string name): bool {
    return locals.has("int:" + name)
}

// Floats work the same way, under a "float:" prefix.
method markFloat(map<string, string> locals, string name) {
    locals["float:" + name] = "1"
}

method isFloatLocal(map<string, string> locals, string name): bool {
    return locals.has("float:" + name)
}

// What collectAssignments gathers about a method body.
final FLAG_DECLARED = "declared:"
final FLAG_LOOP = "loop:"
final FLAG_TYPE = "type:"
final NO_VALUE = "(none)"

// The child of the node at `index`, NO_VALUE when it has none.
method childOrNone(string node, integer index): string {
    if (nodeCount(node) > index) {
        return nodeChild(node, index)
    }
    return NO_VALUE
}

// Collects the assignments of a method body: every assigned name into
// `names`, the assigned expression into `values`, plus flags for names that
// are declared locally ("declared:") or bound by a loop ("loop:"). The loops
// themselves go to `loops` as "variable expression" pairs of nodes, and the
// value of every `return` to `returns` (NO_VALUE for a bare one).
method collectAssignments(string node, array<string> names, array<string> values, map<string, string> flags, array<string> loops, array<string> returns) {
    var head = nodeHead(node)
    if (head == "at") {
        collectAssignments(nodeChild(node, 2), names, values, flags, loops, returns)
        return
    }
    if (head == "block") {
        var i = 1
        var nodeCount = nodeCount(node)
        while (i < nodeCount) {
            collectAssignments(nodeChild(node, i), names, values, flags, loops, returns)
            i = i + 1
        }
        return
    }
    if (head == "if") {
        collectAssignments(nodeChild(node, 2), names, values, flags, loops, returns)
        if (nodeCount(node) > 3) {
            collectAssignments(nodeChild(node, 3), names, values, flags, loops, returns)
        }
        return
    }
    if (head == "while") {
        collectAssignments(nodeChild(node, 2), names, values, flags, loops, returns)
        return
    }
    if (head == "sync") {
        collectAssignments(nodeChild(node, 2), names, values, flags, loops, returns)
        return
    }
    if (head == "forin") {
        flags[FLAG_LOOP + nodeChild(node, 1)] = "1"     // holds arbitrary elements
        loops.append(nodeChild(node, 1))
        loops.append(nodeChild(node, 2))
        collectAssignments(nodeChild(node, 3), names, values, flags, loops, returns)
        return
    }
    if (head == "return") {
        returns.append(childOrNone(node, 1))
        return
    }
    if (head == "var" || head == "assign") {
        var name = nodeChild(node, 1)
        names.append(name)
        values.append(childOrNone(node, 2))
        if (head == "var") {
            flags[FLAG_DECLARED + name] = "1"           // a bare assignment may target a global
        }
        return
    }
    if (head == "tvar") {
        var tname = nodeChild(node, 2)
        names.append(tname)
        values.append(childOrNone(node, 3))
        flags[FLAG_DECLARED + tname] = "1"
        // a declared type decides the representation and must be honoured:
        // `integer x = 2.9` truncates, so x can never be an unboxed double
        var declared = normType(nodeChild(node, 1))
        if (flags.has(FLAG_TYPE + tname) && flags[FLAG_TYPE + tname] != declared) {
            declared = "mixed"
        }
        flags[FLAG_TYPE + tname] = declared
    }
}

// The locals map as the analysis sees it: the names bound so far, every name
// the body declares (a name used before its declaration still means the
// field or global until then, but taking it for a local only makes the
// analysis more cautious), and the marks.
method analysisView(map<string, string> locals, map<string, string> flags): map<string, string> {
    var view = {}
    for (key in locals.keys()) {
        view[key] = locals[key]
    }
    for (flag in flags.keys()) {
        if (flag.startsWith(FLAG_DECLARED)) {
            var name = flag.substring(FLAG_DECLARED.length(), flag.length())
            if (view.has(name) == false) {
                view[name] = "l_" + name
            }
        }
    }
    return view
}

// The class a loop over `iterable` binds its variable to, "" when unknown.
method loopElementClass(string iterable, map<string, string> view): string {
    if (isList(iterable) == false && view.has("elem:" + iterable)) {
        return view["elem:" + iterable]
    }
    return ""
}

// One round of class guesses: a local gets the class that all of its
// assignments (and loops) agree on, as far as the guesses so far tell.
method guessLocalClasses(array<string> names, array<string> values, array<string> loops, map<string, string> flags, map<string, string> parameters, map<string, string> prog, map<string, string> ctx, map<string, string> view): bool {
    var claims = {}
    var i = 0
    while (i < names.length()) {
        claimClass(claims, names[i], classOf(values[i], prog, ctx, view))
        i = i + 1
    }
    var k = 0
    while (k < loops.length()) {
        claimClass(claims, loops[k], loopElementClass(loops[k + 1], view))
        k = k + 2
    }
    var changed = false
    for (name in claims.keys()) {
        var cls = claims[name]
        var known = view.has("cls:" + name)
        if (cls != "" && known == false && parameters.has(name) == false && flags.has(FLAG_TYPE + name) == false) {
            view["cls:" + name] = cls
            changed = true
        }
    }
    return changed
}

// A claim is the one class every assignment of a name has; "" once two
// disagree or one has no known class.
method claimClass(map<string, string> claims, string name, string cls) {
    if (claims.has(name) == false) {
        claims[name] = cls
        return
    }
    if (claims[name] != cls) {
        claims[name] = ""
    }
}

// The class guesses of a body, added to `view` (and so to `locals`).
method inferClasses(array<string> names, array<string> values, array<string> loops, map<string, string> flags, map<string, string> parameters, map<string, string> prog, map<string, string> ctx, map<string, string> view, map<string, string> locals) {
    // a local declared with a class type holds an object of it
    for (flag in flags.keys()) {
        if (flag.startsWith(FLAG_TYPE)) {
            var name = flag.substring(FLAG_TYPE.length(), flag.length())
            var cls = declaredClass(prog, flags[flag])
            var element = declaredElementClass(prog, flags[flag])
            if (cls != "") {
                view["cls:" + name] = cls
            }
            if (element != "") {
                view["elem:" + name] = element
            }
        }
    }
    var rounds = 0
    while (rounds < 8 && guessLocalClasses(names, values, loops, flags, parameters, prog, ctx, view)) {
        rounds = rounds + 1
    }
    for (key in view.keys()) {
        if (key.startsWith("cls:") || key.startsWith("elem:")) {
            locals[key] = view[key]
        }
    }
}

// The locals (and integer parameters) of a method body that can be unboxed.
// `parameters` are the names bound by the signature, `intCandidates` those of
// them declared `integer`.
method inferIntLocals(array<string> names, array<string> values, map<string, string> flags, map<string, string> parameters, map<string, string> intCandidates, map<string, string> prog, map<string, string> ctx, map<string, string> view): map<string, string> {
    var ints = {}
    for (name in intCandidates) {
        ints[name] = "1"
        markInt(view, name)
    }
    var i = 0
    while (i < names.length()) {
        var name = names[i]
        var typed = flags.has(FLAG_TYPE + name) == false || flags[FLAG_TYPE + name] == "integer"
        if (flags.has(FLAG_DECLARED + name) && flags.has(FLAG_LOOP + name) == false && parameters.has(name) == false && typed) {
            ints[name] = "1"
            markInt(view, name)
        }
        if (flags.has(FLAG_LOOP + name) || typed == false) {
            ints.remove(name)
            view.remove("int:" + name)
        }
        i = i + 1
    }
    // drop candidates whose assignments are not integer expressions, until
    // the set is stable
    var changed = true
    var rounds = 0
    while (changed && rounds < 16) {
        changed = false
        rounds = rounds + 1
        var k = 0
        while (k < names.length()) {
            var candidate = names[k]
            if (ints.has(candidate) && valueKind(values[k], prog, ctx, view) != KIND_INT) {
                ints.remove(candidate)
                view.remove("int:" + candidate)
                changed = true
            }
            k = k + 1
        }
    }
    return ints
}

// The locals (and float parameters) that can be unboxed doubles. `ints` are
// the names already claimed by the integer pass.
method inferFloatLocals(array<string> names, array<string> values, map<string, string> flags, map<string, string> parameters, map<string, string> floatCandidates, map<string, string> ints, map<string, string> prog, map<string, string> ctx, map<string, string> view): map<string, string> {
    var floats = {}
    for (name in floatCandidates) {
        floats[name] = "1"
        markFloat(view, name)
    }
    var i = 0
    while (i < names.length()) {
        var name = names[i]
        var typed = flags.has(FLAG_TYPE + name) == false || flags[FLAG_TYPE + name] == "float"
        var local = flags.has(FLAG_DECLARED + name) && flags.has(FLAG_LOOP + name) == false
        if (local && parameters.has(name) == false && ints.has(name) == false && typed) {
            floats[name] = "1"
            markFloat(view, name)
        }
        if (flags.has(FLAG_LOOP + name) || ints.has(name) || typed == false) {
            floats.remove(name)
            view.remove("float:" + name)
        }
        i = i + 1
    }
    var changed = true
    var rounds = 0
    while (changed && rounds < 16) {
        changed = false
        rounds = rounds + 1
        var k = 0
        while (k < names.length()) {
            var candidate = names[k]
            // a `float` declaration also accepts integer expressions (cast)
            var declaredFloat = flags.has(FLAG_TYPE + candidate) && flags[FLAG_TYPE + candidate] == "float"
            var kind = valueKind(values[k], prog, ctx, view)
            var ok = kind == KIND_FLOAT || (declaredFloat && kind == KIND_INT)
            if (floats.has(candidate) && ok == false) {
                floats.remove(candidate)
                view.remove("float:" + candidate)
                changed = true
            }
            k = k + 1
        }
    }
    return floats
}

// Marks what the code generator can say about the locals of `body`: the
// parameters of the signature have been bound in `locals` already. With
// `unboxParams` the parameters declared integer or float may be unboxed too
// (the free methods take them that way), otherwise they stay boxed.
//
// `returnKinds` receives the kind of every `return` of the body (a bare return
// has none), which workers.nv decides the result of an unboxed worker by.
method markLocalKinds(string body, string params, bool unboxParams, map<string, string> prog, map<string, string> ctx, map<string, string> locals, array<string> returnKinds) {
    var names = []
    var values = []
    var flags = {}
    var loops = []
    var returns = []
    collectAssignments(body, names, values, flags, loops, returns)
    var parameters = {}
    var intCandidates = {}
    var floatCandidates = {}
    var i = 1
    var paramCount = nodeCount(params)
    while (i < paramCount) {
        var p = nodeChild(params, i)
        var pname = nodeChild(p, 2)
        var ptype = nodeChild(p, 1)
        parameters[pname] = "1"
        if (unboxParams && kindOfType(ptype) == KIND_INT) {
            intCandidates[pname] = "1"
        }
        if (unboxParams && kindOfType(ptype) == KIND_FLOAT) {
            floatCandidates[pname] = "1"
        }
        if (declaredClass(prog, ptype) != "") {
            locals["cls:" + pname] = declaredClass(prog, ptype)
        }
        if (declaredElementClass(prog, ptype) != "") {
            locals["elem:" + pname] = declaredElementClass(prog, ptype)
        }
        i = i + 1
    }
    var view = analysisView(locals, flags)
    inferClasses(names, values, loops, flags, parameters, prog, ctx, view, locals)
    var ints = inferIntLocals(names, values, flags, parameters, intCandidates, prog, ctx, view)
    var floats = inferFloatLocals(names, values, flags, parameters, floatCandidates, ints, prog, ctx, view)
    for (name in ints) {
        markInt(locals, name)
    }
    for (name in floats) {
        markFloat(locals, name)
    }
    for (returned in returns) {
        returnKinds.append(returnedKind(returned, prog, ctx, view))
    }
}

// The kind of a returned expression; a bare `return` has none.
method returnedKind(string returned, map<string, string> prog, map<string, string> ctx, map<string, string> view): string {
    if (returned == NO_VALUE) {
        return KIND_NONE
    }
    return valueKind(returned, prog, ctx, view)
}
