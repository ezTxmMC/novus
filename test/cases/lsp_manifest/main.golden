== keys [project, version, main, lib, output, novus, require, replace]
== file in a package folder
  root=[/proj] manifest=[/proj/project.nv] main=[/proj/cmd/main.nv] hasManifest=true name=[p]
== deeply nested file
  root=[/proj] manifest=[/proj/project.nv] main=[/proj/cmd/main.nv] hasManifest=true name=[p]
== the main file itself
  root=[/proj] manifest=[/proj/project.nv] main=[/proj/cmd/main.nv] hasManifest=true name=[p]
== the project folder
  root=[/proj] manifest=[/proj/project.nv] main=[/proj/cmd/main.nv] hasManifest=true name=[p]
== a folder start
  root=[/proj] manifest=[/proj/project.nv] main=[/proj/cmd/main.nv] hasManifest=true name=[p]
== a file that does not exist yet
  root=[/proj] manifest=[/proj/project.nv] main=[/proj/cmd/main.nv] hasManifest=true name=[p]
== no manifest: the file is the program
  root=[/loose] manifest=[] main=[/loose/tool.nv] hasManifest=false name=[]
== no manifest: a folder has no main
  root=[/loose] manifest=[] main=[] hasManifest=false name=[]
== project.nv as a folder is no manifest
  root=[/dirmanifest/sub] manifest=[] main=[/dirmanifest/sub/s.nv] hasManifest=false name=[]
== nearest manifest wins
  root=[/outer/inner] manifest=[/outer/inner/project.nv] main=[/outer/inner/main.nv] hasManifest=true name=[inner]
== outer manifest
  root=[/outer] manifest=[/outer/project.nv] main=[/outer/main.nv] hasManifest=true name=[outer]
== scratch buffer
  root=[] manifest=[] main=[] hasManifest=false name=[]
== unnormalised path
  root=[/proj] manifest=[/proj/project.nv] main=[/proj/cmd/main.nv] hasManifest=true name=[p]
== a relative path ends at the current folder
  root=[.] manifest=[project.nv] main=[main.nv] hasManifest=true name=[rel]
== the working folder is no ancestor of a .. path
  root=[../x] manifest=[] main=[../x/f.nv] hasManifest=false name=[]
== a .. path climbs further up
  root=[../..] manifest=[../../project.nv] main=[../../main.nv] hasManifest=true name=[up]
== a .. path finds the manifest next to it
  root=[..] manifest=[../project.nv] main=[../main.nv] hasManifest=true name=[near]
== a file 63 folders below the manifest finds it
  root length 1 hasManifest=true main=8
== a file 64 folders below the manifest does not
  root length 128 hasManifest=false main=133
