{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Novus Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../test"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "novus: compile extension"
    }
  ]
}
