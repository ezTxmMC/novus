package ast

// Text helpers shared by the parser and the code generator.
//
// NOTE: this file is part of the bootstrap chain: the snapshot's runtime must
// already contain the natives before they are declared here (BOOTSTRAP.md).

// Encode text as a quoted s-expression string atom: backslash, quote, the
// control characters \n \r \t and "?" are escaped (the result is also valid
// inside a C literal, and "??" stays out of the C - trigraphs).
method sexpStr(string text): string native "nv_sexp_str"

// Joins many pieces into one string with O(n log n) copying.
method joinParts(array<string> parts): string {
    var current = parts
    while (current.length() > 1) {
        var next = []
        var i = 0
        while (i < current.length()) {
            var piece = current[i]
            if (i + 1 < current.length()) {
                piece = piece + current[i + 1]
            }
            next.append(piece)
            i = i + 2
        }
        current = next
    }
    if (current.length() == 0) {
        return ""
    }
    return current[0]
}
