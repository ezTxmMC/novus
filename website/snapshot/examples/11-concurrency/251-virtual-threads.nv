package main

// `virtual` runs a method on a virtual thread: a stack of its own that a
// small pool of carrier threads shares. Spawning one costs a few kilobytes,
// so a program can have as many as it has work.

method square(integer n): integer {
    return n * n
}

method main {
    var tasks = []
    var i = 1
    while (i <= 10) {
        tasks.append(virtual square(i))
        i = i + 1
    }
    // the spawn hands back a task; await is the value it ends up with
    var total = 0
    for (t in tasks) {
        total = total + await t
    }
    println "the first ten squares add up to ${total}"
}
