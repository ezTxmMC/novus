package fixtures

import json
import os
import path
import thread

/// Greeting used by main.
private final GREETING = "Hello"

/**
 * Entry point.
 */
method main {
  var total = add(1, 2)
  var ratio = 3.5 * total
  var names = ["a", "b"]
  var counter = Counter{ value=0 }
  counter.increment()
  counter.increment(5)
  println "${GREETING}: ${total} ${ratio}"
  println names
  if (total > 2 && ratio != 0) {
    println "big"
  } else if (total == 0) {
    println "zero"
  } else {
    println "small"
  }
  for (name in names) {
    println name
  }
  for (var i = 0; i < 3; i = i + 1) {
    println i
  }
  var n = 3
  while (n > 0) {
    n = n - 1
    if (n == 1) { break }
  }
  println counter.value()
  println Color.RED
  println json.stringify(counter)
  println (1 + 2) * 3
  print "no newline "
  eprintln "to stderr"
  integer truncated = -2.5 * -1
  println truncated
  println path.join(os.temp(), "x")
  println os.platform()
}

method add(integer a, integer b): integer {
  return a + b
}

define interface ICounter {
  increment()
}

define class Counter based ICounter {
  private final integer value: get, set

  construct(integer value) {
    this.value = value
  }

  method describe(): string {
    return "counter at ${value}"
  }

  @Interface
  method increment() {
    this.value = this.value + 1
  }

  method increment(integer by) {
    this.value = this.value + by
  }
}

define enum Color {
  RED("red"),
  GREEN("green");

  private final string text: get

  private construct(string text) {
    this.text = text
  }
}

// concurrency: threads, virtual threads, await, sync

var totalSeen = 0
var totalLock = 0

method piece(integer n): integer {
  return n * 2
}

async method fetchName(string id): string {
  return "name of ${id}"
}

method tally(integer times) {
  var i = 0
  while (i < times) {
    sync {
      totalSeen = totalSeen + 1
    }
    i = i + 1
  }
}

method concurrency(): integer {
  var counted = thread.counter(0)
  var work = thread.channel(4)
  totalLock = thread.mutex()

  var one = virtual piece(21)
  var two = thread piece(2)
  var named = await fetchName("x")
  println named

  sync (totalLock) {
    totalSeen = totalSeen + 1
  }

  var tasks = [virtual piece(1), virtual piece(2)]
  var results = thread.joinAll(tasks)
  println results

  thread.send(work, 1)
  var item = thread.recv(work)
  println item
  thread.close(work)
  thread.add(counted, 1)
  thread.sleep(1)

  return await one + await two
}
