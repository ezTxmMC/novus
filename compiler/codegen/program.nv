package codegen

import ast
import codegen/emit
import codegen/expr
import codegen/index
import codegen/order
import codegen/typed
import parser

// Whole-program generation: the declarations are generated one by one into
// the parts of a C translation unit, which are then put together.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// Generates the complete C translation unit. `runtime` is the text of
// novus_rt.h to embed; when empty an #include "novus_rt.h" is emitted.
method generateProgram(array<string> decls, string runtime): string {
    var prog = {}
    indexProgram(decls, prog)
    checkClasses(prog, decls)
    analyseWorkers(decls, prog)
    var parts = newProgramParts()
    for (d in decls) {
        genDeclaration(d, nodeHead(d), prog, parts)
    }
    return assembleProgram(prog, runtime, parts)
}

// The pieces of the translation unit, filled declaration by declaration:
// prototypes, function and class bodies, the class registry, the roots and
// the init units of the globals and enums (with the C text each one reads, see
// order/initorder.nv) and how many variants of an overloaded method are emitted.
method newProgramParts(): map<string, object> {
    return {"protos": [], "bodies": [], "registry": [], "rootsInit": [], "globalUnits": [],
        "enumUnits": [], "sources": {}, "emitted": {}, "cblocks": []}
}

method genDeclaration(string d, string head, map<string, string> prog, map<string, object> parts) {
    if (head == "method" && isNativeMethod(d) == false) {
        genFunctionUnit(d, prog, parts)
        return
    }
    if (head == "class" || head == "enum") {
        genTypeUnit(d, head, prog, parts)
        return
    }
    if (head == "global") {
        genGlobalUnit(d, prog, parts)
        return
    }
    if (head == CBLOCK_NODE) {
        parts["cblocks"].append(genCBlockDeclaration(d, prog, {"pos": sexpUnescape(nodeChild(d, 2))}))
    }
}

method genTypeUnit(string d, string head, map<string, string> prog, map<string, object> parts) {
    genClassCode(d, prog, parts["protos"], parts["bodies"], parts["registry"], parts["sources"])
    if (head != "enum") {
        return
    }
    parts["enumUnits"].append("e:" + nodeChild(d, 1))
    parts["sources"]["e:" + nodeChild(d, 1)] = genEnumInit(d, prog)
}

method genGlobalUnit(string d, map<string, string> prog, map<string, object> parts) {
    var name = nodeChild(d, 1)
    var ctx = {"class": "", "pkg": packageOf(name), "func": "", "ret": "void", "pos": "constant " + name}
    var locals = {}
    var cname = cName(name)
    parts["protos"].append("static nv g_" + cname + ";" + nl())
    // the collector cannot see statics on its own: each global is a root;
    // until its initialiser has run a global reads as null
    parts["rootsInit"].append("    nv_gc_root(&g_" + cname + ");" + nl())
    parts["rootsInit"].append("    g_" + cname + " = nv_nil;" + nl())
    parts["globalUnits"].append("g:" + cname)
    parts["sources"]["g:" + cname] = genExpr(nodeChild(d, 2), prog, ctx, locals)
    if (tempNames(ctx) != "") {
        parts["sources"]["t:" + cname] = tempNames(ctx)
    }
}

// A free method: its prototype, its body and, for the first of several
// overloads of one arity, the dispatcher that picks among them.
method genFunctionUnit(string d, map<string, string> prog, map<string, object> parts) {
    var name = methodName(d)
    var arity = arityOf(d)
    var variants = parseInt(prog["func:" + name + "/" + arity])
    var variant = nextVariant(parts["emitted"], name + "/" + arity)
    var cname = funcCName(name, arity, variant, variants)
    var sources = parts["sources"]
    parts["protos"].append("static nv " + cname + "(" + cParamList(d) + ");" + nl())
    var descriptor = rawDescriptor(prog, name, arity)
    if (descriptor != "") {
        parts["protos"].append("static " + rawResultType(descriptor) + " " + cname + "_raw(" + rawParamList(d, descriptor) + ");" + nl())
    }
    var body = genFreeMethod(d, cname, prog)
    parts["bodies"].append(body)
    sources["f:" + cname] = body
    if (descriptor != "") {
        sources["f:" + cname + "_raw"] = body
    }
    if (variants > 1 && variant == 0) {
        genDispatcherUnit(d, name, arity, variants, prog, parts)
    }
}

// How many variants of the overload set `key` were emitted before this one.
method nextVariant(map<string, string> emitted, string key): integer {
    var variant = 0
    if (emitted.has(key)) {
        variant = parseInt(emitted[key])
    }
    emitted[key] = intToStr(variant + 1)
    return variant
}

method genDispatcherUnit(string d, string name, integer arity, integer variants, map<string, string> prog, map<string, object> parts) {
    var dispatcherName = funcCName(name, arity, 0, 1)
    var dispatcher = genDispatcher(name, arity, variants, prog)
    parts["protos"].append("static nv " + dispatcherName + "(" + cParamList(d) + ");" + nl())
    parts["bodies"].append(dispatcher)
    parts["sources"]["f:" + dispatcherName] = dispatcher
}

// The translation unit: runtime, declarations, tables, class registry,
// start-up, bodies and main.
method assembleProgram(map<string, string> prog, string runtime, map<string, object> parts): string {
    var out = []
    out.append("/* do not edit - snapshot of novusc in c */\n" + nl())
    out.append(runtimeText(runtime))
    out.append(joinParts(parts["cblocks"]))
    out.append(nl() + "/* declarations */" + nl())
    out.append(joinParts(parts["protos"]))
    out.append(literalTable(prog))
    out.append(icTable(prog))
    out.append(spawnBodies(prog))
    out.append(nl() + "static void nv_register_classes(void) {" + nl() + "    NvClass *c = 0;" + nl() + "    (void)c;" + nl())
    out.append(joinParts(parts["registry"]))
    out.append("}" + nl() + nl() + genInitFunction(parts["rootsInit"], parts["globalUnits"], parts["enumUnits"], parts["sources"]))
    for (body in parts["bodies"]) {
        out.append(body + nl())
    }
    out.append(genMainEntry(prog))
    return joinParts(out)
}

// The runtime to embed, or the include of it when there is none.
method runtimeText(string runtime): string {
    if (runtime == "") {
        return "#include " + cstr("novus_rt.h") + nl()
    }
    if (runtime.charAt(runtime.length() - 1) != nl()) {
        return runtime + nl()
    }
    return runtime
}
