package lexer

// Raw C inside Novus: `c { ... }`, a statement of a method or a declaration of the program.
// The text up to the matching brace is one token, CBLOCK, which the parser keeps as it is.
// Braces inside C strings, character literals and comments do not count.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

final CBLOCK_WORD = "c"
final CBLOCK_KIND = "CBLOCK"
final CBLOCK_UNTERMINATED_KIND = "CBLOCK_UNTERMINATED"

// The words after which `c {` is a declaration of something named c, not a C block.
private final CBLOCK_NAME_CONTEXT = { "method": true, "class": true, "construct": true, "async": true }

// The index after the C block that starts at `from` (the word `c`), `from` itself when none does.
method lexCBlock(string source, integer from, string pos, array<string> tokens): integer {
    var open = cBlockOpen(source, from)
    if (open < 0 || isCBlockName(tokens)) {
        return from
    }
    var close = cBlockClose(source, open + 1)
    if (close < 0) {
        tokens.append(CBLOCK_UNTERMINATED_KIND + " " + pos + " ")
        return source.length()
    }
    tokens.append(CBLOCK_KIND + " " + pos + " " + source.substring(open + 1, close))
    return close + 1
}

// The index of the `{` after the word `c` at `from`, -1 when the word is another one or no brace follows.
method cBlockOpen(string source, integer from): integer {
    if (source.charAt(from) != CBLOCK_WORD) {
        return 0 - 1
    }
    var i = from + 1
    if (i < source.length() && isAlphaNum(source.charAt(i))) {
        return 0 - 1
    }
    while (i < source.length() && (source.charAt(i) == " " || source.charAt(i) == TAB)) {
        i = i + 1
    }
    if (i < source.length() && source.charAt(i) == "{") {
        return i
    }
    return 0 - 1
}

// `method c {`, `define class c {`: the last token declares a name.
method isCBlockName(array<string> tokens): bool {
    if (tokens.length() == 0) {
        return false
    }
    var last = tokens[tokens.length() - 1]
    if (tokKind(last) == "SYM") {
        return tokVal(last) == "." || tokVal(last) == "@"
    }
    return CBLOCK_NAME_CONTEXT.has(tokVal(last))
}

// The index of the `}` that closes the block whose text starts at `from`, -1 when there is none.
method cBlockClose(string source, integer from): integer {
    var depth = 1
    var i = from
    while (i < source.length()) {
        var c = source.charAt(i)
        if (c == QUOTE || c == "'") {
            i = skipCQuoted(source, i)
            continue
        }
        if (c == "/" && i + 1 < source.length() && source.charAt(i + 1) == "/") {
            i = skipLineComment(source, i)
            continue
        }
        if (c == "/" && i + 1 < source.length() && source.charAt(i + 1) == "*") {
            i = skipBlockComment(source, i)
            continue
        }
        depth = depth + cBraceDelta(c)
        if (depth == 0) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

method cBraceDelta(string c): integer {
    if (c == "{") {
        return 1
    }
    if (c == "}") {
        return 0 - 1
    }
    return 0
}

// The index after the C string or character literal that starts at `from`; a backslash escapes the next character.
method skipCQuoted(string source, integer from): integer {
    var quote = source.charAt(from)
    var i = from + 1
    while (i < source.length() && source.charAt(i) != quote && source.charAt(i) != NEWLINE) {
        if (source.charAt(i) == BACKSLASH) {
            i = i + 1
        }
        i = i + 1
    }
    return i + 1
}
