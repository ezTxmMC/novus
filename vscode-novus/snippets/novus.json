    "prefix": [
      "psvm",
      "mainargs"
    ]
  },
  "Entry point whose return value is the exit code": {
    "body": [
      "method main(array<string> args): integer {",
      "\t$0",
      "\treturn ${1:0}",
      "}"
    ],
    "description": "Entry point whose return value is the exit code",
    "prefix": [
      "maine",
      "psvmi"
    ]
  },
  "Package declaration": {
    "body": [
