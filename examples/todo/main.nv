package main

import json

// A tiny todo list with JSON persistence (todo.json in the working dir).
//   novus run examples/todo/main.nv add "buy milk"
//   novus run examples/todo/main.nv list
//   novus run examples/todo/main.nv done 0

method main(array<string> arguments) {
    var store = "todo.json"
    var items = loadItems(store)

    if (arguments.length() < 1) {
        printUsage()
        return 0
    }

    var command = arguments[0]

    if (command == "add") {
        if (arguments.length() < 2) {
            println "add needs a text argument"
            return 0
        }
        items.append({ "text": arguments[1], "done": false })
        saveItems(store, items)
        println "added: ${arguments[1]}"
    } else if (command == "list") {
        if (items.length() == 0) {
            println "nothing to do!"
            return 0
        }
        var i = 0
        for (item in items) {
            var mark = "[ ]"
            if (item["done"] == true) {
                mark = "[x]"
            }
            var text = item["text"]
            println "${i} ${mark} ${text}"
            i = i + 1
        }
    } else if (command == "done") {
        if (arguments.length() < 2) {
            println "done needs an index"
            return 0
        }
        var index = parseInt(arguments[1])
        if (index < 0 || index >= items.length()) {
            println "no such item: ${index}"
            return 0
        }
        var item = items[index]
        item["done"] = true
        items[index] = item
        saveItems(store, items)
        var text = item["text"]
        println "done: ${text}"
    } else {
        printUsage()
    }
}

method loadItems(string store): array<string> {
    if (fileExists(store)) {
        return json.parse(readFile(store))
    }
    return []
}

method saveItems(string store, array<string> items) {
    writeFile(store, json.stringify(items))
}

method printUsage() {
    println "Usage:"
    println "  todo add <text>   - add an item"
    println "  todo list         - show all items"
    println "  todo done <index> - mark an item as done"
}
