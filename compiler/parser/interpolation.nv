package parser

import ast
import lexer

// String literals with ${...} interpolation.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

private final DOLLAR = chr(36)

// String literal with ${...} interpolation -> (str "...") or a (+ ...) chain.
method parseInterpolated(string text, string pos): string {
    var n = text.length()
    var i = 0
    var current = ""
    var node = ""
    var first = true
    while (i < n) {
        var close = interpolationEnd(text, i)
        if (close < 0) {
            current = current + text.charAt(i)
            i = i + 1
            continue
        }
        var e = parseExpr(lex(text.substring(i + 2, close - 1), pos), 0, 0)
        node = joinInterpolated(node, current, first, e["node"])
        first = false
        current = ""
        i = close
    }
    if (first) {
        return "(str " + sexpStr(current) + ")"
    }
    if (current != "") {
        node = "(+ " + node + " (str " + sexpStr(current) + "))"
    }
    return node
}

// The index after the closing brace of a ${...} that starts at `i`, -1 when none does there.
method interpolationEnd(string text, integer i): integer {
    if (text.charAt(i) != DOLLAR || i + 1 >= text.length() || text.charAt(i + 1) != "{") {
        return 0 - 1
    }
    var depth = 1
    var j = i + 2
    while (j < text.length() && depth > 0) {
        if (text.charAt(j) == "{") {
            depth = depth + 1
        }
        if (text.charAt(j) == "}") {
            depth = depth - 1
        }
        j = j + 1
    }
    if (depth > 0) {
        return 0 - 1
    }
    return j
}

// The chain so far, the literal text before the expression, and the expression.
method joinInterpolated(string node, string current, bool first, string expression): string {
    var chain = node
    if (first) {
        chain = "(str " + sexpStr(current) + ")"
    }
    if (first == false && current != "") {
        chain = "(+ " + node + " (str " + sexpStr(current) + "))"
    }
    return "(+ " + chain + " " + expression + ")"
}
