package codegen

import "../ast/sexp.nv"
import "../parser/errors.nv"
import "calls.nv"

// Stdlib modules: json, path, os, http.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// Stdlib modules: "module.name/arity" -> C function ("*" = variadic,
// called as fn(count, args...)).
method moduleTable(): map<string, string> {
    return {
        "json.stringify/1": "nv_json_stringify", "json.pretty/1": "nv_json_pretty",
        "json.parse/1": "nv_json_parse", "json.isValid/1": "nv_json_is_valid",
        "json.save/3": "nv_json_save", "json.load/1": "nv_json_load",
        "path.join/*": "nv_path_join", "path.absolute/0": "nv_path_absolute",
        "path.absolute/1": "nv_path_absolute_of", "path.exists/1": "nv_path_exists",
        "path.isDir/1": "nv_os_is_dir", "path.isFile/1": "nv_os_is_file",
        "path.dirname/1": "nv_path_dirname", "path.basename/1": "nv_path_basename",
        "path.stem/1": "nv_path_stem", "path.extension/1": "nv_path_extension",
        "path.normalize/1": "nv_path_normalize", "path.isAbsolute/1": "nv_path_is_absolute",
        "path.relative/2": "nv_path_relative", "path.temp/0": "nv_path_temp",
        "path.separator/0": "nv_path_separator",
        "os.mkdir/1": "nv_os_mkdir", "os.rmdir/1": "nv_os_rmdir", "os.remove/1": "nv_remove_file",
        "os.removeAll/1": "nv_os_remove_all", "os.listDir/1": "nv_os_list_dir",
        "os.exists/1": "nv_path_exists", "os.isDir/1": "nv_os_is_dir", "os.isFile/1": "nv_os_is_file",
        "os.rename/2": "nv_os_rename", "os.copy/2": "nv_os_copy", "os.fileSize/1": "nv_os_file_size",
        "os.modified/1": "nv_os_modified", "os.readFile/1": "nv_read_file",
        "os.writeFile/2": "nv_write_file", "os.appendFile/2": "nv_append_file",
        "os.cwd/0": "nv_path_absolute", "os.chdir/1": "nv_os_chdir", "os.temp/0": "nv_path_temp",
        "os.home/0": "nv_os_home", "os.exec/1": "nv_exec", "os.output/1": "nv_os_output",
        "os.env/1": "nv_env", "os.setEnv/2": "nv_os_set_env", "os.exit/1": "nv_exit",
        "os.platform/0": "nv_platform", "os.args/0": "nv_args", "os.pid/0": "nv_os_pid",
        "os.time/0": "nv_os_time", "os.clock/0": "nv_os_clock", "os.sleep/1": "nv_os_sleep",
        "os.readLine/0": "nv_read_line",
        "http.get/1": "nv_http_get", "http.post/2": "nv_http_post", "http.put/2": "nv_http_put",
        "http.delete/1": "nv_http_delete", "http.request/4": "nv_http_request",
        "http.download/2": "nv_http_download"
    }
}

method isModuleName(string name): bool {
    return name == "json" || name == "path" || name == "http" || name == "os"
}

method genModuleCall(string module, string name, string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    var nargs = nodeCount(node) - 3
    var args = genArgs(node, 3, prog, ctx, locals)
    var table = moduleTable()
    var key = module + "." + name + "/" + nargs
    if (table.has(key)) {
        return table[key] + "(" + args + ")"
    }
    var variadic = module + "." + name + "/*"
    if (table.has(variadic)) {
        if (nargs == 0) {
            return table[variadic] + "(0)"
        }
        return table[variadic] + "(" + nargs + ", " + args + ")"
    }
    var arities = ""
    var n = 0
    while (n < 8) {
        if (table.has(module + "." + name + "/" + n)) {
            if (arities != "") {
                arities = arities + " or "
            }
            arities = arities + n
        }
        n = n + 1
    }
    if (arities != "") {
        fail(module + "." + name + "() takes " + arities + " argument(s) but got " + nargs, ctx["pos"])
    }
    fail("unknown module function " + module + "." + name + "()", ctx["pos"])
    return ""
}
