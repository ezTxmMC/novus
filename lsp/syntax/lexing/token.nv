package lexing

import base/text

// One lexical token. Offsets are UTF-8 byte offsets, `line` is 0-based, `column` is a byte column.
define class Token {
    TokenKind kind
    string text
    integer start
    integer end
    integer line
    integer column
    bool firstOnLine
    string value
    array<Span> interpolations
    bool terminated

    construct(TokenKind kind, string text, integer start, integer end, integer line, integer column) {
        this.kind = kind
        this.text = text
        this.start = start
        this.end = end
        this.line = line
        this.column = column
        this.firstOnLine = false
        this.value = text
        this.interpolations = []
        this.terminated = true
    }

    method span(): Span {
        return Span(this.start, this.end)
    }

    method isPunct(string punct): bool {
        return this.kind == TokenKind.Punct && this.value == punct
    }

    method isKeyword(string word): bool {
        return this.kind == TokenKind.Keyword && this.text == word
    }

    method isIdent(string word): bool {
        return this.kind == TokenKind.Ident && this.text == word
    }

    method isWord(string word): bool {
        if (this.kind == TokenKind.Ident || this.kind == TokenKind.Keyword) {
            return this.text == word
        }
        return false
    }

    method isEnd(): bool {
        return this.kind == TokenKind.EndOfFile
    }
}

// The compiler knows exactly these 19 keywords; every other word is an identifier decided by position.
private final LEXING_KEYWORDS = ["package", "import", "method", "var", "println", "print", "eprintln",
    "private", "final", "return", "if", "else", "while", "for", "in", "true", "false", "break", "continue"]

private final LEXING_KEYWORD_SET = { "package": true, "import": true, "method": true, "var": true,
    "println": true, "print": true, "eprintln": true, "private": true, "final": true, "return": true,
    "if": true, "else": true, "while": true, "for": true, "in": true, "true": true, "false": true,
    "break": true, "continue": true }

define enum TokenKind {
    Ident, Keyword, Integer, Float, String, Punct, Comment, Unknown, EndOfFile
}

method isKeywordWord(string word): bool {
    return LEXING_KEYWORD_SET.has(word)
}

method keywordWords(): array<string> {
    var copy = []
    for (word in LEXING_KEYWORDS) {
        copy.append(word)
    }
    return copy
}
