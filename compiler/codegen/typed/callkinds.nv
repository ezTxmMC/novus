package typed

import ast
import parser

// The kind of calls: free functions with an unboxed worker, method calls and field reads.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// The function a `name(args)` call reaches when it is a call of a method that
// is not a member of a class, "" otherwise. It follows genCall.
method freeCallTarget(string name, integer nargs, map<string, string> prog, map<string, string> ctx): string {
    var key = name + "/" + nargs
    var pkg = ctx["pkg"]
    if (pkg != "" && (prog.has("func:" + pkg + "." + name + "/" + nargs) || prog.has("func:" + pkg + "." + name + "/*"))) {
        return pkg + "." + name
    }
    if (ctx["class"] != "" && findMethod(prog, ctx["class"], name) != "") {
        return ""
    }
    if (prog.has("func:" + key) == false && prog.has("unq:" + key)) {
        var candidates = prog["unq:" + key]
        if (candidates.contains(" ")) {
            return ""
        }
        return candidates
    }
    if (isCoreBuiltin(name) || isClassLike(prog, name)) {
        return ""
    }
    if (prog.has("func:" + key)) {
        return name
    }
    return ""
}

// The unboxed worker descriptor of a function, "" when it has none (workers.nv).
method rawDescriptor(map<string, string> prog, string name, integer nargs): string {
    var key = "raw:" + name + "/" + nargs
    if (prog.has(key)) {
        return prog[key]
    }
    return ""
}

// The kind of what the worker described by `descriptor` returns.
method rawReturnKind(string descriptor): string {
    if (descriptor == "") {
        return KIND_NONE
    }
    var kind = descriptor.charAt(0)
    if (kind == KIND_INT || kind == KIND_FLOAT) {
        return kind
    }
    return KIND_NONE
}

// The kind of the parameter at `index` (from 0) of a worker: what it takes
// unboxed, or "n" when it is passed as it is.
method rawParamKind(string descriptor, integer index): string {
    return descriptor.charAt(index + 2)
}

method callKind(string node, map<string, string> prog, map<string, string> ctx): string {
    if (isTypedContext(ctx) == false) {
        return KIND_NONE
    }
    var nargs = nodeCount(node) - 2
    var target = freeCallTarget(nodeChild(node, 1), nargs, prog, ctx)
    if (target == "") {
        return KIND_NONE
    }
    return rawReturnKind(rawDescriptor(prog, target, nargs))
}

// The kind of `target.name()` when it reads a numeric field of a class that
// is known for `target`, "" when it is anything else.
method fieldReadKind(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    var cls = classOf(nodeChild(node, 1), prog, ctx, locals)
    if (cls == "") {
        return KIND_NONE
    }
    return kindOfType(fieldType(prog, cls, nodeChild(node, 2)))
}

method methodCallKind(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (isTypedContext(ctx) == false) {
        return KIND_NONE
    }
    var target = nodeChild(node, 1)
    if (isModuleTarget(target, prog, ctx, locals)) {
        return moduleCallKind(node, prog)
    }
    if (nodeCount(node) == 3) {
        return fieldReadKind(node, prog, ctx, locals)
    }
    return KIND_NONE
}
