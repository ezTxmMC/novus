# Build output
# build/  scripts/bootstrap.sh (novusc0, novusc1, novusc)
# dist/   scripts/cross.sh (cross compiled binaries)
build/
dist/
*.o
*.obj
*.exe
*.pdb
a.out

# novus-lsp: `make lsp` writes build/novus-lsp; a build without -o leaves the binary next to the sources
lsp/novus-lsp
lsp/novus-lsp.exe

# Generated C: `novusc emit` / `novusc build --keep-c` next to the sources.
# The bootstrap snapshot is the one C file that is tracked.
*.c
!bootstrap/novusc.c

# Files the examples write while they run (they clean up themselves)
examples/*/example-*
examples/*/*.json

# Binaries built from the examples and the quick start
/wc
/demo
examples/*/wc
examples/*/mccloud
examples/**/test/
test/cases/project/geoapp

# Program output written into the working directory
todo.json
mccloud-data/
people/

# Website (website/, written in Novus; its `dist/` is covered above)
website/.nvh-tailwind/
website/public/site.css
website/public/search-index.json

# vscode-novus (TypeScript)
node_modules/
*.tsbuildinfo
.vite/

# Tooling caches and logs
.cache/
*.log
*.tmp
*.swp
*~

# Editors and OS
.vscode/
!vscode-novus/.vscode/
.idea/
.DS_Store
Thumbs.db

# Benchmarks: sources, runner and results are tracked, build output is not.
# (This used to ignore benchmarks/ entirely - the website reads results.json
# and the sources, so they have to be in the repository.)
benchmarks/.build/
benchmarks/input.txt
benchmarks/java/*.class
!benchmarks/*.c
**claude**
DESIGN**.md

# Translated from website/content/**/*.nvmd by nvh-markdown (`make -C website content`)
website/content/**/*.nvh
