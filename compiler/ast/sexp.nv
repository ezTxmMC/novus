package ast

// Navigating the string-encoded s-expression AST.
//
// The navigation itself is native (runtime/nv_sexp.h): a node is scanned
// once and the places where its children start and end are remembered, so
// asking for the next child is an array read instead of another scan of the
// node. The results are exactly what scanning the string gave.
//
// NOTE: this file is part of the bootstrap chain: the snapshot's runtime must
// already contain the natives before they are declared here (BOOTSTRAP.md).

// Whether the node is a list: it starts with an opening parenthesis.
method isList(string s): bool native "nv_sexp_is_list"

// s.charAt(i) starts a child node; returns the index just past it.
method atomEnd(string s, integer i): integer native "nv_sexp_atom_end"

// The index-th child of a list node (index 0 is the head), "" if absent.
method nodeChild(string s, integer index): string native "nv_sexp_child"

method nodeCount(string s): integer native "nv_sexp_count"

method nodeHead(string s): string native "nv_sexp_head"

// Decodes the escapes of a quoted string atom back into raw text.
method sexpUnescape(string s): string native "nv_sexp_unescape"
