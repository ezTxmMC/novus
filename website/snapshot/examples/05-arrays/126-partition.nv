package main

// Splitting values into two groups.

method main {
    var numbers = [8, 3, 12, 5, 20, 1]
    var small = []
    var large = []
    for (n in numbers) {
        if (n < 10) {
            small.append(n)
            continue
        }
        large.append(n)
    }
    println "small: ${small}"
    println "large: ${large}"
}
