package lexer

// Character classes, keywords and escape sequences.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// Built once: the lexer asks about every identifier and every character.
private final KEYWORDS = { "package": true, "import": true, "method": true, "var": true,
    "println": true, "print": true, "eprintln": true, "private": true,
    "final": true, "return": true, "if": true, "else": true, "while": true,
    "for": true, "in": true, "true": true, "false": true, "break": true,
    "continue": true }

private final SYMBOL_CHARS = { "{": true, "}": true, "(": true, ")": true, "[": true, "]": true,
    ":": true, ";": true, ",": true, ".": true, "+": true, "-": true, "*": true,
    "/": true, "%": true, "=": true, "<": true, ">": true, "!": true, "@": true,
    "&": true, "|": true, "^": true }

method isKeywordWord(string word): bool {
    return KEYWORDS.has(word)
}

method isTwoCharOp(string op): bool {
    return op == "==" || op == "!=" || op == "<=" || op == ">=" || op == "&&" || op == "||" || op == "=>" || op == "=<" || op == "<<" || op == ">>"
}

method isDigit(string c): bool {
    return c >= "0" && c <= "9"
}

method isHexDigit(string c): bool {
    return isDigit(c) || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
}

// The value of a single hexadecimal digit.
method hexValue(string c): integer {
    if (isDigit(c)) {
        return ord(c) - ord("0")
    }
    if (c >= "a" && c <= "f") {
        return ord(c) - ord("a") + 10
    }
    return ord(c) - ord("A") + 10
}

method isAlpha(string c): bool {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
}

method isAlphaNum(string c): bool {
    return isAlpha(c) || isDigit(c)
}

method isSymbolChar(string c): bool {
    return SYMBOL_CHARS.has(c)
}

method lexEscape(string c): string {
    if (c == "n") {
        return chr(10)
    }
    if (c == "t") {
        return chr(9)
    }
    if (c == "r") {
        return chr(13)
    }
    if (c == "0") {
        return chr(0)
    }
    return c
}
