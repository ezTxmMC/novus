<?nv
import data

prop string slug = ""
prop string title = ""
prop string description = ""

method item(): NavItem {
    return data.documentBySlug(slug)
}

method headings(): array {
    return data.documentHeadings(item().file)
}
?>
<Layout title={title} description={description} section="docs">
    <div class="mx-auto flex max-w-[90rem] gap-10 px-4 sm:px-6 lg:px-8">
        <aside class="sticky top-16 hidden h-[calc(100vh-4rem)] w-60 shrink-0 overflow-y-auto py-10 pr-2 lg:block">
            <Sidebar current={item().path} />
        </aside>
        <div class="min-w-0 flex-1 py-10">
            <details class="mb-8 rounded-xl border border-ink-700 bg-ink-900/70 lg:hidden">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-ink-100">Documentation menu</summary>
                <div class="border-t border-ink-700 p-4"><Sidebar current={item().path} /></div>
            </details>
            <header class="max-w-3xl">
                <p class="eyebrow">{data.sectionOf(item().path)}</p>
                <h1 class="mt-2 text-4xl font-semibold tracking-tight text-ink-50 sm:text-5xl">{title}</h1>
                <p class="mt-3 text-lg text-ink-400">{description}</p>
            </header>
            <article class="prose-nv mt-8" id="doc-content">
                <slot />
            </article>
            <nav class="mt-16 grid max-w-3xl gap-4 sm:grid-cols-2" aria-label="Previous and next page">
                {#if data.previousOf(item().path).path != ""}
                    <a href={data.previousOf(item().path).path} class="card no-underline" rel="prev">
                        <span class="eyebrow">Previous</span>
                        <span class="mt-1 block text-ink-50">{data.previousOf(item().path).title}</span>
                    </a>
                {/if}
                {#if data.nextOf(item().path).path != ""}
                    <a href={data.nextOf(item().path).path} class="card text-right no-underline sm:col-start-2" rel="next">
                        <span class="eyebrow">Next</span>
                        <span class="mt-1 block text-ink-50">{data.nextOf(item().path).title}</span>
                    </a>
                {/if}
            </nav>
        </div>
        <aside class="sticky top-16 hidden h-[calc(100vh-4rem)] w-56 shrink-0 overflow-y-auto py-10 xl:block">
            <p class="eyebrow mb-3">On this page</p>
            <ul id="toc" class="toc-list">
                {#for heading in headings()}
                    {#if heading.level == 2 || heading.level == 3}
                        <li class="toc-item toc-level-{heading.level}"><a href="#{heading.id}">{heading.text}</a></li>
                    {/if}
                {/for}
            </ul>
        </aside>
    </div>
</Layout>
