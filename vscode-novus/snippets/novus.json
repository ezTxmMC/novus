{
  "Program entry point": {
    "body": [
      "method main {",
      "\t$0",
      "}"
    ],
    "description": "Program entry point",
    "prefix": "main"
  },
  "Program entry point receiving the command line arguments": {
    "body": [
      "method main(array<string> args) {",
      "\t$0",
      "}"
    ],
