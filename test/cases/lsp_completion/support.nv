package main

import "novus/lsp/base/model"
import "novus/lsp/base/platform"
import "novus/lsp/base/text"
import "novus/lsp/features/candidates"
import "novus/lsp/features/completion"
import "novus/lsp/projects/stdlib"
import "novus/lsp/projects/workspace"
import "novus/lsp/services/snippets"

// One program in memory with the engine over it; the cursor of a case is written as the marker `<|>` in the text.
define class CxWorld {
    map<string, string> files
    FileCache cache
    Workspace space
    Settings settings
    CompletionEngine engine

    construct(map<string, string> files) {
        this.files = files
        this.cache = FileCache(MemoryTextSource(files))
        this.space = Workspace(this.cache, standardLibrary())
        this.settings = Settings()
        this.engine = CompletionEngine(SymbolSources(this.space, this.settings), ModuleSources(this.space, this.settings),
            LexicalSources(this.space, loadSnippetCatalogue(), this.settings), this.settings)
    }

    // The context of `filePath` with the marked text as its content.
    method contextOf(string filePath, string marked): FileContext {
        var source = cxWithoutMarker(marked)
        this.files[filePath] = source
        return this.space.contextFor(Document(filePathToUri(filePath), "novus", 1, source))
    }

    method detect(string filePath, string marked): CompletionContext {
        var context = this.contextOf(filePath, marked)
        return this.engine.detector.detect(context, cxMarkerOffset(marked))
    }

    method complete(string filePath, string marked): CompletionList {
        var context = this.contextOf(filePath, marked)
        return this.engine.complete(context, cxMarkerOffset(marked), "")
    }
}

private final CX_MARKER = "<|>"
private final CX_COUNT_LIMIT = 100

method cxMarkerOffset(string marked): integer {
    return marked.indexOf(CX_MARKER)
}

method cxWithoutMarker(string marked): string {
    var cut = cxMarkerOffset(marked)
    return marked.substring(0, cut) + marked.substring(cut + CX_MARKER.length(), marked.length())
}

method cxEscape(string value): string {
    return value.replace("\r", "\\r").replace("\n", "\\n")
}

// `kind prefix=[..] replace=[..]` and the type name and detail when the context has them.
method cxContextLine(CompletionContext request, string source): string {
    if (request.suppressed) {
        return "suppressed"
    }
    var line = request.kind + " prefix=[" + request.prefix + "] replace=[" + source.substring(request.replaceSpan.start, request.replaceSpan.end) + "]"
    if (request.typeName != "") {
        line = line + " type=[" + request.typeName + "]"
    }
    if (request.detail != "") {
        line = line + " detail=[" + request.detail + "]"
    }
    if (request.receiver.length() > 0) {
        line = line + " receiver=" + request.receiver.length() + " steps"
    }
    return line
}

method cxItemLine(CompletionItem item): string {
    var line = "  " + item.sortText + " " + item.label + " (" + item.kind + ")"
    if (item.detail != "") {
        line = line + " " + item.detail
    }
    if (item.insertText != "") {
        line = line + " => " + cxEscape(item.insertText)
    }
    for (edit in item.additionalEdits) {
        line = line + " +edit@" + edit.span.start + "[" + cxEscape(edit.newText) + "]"
    }
    if (item.deprecated) {
        line = line + " deprecated"
    }
    return line
}

// The context of the cursor, then the items of the answer (all of them up to `limit`, then the count).
method cxShow(string title, CxWorld world, string filePath, string marked, integer limit) {
    println("== " + title)
    var request = world.detect(filePath, marked)
    println("context: " + cxContextLine(request, cxWithoutMarker(marked)))
    var list = world.complete(filePath, marked)
    var shown = 0
    for (item in list.items) {
        if (shown < limit) {
            println(cxItemLine(item))
        }
        shown = shown + 1
    }
    println("items: " + cxCount(list.items.length()) + " incomplete=" + list.isIncomplete)
}

// A long list (every keyword, builtin and snippet) is not counted exactly: the count follows the catalogues.
method cxCount(integer count): string {
    if (count > CX_COUNT_LIMIT) {
        return "more than " + CX_COUNT_LIMIT
    }
    return "" + count
}

// Only the context of the cursor.
method cxShowContext(string title, CxWorld world, string filePath, string marked) {
    var request = world.detect(filePath, marked)
    println(title + ": " + cxContextLine(request, cxWithoutMarker(marked)))
}

// The text after accepting the item `label`: its own edit only, the additional edits are shown by `cxShow`.
method cxAccept(string title, CxWorld world, string filePath, string marked, string label) {
    var source = cxWithoutMarker(marked)
    for (item in world.complete(filePath, marked).items) {
        if (item.label == label) {
            var inserted = item.insertText
            if (inserted == "") {
                inserted = item.label
            }
            println(title + ": " + cxEscape(source.substring(0, item.replaceSpan.start) + inserted + source.substring(item.replaceSpan.end, source.length())))
            return
        }
    }
    println(title + ": no item " + label)
}

method cxLabels(CompletionList list): string {
    var labels = []
    for (item in list.items) {
        labels.append(item.label)
    }
    return labels.join(" ")
}

method cxProject(): map<string, string> {
    return {
        "/p/project.nv": "project \"p\"\nmain \"main.nv\"\nrequire \"ex.com/lib\"\nreplace \"ex.com/lib\" \"lib\"\n",
        "/p/main.nv": "package main\n\nimport geo\n\nmethod main() {\n}\n",
        "/p/util.nv": "package main\n\nmethod helper(integer n): integer {\n    return n\n}\n",
        "/p/geo/shape.nv": "package geo\n\n// A shape with an area.\ndefine class Shape {\n    string name\n    float size: get, set\n    method area(): float {\n        return 1.0\n    }\n}\ndefine enum Color { Red, Green; }\nmethod describe(Shape shape): string {\n    return shape.name\n}\n",
        "/p/geo/extra.nv": "package geo\n\ndefine interface Named {\n    label(): string\n}\n",
        "/p/geo/shapes/round.nv": "package shapes\n\ndefine class Round {\n    float radius\n}\n",
        "/p/other/thing.nv": "package other\n\ndefine class Thing {\n    integer id\n}\nmethod describe(Thing thing): string {\n    return \"x\"\n}\n",
        "/p/lib/lib.nv": "// Returns its argument.\nmethod libFunction(integer a): integer {\n    return a\n}\n// A thing of the library.\ndefine class LibThing {\n    string label\n}\n",
        "/p/lib/sub/extra.nv": "package sub\n\nmethod subFunction(): integer {\n    return 1\n}\n"
    }
}
