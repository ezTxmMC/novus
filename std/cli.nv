package cli

// Command line parsing: `cli.parse(args)` splits positional arguments from
// options: --name value, --name=value, --flag, -x.
//   { "args": [...], "opts": { "name": "value", "flag": "true" } }

method parse(array<string> arguments): map<string, object> {
    var positional = []
    var options = {}
    var i = 0
    while (i < arguments.length()) {
        var a = arguments[i]
        if (a == "--") {
            i = i + 1
            while (i < arguments.length()) {
                positional.append(arguments[i])
                i = i + 1
            }
            break
        }
        if (a.startsWith("--")) {
            var body = a.substring(2, a.length())
            var eq = body.indexOf("=")
            if (eq >= 0) {
                options[body.substring(0, eq)] = body.substring(eq + 1, body.length())
                i = i + 1
                continue
            }
            if (i + 1 < arguments.length() && arguments[i + 1].startsWith("-") == false) {
                options[body] = arguments[i + 1]
                i = i + 2
                continue
            }
            options[body] = "true"
            i = i + 1
            continue
        }
        if (a.startsWith("-") && a.length() > 1) {
            options[a.substring(1, a.length())] = "true"
            i = i + 1
            continue
        }
        positional.append(a)
        i = i + 1
    }
    return { "args": positional, "opts": options }
}

// Option value or a fallback.
method option(map<string, object> parsed, string name, string fallback): string {
    var opts = parsed["opts"]
    if (opts.has(name)) {
        return opts[name]
    }
    return fallback
}

method flag(map<string, object> parsed, string name): bool {
    var opts = parsed["opts"]
    return opts.has(name)
}

// Positional argument at `index` or a fallback.
method argument(map<string, object> parsed, integer index, string fallback): string {
    var args = parsed["args"]
    if (index < args.length()) {
        return args[index]
    }
    return fallback
}
