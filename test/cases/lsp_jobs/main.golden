--- planner: dirty buffers go into overlays
main.nv edited: ok=true why='' entry=/proj/main.nv novusc=./main.nv
  request 1 entry=/proj/main.nv root=/proj timeout=60
  overlays [/proj/main.nv buffer]
  versions [/proj/main.nv=7]
util.nv edited, main.nv requested:
  request 1 entry=/proj/main.nv root=/proj timeout=60
  overlays [/proj/main.nv disk, /proj/util.nv buffer]
  versions [/proj/util.nv=3]
project.nv edited: ok=true why='' entry=/proj/main.nv novusc=./main.nv
  request 1 entry=/proj/main.nv root=/proj timeout=60
  overlays [/proj/main.nv disk, /proj/project.nv buffer]
  versions [/proj/project.nv=2]
