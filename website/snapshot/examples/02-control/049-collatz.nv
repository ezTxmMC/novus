package main

// The Collatz sequence: halve even numbers, triple odd ones and add one.

method main {
    var n = 27
    var steps = 0
    var peak = n
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        if (n > peak) {
            peak = n
        }
        steps = steps + 1
    }
    println "steps ${steps}, highest value ${peak}"
}
