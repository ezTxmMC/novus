package edits

import base/maybe
import base/model
import features/actions
import server/protocol
import server/rpc
import server/session

// `textDocument/codeAction`: the quick fixes of the diagnostics that the client sends and *Organize imports*, filtered by
// `context.only` when the client asks for some kinds. A document that is not open gets none. Every action edits the requesting
// document, so one line index serves them all (a command action edits nothing, 6.28).
define class CodeActionHandler based RequestHandler {
    Session session
    ActionEngine engine
    WireEncoder encoder

    construct(Session session, ActionEngine engine, WireEncoder encoder) {
        this.session = session
        this.engine = engine
        this.encoder = encoder
    }

    method handle(Request request): object {
        var context = this.session.contextFor(decodeDocumentUri(request.params))
        if (isNone(context)) {
            return []
        }
        var lines = context.document.lines
        var range = this.session.codec.spanOf(lines, decodeSelectedRange(request.params))
        var diagnostics = decodeContextDiagnostics(request.params, this.session.codec, lines)
        var wanted = protocolTextList(protocolPath(request.params, ["context", "only"]))
        var linesByPath = {}
        linesByPath[context.document.filePath] = lines
        var encoded = []
        for (item in this.engine.actionsFor(context, range, diagnostics)) {
            if (editsKindWanted(item.kind, wanted)) {
                encoded.append(this.encoder.codeAction(lines, item, linesByPath))
            }
        }
        return encoded
    }
}

// No `only` means every kind; else a kind matches an entry that is equal to it or a prefix up to a dot (`source` wants
// `source.organizeImports`), as the protocol defines the hierarchy of code action kinds.
method editsKindWanted(string kind, array<string> wanted): bool {
    if (wanted.length() == 0) {
        return true
    }
    for (entry in wanted) {
        if (kind == entry || kind.startsWith(entry + ".")) {
            return true
        }
    }
    return false
}
