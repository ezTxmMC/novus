package codegen

import ast
import parser

// Statements -> C: the dispatch on the kind of statement.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method genStatement(string node, string indent, map<string, string> prog, map<string, string> ctx, map<string, string> locals, map<string, string> blockVars): string {
    if (isList(node) == false) {
        return genExpressionStatement(node, indent, prog, ctx, locals)
    }
    var head = nodeHead(node)
    if (head == "nop") {
        return ""
    }
    if (head == CBLOCK_NODE) {
        return genCBlockStatement(node, indent, prog, ctx, locals)
    }
    if (head == "var") {
        return genVarStatement(node, indent, prog, ctx, locals, blockVars)
    }
    if (head == "tvar") {
        return genTypedVarStatement(node, indent, prog, ctx, locals, blockVars)
    }
    if (head == "assign") {
        return genAssignStatement(node, indent, prog, ctx, locals)
    }
    if (head == "setexpr") {
        return genSetStatement(node, indent, prog, ctx, locals, blockVars)
    }
    if (head == "return") {
        return genReturnStatement(node, indent, prog, ctx, locals)
    }
    if (head == "println" || head == "print" || head == "eprintln") {
        return indent + PRINT_FUNCTIONS[head] + "(" + genExpr(nodeChild(node, 1), prog, ctx, locals) + ");" + nl()
    }
    return genControlStatement(node, head, indent, prog, ctx, locals, blockVars)
}

// The runtime function of each print statement.
private final PRINT_FUNCTIONS = {"println": "nv_println", "print": "nv_print", "eprintln": "nv_eprintln"}

method genExpressionStatement(string node, string indent, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    return indent + "(void)" + genExpr(node, prog, ctx, locals) + ";" + nl()
}

// `var name [= value]`
method genVarStatement(string node, string indent, map<string, string> prog, map<string, string> ctx, map<string, string> locals, map<string, string> blockVars): string {
    var name = nodeChild(node, 1)
    if (nodeCount(node) > 2) {
        return declareLocal(name, genValueFor(name, nodeChild(node, 2), prog, ctx, locals), indent, locals, blockVars)
    }
    if (isIntLocal(locals, name)) {
        return declareLocal(name, "0", indent, locals, blockVars)
    }
    if (isFloatLocal(locals, name)) {
        return declareLocal(name, "0.0", indent, locals, blockVars)
    }
    return declareLocal(name, "nv_nil", indent, locals, blockVars)
}

// `Type name [= value]`
method genTypedVarStatement(string node, string indent, map<string, string> prog, map<string, string> ctx, map<string, string> locals, map<string, string> blockVars): string {
    var name = nodeChild(node, 2)
    var declaredType = nodeChild(node, 1)
    if (nodeCount(node) <= 3) {
        return declareLocal(name, defaultCode(declaredType), indent, locals, blockVars)
    }
    var value = nodeChild(node, 3)
    if (isIntLocal(locals, name)) {
        return declareLocal(name, genInt(value, prog, ctx, locals), indent, locals, blockVars)
    }
    if (isFloatLocal(locals, name)) {
        return declareLocal(name, genNumberAs(value, KIND_FLOAT, prog, ctx, locals), indent, locals, blockVars)
    }
    return declareLocal(name, coerceCode(genExpr(value, prog, ctx, locals), declaredType), indent, locals, blockVars)
}

// `name = value` for a local, a global or a field of `this`.
method genAssignStatement(string node, string indent, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    var target = nodeChild(node, 1)
    var cname = resolveVar(target, prog, ctx, locals)
    if (cname == "" && isImplicitField(target, prog, ctx, locals)) {
        var stored = coerceFieldCode(genExpr(nodeChild(node, 2), prog, ctx, locals), fieldType(prog, ctx["class"], target))
        return indent + nv_fieldSlotCode(prog, ctx, target) + " = " + stored + ";" + nl()
    }
    if (cname == "" || cname == "self") {
        fail("unknown variable '" + target + "'", ctx["pos"])
    }
    return indent + cname + " = " + genValueFor(target, nodeChild(node, 2), prog, ctx, locals) + ";" + nl()
}

// `target.member = value` and `target[index] = value`
method genSetStatement(string node, string indent, map<string, string> prog, map<string, string> ctx, map<string, string> locals, map<string, string> blockVars): string {
    var sequence = sequenceOperands(node, prog, ctx, locals)
    if (sequence.length() > 0) {
        return sequencedStatements(sequence, indent) + genStatement(sequence[0], indent, prog, ctx, locals, blockVars)
    }
    return indent + genSetCode(nodeChild(node, 1), nodeChild(node, 2), prog, ctx, locals) + ";" + nl()
}

method genReturnStatement(string node, string indent, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    // leaving a method leaves every sync block it is inside
    var leaveAll = syncUnwind(syncHeld(ctx), "")
    if (nodeCount(node) <= 1) {
        return indent + leaveAll + "return nv_nil;" + nl()
    }
    if (ctx.has("rawret") && ctx["rawret"] != "") {
        // the unboxed worker of a method returns the number itself
        return indent + leaveAll + "return " + genNumberAs(nodeChild(node, 1), ctx["rawret"], prog, ctx, locals) + ";" + nl()
    }
    return indent + leaveAll + "return " + coerceCode(genExpr(nodeChild(node, 1), prog, ctx, locals), ctx["ret"]) + ";" + nl()
}

// The C expression that stores `valueNode` into a member (`o.f`) or an
// element (`a[i]`).
method genSetCode(string lhs, string valueNode, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    var value = genExpr(valueNode, prog, ctx, locals)
    if (nodeHead(lhs) == "idx") {
        return "nv_index_set(" + genExpr(nodeChild(lhs, 1), prog, ctx, locals) + ", " + genExpr(nodeChild(lhs, 2), prog, ctx, locals) + ", " + value + ")"
    }
    if (nodeHead(lhs) != "mget") {
        fail("invalid assignment target", ctx["pos"])
    }
    var receiver = nodeChild(lhs, 1)
    var member = nodeChild(lhs, 2)
    if (receiver == "this" && ctx["class"] != "" && fieldSlot(prog, ctx["class"], member) >= 0) {
        return "nv_fields(self->o)[" + fieldSlot(prog, ctx["class"], member) + "] = " + coerceFieldCode(value, fieldType(prog, ctx["class"], member))
    }
    return "nv_set_member(" + genExpr(receiver, prog, ctx, locals) + ", " + cstr(member) + ", " + value + ")"
}
