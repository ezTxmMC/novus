package main

private final NAV_MAIN_TEXT = "import geo\nimport strings\nimport @helper\n\ndefine enum Color {\n    Red,\n    Green\n}\n\nmethod main() {\n    var circle = Circle(2.0)\n    var area = circle.area()\n    println(geo.describe(circle))\n    println(strings.repeat(\"a\", 2))\n    var shade = Color.Red\n    var total = helper(1)\n    total = total + helper(2)\n    println(area)\n    println(scaled(1.0) + scaled(1.0, 2.0))\n}\n"

private final NAV_SHAPE_TEXT = "package geo\n\ndefine abstract Shape {\n    abstract method area(): float\n\n    method label(): string {\n        return \"shape\"\n    }\n}\n\ndefine class Circle based Shape {\n    float radius\n\n    construct(float radius) {\n        this.radius = radius\n    }\n\n    method area(): float {\n        return radius * radius\n    }\n\n    method grow(float by): float {\n        var next = radius + by\n        return next\n    }\n}\n\nmethod describe(Shape shape): string {\n    return shape.label()\n}\n\nmethod scaled(float factor): float {\n    return factor\n}\n\nmethod scaled(float factor, float extra): float {\n    return factor + extra\n}\n"

private final NAV_CALLS_SHAPE_TEXT = "package geo\n\nmethod scaled(float factor): float {\n    return factor\n}\n\nmethod scaled(float factor, float extra): float {\n    return factor + extra\n}\n"

private final NAV_HELPER_TEXT = "method helper(integer count): integer {\n    return count + 1\n}\n"

// The project of the navigation cases: a manifest, the root file, a package folder and a root helper file.
method navProject(string mainText, string shapeText): map<string, string> {
    return {
        "/p/project.nv": "project \"p\"\nmain \"main.nv\"\n",
        "/p/main.nv": mainText,
        "/p/geo/shape.nv": shapeText,
        "/p/helper.nv": NAV_HELPER_TEXT
    }
}

// The main file with the cursor marker put in front of the first occurrence of `needle` (plus `shift` bytes).
method navMain(string needle, integer shift): map<string, string> {
    return navProject(navMarked(NAV_MAIN_TEXT, needle, shift), NAV_SHAPE_TEXT)
}

method navShape(string needle, integer shift): map<string, string> {
    return navProject(NAV_MAIN_TEXT, navMarked(NAV_SHAPE_TEXT, needle, shift))
}

method navMarked(string content, string needle, integer shift): string {
    var at = content.indexOf(needle) + shift
    return content.substring(0, at) + "@@" + content.substring(at, content.length())
}
