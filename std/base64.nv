package base64

import math

// Base64 encoding (RFC 4648, with padding).

method alphabet(): string {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

method encode(string text): string {
    var table = alphabet()
    var out = ""
    var i = 0
    var n = text.length()
    while (i < n) {
        var b0 = ord(text.charAt(i))
        var b1 = 0
        var b2 = 0
        if (i + 1 < n) {
            b1 = ord(text.charAt(i + 1))
        }
        if (i + 2 < n) {
            b2 = ord(text.charAt(i + 2))
        }
        var triple = b0 * 65536 + b1 * 256 + b2
        out = out + table.charAt(triple / 262144)
        out = out + table.charAt((triple / 4096) % 64)
        if (i + 1 < n) {
            out = out + table.charAt((triple / 64) % 64)
        }
        if (i + 1 >= n) {
            out = out + "="
        }
        if (i + 2 < n) {
            out = out + table.charAt(triple % 64)
        }
        if (i + 2 >= n) {
            out = out + "="
        }
        i = i + 3
    }
    return out
}

method decode(string encoded): string {
    var table = alphabet()
    var out = ""
    var bits = 0
    var value = 0
    for (c in encoded) {
        if (c == "=" || c == "\n" || c == "\r" || c == " ") {
            continue
        }
        var index = table.indexOf(c)
        if (index < 0) {
            continue
        }
        value = value * 64 + index
        bits = bits + 6
        if (bits >= 8) {
            bits = bits - 8
            var byte = value / math.powInt(2, bits)
            out = out + chr(byte % 256)
            value = value % math.powInt(2, bits)
        }
    }
    return out
}
