package main

import path

// Embeds a C header into a Novus source file as a string constant:
//   novusc run tools/embed.nv runtime/novus_rt.h > compiler/runtime/runtime.nv
// The generated module exposes `runtimeSource()`, which novusc pastes at
// the top of every generated C file.
//
// The runtime is split into parts that novus_rt.h pulls in with quoted
// includes (`#include "nv_values.h"`); those are inlined here, each part
// once, in the order they are included, so the embedded runtime is the
// same single translation unit a C compiler would see.

method main(array<string> arguments) {
    if (arguments.length() < 1) {
        eprintln "usage: embed <file>"
        return 1
    }
    var seen = {}
    var text = inlineIncludes(arguments[0], seen)
    if (text == "") {
        eprintln "cannot read " + arguments[0]
        return 1
    }
    println "package runtime"
    println ""
    println "// GENERATED from " + arguments[0] + " by tools/embed.nv - do not edit."
    println "// The C runtime that every program compiled by novusc embeds."
    println ""
    println "method runtimeSource(): string {"
    println "    return \"" + escapeNovus(text) + "\""
    println "}"
    return 0
}

method escapeChar(string c): string {
    if (c == "\\") {
        return "\\\\"
    }
    if (c == "\"") {
        return "\\\""
    }
    if (c == "\n") {
        return "\\n"
    }
    if (c == "\t") {
        return "\\t"
    }
    if (c == "\r") {
        return "\\r"
    }
    if (c == "$") {
        // keep "${" out of the literal (interpolation)
        return "\\$"
    }
    return c
}

method escapeNovus(string text): string {
    var out = ""
    var i = 0
    var n = text.length()
    while (i < n) {
        out = out + escapeChar(text.charAt(i))
        i = i + 1
    }
    return out
}

// The text of `file` with every `#include "name"` line replaced by the text
// of that file (relative to the including file), recursively. A part that
// was already inlined is dropped, as its include guard would drop it.
method inlineIncludes(string file, map<string, string> seen): string {
    var text = readFile(file)
    if (text == "") {
        return ""
    }
    var dir = path.dirname(file)
    var out = ""
    var lines = text.split("\n")
    var i = 0
    var n = lines.length()
    while (i < n) {
        var line = lines[i]
        var name = quotedInclude(line)
        if (name == "") {
            out = out + line
            if (i < n - 1) {
                out = out + "\n"
            }
        } else {
            var target = path.join(dir, name)
            if (seen.has(target) == false) {
                seen[target] = "1"
                var part = inlineIncludes(target, seen)
                if (part == "") {
                    eprintln "cannot read " + target + " (included from " + file + ")"
                    exit(1)
                }
                out = out + part
                if (part.endsWith("\n") == false) {
                    out = out + "\n"
                }
            }
        }
        i = i + 1
    }
    return out
}

// The file name of an `#include "name"` line, "" for any other line.
method quotedInclude(string line): string {
    var s = line.trim()
    if (s.startsWith("#include \"") == false) {
        return ""
    }
    var rest = s.substring(10, s.length())
    var close = rest.indexOf("\"")
    if (close < 0) {
        return ""
    }
    return rest.substring(0, close)
}
