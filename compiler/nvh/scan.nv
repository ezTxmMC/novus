package nvh

import lexer
import loader
import parser

// Scanning code that sits inside template text: strings, braces, argument
// lists and statements.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// Index after the string literal that starts at `at` (a double quote).
method nvhSkipString(string s, integer at): integer {
    var i = at + 1
    var n = s.length()
    while (i < n) {
        var c = s.charAt(i)
        if (c == NVH_BACKSLASH) {
            i = i + 2
            continue
        }
        if (c == NVH_QUOTE) {
            return i + 1
        }
        i = i + 1
    }
    return n
}

// Index after the '}' closing the '{' at `open`, -1 when there is none.
method nvhCloseBrace(string s, integer open): integer {
    var depth = 0
    var i = open
    var n = s.length()
    while (i < n) {
        var c = s.charAt(i)
        if (c == NVH_QUOTE) {
            i = nvhSkipString(s, i)
            continue
        }
        if (c == "{") {
            depth = depth + 1
        }
        if (c == "}") {
            depth = depth - 1
            if (depth == 0) {
                return i + 1
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// Splits `s` at the commas that are not nested in brackets or strings.
method nvhSplitArgs(string s): array<string> {
    var out = []
    var depth = 0
    var start = 0
    var i = 0
    var n = s.length()
    while (i < n) {
        var c = s.charAt(i)
        if (c == NVH_QUOTE) {
            i = nvhSkipString(s, i)
            continue
        }
        if (c == "(" || c == "[" || c == "{") {
            depth = depth + 1
        }
        if (c == ")" || c == "]" || c == "}") {
            depth = depth - 1
        }
        if (c == "," && depth == 0) {
            out.append(s.substring(start, i).trim())
            start = i + 1
        }
        i = i + 1
    }
    var last = s.substring(start, n).trim()
    if (last != "" || out.length() > 0) {
        out.append(last)
    }
    return out
}

// The text and {expr} parts of an attribute value: ["t", text] and ["e", code].
method nvhInterpolate(string s, string pos): array<object> {
    var out = []
    var text = ""
    var i = 0
    var n = s.length()
    while (i < n) {
        var c = s.charAt(i)
        if (c == NVH_BACKSLASH && i + 1 < n && (s.charAt(i + 1) == "{" || s.charAt(i + 1) == "}")) {
            text = text + s.charAt(i + 1)
            i = i + 2
            continue
        }
        if (c != "{") {
            text = text + c
            i = i + 1
            continue
        }
        var close = nvhCloseBrace(s, i)
        if (close < 0) {
            fail("unclosed '{' in attribute value", pos)
        }
        if (text != "") {
            out.append(["t", text])
            text = ""
        }
        out.append(["e", s.substring(i + 1, close - 1).trim()])
        i = close
    }
    if (text != "") {
        out.append(["t", text])
    }
    return out
}

// Index of the line break that ends the statement starting at `i` (one at
// bracket depth 0), or the end of the code.
method nvhStatementEnd(string code, integer from): integer {
    var depth = 0
    var i = from
    var n = code.length()
    while (i < n) {
        var c = code.charAt(i)
        if (c == NVH_QUOTE) {
            i = nvhSkipString(code, i)
            continue
        }
        if (c == "/" && i + 1 < n && code.charAt(i + 1) == "/") {
            i = nvhLineEnd(code, i)
            continue
        }
        if (c == "/" && i + 1 < n && code.charAt(i + 1) == "*") {
            var close = code.indexOf("*/", i + 2)
            if (close < 0) {
                return n
            }
            i = close + 2
            continue
        }
        if (c == "'") {
            i = nvhSkipCharLiteral(code, i)
            continue
        }
        if (c == "{" || c == "(" || c == "[") {
            depth = depth + 1
        }
        if (c == "}" || c == ")" || c == "]") {
            depth = depth - 1
        }
        if (c == NVH_NEWLINE && depth <= 0) {
            return i
        }
        i = i + 1
    }
    return n
}

// Index after the C character literal ('{', '\n') that starts at `at`, so the braces of a
// `c { }` block that are characters do not count; `at + 1` when no literal follows.
method nvhSkipCharLiteral(string code, integer at): integer {
    var body = at + 2
    if (at + 1 < code.length() && code.charAt(at + 1) == NVH_BACKSLASH) {
        body = at + 3
    }
    if (body < code.length() && code.charAt(body) == "'") {
        return body + 1
    }
    return at + 1
}

// Index of the line break at or after `from`, the end of the text when there is none.
method nvhLineEnd(string code, integer from): integer {
    var i = from
    while (i < code.length() && code.charAt(i) != NVH_NEWLINE) {
        i = i + 1
    }
    return i
}
