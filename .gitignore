# Build output
# build/  scripts/bootstrap.sh (novusc0, novusc1, novusc)
# dist/   scripts/cross.sh (cross compiled binaries)
build/
dist/
*.o
*.obj
*.exe
*.pdb
a.out

# Generated C: `novusc emit` / `novusc build --keep-c` next to the sources.
# The bootstrap snapshot is the one C file that is tracked.
*.c
!bootstrap/novusc.c

# Files the examples write while they run (they clean up themselves)
examples/*/example-*
examples/*/*.json

# Binaries built from the examples and the quick start
/wc
/demo
examples/*/wc
examples/*/mccloud
examples/**/test/
test/cases/project/geoapp

# Program output written into the working directory
todo.json
mccloud-data/
people/

# Website (website/ — bun + vite docs site; its `dist/` is covered above)
node_modules/
*.tsbuildinfo
.vite/

# Copied out of the repository by `bun run sync` (scripts/sync-content.ts)
website/src/generated/
website/src/lib/novus.tmLanguage.json

# Documentation site (website/ has its own .gitignore as well)
website/node_modules/
website/dist/
website/src/generated/
website/src/lib/novus.tmLanguage.json

# Tooling caches and logs
.cache/
*.log
*.tmp
*.swp
*~

# Editors and OS
.vscode/
!vscode-novus/.vscode/
.idea/
.DS_Store
Thumbs.db
