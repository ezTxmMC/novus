#### strings that run over lines
open import string: importModule prefix=[] replace=[] type=[ex.com/]
accept below the module: package main\n\nimport "ex.com/lib\nimport geo\nmethod main() {\n    println("x")\n}\n
accept a whole key: package main\n\nimport "ex.com/lib\nimport geo\nmethod main() {\n    println("x")\n}\n
crlf: package main\r\n\r\nimport "ex.com/lib\r\nimport geo\r\n
the closing quote is on the same line: package main\n\nimport "ex.com/lib"\n
the cursor in the first segment: package main\n\nimport "ex.com/lib"\n
the cursor in a segment below a module: package main\n\nimport "ex.com/lib/sub/x"\n
open require string: manifest prefix=[ex.c] replace=[ex.c] detail=[requireModule]
accept in a manifest: project "p"\nrequire "ex.com/lib"\nrequire "ex.com/lib\nversion "1"\n
replace module: project "p"\nrequire "ex.com/lib"\nreplace "ex.com/lib\nversion "1"\n
replace directory: project "p"\nrequire "ex.com/lib"\nreplace "ex.com/lib" "lib\nversion "1"\n
