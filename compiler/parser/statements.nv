package parser

import ast
import lexer

// Statements and blocks.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method parseBlock(array<string> tokens, integer pos): map<string, string> {
    var p = expectSym(tokens, pos, "{")
    var node = "(block"
    while (isSym(tokens, p, "}") == false) {
        if (atEnd(tokens, p)) {
            fail("unterminated block (missing '}')", posOf(tokens, p))
        }
        var at = posOf(tokens, p)
        var s = parseStatement(tokens, p)
        if (s["node"] != "(nop)") {
            node = node + " (at " + at + " " + s["node"] + ")"
        }
        p = parseInt(s["pos"])
    }
    return { "node": node + ")", "pos": p + 1 }
}

method parseIf(array<string> tokens, integer pos): map<string, string> {
    var p = expectSym(tokens, pos + 1, "(")
    var c = parseExpr(tokens, p, 0)
    p = expectSym(tokens, parseInt(c["pos"]), ")")
    var thenBlock = parseBlock(tokens, p)
    var node = "(if " + c["node"] + " " + thenBlock["node"]
    p = parseInt(thenBlock["pos"])
    if (isKw(tokens, p, "else") == false) {
        return { "node": node + ")", "pos": p }
    }
    var tail = parseElse(tokens, p + 1)
    return { "node": node + " " + tail["node"] + ")", "pos": parseInt(tail["pos"]) }
}

// What follows `else`: another if, or the block.
method parseElse(array<string> tokens, integer pos): map<string, string> {
    if (isKw(tokens, pos, "if")) {
        return parseIf(tokens, pos)
    }
    return parseBlock(tokens, pos)
}

// Is there a typed declaration `Type name = expr` at pos?
method isTypedDecl(array<string> tokens, integer pos): bool {
    if (isIdent(tokens, pos) == false) {
        return false
    }
    var p = pos + 1
    if (isSym(tokens, p, "<")) {
        var depth = 0
        while (atEnd(tokens, p) == false) {
            if (isSym(tokens, p, "<")) {
                depth = depth + 1
            }
            if (isSym(tokens, p, ">")) {
                depth = depth - 1
            }
            p = p + 1
            if (depth == 0) {
                break
            }
        }
    }
    return isIdent(tokens, p) && isSym(tokens, p + 1, "=")
}

method parseStatement(array<string> tokens, integer pos): map<string, string> {
    var t = tokens[pos]
    var kind = tokKind(t)
    var val = tokVal(t)
    if (kind == "SYM" && val == ";") {
        return { "node": "(nop)", "pos": pos + 1 }
    }
    if (kind == CBLOCK_KIND || kind == CBLOCK_UNTERMINATED_KIND) {
        return { "node": cBlockNode(t), "pos": pos + 1 }
    }
    if (kind == "KEYWORD") {
        return parseKeywordStatement(tokens, pos, val)
    }
    // sync { ... } takes the program-wide lock, sync (lock) { ... } that one
    if (kind == "IDENT" && val == "sync" && (isSym(tokens, pos + 1, "{") || isSym(tokens, pos + 1, "("))) {
        return parseSync(tokens, pos)
    }
    if (kind == "IDENT" && isSym(tokens, pos + 1, "=")) {
        var assigned = parseExpr(tokens, pos + 2, 0)
        return { "node": "(assign " + val + " " + assigned["node"] + ")", "pos": parseInt(assigned["pos"]) }
    }
    if (isTypedDecl(tokens, pos)) {
        return parseTypedDecl(tokens, pos)
    }
    return parseExpressionStatement(tokens, pos)
}

method parseKeywordStatement(array<string> tokens, integer pos, string val): map<string, string> {
    if (val == "var") {
        return parseVar(tokens, pos)
    }
    if (val == "return") {
        return parseReturn(tokens, pos)
    }
    if (val == "println" || val == "print" || val == "eprintln") {
        var printed = parseExpr(tokens, pos + 1, 0)
        return { "node": "(" + val + " " + printed["node"] + ")", "pos": parseInt(printed["pos"]) }
    }
    if (val == "if") {
        return parseIf(tokens, pos)
    }
    if (val == "while") {
        return parseWhile(tokens, pos)
    }
    if (val == "for") {
        return parseFor(tokens, pos)
    }
    if (val == "break" || val == "continue") {
        return { "node": "(" + val + ")", "pos": pos + 1 }
    }
    if (val == "package") {
        return { "node": "(nop)", "pos": pos + 2 }
    }
    fail("unexpected keyword '" + val + "'", tokPos(tokens[pos]))
    return { "node": "(nop)", "pos": pos + 1 }
}

// var name [: type] [= expr]
method parseVar(array<string> tokens, integer pos): map<string, string> {
    var p = expectIdent(tokens, pos + 1, "variable name")
    var name = tokVal(tokens[p - 1])
    var declType = ""
    if (isSym(tokens, p, ":")) {
        var ty = parseType(tokens, p + 1)
        declType = ty["node"]
        p = parseInt(ty["pos"])
    }
    var head = "(var "
    if (declType != "") {
        head = "(tvar " + declType + " "
    }
    if (isSym(tokens, p, "=") == false) {
        return { "node": head + name + ")", "pos": p }
    }
    var value = parseExpr(tokens, p + 1, 0)
    return { "node": head + name + " " + value["node"] + ")", "pos": parseInt(value["pos"]) }
}

// A return without a value ends its line.
method parseReturn(array<string> tokens, integer pos): map<string, string> {
    var next = pos + 1
    if (atEnd(tokens, next) || isSym(tokens, next, "}") || tokPos(tokens[next]) != tokPos(tokens[pos])) {
        return { "node": "(return)", "pos": next }
    }
    var value = parseExpr(tokens, next, 0)
    return { "node": "(return " + value["node"] + ")", "pos": parseInt(value["pos"]) }
}

// Type name = expr
method parseTypedDecl(array<string> tokens, integer pos): map<string, string> {
    var declType = parseType(tokens, pos)
    var p = parseInt(declType["pos"])
    var name = tokVal(tokens[p])
    var value = parseExpr(tokens, p + 2, 0)
    return { "node": "(tvar " + declType["node"] + " " + name + " " + value["node"] + ")", "pos": parseInt(value["pos"]) }
}

// An expression, or `target = value` where the target is a member or an element.
method parseExpressionStatement(array<string> tokens, integer pos): map<string, string> {
    var target = parseExpr(tokens, pos, 0)
    var after = parseInt(target["pos"])
    if (isSym(tokens, after, "=") == false) {
        return { "node": target["node"], "pos": after }
    }
    var value = parseExpr(tokens, after + 1, 0)
    return { "node": "(setexpr " + target["node"] + " " + value["node"] + ")", "pos": parseInt(value["pos"]) }
}

// `c { ... }`: the raw text, kept as it is, and where it is (see lexer/cblock.nv).
method cBlockNode(string token): string {
    if (tokKind(token) == CBLOCK_UNTERMINATED_KIND) {
        fail("unterminated c { } block (missing '}')", tokPos(token))
    }
    return "(cblock " + sexpStr(tokVal(token)) + " " + sexpStr(tokPos(token)) + ")"
}
