package codegen

import "../ast/sexp.nv"
import "../parser/errors.nv"
import "../parser/types.nv"

// Small helpers shared by the code generator files.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method nl(): string {
    return chr(10)
}

method cstr(string text): string {
    return q() + text + q()
}

method copyMap(map<string, string> m): map<string, string> {
    var out = {}
    for (k in m.keys()) {
        out[k] = m[k]
    }
    return out
}

method isPrimitiveType(string t): bool {
    var n = normType(t)
    return n == "integer" || n == "float" || n == "string"
}

// Conversion to a declared primitive type, the expression otherwise.
method coerceCode(string expr, string t): string {
    var n = normType(t)
    if (n == "integer") {
        return "nv_coerce_int(" + expr + ")"
    }
    if (n == "float") {
        return "nv_coerce_float(" + expr + ")"
    }
    if (n == "string") {
        return "nv_coerce_string(" + expr + ")"
    }
    return expr
}

// The value a method returns when it falls off the end.
method defaultCode(string t): string {
    var n = normType(t)
    if (n == "integer") {
        return "nv_int(0)"
    }
    if (n == "float") {
        return "nv_float(0.0)"
    }
    if (n == "string") {
        return "nv_lit(" + cstr("") + ")"
    }
    if (n == "bool") {
        return "nv_bool(0)"
    }
    return "nv_nil"
}

method paramsNode(string m): string {
    return nodeChild(m, 3)
}

method arityOf(string m): integer {
    return nodeCount(paramsNode(m)) - 1
}

method isAbstractMethod(string m): bool {
    return nodeChild(m, 5) == "(abstract)"
}

method methodName(string m): string {
    return nodeChild(m, 1)
}

method methodRet(string m): string {
    return nodeChild(m, 2)
}

method intToStr(integer i): string {
    return "" + i
}
