  replaces {github.com/user/lib: ../lib}
== empty text
  dir=/work/app name=[] version=[] main=[main.nv] lib=[] output=[]
  entry=main.nv mainPath=/work/app/main.nv executable=app
  replaces {}
== only a comment
  dir=. name=[] version=[] main=[main.nv] lib=[] output=[]
  entry=main.nv mainPath=main.nv executable=app
  replaces {}
== name only, entry is main
  dir=/w name=[example.com/a/b/tool] version=[] main=[main.nv] lib=[] output=[]
  entry=main.nv mainPath=/w/main.nv executable=tool
  directive line 0 project [example.com/a/b/tool] key 0-7 values [8-30]
  replaces {}
== name ends with a slash
  dir=/w name=[example.com/a/] version=[] main=[main.nv] lib=[] output=[]
  entry=main.nv mainPath=/w/main.nv executable=app
  directive line 0 project [example.com/a/] key 0-7 values [8-24]
  replaces {}
== lib wins as entry
  dir=/w name=[] version=[] main=[m.nv] lib=[l.nv] output=[]
  entry=l.nv mainPath=/w/m.nv executable=app
  directive line 0 main [m.nv] key 0-4 values [5-11]
  directive line 1 lib [l.nv] key 12-15 values [16-22]
  replaces {}
== root folder file
  dir=/ name=[x] version=[] main=[main.nv] lib=[] output=[]
  entry=main.nv mainPath=/main.nv executable=x
  directive line 0 project [x] key 0-7 values [8-11]
  replaces {}
== relative bare name
  dir=. name=[x] version=[] main=[main.nv] lib=[] output=[]
  entry=main.nv mainPath=main.nv executable=x
  directive line 0 project [x] key 0-7 values [8-11]
  replaces {}
== require without version, duplicates, replace overwrite
  dir=/w name=[] version=[] main=[main.nv] lib=[] output=[]
  entry=main.nv mainPath=/w/main.nv executable=app
  directive line 0 require [a/b] key 0-7 values [8-13]
  directive line 1 require [a/b, v2] key 14-21 values [22-27 28-32]
  directive line 2 require [c/d, main] key 33-40 values [41-46 47-53]
  directive line 3 replace [a/b, ../one] key 54-61 values [62-67 68-76]
  directive line 4 replace [a/b, ../two] key 77-84 values [85-90 91-99]
  directive line 5 replace [unused/x, ../x] key 100-107 values [108-118 119-125]
  require a/b @ latest line 0 span 0-13
  require c/d @ main line 2 span 33-53
  replaces {a/b: ../two, unused/x: ../x}
== unknown setting
  dir=/w name=[a] version=[] main=[main.nv] lib=[] output=[]
  entry=main.nv mainPath=/w/main.nv executable=a
  directive line 0 project [a] key 0-7 values [8-11]
  directive line 1 foo [bar] key 12-15 values [16-21]
  replaces {}
  issue line 1 span 12-15 [unknown-setting]: unknown setting 'foo' (known: project, version, main, lib, output, novus, require, replace) warning=false
