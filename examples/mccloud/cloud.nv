package mccloud

import json
import os
import path

import "files.nv"
import "process.nv"

// Cloud state: groups (cloud.json), running servers (servers.json), the
// template and server directories.

define class Group {
    private final string name: get
    private final integer memory: get, set
    private final integer port: get, set
    private final integer max: get, set
}

define class Server {
    private final string name: get
    private final string group: get
    private final integer port: get
    private final string dir: get
    private final integer started: get
}

define class Cloud {
    private final string root: get
    private final string java: get, set
    private final map<string, Group> groups: get
    private final array<Server> servers: get

    construct(string root) {
        this.root = root
        this.java = "java"
        this.groups = {}
        this.servers = []
        this.load()
    }

    method configFile(): string {
        return path.join(root, "cloud.json")
    }

    method serversFile(): string {
        return path.join(root, "servers.json")
    }

    method templateDir(string group): string {
        return path.join(root, "templates", group)
    }

    method serverDir(string name): string {
        return path.join(root, "servers", name)
    }

    method load() {
        if (fileExists(configFile())) {
            var data = json.parse(readFile(configFile()))
            java = data["java"]
            for (name in data["groups"]) {
                var g = data["groups"][name]
                groups[name] = Group(name, g["memory"], g["port"], g["max"])
            }
        }
        if (fileExists(serversFile())) {
            for (s in json.parse(readFile(serversFile()))) {
                servers.append(Server(s["name"], s["group"], s["port"], s["dir"], s["started"]))
            }
        }
    }

    method save() {
        os.mkdir(root)
        writeFile(configFile(), json.pretty({ "java": java, "groups": groups }))
        writeFile(serversFile(), json.pretty(servers))
    }

    method hasGroup(string name): bool {
        return groups.has(name)
    }

    method findServer(string name): integer {
        var i = 0
        while (i < servers.length()) {
            if (servers[i].name() == name) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    method runningInGroup(string group): integer {
        var count = 0
        for (s in servers) {
            if (s.group() == group) {
                count = count + 1
            }
        }
        return count
    }

    method portInUse(integer port): bool {
        for (s in servers) {
            if (s.port() == port) {
                return true
            }
        }
        return false
    }

    // "lobby-1", "lobby-2", ... - the first name not in use.
    method nextName(string group): string {
        var index = 1
        while (findServer("${group}-${index}") >= 0) {
            index = index + 1
        }
        return "${group}-${index}"
    }

    method nextPort(string group): integer {
        var port = groups[group].port()
        while (portInUse(port)) {
            port = port + 1
        }
        return port
    }

    // Creates the server directory from the template and starts the process.
    method startServer(string group): Server {
        var g = groups[group]
        var name = nextName(group)
        var port = nextPort(group)
        var dir = serverDir(name)
        if (os.exists(dir) == false) {
            copyDir(templateDir(group), dir)
        }
        setProperty(path.join(dir, "server.properties"), "server-port", "" + port)
        setProperty(path.join(dir, "eula.txt"), "eula", "true")
        var memory = g.memory()
        var command = "${java} -Xms${memory}M -Xmx${memory}M -jar server.jar nogui"
        if (startProcess(name, dir, command) == false) {
            eprintln "could not start ${name} (${backendName()})"
            exit(1)
        }
        var server = Server(name, group, port, dir, os.time())
        servers.append(server)
        save()
        return server
    }

    method stopServer(string name): bool {
        var index = findServer(name)
        if (index < 0) {
            return false
        }
        stopProcess(name)
        servers.remove(index)
        save()
        return true
    }

    // Drops servers whose process is gone (crashed or stopped from inside).
    method forget(string name) {
        var index = findServer(name)
        if (index >= 0) {
            servers.remove(index)
            save()
        }
    }
}
