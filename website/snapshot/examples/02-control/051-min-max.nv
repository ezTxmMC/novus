package main

// Finding the smallest and largest value in one pass.

method main {
    var numbers = [12, 45, 7, 23, 89, 3]
    var smallest = numbers[0]
    var largest = numbers[0]
    for (n in numbers) {
        if (n < smallest) {
            smallest = n
        }
        if (n > largest) {
            largest = n
        }
    }
    println "min ${smallest}, max ${largest}, spread ${largest - smallest}"
}
