package codegen

import "../ast/sexp.nv"
import "../ast/text.nv"
import "../parser/errors.nv"
import "../parser/types.nv"

// Small helpers shared by the code generator files.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method nl(): string {
    return chr(10)
}

method cstr(string text): string {
    return q() + text + q()
}

// Every distinct string literal of a program is laid down as one static
// value. A literal inside a loop is then a constant address instead of a
// value the runtime has to box (or look up in a cache) on every pass.
// `cText` is the literal already in C form, quotes included.
method litRef(map<string, string> prog, string cText): string {
    var key = "lit:" + cText
    if (prog.has(key)) {
        return "(&nv_lits[" + prog[key] + "])"
    }
    var index = 0
    if (prog.has("litn")) {
        index = parseInt(prog["litn"])
    }
    prog[key] = intToStr(index)
    prog["litat:" + index] = cText
    prog["litn"] = intToStr(index + 1)
    return "(&nv_lits[" + index + "])"
}

// The literal table itself, in first-use order.
method literalTable(map<string, string> prog): string {
    if (prog.has("litn") == false) {
        return ""
    }
    var count = parseInt(prog["litn"])
    var parts = []
    parts.append(nl() + "/* string literals */" + nl())
    parts.append("static NvVal nv_lits[" + count + "];" + nl())
    parts.append("static const char *const nv_lit_text[" + count + "] = {" + nl())
    var i = 0
    while (i < count) {
        parts.append("    " + prog["litat:" + i] + "," + nl())
        i = i + 1
    }
    parts.append("};" + nl())
    return joinParts(parts)
}

// The bodies registered by spawnBody(), in the order the spawn sites were
// generated.
method spawnBodies(map<string, string> prog): string {
    if (prog.has("spawnn") == false) {
        return ""
    }
    var count = parseInt(prog["spawnn"])
    var parts = []
    parts.append(nl() + "/* bodies of thread, virtual and async spawns */" + nl())
    var i = 0
    while (i < count) {
        parts.append("static nv nv_spawn_body_" + i + "(nv *a, int n) {" + nl())
        parts.append("    (void)a;" + nl() + "    (void)n;" + nl())
        parts.append("    return " + prog["spawnat:" + i] + ";" + nl() + "}" + nl())
        i = i + 1
    }
    return joinParts(parts)
}

method copyMap(map<string, string> m): map<string, string> {
    var out = {}
    for (k in m.keys()) {
        out[k] = m[k]
    }
    return out
}

method isPrimitiveType(string t): bool {
    var n = normType(t)
    return n == "integer" || n == "float" || n == "string"
}

// Conversion to a declared primitive type, the expression otherwise.
method coerceCode(string expr, string t): string {
    var n = normType(t)
    if (n == "integer") {
        return "nv_coerce_int(" + expr + ")"
    }
    if (n == "float") {
        return "nv_coerce_float(" + expr + ")"
    }
    if (n == "string") {
        return "nv_coerce_string(" + expr + ")"
    }
    return expr
}

// The value a method returns when it falls off the end.
method defaultCode(string t): string {
    var n = normType(t)
    if (n == "integer") {
        return "nv_int(0)"
    }
    if (n == "float") {
        return "nv_float(0.0)"
    }
    if (n == "string") {
        return "(&nv_empty_str_val)"
    }
    if (n == "bool") {
        return "nv_bool(0)"
    }
    return "nv_nil"
}

method paramsNode(string m): string {
    return nodeChild(m, 3)
}

method arityOf(string m): integer {
    return nodeCount(paramsNode(m)) - 1
}

method isAbstractMethod(string m): bool {
    return nodeChild(m, 5) == "(abstract)"
}

method methodName(string m): string {
    return nodeChild(m, 1)
}

method methodRet(string m): string {
    return nodeChild(m, 2)
}

// C identifier for a (possibly package qualified) Novus name: os.mkdir -> os__mkdir
method cName(string name): string {
    return name.replace(".", "__")
}

// Package part of a qualified name ("os" for "os.mkdir"), "" when plain.
method packageOf(string name): string {
    var dot = name.indexOf(".")
    if (dot < 0) {
        return ""
    }
    return name.substring(0, dot)
}

// Is `name` among the method's annotations? `async method` records itself
// as one, so nothing else in the node had to change shape.
method hasAnnotation(string m, string name): bool {
    var annos = nodeChild(m, 4)
    var i = 1
    var count = nodeCount(annos)
    while (i < count) {
        if (nodeChild(nodeChild(annos, i), 1) == name) {
            return true
        }
        i = i + 1
    }
    return false
}

method isAsyncMethod(string m): bool {
    return hasAnnotation(m, "Async")
}

// "a[0], a[1], ..." - how a spawned body reaches the arguments the thread
// that spawned it evaluated.
method argSlots(integer arity): string {
    var out = ""
    var i = 0
    while (i < arity) {
        if (i > 0) {
            out = out + ", "
        }
        out = out + "a[" + i + "]"
        i = i + 1
    }
    return out
}

// How deeply the statement being generated sits inside sync blocks.
method syncDepth(map<string, string> ctx): integer {
    if (ctx.has("sync") == false || ctx["sync"] == "") {
        return 0
    }
    return ctx["sync"].split(" ").length()
}

// The sync blocks the statement being generated sits inside, innermost last.
method syncHeld(map<string, string> ctx): string {
    if (ctx.has("sync")) {
        return ctx["sync"]
    }
    return ""
}

// The same at the point the innermost enclosing loop began: what `break`
// and `continue` have to leave behind, as opposed to `return`, which leaves
// every one of them.
method syncLoopHeld(map<string, string> ctx): string {
    if (ctx.has("syncloop")) {
        return ctx["syncloop"]
    }
    return ""
}

// C has no scope guards, so leaving a sync block early unlocks on the way
// out: every lock between `held` and `outer`, innermost first.
method syncUnwind(string held, string outer): string {
    if (held == "") {
        return ""
    }
    var names = held.split(" ")
    var keep = 0
    if (outer != "") {
        keep = outer.split(" ").length()
    }
    var out = ""
    var i = names.length() - 1
    while (i >= keep) {
        out = out + "nv_sync_leave(" + names[i] + "); "
        i = i - 1
    }
    return out
}

method isNativeMethod(string m): bool {
    return nodeHead(nodeChild(m, 5)) == "native"
}

method intToStr(integer i): string {
    return "" + i
}

// How a dynamic `target.name(args)` call is emitted. Arities up to three
// skip the runtime's va_list, and appending to an array is one push.
method invokeCall(string receiver, string name, integer nargs, string args): string {
    if (nargs == 1 && name == "has") {
        return "nv_has_key(" + receiver + ", " + cstr(name) + ", " + args + ")"
    }
    if (nargs == 1 && (name == "append" || name == "push")) {
        return "nv_append(" + receiver + ", " + cstr(name) + ", " + args + ")"
    }
    if (nargs > 0 && nargs < 4) {
        return "nv_invoke" + nargs + "(" + receiver + ", " + cstr(name) + ", " + args + ")"
    }
    return "nv_invoke(" + receiver + ", " + cstr(name) + ", " + nargs + ", " + args + ")"
}

// How the collection of a `for (x in xs)` loop is obtained. A body that
// contains no call and no property assignment cannot change the collection,
// so the loop can walk it directly instead of a snapshot copy. Anything that
// looks like a call - even inside a string literal - takes the safe path.
method iterCall(string body, string iter): string {
    if (body.contains("(mcall") || body.contains("(call") || body.contains("(setexpr")) {
        return "nv_iter(" + iter + ")"
    }
    return "nv_iter_live(" + iter + ")"
}

// The no-argument form of invokeCall().
method invokeCall0(string receiver, string name): string {
    if (name == "length") {
        return "nv_length_of(" + receiver + ", " + cstr(name) + ")"
    }
    return "nv_invoke0(" + receiver + ", " + cstr(name) + ")"
}
