package codegen

import ast
import parser

// The program index: methods, classes, enums, interfaces, globals.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method indexProgram(array<string> decls, map<string, string> prog): integer {
    for (d in decls) {
        var head = nodeHead(d)
        var name = nodeChild(d, 1)
        if (head == "method") {
            var key = name + "/" + arityOf(d)
            var count = 0
            if (prog.has("func:" + key)) {
                count = parseInt(prog["func:" + key])
            }
            prog["fnode:" + key + "/" + count] = d
            prog["func:" + key] = intToStr(count + 1)
            prog["hasfunc:" + name] = "1"
            if (packageOf(name) != "") {
                prog["pkg:" + packageOf(name)] = "1"
            }
            if (isNativeMethod(d) && nodeCount(nodeChild(d, 5)) > 2) {
                // variadic native: callable with any number of arguments
                prog["fnode:" + name + "/*/0"] = d
                prog["func:" + name + "/*"] = "1"
            }
            continue
        }
        if (head == "class" || head == "enum") {
            if (isClassLike(prog, name) || prog.has("iface:" + name)) {
                fail("duplicate definition of '" + name + "'", head + " " + name)
            }
            prog[head + ":" + name] = d
            continue
        }
        if (head == "classpkg") {
            prog["classpkg:" + name] = nodeChild(d, 2)
            continue
        }
        if (head == "userpkg") {
            prog["userpkg:" + name] = "1"
            continue
        }
        if (head == "iface" || head == "annodef" || head == "global") {
            prog[head + ":" + name] = d
            if (head == "global" && packageOf(name) != "") {
                prog["pkg:" + packageOf(name)] = "1"
            }
        }
    }
    indexUnqualified(decls, prog)
    return 0
}

// Functions and globals of the program's packages are namespaced
// (geo.area) but called unqualified where one package alone has the name:
// "unq:area/1" and "unqglobal:NAME" name the qualified candidates,
// separated by spaces when there are several (the call is then ambiguous).
method indexUnqualified(array<string> decls, map<string, string> prog): integer {
    for (d in decls) {
        var head = nodeHead(d)
        if (head != "method" && head != "global") {
            continue
        }
        var name = nodeChild(d, 1)
        var pkg = packageOf(name)
        if (pkg == "" || prog.has("userpkg:" + pkg) == false) {
            continue
        }
        var short = name.substring(pkg.length() + 1, name.length())
        var key = "unqglobal:" + short
        if (head == "method") {
            key = "unq:" + short + "/" + arityOf(d)
            prog["unqname:" + short] = addCandidate(prog, "unqname:" + short, name)
        }
        prog[key] = addCandidate(prog, key, name)
    }
    return 0
}

method addCandidate(map<string, string> prog, string key, string name): string {
    if (prog.has(key) == false) {
        return name
    }
    for (c in prog[key].split(" ")) {
        if (c == name) {
            return prog[key]
        }
    }
    return prog[key] + " " + name
}

// The error for a name several packages define.
method ambiguousName(string name, string candidates, string pos): integer {
    var list = candidates.split(" ")
    fail("'" + name + "' is defined in more than one package (" + list.join(", ") + ") - call it qualified, e.g. " + list[0] + "(...)", pos)
    return 0
}

// The standard module a class was declared in, "" for program classes.
method classPackage(map<string, string> prog, string cls): string {
    if (prog.has("classpkg:" + cls)) {
        return prog["classpkg:" + cls]
    }
    return ""
}

method isClassLike(map<string, string> prog, string name): bool {
    return prog.has("class:" + name) || prog.has("enum:" + name)
}

// The class or enum node, "" if unknown.
method typeNode(map<string, string> prog, string name): string {
    if (prog.has("class:" + name)) {
        return prog["class:" + name]
    }
    if (prog.has("enum:" + name)) {
        return prog["enum:" + name]
    }
    return ""
}

method classBase(string node): string {
    if (nodeHead(node) == "class") {
        var base = nodeChild(node, 2)
        if (base == "-") {
            return ""
        }
        return base
    }
    return ""
}

method classFields(string node): string {
    if (nodeHead(node) == "enum") {
        return nodeChild(node, 3)
    }
    return nodeChild(node, 4)
}

method classCtor(string node): string {
    if (nodeHead(node) == "enum") {
        return nodeChild(node, 4)
    }
    return nodeChild(node, 5)
}

method classMethods(string node): string {
    if (nodeHead(node) == "enum") {
        return nodeChild(node, 5)
    }
    return nodeChild(node, 6)
}

method classIsAbstract(string node): bool {
    return nodeHead(node) == "class" && nodeChild(node, 3) == "true"
}

// The most-derived method node named `name` reachable from class `cls`.
method findMethod(map<string, string> prog, string cls, string name): string {
    var current = cls
    var guard = 0
    while (current != "" && guard < 64) {
        var node = typeNode(prog, current)
        if (node == "") {
            return ""
        }
        var methods = classMethods(node)
        var i = 1
        var methodsCount = nodeCount(methods)
        while (i < methodsCount) {
            var m = nodeChild(methods, i)
            if (methodName(m) == name) {
                return m
            }
            i = i + 1
        }
        current = classBase(node)
        guard = guard + 1
    }
    return ""
}

// Number of fields of a class including its bases.
method classFieldCount(map<string, string> prog, string cls): integer {
    var cached = "fieldcount:" + cls
    if (prog.has(cached)) {
        return parseInt(prog[cached])
    }
    var node = typeNode(prog, cls)
    if (node == "") {
        return 0
    }
    var count = nodeCount(classFields(node)) - 1
    var base = classBase(node)
    if (base != "" && isClassLike(prog, base)) {
        count = count + classFieldCount(prog, base)
    }
    prog[cached] = intToStr(count)
    return count
}

// The field slots of a class, worked out once and kept in `prog`.
//
// Every identifier inside a class method has to be asked whether it names a
// field, and the answer used to be a linear walk of the field list. That made
// compiling a class quadratic in the number of its members - a class with
// ninety of them cost tens of gigabytes - so the walk happens once per class
// and the answers are looked up.
method indexClassFields(map<string, string> prog, string cls): integer {
    if (prog.has("fieldsindexed:" + cls)) {
        return 0
    }
    prog["fieldsindexed:" + cls] = "1"
    var node = typeNode(prog, cls)
    if (node == "") {
        return 0
    }
    var base = classBase(node)
    var offset = 0
    if (base != "" && isClassLike(prog, base)) {
        indexClassFields(prog, base)
        offset = classFieldCount(prog, base)
    }
    var fields = classFields(node)
    var fieldsCount = nodeCount(fields)
    var i = 1
    while (i < fieldsCount) {
        var name = nodeChild(nodeChild(fields, i), 2)
        prog["fieldslot:" + cls + "." + name] = intToStr(offset + i - 1)
        i = i + 1
    }
    return 0
}

// Index of `name` in the object's field slots, -1 when it is not a field.
// The layout is base classes first, which is why a slot stays valid for
// every subclass (see nv_field_index in the runtime).
method fieldSlot(map<string, string> prog, string cls, string name): integer {
    indexClassFields(prog, cls)
    var key = "fieldslot:" + cls + "." + name
    if (prog.has(key)) {
        return parseInt(prog[key])
    }
    var node = typeNode(prog, cls)
    if (node == "") {
        return -1
    }
    var base = classBase(node)
    if (base != "" && isClassLike(prog, base)) {
        return fieldSlot(prog, base, name)
    }
    return -1
}

// Is `name` a field of class `cls` or one of its bases?
method classHasField(map<string, string> prog, string cls, string name): bool {
    return fieldSlot(prog, cls, name) >= 0
}

// Inside a class, a bare identifier may refer to a field of `this`.
method isImplicitField(string name, map<string, string> prog, map<string, string> ctx, map<string, string> locals): bool {
    if (ctx["class"] == "" || locals.has(name) || prog.has("global:" + name)) {
        return false
    }
    return classHasField(prog, ctx["class"], name)
}
