package main

import arrays

// The classic: multiples of 3 are Fizz, of 5 Buzz, of both FizzBuzz.

method main {
    for (n in arrays.range(1, 16)) {
        if (n % 15 == 0) {
            println "FizzBuzz"
            continue
        }
        if (n % 3 == 0) {
            println "Fizz"
            continue
        }
        if (n % 5 == 0) {
            println "Buzz"
            continue
        }
        println n
    }
}
