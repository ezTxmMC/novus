package main

import arrays
import math

// The 0/1 knapsack problem solved with dynamic programming.

method knapsack(array<integer> weights, array<integer> values, integer capacity): integer {
    var best = []
    for (c in arrays.range(0, capacity + 1)) {
        best.append(0)
    }
    for (i in arrays.range(0, weights.length())) {
        var c = capacity
        while (c >= weights[i]) {
            best[c] = math.max(best[c], best[c - weights[i]] + values[i])
            c = c - 1
        }
    }
    return best[capacity]
}

method main {
    var weights = [1, 3, 4, 5]
    var values = [1, 4, 5, 7]
    println knapsack(weights, values, 7)
    println knapsack(weights, values, 3)
    println knapsack(weights, values, 0)
}
