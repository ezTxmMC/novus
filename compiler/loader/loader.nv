package loader

import "../ast/sexp.nv"
import "../parser/declarations.nv"
import "../parser/errors.nv"
import "../std/stdlib.nv"
import "paths.nv"

// Loads a program and resolves `import "file.nv"` declarations.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// Longest module key that `rel` names ("" when it is a plain file import).
method moduleOf(string rel, map<string, string> modules): string {
    var best = ""
    for (key in modules) {
        if (key.endsWith("/")) {
            continue
        }
        if (rel == key || rel.startsWith(key + "/")) {
            if (key.length() > best.length()) {
                best = key
            }
        }
    }
    return best
}

// Resolves an import path: dependency modules first, then relative files.
method resolveImport(string dir, string rel, map<string, string> modules): string {
    var module = moduleOf(rel, modules)
    if (module == "") {
        return joinPath(dir, rel)
    }
    if (rel == module) {
        return modules[module]
    }
    return joinPath(modules[module + "/"], rel.substring(module.length() + 1, rel.length()))
}

method loadFile(string path, string importedFrom, map<string, string> loaded, array<string> out, map<string, string> modules): integer {
    var key = normalizePath(path)
    if (loaded.has(key)) {
        return 0
    }
    loaded[key] = "1"
    if (fileExists(path) == false) {
        fail("cannot open '" + path + "'", importedFrom)
    }
    var decls = parseFile(readFile(path), fileLabel(path))
    var dir = dirName(path)
    addDecls(decls, dir, fileLabel(path), loaded, out, modules)
    return 0
}

// Appends declarations, following file and module imports.
method addDecls(array<string> decls, string dir, string from, map<string, string> loaded, array<string> out, map<string, string> modules): integer {
    for (d in decls) {
        var head = nodeHead(d)
        if (head == "import") {
            var rel = sexpUnescape(nodeChild(d, 1))
            loadFile(resolveImport(dir, rel, modules), from, loaded, out, modules)
            continue
        }
        if (head == "importmod") {
            loadStdModule(nodeChild(d, 1), from, loaded, out, modules)
            continue
        }
        out.append(d)
    }
    return 0
}

// Loads an embedded standard library module (`import os`). Its methods and
// globals are namespaced: `(method os.mkdir ...)`, used as os.mkdir(...).
method loadStdModule(string name, string from, map<string, string> loaded, array<string> out, map<string, string> modules): integer {
    var key = "std:" + name
    if (loaded.has(key)) {
        return 0
    }
    loaded[key] = "1"
    var source = stdSource(name)
    if (source == "") {
        fail("unknown module '" + name + "' (standard modules: " + stdModules().join(", ") + ")", from)
    }
    var decls = []
    for (d in parseFile(source, "std/" + name + ".nv")) {
        var head = nodeHead(d)
        if (head == "method") {
            decls.append("(method " + name + "." + d.substring(8, d.length()))
            continue
        }
        if (head == "global") {
            decls.append("(global " + name + "." + d.substring(8, d.length()))
            continue
        }
        decls.append(d)
    }
    addDecls(decls, "std", "std/" + name + ".nv", loaded, out, modules)
    return 0
}

// All top-level declarations of the program rooted at mainFile.
method loadProgram(string mainFile): array<string> {
    return loadProgramWith(mainFile, {})
}

// Same, with dependency modules (key -> entry file, key + "/" -> directory).
method loadProgramWith(string mainFile, map<string, string> modules): array<string> {
    var loaded = {}
    var decls = []
    loadFile(mainFile, "command line", loaded, decls, modules)
    return decls
}
