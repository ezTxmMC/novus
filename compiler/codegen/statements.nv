package codegen

import "../ast/sexp.nv"
import "../ast/text.nv"
import "../parser/errors.nv"
import "../parser/types.nv"
import "common.nv"
import "expressions.nv"
import "inference.nv"
import "index.nv"

// Statements and blocks -> C.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method genBlock(string block, string indent, map<string, string> prog, map<string, string> ctx, map<string, string> outerLocals): string {
    var locals = copyMap(outerLocals)
    var blockVars = {}
    var parts = []
    var i = 1
    var blockCount = nodeCount(block)
    while (i < blockCount) {
        var at = nodeChild(block, i)
        var stmt = at
        if (nodeHead(at) == "at") {
            ctx["pos"] = nodeChild(at, 1)
            stmt = nodeChild(at, 2)
        }
        parts.append(genStatement(stmt, indent, prog, ctx, locals, blockVars))
        i = i + 1
    }
    return joinParts(parts)
}

method declareLocal(string name, string init, string indent, map<string, string> locals, map<string, string> blockVars): string {
    var type = "nv "
    if (isIntLocal(locals, name)) {
        type = "long long "
    }
    if (isFloatLocal(locals, name)) {
        type = "double "
    }
    if (blockVars.has(name)) {
        return indent + "l_" + name + " = " + init + ";" + nl()
    }
    locals[name] = "l_" + name
    blockVars[name] = "1"
    return indent + type + "l_" + name + " = " + init + ";" + nl()
}

// Initializer or assigned value, unboxed when the local is an integer.
method genValueFor(string name, string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (isIntLocal(locals, name)) {
        return genInt(node, prog, ctx, locals)
    }
    if (isFloatLocal(locals, name)) {
        return genFloat(node, prog, ctx, locals)
    }
    return genExpr(node, prog, ctx, locals)
}

method genStatement(string node, string indent, map<string, string> prog, map<string, string> ctx, map<string, string> locals, map<string, string> blockVars): string {
    if (isList(node) == false) {
        return indent + "(void)" + genExpr(node, prog, ctx, locals) + ";" + nl()
    }
    var head = nodeHead(node)
    if (head == "nop") {
        return ""
    }
    if (head == "var") {
        var name = nodeChild(node, 1)
        if (nodeCount(node) > 2) {
            return declareLocal(name, genValueFor(name, nodeChild(node, 2), prog, ctx, locals), indent, locals, blockVars)
        }
        if (isIntLocal(locals, name)) {
            return declareLocal(name, "0", indent, locals, blockVars)
        }
        if (isFloatLocal(locals, name)) {
            return declareLocal(name, "0.0", indent, locals, blockVars)
        }
        return declareLocal(name, "nv_nil", indent, locals, blockVars)
    }
    if (head == "tvar") {
        var tname = nodeChild(node, 2)
        var ttype = nodeChild(node, 1)
        if (nodeCount(node) > 3) {
            if (isIntLocal(locals, tname)) {
                return declareLocal(tname, genInt(nodeChild(node, 3), prog, ctx, locals), indent, locals, blockVars)
            }
            if (isFloatLocal(locals, tname)) {
                return declareLocal(tname, genFloat(nodeChild(node, 3), prog, ctx, locals), indent, locals, blockVars)
            }
            return declareLocal(tname, coerceCode(genExpr(nodeChild(node, 3), prog, ctx, locals), ttype), indent, locals, blockVars)
        }
        return declareLocal(tname, defaultCode(ttype), indent, locals, blockVars)
    }
    if (head == "assign") {
        var target = nodeChild(node, 1)
        var cname = resolveVar(target, prog, ctx, locals)
        if (cname == "" && isImplicitField(target, prog, ctx, locals)) {
            return indent + "nv_fields(self->o)[" + fieldSlot(prog, ctx["class"], target) + "] = " + genExpr(nodeChild(node, 2), prog, ctx, locals) + ";" + nl()
        }
        if (cname == "" || cname == "self") {
            fail("unknown variable '" + target + "'", ctx["pos"])
        }
        return indent + cname + " = " + genValueFor(target, nodeChild(node, 2), prog, ctx, locals) + ";" + nl()
    }
    if (head == "setexpr") {
        var lhs = nodeChild(node, 1)
        var value = genExpr(nodeChild(node, 2), prog, ctx, locals)
        if (nodeHead(lhs) == "idx") {
            return indent + "nv_index_set(" + genExpr(nodeChild(lhs, 1), prog, ctx, locals) + ", " + genExpr(nodeChild(lhs, 2), prog, ctx, locals) + ", " + value + ");" + nl()
        }
        if (nodeHead(lhs) == "mget") {
            var receiver = nodeChild(lhs, 1)
            var member = nodeChild(lhs, 2)
            if (receiver == "this" && ctx["class"] != "" && fieldSlot(prog, ctx["class"], member) >= 0) {
                return indent + "nv_fields(self->o)[" + fieldSlot(prog, ctx["class"], member) + "] = " + value + ";" + nl()
            }
            return indent + "nv_set_member(" + genExpr(receiver, prog, ctx, locals) + ", " + cstr(member) + ", " + value + ");" + nl()
        }
        fail("invalid assignment target", ctx["pos"])
    }
    if (head == "return") {
        // leaving a method leaves every sync block it is inside
        var leaveAll = syncUnwind(syncHeld(ctx), "")
        if (nodeCount(node) > 1) {
            return indent + leaveAll + "return " + coerceCode(genExpr(nodeChild(node, 1), prog, ctx, locals), ctx["ret"]) + ";" + nl()
        }
        return indent + leaveAll + "return nv_nil;" + nl()
    }
    if (head == "sync") {
        var lock = "nv_nil"
        if (nodeChild(node, 1) != "-") {
            lock = genExpr(nodeChild(node, 1), prog, ctx, locals)
        }
        var held = syncHeld(ctx)
        var guard = "sy" + syncDepth(ctx)
        var inner = indent + "    "
        var out = indent + "{" + nl()
        out = out + inner + "NvLock *" + guard + " = nv_sync_enter(" + lock + ");" + nl()
        if (held == "") {
            ctx["sync"] = guard
        } else {
            ctx["sync"] = held + " " + guard
        }
        out = out + genBlock(nodeChild(node, 2), inner, prog, ctx, locals)
        ctx["sync"] = held
        out = out + inner + "nv_sync_leave(" + guard + ");" + nl()
        return out + indent + "}" + nl()
    }
    if (head == "println") {
        return indent + "nv_println(" + genExpr(nodeChild(node, 1), prog, ctx, locals) + ");" + nl()
    }
    if (head == "print") {
        return indent + "nv_print(" + genExpr(nodeChild(node, 1), prog, ctx, locals) + ");" + nl()
    }
    if (head == "eprintln") {
        return indent + "nv_eprintln(" + genExpr(nodeChild(node, 1), prog, ctx, locals) + ");" + nl()
    }
    if (head == "if") {
        var out = indent + "if (" + genCondition(nodeChild(node, 1), prog, ctx, locals) + ") {" + nl()
        out = out + genBlock(nodeChild(node, 2), indent + "    ", prog, ctx, locals)
        out = out + indent + "}"
        if (nodeCount(node) > 3) {
            var elseNode = nodeChild(node, 3)
            if (nodeHead(elseNode) == "if") {
                var ec = genStatement(elseNode, indent, prog, ctx, locals, blockVars)
                return out + " else " + ec.substring(indent.length(), ec.length())
            }
            out = out + " else {" + nl() + genBlock(elseNode, indent + "    ", prog, ctx, locals) + indent + "}"
        }
        return out + nl()
    }
    if (head == "while") {
        var wout = indent + "while (" + genCondition(nodeChild(node, 1), prog, ctx, locals) + ") {" + nl()
        var wouter = syncLoopHeld(ctx)
        ctx["syncloop"] = syncHeld(ctx)
        wout = wout + genBlock(nodeChild(node, 2), indent + "    ", prog, ctx, locals)
        ctx["syncloop"] = wouter
        return wout + indent + "}" + nl()
    }
    if (head == "forin") {
        var v = nodeChild(node, 1)
        var iter = genExpr(nodeChild(node, 2), prog, ctx, locals)
        var inner = indent + "    "
        var fout = indent + "{" + nl()
        fout = fout + inner + "NvArr *it_" + v + " = " + iterCall(nodeChild(node, 3), iter) + ";" + nl()
        fout = fout + inner + "int n_" + v + " = it_" + v + "->len;" + nl()
        fout = fout + inner + "for (int i_" + v + " = 0; i_" + v + " < n_" + v + "; i_" + v + "++) {" + nl()
        fout = fout + inner + "    nv l_" + v + " = it_" + v + "->items[i_" + v + "];" + nl()
        var bodyLocals = copyMap(locals)
        bodyLocals[v] = "l_" + v
        var fouter = syncLoopHeld(ctx)
        ctx["syncloop"] = syncHeld(ctx)
        fout = fout + genBlock(nodeChild(node, 3), inner + "    ", prog, ctx, bodyLocals)
        ctx["syncloop"] = fouter
        fout = fout + inner + "}" + nl()
        return fout + indent + "}" + nl()
    }
    if (head == "break") {
        // only the sync blocks entered inside the loop are left behind
        return indent + syncUnwind(syncHeld(ctx), syncLoopHeld(ctx)) + "break;" + nl()
    }
    if (head == "continue") {
        return indent + syncUnwind(syncHeld(ctx), syncLoopHeld(ctx)) + "continue;" + nl()
    }
    return indent + "(void)" + genExpr(node, prog, ctx, locals) + ";" + nl()
}
