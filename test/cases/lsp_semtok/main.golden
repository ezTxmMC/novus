== names after a dot
this.total =  -> total: property +modification
this.total + by -> total: property
return this.next.total -> next: property
return this.next.total -> total: property
    thing.bump(1)\n -> bump: method
    thing.total\n -> total: property
thing.missing\n -> missing: none
thing.missing() -> missing: method
thing.bump(1, 2) -> bump: method
names.append -> append: method
args.length -> length: method
strings.repeat -> repeat: function +defaultLibrary
strings.nothing\n -> nothing: none
strings.nothing(1) -> nothing: none
Kind.Round\n -> Round: enumMember +readonly
Kind.values() -> values: method +defaultLibrary
Kind.Nothing -> Nothing: none
geo.describe(thing) -> describe: function
thing.next.next.total -> next: property
next.next.total -> total: property
