package main

import arrays

// Binary search halves the range with every step.

method binarySearch(array<integer> sorted, integer target): integer {
    var low = 0
    var high = sorted.length() - 1
    while (low <= high) {
        var middle = (low + high) / 2
        if (sorted[middle] == target) {
            return middle
        }
        if (sorted[middle] < target) {
            low = middle + 1
            continue
        }
        high = middle - 1
    }
    return -1
}

method main {
    var sorted = arrays.sort([9, 3, 7, 1, 8, 15, 22])
    println sorted
    println binarySearch(sorted, 8)
    println binarySearch(sorted, 100)
}
