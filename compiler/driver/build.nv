package driver

import os
import path

import codegen
import loader
import nvh
import project
import runtime

// Compiling programs: C generation, invoking the C compiler, run.

// The generated C for a program (runtime embedded unless `mode` is "include").
// Dependencies come from the nearest project.nv above the source file.
method generate(string source, string mode): string {
    return generate(source, mode, false)
}

// With `offline`, a dependency that is not in the cache is an error instead
// of a git clone.
method generate(string source, string mode, bool offline): string {
    if (fileExists(source) == false) {
        eprintln "novusc: cannot open '${source}'"
        exit(1)
    }
    var modules = modulesFor(findManifest(path.dirname(source)), offline)
    var decls = loadProgramWith(source, modules)
    if (mode == "include") {
        return generateProgram(decls, "")
    }
    return generateProgram(decls, runtimeSource())
}

// The manifest of the current directory (or a parent); aborts when none.
method currentProject(): Manifest {
    var file = findManifest(".")
    if (file == "") {
        eprintln "novusc: no project.nv found here - pass a source file or run 'novusc init'"
        exit(1)
    }
    return parseManifest(file)
}

// Source file for a command: the argument, or the project's main file.
method sourceFor(array<string> arguments): string {
    if (arguments.length() >= 2 && isSourceFile(arguments[1])) {
        return arguments[1]
    }
    var m = currentProject()
    return path.join(m.dir(), m.main())
}

// A Novus source (.nv) or a component page (.nvh, served on its own).
method isSourceFile(string file): bool {
    return file.endsWith(".nv") || file.endsWith(".nvh")
}

// Build options start after the command and the optional source file.
method optionStart(array<string> arguments): integer {
    if (arguments.length() >= 2 && isSourceFile(arguments[1])) {
        return 2
    }
    return 1
}

// novusc init [module-path]: creates project.nv and a hello-world main.nv.
method initProject(array<string> arguments): integer {
    if (fileExists("project.nv")) {
        eprintln "novusc: project.nv already exists"
        return 1
    }
    var name = path.basename(path.absolute)
    if (arguments.length() >= 2) {
        name = arguments[1]
    }
    writeFile("project.nv", "project \"${name}\"\nversion \"0.1.0\"\nmain \"main.nv\"\n\n// require \"github.com/user/library\" \"v1.0.0\"\n")
    if (fileExists("main.nv") == false) {
        writeFile("main.nv", "package main\n\nmethod main {\n    println \"Hello from ${name}!\"\n}\n")
    }
    println "created project.nv (project \"${name}\") - next: novusc run"
    return 0
}

// novusc deps [update | add <module> [version]]
method depsCommand(array<string> arguments): integer {
    var m = currentProject()
    if (arguments.length() >= 2 && arguments[1] == "add") {
        if (arguments.length() < 3) {
            eprintln "usage: novusc deps add <module> [version]"
            return 1
        }
        var version = "latest"
        if (arguments.length() >= 4) {
            version = arguments[3]
        }
        os.appendFile(m.file(), "require \"${arguments[2]}\" \"${version}\"\n")
        println "added require \"${arguments[2]}\" \"${version}\" to ${m.file()}"
        m = parseManifest(m.file())
    }
    if (arguments.length() >= 2 && arguments[1] == "update") {
        for (d in m.requires()) {
            if (m.replaces().has(d.module()) == false) {
                os.removeAll(dependencyDir(d.module(), d.version()))
            }
        }
    }
    var modules = {}
    resolveModules(m, modules)
    if (m.requires().length() == 0) {
        println "no dependencies (add one with: novusc deps add <module> [version])"
        return 0
    }
    for (key in modules) {
        if (key.endsWith("/") == false) {
            println "${key} -> ${modules[key]}"
        }
    }
    return 0
}

// novusc nvh <file.nvh>: prints the Novus source a component compiles to.
method nvhCommand(array<string> arguments): integer {
    if (arguments.length() < 2 || arguments[1].endsWith(".nvh") == false) {
        eprintln "usage: novusc nvh <file.nvh>"
        return 1
    }
    var file = arguments[1]
    if (fileExists(file) == false) {
        eprintln "novusc: cannot open '${file}'"
        return 1
    }
    print transpileNvh(readFile(file), file, path.dirname(file), projectRoot(file))
    return 0
}

method emitCommand(string source, map<string, string> options): integer {
    var code = generate(source, runtimeMode(options), options.has("--offline"))
    if (options.has("-o")) {
        var target = options["-o"]
        writeFile(target, code)
        println "wrote ${target}"
    } else {
        print code
    }
    return 0
}

method quoted(string s): string {
    return "\"" + s + "\""
}

method isWindows(map<string, string> options): bool {
    if (options.has("--target")) {
        return options["--target"].contains("windows")
    }
    return platform() == "windows"
}

method cCompiler(map<string, string> options): string {
    if (options.has("--target")) {
        var zig = env("NOVUS_ZIG")
        if (zig == "") {
            zig = "zig"
        }
        if (options.has("--cc")) {
            zig = options["--cc"]
        }
        return zig + " cc -target " + options["--target"]
    }
    if (options.has("--cc")) {
        return options["--cc"]
    }
    if (env("NOVUS_CC") != "") {
        return env("NOVUS_CC")
    }
    if (platform() == "windows") {
        return "gcc"
    }
    // gcc optimizes the generated code markedly better than clang - the
    // tagged integer paths end up in registers there. Measured on the loop
    // benchmark: 8 ms with gcc, 25 ms with clang, same C.
    if (os.hasCommand("gcc")) {
        return "gcc"
    }
    return "cc"
}

// -ffp-contract=off: a C compiler may fuse `a * b + c` into one fused
// multiply-add (clang does by default, gcc does on hardware that has one).
// That rounds once instead of twice, so the last digits differ from the
// boxed arithmetic and from other platforms. Novus floats are IEEE doubles,
// one operation at a time.
final FLOAT_FLAGS = "-ffp-contract=off"

// `build` optimizes hard, the program is built once and run often.
final BUILD_OPTIMIZATION = "2"

// `run` compiles on every change and often runs briefly: -O1 builds in about
// half the time of -O2 and runs the benchmark programs within 20% of it (see
// README). $NOVUS_RUN_OPT overrides it.
final RUN_OPTIMIZATION = "1"
final OPTIMIZATION_LEVELS = ["0", "1", "2", "3", "s"]

method runOptimization(): string {
    var level = env("NOVUS_RUN_OPT")
    if (level == "") {
        return RUN_OPTIMIZATION
    }
    if (OPTIMIZATION_LEVELS.contains(level) == false) {
        eprintln "novusc: NOVUS_RUN_OPT must be one of 0, 1, 2, 3, s (got '${level}')"
        exit(1)
    }
    return level
}

// Options carry the level of the command as "--opt" (an internal option).
method cFlags(map<string, string> options): string {
    var level = BUILD_OPTIMIZATION
    if (options.has("--opt")) {
        level = options["--opt"]
    }
    var flags = "-O" + level + " " + FLOAT_FLAGS
    if (env("NOVUS_CFLAGS") != "") {
        flags = flags + " " + env("NOVUS_CFLAGS")
    }
    if (options.has("--cflags")) {
        flags = flags + " " + options["--cflags"]
    }
    return flags
}

method cLibraries(map<string, string> options): string {
    if (isWindows(options)) {
        // there the runtime's sockets are winsock, and its threads and fibers
        // come from the system itself - nothing to link for them
        return " -lm -lws2_32"
    }
    return " -lm -lpthread"
}

method defaultOutput(string source, map<string, string> options): string {
    var out = path.stem(source)
    var manifest = findManifest(path.dirname(source))
    if (manifest != "") {
        out = parseManifest(manifest).outputName()
    }
    if (options.has("-o")) {
        out = options["-o"]
    }
    if (isWindows(options) && out.endsWith(".exe") == false) {
        out = out + ".exe"
    }
    return out
}

method runtimeMode(map<string, string> options): string {
    if (options.has("--no-runtime")) {
        return "include"
    }
    return "embed"
}

// Compiles `source` to a native executable and returns its path.
method buildBinary(string source, map<string, string> options): string {
    rejectCacheConflicts(options)
    var code = generate(source, runtimeMode(options), options.has("--offline"))
    var output = defaultOutput(source, options)
    if (options.has("--cache")) {
        buildThroughCache(code, output, options)
        return output
    }
    compileProgram(code, output, options)
    return output
}

// The cache compiles in its own folder: the generated C file is not next to
// the output (--keep-c) and does not find a runtime header next to the
// program (--no-runtime).
method rejectCacheConflicts(map<string, string> options) {
    if (options.has("--cache") == false) {
        return
    }
    for (conflict in ["--keep-c", "--no-runtime"]) {
        if (options.has(conflict)) {
            eprintln "novusc: --cache cannot be combined with ${conflict}"
            exit(1)
        }
    }
}

// Writes `code` next to `output`, compiles it and removes it again (kept
// with --keep-c or when the C compiler fails).
method compileProgram(string code, string output, map<string, string> options) {
    var cFile = output + ".c"
    if (output.endsWith(".exe")) {
        cFile = output.substring(0, output.length() - 4) + ".c"
    }
    writeFile(cFile, code)
    var command = cCompiler(options) + " " + cFlags(options) + " " + quoted(cFile) + " -o " + quoted(output) + cLibraries(options)
    var rc = exec(command)
    if (rc != 0) {
        eprintln "novusc: C compilation failed (generated file kept at ${cFile})"
        eprintln "  command: ${command}"
        exit(1)
    }
    if (options.has("--keep-c") == false) {
        removeFile(cFile)
    }
}

// build --cache: the executable comes from the cache of `run` and is copied
// to `output`; without a usable cache the program is compiled directly.
method buildThroughCache(string code, string output, map<string, string> options) {
    var cached = cachedExecutable(code, options)
    if (cached == "") {
        compileProgram(code, output, options)
        return
    }
    copyExecutable(cached, output)
    if (isStagingFile(cached)) {
        removeFile(cached)
    }
}

// Replaces `to` like a plain build does (the linker unlinks its output
// first): a copy over an existing file would keep its permissions, and
// overwriting a running or signed executable in place is not safe.
method copyExecutable(string from, string to) {
    if (os.isDir(to)) {
        eprintln "novusc: cannot write ${to}: it is a directory"
        exit(1)
    }
    os.remove(to)
    if (copyFile(from, to) == false) {
        eprintln "novusc: cannot copy ${from} to ${to}"
        exit(1)
    }
}

// cp keeps the permission to execute, os.copy does not (Windows has none).
method copyFile(string from, string to): bool {
    if (platform() == "windows") {
        return os.copy(from, to)
    }
    return exec("cp " + os.shellQuote(from) + " " + os.shellQuote(to)) == 0
}

// A small stable hash so temporary names differ per source path.
method pathHash(string s): integer {
    var h = 7
    var i = 0
    while (i < s.length()) {
        h = (h * 31 + ord(s.charAt(i))) % 1000000007
        i = i + 1
    }
    return h
}

// Where `run` compiles when there is no cache: a temporary file per source
// path, deleted after the run.
method temporaryProgram(string source, map<string, string> options): string {
    var name = "novusc-" + path.stem(source) + "-" + pathHash(path.absolute() + "/" + source)
    return path.join(path.temp(), name + executableSuffix(options))
}

method runCommand(string source, array<string> arguments): integer {
    var options = {}
    options["--opt"] = runOptimization()
    var code = generate(source, "embed")
    var exe = cachedExecutable(code, options)
    var temporary = exe == "" || isStagingFile(exe)
    if (exe == "") {
        exe = temporaryProgram(source, options)
        compileProgram(code, exe, options)
    }
    var command = quoted(exe)
    var i = optionStart(arguments)
    while (i < arguments.length()) {
        command = command + " " + quoted(arguments[i])
        i = i + 1
    }
    var rc = exec(command)
    if (temporary) {
        removeFile(exe)
    }
    return rc
}
