package driver

import crypto
import os
import path
import strings

// The cache of compiled programs: `novusc run` (and `build --cache`) keeps the
// executable of everything it compiled, keyed by a hash of what determines it -
// the generated C, the C compiler and its version, the flags and the novusc
// version. The same program again costs the time to generate its C and one
// hash instead of a C compiler run.
//
// A directory entry is <key> (the executable) and <key>.use (an empty file
// whose modification time is the last use - the executable's own time cannot
// be touched from Novus). Executables are written under a staging name and
// renamed into place, so a reader never sees half a file and two compilers of
// the same program race harmlessly. Only files named like an entry or like a
// staging file (tmp-<pid>-<key>[.c|.exe]) are ever deleted, never a folder:
// $NOVUS_CACHE may point at any folder. A cache folder that cannot be written
// is not an error, the program is then compiled to a temporary file.

final CACHE_OFF = "off"
final KEY_LENGTH = 32
final C_SUFFIX = ".c"
final STAGING_PREFIX = "tmp-"
final USE_SUFFIX = ".use"
final EXE_SUFFIX = ".exe"
final STALE_STAGING_MILLIS = 3600000
final USED_DIGITS = 16
final DEFAULT_LIMIT_BYTES = 268435456
final KILOBYTE = 1024
final MEGABYTE = 1048576
final GIGABYTE = 1073741824
final MAX_LIMIT_BYTES = 1125899906842624

// Runs `run()` with runtime errors caught (the runtime's own trap, the one
// std/toml.nv uses): writing a file that cannot be opened is such an error.
method tryRun(object task): object native "nv_try_run"
method tryFailed(): bool native "nv_try_failed"

define class WriteTask {
    private final string file: get
    private final string content: get

    method run(): object {
        os.writeFile(file, content)
        return true
    }
}

// Writes the file; false when it cannot be written.
method tryWriteFile(string file, string content): bool {
    tryRun(WriteTask(file, content))
    return tryFailed() == false
}

define class CacheEntry {
    private final string name: get
    private final integer size: get
    private final integer used: get
}

method executableSuffix(map<string, string> options): string {
    if (isWindows(options)) {
        return EXE_SUFFIX
    }
    return ""
}

// First lines of `cc --version`: a new compiler release must not reuse what
// the old one produced.
method compilerIdentity(string compiler): string {
    var result = os.run(compiler + " --version 2>&1")
    return "" + result["output"]
}

method cacheKey(string code, map<string, string> options): string {
    var compiler = cCompiler(options)
    var identity = [VERSION, platform(), compiler, compilerIdentity(compiler), cFlags(options), cLibraries(options)]
    var digest = crypto.sha256(identity.join("\n") + "\n\n" + code)
    return crypto.hex(digest).substring(0, KEY_LENGTH)
}

method stagingName(string key, map<string, string> options): string {
    return STAGING_PREFIX + os.pid() + "-" + key + executableSuffix(options)
}

method isStagingFile(string file): bool {
    return path.basename(file).startsWith(STAGING_PREFIX)
}

// The cached executable of the program whose C is `code`, compiled on a miss.
// "" when there is no usable cache (off, not creatable, not writable). A
// staged executable (the cache refused the rename) is returned as it is; the
// caller deletes it after use (isStagingFile).
method cachedExecutable(string code, map<string, string> options): string {
    var directory = cacheDirectory()
    if (directory == "") {
        return ""
    }
    // checked before any compile, so a bad value never costs a C compiler run
    var limit = cacheLimitBytes()
    os.mkdir(directory)
    if (os.isDir(directory) == false) {
        return ""
    }
    var key = cacheKey(code, options)
    var executable = path.join(directory, key + executableSuffix(options))
    if (os.isFile(executable)) {
        markUsed(executable)
        return executable
    }
    return compileIntoCache(code, directory, key, limit, options)
}

method compileIntoCache(string code, string directory, string key, integer limit, map<string, string> options): string {
    var staging = path.join(directory, stagingName(key, options))
    if (tryWriteFile(staging, "") == false) {
        return ""
    }
    compileProgram(code, staging, options)
    var executable = path.join(directory, key + executableSuffix(options))
    if (os.rename(staging, executable)) {
        markUsed(executable)
        evictOldEntries(directory, key, limit)
        return executable
    }
    if (os.isFile(executable)) {
        // another novusc stored the same program first (and, on Windows,
        // renaming onto an existing file fails)
        os.remove(staging)
        markUsed(executable)
        return executable
    }
    return staging
}

// Best effort: a cache folder that is read only still serves its programs.
method markUsed(string executable) {
    tryWriteFile(executable + USE_SUFFIX, "")
}

method lastUse(string executable): integer {
    var stamp = os.modifiedMillis(executable + USE_SUFFIX)
    if (stamp >= 0) {
        return stamp
    }
    return os.modifiedMillis(executable)
}
