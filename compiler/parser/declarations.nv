package parser

import ast
import lexer

// Whole files: the top-level declarations, constants and imports.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

// [private] [final] [var] NAME [: type] = expr (top-level constant)
method parseGlobal(array<string> tokens, integer pos, array<string> decls): integer {
    var p = pos
    while (isKw(tokens, p, "private") || isKw(tokens, p, "final")) {
        p = p + 1
    }
    if (isKw(tokens, p, "var")) {
        p = p + 1
    }
    p = expectIdent(tokens, p, "constant name")
    var gname = tokVal(tokens[p - 1])
    if (isSym(tokens, p, ":")) {
        var gt = parseType(tokens, p + 1)
        p = parseInt(gt["pos"])
    }
    p = expectSym(tokens, p, "=")
    var ge = parseExpr(tokens, p, 0)
    decls.append("(global " + gname + " " + ge["node"] + ")")
    return parseInt(ge["pos"])
}

method isGlobalStart(array<string> tokens, integer p): bool {
    if (isKw(tokens, p, "private") || isKw(tokens, p, "final") || isKw(tokens, p, "var")) {
        return true
    }
    return isIdent(tokens, p) && isSym(tokens, p + 1, "=")
}

// Parses one source file into an array of top-level declaration nodes.
// Imports are returned as (import "path") nodes for the loader to resolve.
method parseFile(string source, string file): array<string> {
    var tokens = lex(source, file)
    var decls = []
    var p = 0
    // the annotations seen since the last declaration; a one element array, so helpers can reset it
    var annos = [NO_ANNOTATIONS]
    while (atEnd(tokens, p) == false) {
        p = parseTopLevel(tokens, p, decls, annos)
    }
    return decls
}

private final NO_ANNOTATIONS = "(annos)"

// One top-level item at `p`; returns the position after it.
method parseTopLevel(array<string> tokens, integer p, array<string> decls, array<string> annos): integer {
    if (isKw(tokens, p, "package")) {
        var after = expectIdent(tokens, p + 1, "package name")
        decls.append("(package " + tokVal(tokens[after - 1]) + " " + sexpStr(posOf(tokens, after - 1)) + ")")
        return after
    }
    if (isKw(tokens, p, "import")) {
        return parseImport(tokens, p, decls)
    }
    if (isSym(tokens, p, "@")) {
        var an = parseAnnotation(tokens, p)
        annos[0] = annos[0].substring(0, annos[0].length() - 1) + " " + an["node"] + ")"
        return parseInt(an["pos"])
    }
    if (isKw(tokens, p, "method") || isIdentNamed(tokens, p, "async") && isKw(tokens, p + 1, "method")) {
        return parseTopLevelMethod(tokens, p, decls, annos)
    }
    if (isIdentNamed(tokens, p, "define")) {
        annos[0] = NO_ANNOTATIONS
        return parseDefine(tokens, p, decls)
    }
    if (isGlobalStart(tokens, p)) {
        return parseGlobal(tokens, p, decls)
    }
    if (isKw(tokens, p, "println") || isKw(tokens, p, "print") || isKw(tokens, p, "eprintln")) {
        return parseInt(parseExpr(tokens, p + 1, 0)["pos"])
    }
    if (isSym(tokens, p, ";")) {
        return p + 1
    }
    if (tokKind(tokens[p]) == CBLOCK_KIND || tokKind(tokens[p]) == CBLOCK_UNTERMINATED_KIND) {
        decls.append(cBlockNode(tokens[p]))
        return p + 1
    }
    fail("unexpected " + describe(tokens, p) + " at top level", tokPos(tokens[p]))
    return p
}

// async method f(...): calling it starts the work on a virtual thread and
// hands back a task, so every call site is `await f(...)`
method parseTopLevelMethod(array<string> tokens, integer p, array<string> decls, array<string> annos): integer {
    var at = p
    var list = annos[0]
    if (isIdentNamed(tokens, p, "async")) {
        at = p + 1
        list = list.substring(0, list.length() - 1) + " (anno Async))"
    }
    var m = parseMethodDecl(tokens, at, list)
    decls.append(m["node"])
    annos[0] = NO_ANNOTATIONS
    return parseInt(m["pos"])
}

// import "module/path"   a dependency module (or a package in it)
// import geo/shapes       a package: every file of that folder
// import @geo/circle      one file of a package (no extension)
method parseImport(array<string> tokens, integer pos, array<string> decls): integer {
    if (tokKind(tokens[pos + 1]) == "STRING") {
        decls.append("(import " + sexpStr(tokVal(tokens[pos + 1])) + ")")
        return pos + 2
    }
    var single = isSym(tokens, pos + 1, "@")
    var p = pos + 1
    if (single) {
        p = p + 1
    }
    p = expectIdent(tokens, p, "package name after 'import'")
    var target = tokVal(tokens[p - 1])
    while (isSym(tokens, p, "/") && isIdent(tokens, p + 1)) {
        target = target + "/" + tokVal(tokens[p + 1])
        p = p + 2
    }
    if (single) {
        decls.append("(importfile " + sexpStr(target) + " " + sexpStr(posOf(tokens, p - 1)) + ")")
        return p
    }
    decls.append("(importmod " + target + ")")
    return p
}
