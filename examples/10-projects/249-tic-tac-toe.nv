package main

import arrays

// Playing a fixed sequence of moves and detecting the winner.

method show(array<string> board) {
    for (row in arrays.range(0, 3)) {
        var cells = []
        for (col in arrays.range(0, 3)) {
            cells.append(board[row * 3 + col])
        }
        println cells.join("|")
    }
    println ""
}

method winner(array<string> board): string {
    var lines = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],
        [0, 3, 6], [1, 4, 7], [2, 5, 8],
        [0, 4, 8], [2, 4, 6]
    ]
    for (line in lines) {
        var a = board[line[0]]
        if (a != " " && a == board[line[1]] && a == board[line[2]]) {
            return a
        }
    }
    return ""
}

method main {
    var board = []
    for (i in arrays.range(0, 9)) {
        board.append(" ")
    }
    var moves = [4, 0, 8, 2, 1, 7, 6]
    var player = "x"
    for (move in moves) {
        board[move] = player
        if (winner(board) != "") {
            break
        }
        if (player == "x") {
            player = "o"
            continue
        }
        player = "x"
    }
    show(board)
    var champion = winner(board)
    if (champion == "") {
        println "no winner"
        return 0
    }
    println "winner: ${champion}"
    return 0
}
