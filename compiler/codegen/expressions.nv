package codegen

import "../ast/sexp.nv"
import "../lexer/chars.nv"
import "../parser/errors.nv"
import "../std/stdlib.nv"
import "calls.nv"
import "common.nv"
import "index.nv"
import "inference.nv"

// Expressions -> C.
//
// NOTE: this file is part of the bootstrap chain: it must stay compilable
// by the previous compiler snapshot (bootstrap/novusc.c).

method isIdentAtom(string node): bool {
    if (node.length() == 0 || isList(node)) {
        return false
    }
    var c = node.charAt(0)
    return isAlpha(c)
}

method isNumberAtom(string node): bool {
    if (node.length() == 0 || isList(node)) {
        return false
    }
    // A hexadecimal literal whose value has the top bit set is lexed into a
    // negative decimal - the same bit pattern, written the way C wants it -
    // so a leading minus is part of the number, not an operator.
    if (node.charAt(0) == "-" && node.length() > 1) {
        return isDigit(node.charAt(1))
    }
    return isDigit(node.charAt(0))
}

method hasDot(string s): bool {
    var i = 0
    while (i < s.length()) {
        if (s.charAt(i) == ".") {
            return true
        }
        i = i + 1
    }
    return false
}

// Is `name` a variable in scope (local, this or global)?
method resolveVar(string name, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (locals.has(name)) {
        return locals[name]
    }
    if (name == "this") {
        if (ctx["class"] != "") {
            return "self"
        }
        return ""
    }
    if (ctx["pkg"] != "" && prog.has("global:" + ctx["pkg"] + "." + name)) {
        return "g_" + cName(ctx["pkg"] + "." + name)
    }
    if (prog.has("global:" + name)) {
        return "g_" + cName(name)
    }
    return ""
}

// The C expression for a node that isFloatValue() accepted: plain double
// arithmetic. Integer sub-expressions are cast.
method genFloat(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (isList(node) == false) {
        if (isNumberAtom(node)) {
            return node
        }
        return locals[node]
    }
    var head = nodeHead(node)
    if (head == "neg") {
        return "(-" + genFloat(nodeChild(node, 1), prog, ctx, locals) + ")"
    }
    var left = nodeChild(node, 1)
    var right = nodeChild(node, 2)
    var l = genFloat(left, prog, ctx, locals)
    var r = genFloat(right, prog, ctx, locals)
    if (isFloatValue(left, locals) == false) {
        l = "(double)(" + genInt(left, prog, ctx, locals) + ")"
    }
    if (isFloatValue(right, locals) == false) {
        r = "(double)(" + genInt(right, prog, ctx, locals) + ")"
    }
    if (head == "/") {
        return "nv_fdiv(" + l + ", " + r + ")"
    }
    if (head == "%") {
        return "nv_fmod_(" + l + ", " + r + ")"
    }
    return "(" + l + " " + head + " " + r + ")"
}

// The C expression for a node that isIntExpr() accepted: plain long long
// arithmetic, no boxing at all.
method genInt(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (isList(node) == false) {
        if (isNumberAtom(node)) {
            return node + "LL"
        }
        if (locals.has(node) == false) {
            fail("internal: '" + node + "' inferred as an integer but not a local", ctx["pos"])
        }
        return locals[node]
    }
    var head = nodeHead(node)
    if (head == "neg") {
        return "(-" + genInt(nodeChild(node, 1), prog, ctx, locals) + ")"
    }
    var left = genInt(nodeChild(node, 1), prog, ctx, locals)
    var right = genInt(nodeChild(node, 2), prog, ctx, locals)
    if (head == "/") {
        return "nv_idiv(" + left + ", " + right + ")"
    }
    if (head == "%") {
        return "nv_imod(" + left + ", " + right + ")"
    }
    if (head == "<<") {
        return "nv_ishl(" + left + ", " + right + ")"
    }
    if (head == ">>") {
        return "nv_ishr(" + left + ", " + right + ")"
    }
    return "(" + left + " " + head + " " + right + ")"
}

// Error for an identifier that names a module but is used like a value.
method failModuleUse(string name, map<string, string> prog, map<string, string> ctx): integer {
    if (prog.has("pkg:" + name)) {
        fail("'" + name + "' is a module - call one of its functions, e.g. " + name + ".x()", ctx["pos"])
    }
    if (stdModules().contains(name)) {
        fail("module '" + name + "' is not imported - add 'import " + name + "'", ctx["pos"])
    }
    return 0
}

// A condition as a C int, avoiding the boxed bool for comparisons and
// logical operators: `while (nv_lt_bool(i, n))` instead of
// `while (nv_truthy(nv_lt(i, n)))`.
method genCondition(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    var head = nodeHead(node)
    if (head == "&&") {
        return "(" + genCondition(nodeChild(node, 1), prog, ctx, locals) + " && " + genCondition(nodeChild(node, 2), prog, ctx, locals) + ")"
    }
    if (head == "||") {
        return "(" + genCondition(nodeChild(node, 1), prog, ctx, locals) + " || " + genCondition(nodeChild(node, 2), prog, ctx, locals) + ")"
    }
    if (head == "!") {
        return "(!(" + genCondition(nodeChild(node, 1), prog, ctx, locals) + "))"
    }
    var bools = {"<": "nv_lt_bool", ">": "nv_gt_bool", "<=": "nv_le_bool", ">=": "nv_ge_bool",
        "==": "nv_eq_bool", "!=": "nv_ne_bool"}
    if (bools.has(head) && nodeCount(node) == 3) {
        var left = nodeChild(node, 1)
        var right = nodeChild(node, 2)
        if (isIntValue(left, locals) && isIntValue(right, locals)) {
            // both sides are unboxed integers: compare them directly (no outer
            // parentheses - comparisons bind tighter than && and ||)
            return genInt(left, prog, ctx, locals) + " " + head + " " + genInt(right, prog, ctx, locals)
        }
        if (isFloatValue(left, locals) || isFloatValue(right, locals)) {
            var numeric = isFloatValue(left, locals) || isIntValue(left, locals)
            numeric = numeric && (isFloatValue(right, locals) || isIntValue(right, locals))
            if (numeric) {
                return genFloatOperand(left, prog, ctx, locals) + " " + head + " " + genFloatOperand(right, prog, ctx, locals)
            }
        }
        return bools[head] + "(" + genExpr(left, prog, ctx, locals) + ", " + genExpr(right, prog, ctx, locals) + ")"
    }
    if (node == "true") {
        return "1"
    }
    if (node == "false") {
        return "0"
    }
    return "nv_truthy(" + genExpr(node, prog, ctx, locals) + ")"
}

// A comparison operand as a double, casting an integer side.
method genFloatOperand(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (isFloatValue(node, locals)) {
        return genFloat(node, prog, ctx, locals)
    }
    return "(double)(" + genInt(node, prog, ctx, locals) + ")"
}

method genExpr(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    if (isList(node) == false) {
        if (node == "true") {
            return "nv_bool(1)"
        }
        if (node == "false") {
            return "nv_bool(0)"
        }
        if (isNumberAtom(node)) {
            if (hasDot(node)) {
                return "nv_float(" + node + ")"
            }
            return "nv_int(" + node + "LL)"
        }
        var v = resolveVar(node, prog, ctx, locals)
        if (v != "") {
            if (isIntLocal(locals, node)) {
                return "nv_int(" + v + ")"     // unboxed local entering a boxed context
            }
            if (isFloatLocal(locals, node)) {
                return "nv_float(" + v + ")"
            }
            return v
        }
        if (isImplicitField(node, prog, ctx, locals)) {
            // the slot is known at compile time - no name lookup at run time
            return "nv_fields(self->o)[" + fieldSlot(prog, ctx["class"], node) + "]"
        }
        if (isClassLike(prog, node)) {
            fail("'" + node + "' is a type, not a value", ctx["pos"])
        }
        if (node == "this") {
            fail("'this' is only available inside classes", ctx["pos"])
        }
        failModuleUse(node, prog, ctx)
        fail("unknown variable '" + node + "'", ctx["pos"])
    }
    var head = nodeHead(node)
    if (head == "str") {
        return litRef(prog, nodeChild(node, 1))
    }
    if (head == "await") {
        return "nv_await(" + genExpr(nodeChild(node, 1), prog, ctx, locals) + ")"
    }
    if (head == "spawn") {
        return genSpawn(node, prog, ctx, locals)
    }
    if (head == "craw") {
        // C written by the code generator itself - see genSpawn()
        return sexpUnescape(nodeChild(node, 1))
    }
    if (head == "neg") {
        var operand = nodeChild(node, 1)
        if (isNumberAtom(operand)) {
            if (hasDot(operand)) {
                return "nv_float(-" + operand + ")"
            }
            return "nv_int(-" + operand + "LL)"
        }
        return "nv_neg(" + genExpr(operand, prog, ctx, locals) + ")"
    }
    if (head == "!") {
        return "nv_not(" + genExpr(nodeChild(node, 1), prog, ctx, locals) + ")"
    }
    if (head == "arr") {
        var count = nodeCount(node) - 1
        if (count == 0) {
            return "nv_arr()"
        }
        return "nv_arr_of(" + count + ", " + genArgs(node, 1, prog, ctx, locals) + ")"
    }
    if (head == "mapl") {
        var pairs = (nodeCount(node) - 1) / 2
        if (pairs == 0) {
            return "nv_map()"
        }
        return "nv_map_of(" + pairs + ", " + genArgs(node, 1, prog, ctx, locals) + ")"
    }
    if (head == "obj") {
        var cls = nodeChild(node, 1)
        if (isClassLike(prog, cls) == false) {
            fail("unknown class '" + cls + "'", ctx["pos"])
        }
        if (prog.has("enum:" + cls)) {
            fail("'" + cls + "' is an enum and cannot be constructed", ctx["pos"])
        }
        if (classIsAbstract(prog["class:" + cls])) {
            fail("cannot instantiate abstract class '" + cls + "'", ctx["pos"])
        }
        var out = "nv_new_object_fields_cached(&nv_cls_" + cls + ", " + cstr(cls) + ", " + (nodeCount(node) - 2)
        var i = 2
        var nodeCount = nodeCount(node)
        while (i < nodeCount) {
            var f = nodeChild(node, i)
            out = out + ", " + cstr(nodeChild(f, 1)) + ", " + genExpr(nodeChild(f, 2), prog, ctx, locals)
            i = i + 1
        }
        return out + ")"
    }
    if (head == "idx") {
        return "nv_index(" + genExpr(nodeChild(node, 1), prog, ctx, locals) + ", " + genExpr(nodeChild(node, 2), prog, ctx, locals) + ")"
    }
    if (head == "mget") {
        var target = nodeChild(node, 1)
        var member = nodeChild(node, 2)
        if (isIdentAtom(target) && resolveVar(target, prog, ctx, locals) == "" && isImplicitField(target, prog, ctx, locals) == false) {
            if (prog.has("enum:" + target)) {
                return "nv_enum_get(" + cstr(target) + ", " + cstr(member) + ")"
            }
            if (prog.has("pkg:" + target)) {
                // module.name without parentheses: a global or a parameterless function
                if (prog.has("global:" + target + "." + member)) {
                    return "g_" + cName(target + "." + member)
                }
                return genQualifiedCall(target, member, node, 3, prog, ctx, locals)
            }
            if (isClassLike(prog, target)) {
                fail("'" + target + "' is a type, not a value", ctx["pos"])
            }
            failModuleUse(target, prog, ctx)
            fail("unknown variable '" + target + "'", ctx["pos"])
        }
        if (target == "this" && ctx["class"] != "" && fieldSlot(prog, ctx["class"], member) >= 0) {
            return "nv_fields(self->o)[" + fieldSlot(prog, ctx["class"], member) + "]"
        }
        return "nv_get_member(" + genExpr(target, prog, ctx, locals) + ", " + cstr(member) + ")"
    }
    if (head == "mcall") {
        var mtarget = nodeChild(node, 1)
        var mname = nodeChild(node, 2)
        var nargs = nodeCount(node) - 3
        if (isIdentAtom(mtarget) && resolveVar(mtarget, prog, ctx, locals) == "" && isImplicitField(mtarget, prog, ctx, locals) == false) {
            if (prog.has("pkg:" + mtarget)) {
                return genQualifiedCall(mtarget, mname, node, 3, prog, ctx, locals)
            }
            if (prog.has("enum:" + mtarget)) {
                if (mname == "values") {
                    return "nv_enum_values(" + cstr(mtarget) + ")"
                }
                fail("unknown enum function " + mtarget + "." + mname + "()", ctx["pos"])
            }
            if (isClassLike(prog, mtarget)) {
                fail("'" + mtarget + "' is a type, not a value", ctx["pos"])
            }
            failModuleUse(mtarget, prog, ctx)
            fail("unknown variable '" + mtarget + "'", ctx["pos"])
        }
        if (nargs == 0) {
            if (mtarget == "this" && ctx["class"] != "" && fieldSlot(prog, ctx["class"], mname) >= 0) {
                return "nv_fields(self->o)[" + fieldSlot(prog, ctx["class"], mname) + "]"
            }
            return invokeCall0(genExpr(mtarget, prog, ctx, locals), mname)
        }
        return invokeCall(genExpr(mtarget, prog, ctx, locals), mname, nargs, genArgs(node, 3, prog, ctx, locals))
    }
    if (head == "call") {
        return genCall(node, prog, ctx, locals)
    }
    // A sub-expression that can only be numeric is computed unboxed and
    // boxed once at the end, instead of boxing every intermediate result.
    if (isIntValue(node, locals)) {
        return "nv_int(" + genInt(node, prog, ctx, locals) + ")"
    }
    if (isFloatValue(node, locals)) {
        return "nv_float(" + genFloat(node, prog, ctx, locals) + ")"
    }
    if (head == "+" && isList(nodeChild(node, 1)) && nodeHead(nodeChild(node, 1)) == "+") {
        return genAddChain(node, prog, ctx, locals)
    }
    var l = genExpr(nodeChild(node, 1), prog, ctx, locals)
    var r = genExpr(nodeChild(node, 2), prog, ctx, locals)
    if (head == "&&") {
        return "nv_bool(nv_truthy(" + l + ") && nv_truthy(" + r + "))"
    }
    if (head == "||") {
        return "nv_bool(nv_truthy(" + l + ") || nv_truthy(" + r + "))"
    }
    // *_fast are inline wrappers that keep small-integer arithmetic in registers
    var ops = {"+": "nv_add_fast", "-": "nv_sub_fast", "*": "nv_mul_fast", "/": "nv_div", "%": "nv_mod",
        "==": "nv_eq", "!=": "nv_ne", "<": "nv_lt", ">": "nv_gt", "<=": "nv_le", ">=": "nv_ge",
        "&": "nv_band", "|": "nv_bor", "^": "nv_bxor", "<<": "nv_shl", ">>": "nv_shr"}
    if (ops.has(head) == false) {
        fail("unsupported expression '" + head + "'", ctx["pos"])
    }
    return ops[head] + "(" + l + ", " + r + ")"
}

// `a + b + c + ...` becomes one runtime call. Chains like this are how
// strings are built, and every step of the nested form allocates a value and
// walks the accumulated text again; the fused call fills one buffer.
method genAddChain(string node, map<string, string> prog, map<string, string> ctx, map<string, string> locals): string {
    var parts = []
    var walk = node
    while (isList(walk) && nodeHead(walk) == "+" && nodeCount(walk) == 3 && parts.length() < 15) {
        parts.append(nodeChild(walk, 2))
        walk = nodeChild(walk, 1)
    }
    parts.append(walk)
    var args = ""
    var i = parts.length()
    while (i > 0) {
        if (args != "") {
            args = args + ", "
        }
        args = args + genExpr(parts[i - 1], prog, ctx, locals)
        i = i - 1
    }
    return "nv_add_chain(" + parts.length() + ", " + args + ")"
}
