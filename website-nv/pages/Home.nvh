<?nv
import components
prop string title = "Novus"
?>
<Layout title="{title}" section="home">
  <section class="hero">
    <h1>Novus</h1>
    <p class="tagline">A fast, expressive compiled language.</p>
    <div class="features">
      <div class="feature">
        <h3>⚡ Fast</h3>
        <p>Compiles to optimized C. Performance comparable to Rust and C++.</p>
      </div>
      <div class="feature">
        <h3>🧠 Expressive</h3>
        <p>Modern syntax with classes, methods, modules, and first-class functions.</p>
      </div>
      <div class="feature">
        <h3>🔒 Safe</h3>
        <p>Memory-safe by default, no garbage collector.</p>
      </div>
    </div>
    <p><a href="/docs/introduction">Learn Novus →</a></p>
  </section>
</Layout>

<style>
.hero { text-align: center; padding: 3rem 0; }
.tagline { font-size: 1.25rem; color: #c084fc; margin-bottom: 2rem; }
.features { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin: 2rem 0; }
.feature { padding: 1.5rem; background: rgba(168, 85, 247, 0.05); border: 1px solid rgba(168, 85, 247, 0.1); border-radius: 8px; }
.feature h3 { margin-top: 0; }
.feature p { color: #d8b4fe; font-size: 0.95rem; }
</style>
