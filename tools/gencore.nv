package gencore

import "parsecore.nv"

// v4: fully string-based AST navigation so the generator can be compiled
// by the Novus pipeline itself (no nested arrays, no escapes after the
// q()/nl()/bs() transformation).

method q(): string {
    return chr(34)
}

method nl(): string {
    return chr(10)
}

method bs(): string {
    return chr(92)
}

method isList(string s): bool {
    if (s.length() > 0) {
        return s.charAt(0) == "("
    }
    return false
}

method nodeChild(string s, integer index): string {
    var quote = chr(34)
    var n = s.length()
    var i = 1
    var count = 0
    while (i < n) {
        while (i < n && s.charAt(i) == " ") {
            i = i + 1
        }
        if (i >= n) {
            return ""
        }
        if (s.charAt(i) == ")") {
            return ""
        }
        var start = i
        if (s.charAt(i) == "(") {
            var depth = 0
            var inQuote = false
            while (i < n) {
                var c = s.charAt(i)
                if (inQuote) {
                    if (c == quote) {
                        inQuote = false
                    }
                } else if (c == quote) {
                    inQuote = true
                } else if (c == "(") {
                    depth = depth + 1
                } else if (c == ")") {
                    depth = depth - 1
                    if (depth == 0) {
                        i = i + 1
                        break
                    }
                }
                i = i + 1
            }
        } else if (s.charAt(i) == quote) {
            i = i + 1
            while (i < n && s.charAt(i) != quote) {
                i = i + 1
            }
            i = i + 1
        } else {
            while (i < n && s.charAt(i) != " " && s.charAt(i) != ")") {
                i = i + 1
            }
        }
        if (count == index) {
            return s.substring(start, i)
        }
        count = count + 1
    }
    return ""
}

method nodeCount(string s): integer {
    var quote = chr(34)
    var n = s.length()
    var i = 1
    var count = 0
    while (i < n) {
        while (i < n && s.charAt(i) == " ") {
            i = i + 1
        }
        if (i >= n) {
            return count
        }
        if (s.charAt(i) == ")") {
            return count
        }
        if (s.charAt(i) == "(") {
            var depth = 0
            var inQuote = false
            while (i < n) {
                var c = s.charAt(i)
                if (inQuote) {
                    if (c == quote) {
                        inQuote = false
                    }
                } else if (c == quote) {
                    inQuote = true
                } else if (c == "(") {
                    depth = depth + 1
                } else if (c == ")") {
                    depth = depth - 1
                    if (depth == 0) {
                        i = i + 1
                        break
                    }
                }
                i = i + 1
            }
        } else if (s.charAt(i) == quote) {
            i = i + 1
            while (i < n && s.charAt(i) != quote) {
                i = i + 1
            }
            i = i + 1
        } else {
            while (i < n && s.charAt(i) != " " && s.charAt(i) != ")") {
                i = i + 1
            }
        }
        count = count + 1
    }
    return count
}

method nodeHead(string s): string {
    if (isList(s)) {
        return nodeChild(s, 0)
    }
    return ""
}

method escapeC(string s): string {
    var newline = chr(10)
    var backslash = chr(92)
    var out = ""
    var i = 0
    while (i < s.length()) {
        var c = s.charAt(i)
        if (c == newline) {
            out = out + backslash + "n"
        } else if (c == backslash) {
            out = out + backslash + backslash
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

method isArrayType(string t): bool {
    if (t.length() >= 5) {
        return t.substring(0, 5) == "array"
    }
    return false
}

method isMapType(string t): bool {
    if (t.length() >= 3) {
        return t.substring(0, 3) == "map"
    }
    return false
}

method cType(string t): string {
    if (isArrayType(t)) {
        return "NvArr*"
    }
    if (isMapType(t)) {
        return "NvMap*"
    }
    if (t == "integer") {
        return "int"
    }
    if (t == "float") {
        return "double"
    }
    if (t == "bool") {
        return "int"
    }
    if (t == "string") {
        return "const char*"
    }
    if (t == "void") {
        return "void"
    }
    return "int"
}

method exprType(string node, map<string, string> locals, map<string, string> rets): string {
    if (node.length() == 0) {
        return "integer"
    }
    if (isList(node) == false) {
        if (node == "true" || node == "false") {
            return "bool"
        }
        if (isDigit(node.charAt(0))) {
            var i = 0
            while (i < node.length()) {
                if (node.charAt(i) == ".") {
                    return "float"
                }
                i = i + 1
            }
            return "integer"
        }
        if (locals.has(node)) {
            return locals[node]
        }
        return "integer"
    }
    var head = nodeHead(node)
    if (head == "str") {
        return "string"
    }
    if (head == "arr") {
        return "array<string>"
    }
    if (head == "mapl") {
        return "map<string,string>"
    }
    if (head == "idx") {
        return "string"
    }
    if (head == "mcall") {
        var name = nodeChild(node, 2)
        if (name == "length") {
            return "integer"
        }
        if (name == "charAt" || name == "substring") {
            return "string"
        }
        if (name == "has") {
            return "bool"
        }
        if (name == "keys") {
            return "array<string>"
        }
        return "void"
    }
    if (head == "mget") {
        return "integer"
    }
    if (head == "call") {
        var fname = nodeChild(node, 1)
        if (fname == "chr") {
            return "string"
        }
        if (fname == "ord" || fname == "parseInt") {
            return "integer"
        }
        if (fname == "readFile") {
            return "string"
        }
        if (fname == "args") {
            return "array<string>"
        }
        if (rets.has(fname)) {
            return rets[fname]
        }
        return "integer"
    }
    if (head == "!" || head == "==" || head == "!=" || head == "<" || head == ">" || head == "<=" || head == ">=" || head == "&&" || head == "||") {
        return "bool"
    }
    var lt = exprType(nodeChild(node, 1), locals, rets)
    var rt = exprType(nodeChild(node, 2), locals, rets)
    if (lt == "string" || rt == "string") {
        return "string"
    }
    if (lt == "float" || rt == "float") {
        return "float"
    }
    return "integer"
}

method genStr(string node, map<string, string> locals, map<string, string> rets): string {
    var t = exprType(node, locals, rets)
    var e = genExpr(node, locals, rets)
    if (t == "integer" || t == "bool") {
        return "nv_int2str(" + e + ")"
    }
    if (t == "float") {
        return "nv_float2str(" + e + ")"
    }
    return e
}

method genExpr(string node, map<string, string> locals, map<string, string> rets): string {
    if (isList(node) == false) {
        if (node == "true") {
            return "1"
        }
        if (node == "false") {
            return "0"
        }
        return node
    }
    var head = nodeHead(node)
    if (head == "str") {
        if (nodeCount(node) > 1) {
            return escapeC(nodeChild(node, 1))
        }
        return "" + q() + "" + q() + ""
    }
    if (head == "arr") {
        var out = "nv_arr_of(" + (nodeCount(node) - 1)
        var i = 1
        while (i < nodeCount(node)) {
            out = out + ", " + genExpr(nodeChild(node, i), locals, rets)
            i = i + 1
        }
        return out + ")"
    }
    if (head == "idx") {
        var targetType = exprType(nodeChild(node, 1), locals, rets)
        var t = genExpr(nodeChild(node, 1), locals, rets)
        var k = genExpr(nodeChild(node, 2), locals, rets)
        if (isMapType(targetType)) {
            return "nv_map_get(" + t + ", " + k + ")"
        }
        return "nv_arr_get(" + t + ", " + k + ")"
    }
    if (head == "mapl") {
        var pairs = (nodeCount(node) - 1) / 2
        var out = "nv_map_of(" + pairs
        var i = 1
        while (i < nodeCount(node)) {
            out = out + ", " + genExpr(nodeChild(node, i), locals, rets)
            out = out + ", " + genStr(nodeChild(node, i + 1), locals, rets)
            i = i + 2
        }
        return out + ")"
    }
    if (head == "mcall") {
        var name = nodeChild(node, 2)
        var t = genExpr(nodeChild(node, 1), locals, rets)
        if (name == "length") {
            var targetType = exprType(nodeChild(node, 1), locals, rets)
            if (isArrayType(targetType) || isMapType(targetType)) {
                return "(" + t + ")->len"
            }
            return "(int)strlen(" + t + ")"
        }
        if (name == "charAt") {
            return "nv_charat(" + t + ", " + genExpr(nodeChild(node, 3), locals, rets) + ")"
        }
        if (name == "substring") {
            return "nv_substr(" + t + ", " + genExpr(nodeChild(node, 3), locals, rets) + ", " + genExpr(nodeChild(node, 4), locals, rets) + ")"
        }
        if (name == "append") {
            return "nv_arr_push(" + t + ", " + genExpr(nodeChild(node, 3), locals, rets) + ")"
        }
        if (name == "has") {
            return "nv_map_has(" + t + ", " + genExpr(nodeChild(node, 3), locals, rets) + ")"
        }
        if (name == "keys") {
            return "nv_map_keys(" + t + ")"
        }
        if (name == "remove") {
            return "nv_map_remove(" + t + ", " + genExpr(nodeChild(node, 3), locals, rets) + ")"
        }
        return "0"
    }
    if (head == "mget") {
        return "0"
    }
    if (head == "call") {
        var fname = nodeChild(node, 1)
        if (fname == "chr") {
            return "nv_chr(" + genExpr(nodeChild(node, 2), locals, rets) + ")"
        }
        if (fname == "ord") {
            return "nv_ord(" + genExpr(nodeChild(node, 2), locals, rets) + ")"
        }
        if (fname == "parseInt") {
            return "atoi(" + genExpr(nodeChild(node, 2), locals, rets) + ")"
        }
        if (fname == "readFile") {
            return "nv_read_file(" + genExpr(nodeChild(node, 2), locals, rets) + ")"
        }
        if (fname == "args") {
            return "nv_get_args()"
        }
        var out = fname + "("
        var i = 2
        while (i < nodeCount(node)) {
            if (i > 2) {
                out = out + ", "
            }
            out = out + genExpr(nodeChild(node, i), locals, rets)
            i = i + 1
        }
        return out + ")"
    }
    if (head == "!") {
        return "(!" + genExpr(nodeChild(node, 1), locals, rets) + ")"
    }
    var op = head
    var lt = exprType(nodeChild(node, 1), locals, rets)
    var rt = exprType(nodeChild(node, 2), locals, rets)
    var l = genExpr(nodeChild(node, 1), locals, rets)
    var r = genExpr(nodeChild(node, 2), locals, rets)
    if (op == "+" && (lt == "string" || rt == "string")) {
        if (lt == "integer") {
            l = "nv_int2str(" + l + ")"
        }
        if (lt == "float") {
            l = "nv_float2str(" + l + ")"
        }
        if (rt == "integer") {
            r = "nv_int2str(" + r + ")"
        }
        if (rt == "float") {
            r = "nv_float2str(" + r + ")"
        }
        return "nv_concat(" + l + ", " + r + ")"
    }
    if ((op == "<" || op == ">" || op == "<=" || op == ">=") && (lt == "string" || rt == "string")) {
        return "(strcmp(" + l + ", " + r + ") " + op + " 0)"
    }
    if ((op == "==" || op == "!=") && lt == "string" && rt == "string") {
        if (op == "==") {
            return "nv_streq(" + l + ", " + r + ")"
        }
        return "(!nv_streq(" + l + ", " + r + "))"
    }
    return "(" + l + " " + op + " " + r + ")"
}

method collectStmtLocals(string s, map<string, string> locals, map<string, string> rets): map<string, string> {
    var head = nodeHead(s)
    if (head == "block") {
        var i = 1
        while (i < nodeCount(s)) {
            locals = collectStmtLocals(nodeChild(s, i), locals, rets)
            i = i + 1
        }
        return locals
    }
    if (head == "var") {
        if (nodeCount(s) > 2) {
            locals[nodeChild(s, 1)] = exprType(nodeChild(s, 2), locals, rets)
        } else {
            locals[nodeChild(s, 1)] = "integer"
        }
        return locals
    }
    if (head == "if") {
        locals = collectStmtLocals(nodeChild(s, 2), locals, rets)
        if (nodeCount(s) > 3) {
            locals = collectStmtLocals(nodeChild(s, 3), locals, rets)
        }
        return locals
    }
    if (head == "while") {
        return collectStmtLocals(nodeChild(s, 2), locals, rets)
    }
    if (head == "forin") {
        locals[nodeChild(s, 1)] = "string"
        return collectStmtLocals(nodeChild(s, 3), locals, rets)
    }
    return locals
}

method genStatement(string node, string indent, map<string, string> locals, map<string, string> rets): string {
    if (isList(node) == false) {
        return indent + genExpr(node, locals, rets) + ";" + nl() + ""
    }
    var head = nodeHead(node)
    if (head == "var") {
        var name = nodeChild(node, 1)
        if (nodeCount(node) > 2) {
            var t = exprType(nodeChild(node, 2), locals, rets)
            return indent + cType(t) + " " + name + " = " + genExpr(nodeChild(node, 2), locals, rets) + ";" + nl() + ""
        }
        return indent + "int " + name + ";" + nl() + ""
    }
    if (head == "assign") {
        return indent + nodeChild(node, 1) + " = " + genExpr(nodeChild(node, 2), locals, rets) + ";" + nl() + ""
    }
    if (head == "setexpr") {
        var lhs = nodeChild(node, 1)
        if (nodeHead(lhs) == "idx") {
            var target = genExpr(nodeChild(lhs, 1), locals, rets)
            var targetType = exprType(nodeChild(lhs, 1), locals, rets)
            var key = genExpr(nodeChild(lhs, 2), locals, rets)
            if (isMapType(targetType)) {
                return indent + "nv_map_set(" + target + ", " + key + ", " + genStr(nodeChild(node, 2), locals, rets) + ");" + nl() + ""
            }
            return indent + "nv_arr_set(" + target + ", " + key + ", " + genExpr(nodeChild(node, 2), locals, rets) + ");" + nl() + ""
        }
        return indent + genExpr(lhs, locals, rets) + " = " + genExpr(nodeChild(node, 2), locals, rets) + ";" + nl() + ""
    }
    if (head == "return") {
        if (nodeCount(node) > 1) {
            return indent + "return " + genExpr(nodeChild(node, 1), locals, rets) + ";" + nl() + ""
        }
        return indent + "return;" + nl() + ""
    }
    if (head == "println") {
        var t = exprType(nodeChild(node, 1), locals, rets)
        var e = genExpr(nodeChild(node, 1), locals, rets)
        if (t == "string") {
            return indent + "printf(" + q() + "%s" + bs() + "n" + q() + ", " + e + ");" + nl() + ""
        }
        if (t == "float") {
            return indent + "printf(" + q() + "%f" + bs() + "n" + q() + ", " + e + ");" + nl() + ""
        }
        if (t == "bool") {
            return indent + "printf(" + q() + "%s" + bs() + "n" + q() + ", (" + e + ") ? " + q() + "true" + q() + " : " + q() + "false" + q() + ");" + nl() + ""
        }
        return indent + "printf(" + q() + "%d" + bs() + "n" + q() + ", " + e + ");" + nl() + ""
    }
    if (head == "if") {
        var out = indent + "if (" + genExpr(nodeChild(node, 1), locals, rets) + ") {" + nl() + ""
        out = out + genBlockBody(nodeChild(node, 2), indent + "    ", locals, rets)
        out = out + indent + "}"
        if (nodeCount(node) > 3) {
            var elseNode = nodeChild(node, 3)
            if (nodeHead(elseNode) == "if") {
                var ec = genStatement(elseNode, indent, locals, rets)
                return out + " else " + ec.substring(indent.length(), ec.length())
            }
            out = out + " else {" + nl() + "" + genBlockBody(elseNode, indent + "    ", locals, rets) + indent + "}"
        }
        return out + "" + nl() + ""
    }
    if (head == "while") {
        return indent + "while (" + genExpr(nodeChild(node, 1), locals, rets) + ") {" + nl() + "" + genBlockBody(nodeChild(node, 2), indent + "    ", locals, rets) + indent + "}" + nl() + ""
    }
    if (head == "forin") {
        var v = nodeChild(node, 1)
        var arrE = genExpr(nodeChild(node, 2), locals, rets)
        var idxVar = "__i_" + v
        var arrVar = "__a_" + v
        var out = indent + "{" + nl() + ""
        out = out + indent + "NvArr* " + arrVar + " = " + arrE + ";" + nl() + ""
        out = out + indent + "for (int " + idxVar + " = 0; " + idxVar + " < (" + arrVar + ")->len; " + idxVar + "++) {" + nl() + ""
        out = out + indent + "    const char* " + v + " = nv_arr_get(" + arrVar + ", " + idxVar + ");" + nl() + ""
        out = out + genBlockBody(nodeChild(node, 3), indent + "    ", locals, rets)
        out = out + indent + "}" + nl() + ""
        out = out + indent + "}" + nl() + ""
        return out
    }
    if (head == "break") {
        return indent + "break;" + nl() + ""
    }
    if (head == "continue") {
        return indent + "continue;" + nl() + ""
    }
    return indent + genExpr(node, locals, rets) + ";" + nl() + ""
}

method genBlockBody(string block, string indent, map<string, string> locals, map<string, string> rets): string {
    var out = ""
    var i = 1
    while (i < nodeCount(block)) {
        out = out + genStatement(nodeChild(block, i), indent, locals, rets)
        i = i + 1
    }
    return out
}

method genSignature(string m): string {
    var name = nodeChild(m, 1)
    if (name == "main") {
        return "int main(int argc, char** argv)"
    }
    var ret = cType(nodeChild(m, 2))
    var params = ""
    if (nodeCount(m) > 4) {
        var pn = nodeChild(m, 3)
        var i = 1
        while (i < nodeCount(pn)) {
            var pp = nodeChild(pn, i)
            if (i > 1) {
                params = params + ", "
            }
            params = params + cType(nodeChild(pp, 1)) + " " + nodeChild(pp, 2)
            i = i + 1
        }
    }
    return ret + " " + name + "(" + params + ")"
}

method genMethod(string m, map<string, string> rets): string {
    var locals = {}
    var bodyIndex = 3
    if (nodeCount(m) > 4) {
        bodyIndex = 4
        var pn = nodeChild(m, 3)
        var i = 1
        while (i < nodeCount(pn)) {
            var pp = nodeChild(pn, i)
            locals[nodeChild(pp, 2)] = nodeChild(pp, 1)
            i = i + 1
        }
    }
    locals = collectStmtLocals(nodeChild(m, bodyIndex), locals, rets)
    var out = genSignature(m) + " {" + nl() + ""
    if (nodeChild(m, 1) == "main") {
        out = out + "    nv_init_args(argc, argv);" + nl() + ""
        if (nodeCount(m) > 4) {
            out = out + "    NvArr* " + nodeChild(nodeChild(nodeChild(m, 3), 1), 2) + " = nv_get_args();" + nl() + ""
        }
    }
    out = out + genBlockBody(nodeChild(m, bodyIndex), "    ", locals, rets)
    return out + "}" + nl() + ""
}

method generateC(string source): string {
    var trees = parseProgram(source)
    var rets = {}
    for (t in trees) {
        rets[nodeChild(t, 1)] = nodeChild(t, 2)
    }
    var out = "#include <stdio.h>" + nl() + "#include " + q() + "novus_rt.h" + q() + "" + nl() + ""
    var protos = ""
    for (t in trees) {
        if (nodeChild(t, 1) != "main") {
            protos = protos + genSignature(t) + ";" + nl() + ""
        }
    }
    if (protos != "") {
        out = out + "" + nl() + "" + protos
    }
    for (t in trees) {
        out = out + "" + nl() + "" + genMethod(t, rets)
    }
    return out
}
