package main

import os
import langstats

// langstats - which languages make up a source tree (like the language bar
// on GitHub), Novus included.
//
//   novusc run tools/langstats.nv [directory] [--all] [--lines]
//
// Percentages are computed over programming languages by bytes (GitHub's
// rule); data, prose and generated files are listed separately. --all counts
// every file type, --lines ranks by lines instead of bytes.

method main(array<string> arguments) {
    var root = "."
    var all = false
    var byLines = false
    for (argument in arguments) {
        if (argument == "--all") {
            all = true
            continue
        }
        if (argument == "--lines") {
            byLines = true
            continue
        }
        root = argument
    }
    if (os.isDir(root) == false) {
        eprintln "langstats: '${root}' is not a directory"
        return 1
    }
    var stats = {}
    var generated = []
    scan(root, "", stats, generated)
    report(stats, generated, all, byLines)
    return 0
}
