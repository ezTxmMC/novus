package main

// Merging two sorted arrays into one.

method merge(array<integer> a, array<integer> b): array<integer> {
    var out = []
    var i = 0
    var j = 0
    while (i < a.length() && j < b.length()) {
        if (a[i] <= b[j]) {
            out.append(a[i])
            i = i + 1
            continue
        }
        out.append(b[j])
        j = j + 1
    }
    while (i < a.length()) {
        out.append(a[i])
        i = i + 1
    }
    while (j < b.length()) {
        out.append(b[j])
        j = j + 1
    }
    return out
}

method main {
    println merge([1, 4, 7], [2, 3, 9, 11])
}
